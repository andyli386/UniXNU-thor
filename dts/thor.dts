/dts-v1/;
/include/ "sm8475.dtsi"
/ {
    model = "Xiaomi 12S Ultra";
    compatible = "xiaomi,thor", "qcom,sm8475";
    /* 12 GiB from 0x80000000, same as pong. The format 2 build reads /memory
       as a single reg pair; reserved regions below keep firmware off limits. */
    memory@80000000 { device_type = "memory"; reg = <0x0 0x80000000 0x3 0x0>; };
    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;
        /* Same SM8475 firmware layout as pong: hyp, AOP, SMEM, PIL, TZ, display */
        region0@80000000 { reg = <0x0 0x80000000 0x0 0x600000>; no-map; };
        region1@80600000 { reg = <0x0 0x80600000 0x0 0x40000>; no-map; };
        region2@80640000 { reg = <0x0 0x80640000 0x0 0x1c0000>; no-map; };
        region3@80800000 { reg = <0x0 0x80800000 0x0 0xa0000>; no-map; };
        region4@80900000 { reg = <0x0 0x80900000 0x0 0x200000>; no-map; };
        region5@80b00000 { reg = <0x0 0x80b00000 0x0 0x4600000>; no-map; };
        region6@85700000 { reg = <0x0 0x85700000 0x0 0x1c200000>; no-map; };
        region7@a1400000 { reg = <0x0 0xa1400000 0x0 0x2b00000>; no-map; };
        region8@a6e00000 { reg = <0x0 0xa6e00000 0x0 0x40000>; no-map; };
        region9@b8000000 { reg = <0x0 0xb8000000 0x0 0x4b00000>; no-map; };
        region10@bb000000 { reg = <0x0 0xbb000000 0x0 0x5000000>; no-map; };
        region11@c0000000 { reg = <0x0 0xc0000000 0x0 0x20000000>; no-map; };
        region12@e0000000 { reg = <0x0 0xe0000000 0x0 0x5700000>; no-map; };
        region13@e8800000 { reg = <0x0 0xe8800000 0x0 0x1000000>; no-map; };
        region14@e9b00000 { reg = <0x0 0xe9b00000 0x0 0x500000>; no-map; };
        region15@ea000000 { reg = <0x0 0xea000000 0x0 0x7400000>; no-map; };
        region16@f8000000 { reg = <0x0 0xf8000000 0x0 0x7c00000>; no-map; };
        region17@ffc00000 { reg = <0x0 0xffc00000 0x0 0x400000>; no-map; };
        region18@830000000 { reg = <0x8 0x30000000 0x0 0x10000000>; no-map; };
    };

    chosen {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;
    };

    cpus {
        #address-cells = <2>;
        #size-cells = <0>;
        CPU0: cpu@0 { device_type = "cpu"; compatible = "arm,armv8"; reg = <0x0 0x0>;
            enable-method = "psci"; status = "okay"; };
        CPU1: cpu@100 { device_type = "cpu"; compatible = "arm,armv8"; reg = <0x0 0x100>;
            enable-method = "psci"; status = "okay"; };
        CPU2: cpu@200 { device_type = "cpu"; compatible = "arm,armv8"; reg = <0x0 0x200>;
            enable-method = "psci"; status = "okay"; };
        CPU3: cpu@300 { device_type = "cpu"; compatible = "arm,armv8"; reg = <0x0 0x300>;
            enable-method = "psci"; status = "okay"; };
        CPU4: cpu@400 { device_type = "cpu"; compatible = "arm,armv8"; reg = <0x0 0x400>;
            enable-method = "psci"; status = "okay"; };
        CPU5: cpu@500 { device_type = "cpu"; compatible = "arm,armv8"; reg = <0x0 0x500>;
            enable-method = "psci"; status = "okay"; };
        CPU6: cpu@600 { device_type = "cpu"; compatible = "arm,armv8"; reg = <0x0 0x600>;
            enable-method = "psci"; status = "okay"; };
        CPU7: cpu@700 { device_type = "cpu"; compatible = "arm,armv8"; reg = <0x0 0x700>;
            enable-method = "psci"; status = "okay"; };
    };

    psci {
        compatible = "arm,psci-1.0";
        method = "smc";
        cpu_suspend = <0xc4000001>;
        cpu_off = <0x84000002>;
        cpu_on = <0xc4000003>;
    };

    timer {
        compatible = "arm,armv8-timer";
        interrupts = <1 13 0xff01 1 14 0xff01 1 11 0xff01 1 10 0xff01>;
        interrupt-parent = <&gic>;
    };

    gic: interrupt-controller@17100000 {
        compatible = "arm,gic-v3";
        #interrupt-cells = <3>;
        interrupt-controller;
        reg = <0x0 0x17100000 0x0 0x10000    /* GICD */
              0x0 0x17180000 0x0 0x200000>; /* GICR */
    };
};
