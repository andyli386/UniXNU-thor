+static bool thor_policy_file_matches(const char *path, const char *expected)
+{
+    const int fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW | O_NONBLOCK);
+    if (fd < 0) return false;
+    const size_t size = strlen(expected);
+    struct stat info;
