+/* Read the UUID from the Mach-O that actually supplied this function.
+ * Kernel staging success alone cannot attest that dyld loaded the adapter. */
+static void report_loaded_adapter(int fd, const char *boot_id)
+{
+    Dl_info adapter = {0};
+    if (!dladdr((const void *)pong_console_line, &adapter) || !adapter.dli_fbase)
+        return;
+    const struct mach_header_64 *header = adapter.dli_fbase;
+    if (header->magic != MH_MAGIC_64)
+        return;
+    const char *command = (const char *)(header + 1);
+    const char *end = command + header->sizeofcmds;
+    uuid_string_t image_uuid = "unavailable";
+    for (uint32_t i = 0; i < header->ncmds; i++) {
+        if ((size_t)(end - command) < sizeof(struct load_command))
+            break;
+        const struct load_command *entry = (const void *)command;
+        if (entry->cmdsize < sizeof(*entry) || entry->cmdsize > (size_t)(end - command))
+            break;
+        if (entry->cmd == LC_UUID && entry->cmdsize == sizeof(struct uuid_command)) {
+            const struct uuid_command *identity = (const void *)command;
+            uuid_unparse_upper(identity->uuid, image_uuid);
+            break;
+        }
+        command += entry->cmdsize;
+    }
+    dprintf(fd, "Pong boot adapter: %s pid=%d boot=%s uuid=%s path=%s\n",
+            process_name, getpid(), boot_id, image_uuid,
+            adapter.dli_fname ? adapter.dli_fname : "unavailable");
