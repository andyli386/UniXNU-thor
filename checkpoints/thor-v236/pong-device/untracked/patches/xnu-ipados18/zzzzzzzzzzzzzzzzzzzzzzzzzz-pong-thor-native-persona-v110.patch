+#ifdef THOR_PERSONA_LAUNCHD_PAYLOAD
+static int
+thor_persona_launchd_source_matches(proc_t p)
+{
+	vfs_context_t context = vfs_context_current();
+	vnode_t file = NULLVP;
+	int error = vnode_open("/sbin/launchd", FREAD, 0,
+	    VNODE_LOOKUP_NOFOLLOW_ANY, &file, context);
+	if (error) {
+		return error;
+	}
+
+	struct vnode_attr attributes;
+	VATTR_INIT(&attributes);
+	VATTR_WANTED(&attributes, va_data_size);
+	VATTR_WANTED(&attributes, va_uid);
+	VATTR_WANTED(&attributes, va_gid);
+	VATTR_WANTED(&attributes, va_mode);
+	error = VNOP_GETATTR(file, &attributes, context);
+	if (!error && (vnode_vtype(file) != VREG ||
+	    !VATTR_IS_SUPPORTED(&attributes, va_data_size) ||
+	    !VATTR_IS_SUPPORTED(&attributes, va_uid) ||
+	    !VATTR_IS_SUPPORTED(&attributes, va_gid) ||
+	    !VATTR_IS_SUPPORTED(&attributes, va_mode) ||
+	    attributes.va_uid != 0 || attributes.va_gid != 0 ||
+	    (attributes.va_mode & 07777) != 0755 ||
+	    attributes.va_data_size != THOR_PERSONA_LAUNCHD_SOURCE_SIZE)) {
+		error = EACCES;
+	}
+	if (!error) {
+		SHA256_CTX hash;
+		unsigned char digest[32], buffer[2048];
+		SHA256_Init(&hash);
+		for (size_t offset = 0; offset < THOR_PERSONA_LAUNCHD_SOURCE_SIZE;) {
+			size_t amount = MIN(sizeof(buffer), THOR_PERSONA_LAUNCHD_SOURCE_SIZE - offset);
+			int residual = 0;
+			error = vn_rdwr(UIO_READ, file, (caddr_t)buffer, (int)amount, (off_t)offset,
+			    UIO_SYSSPACE, IO_UNIT, vfs_context_ucred(context), &residual, p);
+			if (error || residual) {
+				if (!error) error = EIO;
+				break;
+			}
+			SHA256_Update(&hash, buffer, amount);
+			offset += amount;
+		}
+		if (!error) {
+			SHA256_Final(digest, &hash);
+			if (memcmp(digest, thor_persona_launchd_source_sha256, sizeof(digest))) {
+				error = EINVAL;
+			}
+		}
+	}
+	int close_error = vnode_close(file, FREAD, context);
+	return error ? error : close_error;
+}
+#endif
