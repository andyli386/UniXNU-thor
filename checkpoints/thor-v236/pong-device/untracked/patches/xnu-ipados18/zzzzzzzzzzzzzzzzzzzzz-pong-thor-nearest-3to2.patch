diff --git a/iokit/Kernel/PongNearestThreeToTwo.h b/iokit/Kernel/PongNearestThreeToTwo.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/PongNearestThreeToTwo.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#pragma once
+#include <stdint.h>
+
+static inline bool
+pongNearestThreeToTwo(bool filter, bool diff, int32_t sourceWidth,
+    int32_t left, int32_t right, uint32_t panelWidth)
+{
+	return !filter && !diff && sourceWidth > 0 && left == 0 &&
+	       right > 0 && (uint32_t)right == panelWidth &&
+	       (uint64_t)sourceWidth * 3 == (uint64_t)panelWidth * 2;
+}
+
+/* floor(x * 2 / 3) expands each two source pixels to [a, a, b].
+ * The selector ensures an even source width and a complete output row. */
+static inline void
+pongNearestThreeToTwoRow(const uint32_t *source, uint32_t *panel, uint32_t sourceWidth)
+{
+	for (uint32_t x = 0; x < sourceWidth; x += 2) {
+		const uint32_t a = source[x] | 0xff000000u;
+		const uint32_t b = source[x + 1] | 0xff000000u;
+		panel[0] = a;
+		panel[1] = a;
+		panel[2] = b;
+		panel += 3;
+	}
+}
