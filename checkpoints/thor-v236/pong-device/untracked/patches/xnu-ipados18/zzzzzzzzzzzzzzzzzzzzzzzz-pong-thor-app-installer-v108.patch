+static int
+thor_stage_ensure_directory(vnode_t parent, char *name, uid_t uid, gid_t gid,
+    mode_t mode, vnode_t *result)
+{
+	vfs_context_t context = vfs_context_current();
+	vnode_t child = NULLVP;
+	int error = vnode_lookupat(name, VNODE_LOOKUP_NOFOLLOW_ANY, &child, context, parent);
+
+	if (error == ENOENT) {
+		/* Use the same exclusive component-local creation as the VFS sidecar
+		 * directory path. Pass UID/GID with mkdir so no pre-existing vnode
+		 * is ever chowned or chmodded. */
+		struct componentname component = {
+			.cn_nameiop = LOOKUP,
+			.cn_flags = ISLASTCN,
+			.cn_context = context,
+			.cn_pnbuf = name,
+			.cn_pnlen = (int)strlen(name) + 1,
+			.cn_nameptr = name,
+			.cn_namelen = (int)strlen(name),
+		};
+		struct vnode_attr attributes;
+		VATTR_INIT(&attributes);
+		VATTR_SET(&attributes, va_uid, uid);
+		VATTR_SET(&attributes, va_gid, gid);
+		VATTR_SET(&attributes, va_mode, mode);
+		VATTR_SET(&attributes, va_type, VDIR);
+		attributes.va_vaflags = VA_EXCLUSIVE;
+		error = VNOP_MKDIR(parent, &child, &component, &attributes, context);
+		if (error == EEXIST) {
+			error = vnode_lookupat(name, VNODE_LOOKUP_NOFOLLOW_ANY, &child, context, parent);
+		}
+	}
+	if (!error && (child == NULLVP || vnode_mount(child) != vnode_mount(parent))) {
+		error = EXDEV;
+	}
+	if (!error) {
+		error = thor_stage_check_directory(child, uid, gid, mode);
+	}
+	if (error) {
+		if (child) {
+			vnode_put(child);
+		}
+		return error;
+	}
+	*result = child;
+	return 0;
 }
 
 static int
+thor_stage_installd_directories(vnode_t data)
+{
+	vnode_t home = NULLVP, library = NULLVP, leaf = NULLVP;
+	const char *path = "/private/var/installd";
+	int error = thor_stage_ensure_directory(data, "installd", 33, 33, 0700, &home);
+
+	if (!error) {
+		path = "/private/var/installd/Library";
+		error = thor_stage_ensure_directory(home, "Library", 33, 33, 0700, &library);
+	}
+	if (!error) {
+		path = "/private/var/installd/Library/MobileInstallation";
+		error = thor_stage_ensure_directory(library, "MobileInstallation", 33, 33, 0700, &leaf);
+	}
+	if (leaf) {
+		vnode_put(leaf);
+		leaf = NULLVP;
+	}
+	if (!error) {
+		path = "/private/var/installd/Library/Caches";
+		error = thor_stage_ensure_directory(library, "Caches", 33, 33, 0700, &leaf);
+	}
+	if (leaf) {
+		vnode_put(leaf);
+	}
+	if (library) {
+		vnode_put(library);
+	}
+	if (home) {
+		vnode_put(home);
+	}
+	if (error) {
+		printf("THOR APP installer: installd directories FAIL error=%d path=%s\n", error, path);
+	} else {
+		printf("THOR APP installer: installd directories PASS uid=33 gid=33 mode=0700\n");
+	}
+	return error;
+}
