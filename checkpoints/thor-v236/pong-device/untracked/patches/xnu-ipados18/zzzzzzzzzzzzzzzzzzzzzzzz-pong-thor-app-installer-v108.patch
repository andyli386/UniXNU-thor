+	    !VATTR_IS_SUPPORTED(&attributes, va_uid) ||
+	    !VATTR_IS_SUPPORTED(&attributes, va_gid) ||
+	    !VATTR_IS_SUPPORTED(&attributes, va_mode) ||
+	    attributes.va_uid != uid || attributes.va_gid != gid) {
+		return EACCES;
+	}
+	/* The Data root is root:wheel and may be group writable. */
+	if (mode ? (attributes.va_mode & 07777) != mode :
