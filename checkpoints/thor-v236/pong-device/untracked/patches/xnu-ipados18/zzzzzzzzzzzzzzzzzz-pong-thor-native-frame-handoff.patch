 void
+IOMobileFramebuffer::clearPanel(void)
+{
+	for (uint32_t y = 0; y < fPanelHeight; y++) {
+		uint32_t *row = reinterpret_cast<uint32_t *>(fBase + (size_t)y * fRowBytes);
+		for (uint32_t x = 0; x < fPanelWidth; x++) {
+			row[x] = 0xff000000u;
+		}
+	}
+}
