+#if XNU_PONG_ADRENO_PLATFORM
+bool
+IOMobileFramebuffer::gpuFrameHoldActive(void) const
+{
+	return fGpuClearDeadline && mach_absolute_time() < fGpuClearDeadline &&
+	    fGpuFramePowerEpoch == __atomic_load_n(&fPowerRequestEpoch, __ATOMIC_ACQUIRE);
+}
+
+void
+IOMobileFramebuffer::expireDeferredGpuClear(void)
+{
+	if (!fGpuClearDeferred || gpuFrameHoldActive()) {
+		return;
+	}
+	fGpuClearDeferred = false;
+	fLastDesktopGpuFrame = false;
+	fGpuClearDeadline = 0;
+	IOLockLock(fLock);
+	/* A quarantined DMA copy still owns the destination. */
+	if (!pong_scanout_quarantined()) {
+		clearPanel();
+	}
+	IOLockUnlock(fLock);
+}
+
+void
+IOMobileFramebuffer::cancelGpuFrameHold(void)
+{
+	IOLockLock(fSwapLock);
+	__atomic_add_fetch(&fPowerRequestEpoch, 1, __ATOMIC_RELEASE);
+	IOLockWakeup(fSwapLock, fSwap, true);
+	IOLockUnlock(fSwapLock);
+}
+#endif
