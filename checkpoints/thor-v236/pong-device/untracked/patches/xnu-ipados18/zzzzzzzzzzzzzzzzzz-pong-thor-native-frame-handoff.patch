+bool
+MiniIOSurfaceDrawn(MiniIOSurface *surface, uint64_t deadline, uint32_t swapID)
+{
+	if (surface == NULL) {
+		return false;
+	}
+	const uint64_t began = mach_absolute_time();
+	wait_result_t waitResult = THREAD_AWAKENED;
+	IOLockLock(gSurfaceLock);
+	while (surface->gpuWriters && !surface->gpuFailed && waitResult == THREAD_AWAKENED) {
+		/* Only the dedicated presenter enters here. The absolute deadline
+		 * bounds the wait, independent of transient thread aborts. */
+		waitResult = IOLockSleepDeadline(gSurfaceLock, surface, deadline, THREAD_UNINT);
+	}
+	const bool ready = !surface->gpuWriters && !surface->gpuFailed && !surface->drawn;
+	if (ready) {
+		surface->displayReaders++;
+	}
+	const bool logFailure = !ready && logGpuSurfaceReceipt();
+	const uint32_t writers = surface->gpuWriters, readers = surface->displayReaders;
+	const bool poison = surface->gpuFailed, drawn = surface->drawn;
+	IOLockUnlock(gSurfaceLock);
+	if (logFailure) {
+		uint64_t nanos;
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &nanos);
+		IOLog("PONG IOSURFACE: swap=%u sid=%u format=%#x writers=%u readers=%u poison=%d drawn=%d wait=%d elapsed_us=%llu\n",
+		    swapID, surface->sid, surface->info.pixelFormat, writers, readers, poison, drawn,
+		    waitResult, nanos / NSEC_PER_USEC);
+	}
+	return ready;
 }
