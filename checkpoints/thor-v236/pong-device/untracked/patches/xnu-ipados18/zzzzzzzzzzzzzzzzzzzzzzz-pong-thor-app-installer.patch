+#ifdef THOR_UI_RUNTIME_PAYLOAD
+/* Keep the existing adapter untouched. A diagnostic candidate is published
+ * to the configured process list only after a successful native APFS write. */
+static void
+thor_stage_ui_runtime(proc_t p)
+{
+	static const char old_path[] = "/private/var/pong/libpong-ui18.dylib";
+	static const char new_path[] = THOR_UI_RUNTIME_STAGE_PATH;
+	char injection[sizeof(exec_inject_conf)];
+	lck_mtx_lock(&exec_inject_lock);
+	strlcpy(injection, exec_inject_conf, sizeof(injection));
+	lck_mtx_unlock(&exec_inject_lock);
+	if (strncmp(injection, old_path, sizeof(old_path) - 1) ||
+	    injection[sizeof(old_path) - 1] != ' ') {
+		printf("THOR UI runtime: SKIP no compatible injection rule\n");
+		return;
+	}
+
+	int error = thor_stage_data_payload(p, new_path, thor_ui_runtime_payload,
+	    sizeof(thor_ui_runtime_payload), false);
 	if (error) {
 		printf("THOR UI runtime: FAIL error=%d; using existing adapter\n", error);
 		return;
@@ -6104,12 +6176,42 @@
