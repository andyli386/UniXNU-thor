+static int
+thor_stage_verify_payload(proc_t p, vnode_t file, const unsigned char *payload,
+    size_t length, vfs_context_t context)
+{
+	unsigned char buffer[1024];
+	for (size_t offset = 0; offset < length; ) {
+		size_t amount = MIN(sizeof(buffer), length - offset);
+		int residual = 0;
+		int error = vn_rdwr(UIO_READ, file, (caddr_t)buffer, (int)amount,
+		    (off_t)offset, UIO_SYSSPACE, IO_UNIT, vfs_context_ucred(context),
+		    &residual, p);
+		if (error) {
+			return error;
+		}
+		if (residual) {
+			return EIO;
+		}
+		if (memcmp(buffer, payload + offset, amount)) {
+			return EINVAL;
+		}
+		offset += amount;
 	}
+	return 0;
+}
 
