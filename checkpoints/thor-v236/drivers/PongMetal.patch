+    // Keep the handoff worker bounded when a Metal command buffer never
+    // retires.  The command's completion callback retains its resources after
+    // a timeout; the kernel side therefore quarantines the backing instead of
+    // allowing a CPU write to race an in-flight DMA copy.
+    static bool submitAndWait(id<MTLCommandBuffer> commands) {
+        if (!commands) return false;
+        dispatch_semaphore_t completed = dispatch_semaphore_create(0);
+        [commands addCompletedHandler:^(id<MTLCommandBuffer>) {
+            dispatch_semaphore_signal(completed);
+        }];
+        [commands commit];
+        constexpr int64_t kTimeoutNs = 500LL * NSEC_PER_MSEC;
+        if (dispatch_semaphore_wait(completed, dispatch_time(DISPATCH_TIME_NOW, kTimeoutNs))) return false;
