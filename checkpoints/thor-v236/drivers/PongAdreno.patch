+// One row per concurrent tracked method. The caller alone changes its row
+// while the version is 2 modulo 4; odd versions indicate publication. No
+// active row is evicted and no GPU lock is required to read a snapshot.
+struct ThorGpuCall {
+    uint32_t version, pid, method, status;
+    uint64_t tid, fence, entered, left;
+};
+static constexpr unsigned kThorCallRows = 8;
+static ThorGpuCall gThorCalls[2][kThorCallRows];
+static uint32_t gThorCallDrops[2];
+
+static ThorGpuCall *thorGpuEnter(unsigned role, uint32_t method, uint64_t fence)
+{
+    const uint64_t tid = thread_tid(current_thread());
+    for (unsigned i = 0; i < kThorCallRows; ++i) {
+        auto &row = gThorCalls[role][(tid + i) % kThorCallRows];
+        uint32_t v = __atomic_load_n(&row.version, __ATOMIC_RELAXED);
+        if ((v & 3) || !__atomic_compare_exchange_n(&row.version, &v, v + 1,
+            false, __ATOMIC_ACQ_REL, __ATOMIC_RELAXED)) continue;
+        __atomic_store_n(&row.pid, static_cast<uint32_t>(proc_selfpid()), __ATOMIC_RELAXED);
+        __atomic_store_n(&row.tid, tid, __ATOMIC_RELAXED);
+        __atomic_store_n(&row.method, method, __ATOMIC_RELAXED);
+        __atomic_store_n(&row.fence, fence, __ATOMIC_RELAXED);
+        __atomic_store_n(&row.entered, mach_absolute_time(), __ATOMIC_RELAXED);
+        __atomic_store_n(&row.left, 0, __ATOMIC_RELAXED);
+        __atomic_store_n(&row.version, v + 2, __ATOMIC_RELEASE);
+        return &row;
+    }
+    __atomic_fetch_add(&gThorCallDrops[role], 1u, __ATOMIC_RELAXED);
+    return nullptr;
+}
+
+static void thorGpuLeave(ThorGpuCall *row, uint32_t status, uint64_t submitted)
+{
+    if (!row) return;
+    const uint32_t v = __atomic_fetch_add(&row->version, 1u, __ATOMIC_ACQ_REL);
+    if (submitted) __atomic_store_n(&row->fence, submitted, __ATOMIC_RELAXED);
+    __atomic_store_n(&row->status, status, __ATOMIC_RELAXED);
+    __atomic_store_n(&row->left, mach_absolute_time(), __ATOMIC_RELAXED);
+    __atomic_store_n(&row->version, v + 2, __ATOMIC_RELEASE);
+}
+
+static bool thorGpuRead(const ThorGpuCall &row, ThorGpuCall &sample)
+{
+    const uint32_t first = __atomic_load_n(&row.version, __ATOMIC_ACQUIRE);
+    if (!first || (first & 1)) return false;
+    sample.pid = __atomic_load_n(&row.pid, __ATOMIC_RELAXED);
+    sample.tid = __atomic_load_n(&row.tid, __ATOMIC_RELAXED);
+    sample.method = __atomic_load_n(&row.method, __ATOMIC_RELAXED);
+    sample.status = __atomic_load_n(&row.status, __ATOMIC_RELAXED);
+    sample.fence = __atomic_load_n(&row.fence, __ATOMIC_RELAXED);
+    sample.entered = __atomic_load_n(&row.entered, __ATOMIC_RELAXED);
+    sample.left = __atomic_load_n(&row.left, __ATOMIC_RELAXED);
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    return first == __atomic_load_n(&row.version, __ATOMIC_RELAXED);
+}
