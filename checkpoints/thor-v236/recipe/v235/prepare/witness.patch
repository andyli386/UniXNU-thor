+/* v235: return addresses read from frame records, newest first.  The fault chain starts at the
+ * faulting code's frame pointer and leads to whoever called it; the panic chain starts at this
+ * code's own frame in PE_panic_hook and leads to whoever called panic(). */
+#define THOR_WITNESS_CHAIN_MAX     64u
