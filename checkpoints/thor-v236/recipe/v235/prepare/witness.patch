+thor_witness_micros(uint64_t absolute)
+{
+	uint64_t nanos = 0;
+	absolutetime_to_nanoseconds(absolute, &nanos);
+	return nanos / 1000ull;
+}
+
+/* "123.456" for an age in microseconds, "-" when there is none. */
+static const char *
+thor_witness_age(char *out, size_t capacity, bool known, int64_t microseconds)
+{
+	if (!known) {
+		snprintf(out, capacity, "-");
+	} else if (microseconds < 0) {
+		snprintf(out, capacity, "0.000");
+	} else {
+		snprintf(out, capacity, "%llu.%03llu", (unsigned long long)(microseconds / 1000000),
+		    (unsigned long long)((microseconds % 1000000) / 1000));
+	}
+	return out;
+}
