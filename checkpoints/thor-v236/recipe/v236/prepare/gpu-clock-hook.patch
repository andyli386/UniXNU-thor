+extern "C" uint64_t native_adreno_vm_now_hook(void)
+{
+    uint64_t (*now)(void *)=native_adreno_vm_clock_now;
+    if(!now)return 0;
+    if((uint64_t)now<(uint64_t)vm_kernel_stext||(uint64_t)now>=(uint64_t)vm_kernel_etext) {
+        __atomic_add_fetch(&native_adreno_vm_clock_refusals,1,__ATOMIC_RELAXED);
