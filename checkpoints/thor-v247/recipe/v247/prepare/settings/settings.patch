+/* Observe only the Settings window's left-edge contact after native navigation
+ * has started. The original UIKit IMP still receives every UIEvent exactly once. */
+static uintptr_t observed_touch,observed_window;
+static unsigned observed_token;
+static double began_x,began_y;
+static bool dragged;
+struct return_delivery { unsigned token,phase; };
+
+static struct return_delivery edge_event(UIWindow *window,UIEvent *event)
+{
+    struct return_delivery result={0,0};
+    if(!return225_watching() || !event || event.type!=UIEventTypeTouches)return result;
+    NSSet *touches=event.allTouches;
+    UITouch *touch=touches.count==1?touches.anyObject:nil;
+    if(!touch || touch.window!=window) {
+        observed_token=0;return225_invalidate_edge();return result;
+    }
+    UITouchPhase phase=touch.phase;
+    if(phase==UITouchPhaseBegan){
+        observed_token=0;return225_invalidate_edge();
+        if(!return225_room())return result;
+        CGPoint loc=[touch locationInView:window];
+        CGFloat width=window.bounds.size.width;
+        /* Coordinates are in window points. Require a genuine leading-edge start. */
+        if(!(width>=100) || !(loc.x>=0 && loc.x<=24 && loc.x<=width*0.08))return result;
+        double timestamp=touch.timestamp;
+        if(!(timestamp>0 && timestamp<315360000))return result;
+        uint64_t ui=(uint64_t)(timestamp*1000000);
+        observed_token=return225_edge(ui,settings_trace_uptime223());
+        observed_touch=(uintptr_t)touch;observed_window=(uintptr_t)window;
+        began_x=loc.x;began_y=loc.y;dragged=false;
+        result=(struct return_delivery){observed_token,ReturnDown};
+    } else if(observed_token && observed_touch==(uintptr_t)touch && observed_window==(uintptr_t)window){
+        if(phase==UITouchPhaseMoved && !dragged){
+            CGPoint loc=[touch locationInView:window];
+            double dx=loc.x-began_x,dy=loc.y-began_y;
+            if(dx>=12 && dx>=2.0*fabs(dy)){
+                dragged=true;
+                result=(struct return_delivery){observed_token,ReturnDrag};
+            }
+        } else if(phase==UITouchPhaseEnded || phase==UITouchPhaseCancelled){
+            result=(struct return_delivery){observed_token,phase==UITouchPhaseEnded?ReturnEnd:ReturnCancel};
+            observed_token=0;
+            if(phase==UITouchPhaseCancelled)return225_invalidate_edge();
+        }
+    }
+    return result;
+}
+
+static void observe_window(UIWindow *window,SEL selector,UIEvent *event)
+{
+    if(!pthread_main_np() || !return225_watching()) {
+        observe_event223(window,selector,event);return;
+    }
+    struct return_delivery d=edge_event(window,event);
+    if(!d.token){observe_event223(window,selector,event);return;}
+    return225_delivery(d.token,d.phase,true,false);
+    bool completed=false;
+    @try {observe_event223(window,selector,event);completed=true;}
+    @finally {
+        if(!completed){observed_token=0;return225_invalidate_edge();}
+        return225_delivery(d.token,d.phase,false,completed);
+    }
+}
