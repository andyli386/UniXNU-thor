+/* SPDX-License-Identifier: MIT */
+#include "return225.h"
+#include "return_store225.h"
+#include "window_cpu223.h"
+#include <execinfo.h>
+#include <inttypes.h>
+#include <mach/arm/thread_status.h>
+#include <stdatomic.h>
+#include <sys/sysctl.h>
+#include <uuid/uuid.h>
+
+enum { Events=4, Deadlines=4, GlobalSamples=6, MaxSamplesPerEvent=2 };
+static const unsigned delay_ms[Deadlines]={500,1500,3000,5000};
+struct check {
+    unsigned index, token;
+    uint64_t posted;
+    _Atomic(uint64_t) ack;
+};
+struct attempt {
+    uint64_t touch, window;
+    unsigned token, samples;
+    struct check checks[Deadlines];
+};
+static struct attempt attempts[Events];
+static unsigned used,latest,total_samples;
+static bool enabled;
+static dispatch_queue_t diagnostics,writer;
+static thread_t main_port;
+static int store_fd=-1;
+static char session[64];
+static bool dirty;
+static uint64_t flushes;
+static void flush(void *unused)
+{
+    (void)unused;dirty=false;
+    if(store_fd<0)return;
+    if(!thor_journal_sync(store_fd)){close(store_fd);store_fd=-1;}
+    else ++flushes;
+}
+
+static uint64_t now(void){return settings_trace_uptime223();}
+
+/* Called on the file queue. Never opens or syncs a file on the main or timer queue. */
+static void persist(const char *line)
+{
+    if(store_fd<0){
+        if(!session[0]) {
+            size_t n=sizeof session;
+            if(sysctlbyname("kern.bootsessionuuid",session,&n,NULL,0) || !n || n>sizeof session ||
+               !thor_journal_uuid(session)){session[0]=0;return;}
+        }
+#ifdef THOR_RETURN_DIR
+        store_fd=thor_journal_open_in(THOR_RETURN_DIR,"Preferences",session);
+#else
+        store_fd=thor_journal_open_in("/private/var/mobile/Library/Logs","Preferences",session);
+#endif
+    }
+    if(store_fd<0)return;
+    if(!thor_stall_write(store_fd,line,strlen(line))){close(store_fd);store_fd=-1;return;}
+    if(!dirty){
+        dirty=true;
+        dispatch_after_f(dispatch_time(DISPATCH_TIME_NOW,25*NSEC_PER_MSEC),writer,NULL,flush);
+    }
+}
+
+static void emit(unsigned token,const char *stage,uint64_t at,unsigned arg,uint64_t origin)
+{
+    if(!token || token>Events)return;
+    dispatch_async(writer,^{
+        const struct attempt *a=&attempts[token-1];
+        char line[220];
+        int n=snprintf(line,sizeof line,"return225 token=%u touch=%" PRIu64
+            " window=%" PRIu64 " stage=%s at=%" PRIu64 " arg=%u origin=%" PRIu64 "\n",
+            token,a->touch,a->window,stage,at,arg,origin);
+        if(n>0 && (size_t)n<sizeof line)persist(line);
+    });
+}
+
+static void label(const struct image_offset *a,char out[48])
+{
+    if(uuid_is_null(a->uuid)){strcpy(out,"-");return;}
+    uuid_string_t u;uuid_unparse_upper(a->uuid,u);
+    snprintf(out,48,"%s+%" PRIx32,u,a->offset);
+}
+
+/* The main-queue probe is still pending on both sides of thread_get_state
+ * and UUID projection. Do not diagnose if it was acknowledged during sampling. */
+static void delayed(void *context)
+{
+    struct check *c=context;
+    struct attempt *a=&attempts[c->token-1];
+    uint64_t start=now();
+    if(!c->posted || start<c->posted || start-c->posted<95000 ||
+       atomic_load_explicit(&c->ack,memory_order_acquire))return;
+    emit(c->token,"delayed",start,c->index,c->posted);
+    if(total_samples>=GlobalSamples || a->samples>=MaxSamplesPerEvent)return;
+    ++total_samples;++a->samples;
+    arm_thread_state64_t state={0};mach_msg_type_number_t words=ARM_THREAD_STATE64_COUNT;
+    if(thread_get_state(main_port,ARM_THREAD_STATE64,(thread_state_t)&state,&words)!=KERN_SUCCESS ||
+       words!=ARM_THREAD_STATE64_COUNT)return;
+    void *pcs[2]={(void*)arm_thread_state64_get_pc(state),(void*)arm_thread_state64_get_lr(state)};
+    struct image_offset addresses[2]={0};backtrace_image_offsets(pcs,addresses,2);
+    uint64_t finish=now();
+    if(finish<start || atomic_load_explicit(&c->ack,memory_order_acquire))return;
+    /* Keep immutable image-relative addresses; formatting/fsync happens off the sampler. */
+    struct image_offset pc=addresses[0],lr=addresses[1];
+    dispatch_async(writer,^{
+        char p[48],l[48],line[320];label(&pc,p);label(&lr,l);
+        int n=snprintf(line,sizeof line,"return225 token=%u touch=%" PRIu64
+            " window=%" PRIu64 " stage=sample at=%" PRIu64 " arg=%u origin=%" PRIu64
+            " last=%" PRIu64 " pc=%s lr=%s\n",a->token,a->touch,a->window,start,
+            c->index,c->posted,finish,p,l);
+        if(n>0 && (size_t)n<sizeof line)persist(line);
+    });
+}
+static void acknowledge(void *context)
+{
+    struct check *c=context;
+    uint64_t stamp=now();
+    atomic_store_explicit(&c->ack,stamp,memory_order_release);
+    emit(c->token,"ack",stamp,c->index,c->posted);
+}
+static void probe(void *context)
+{
+    struct check *c=context;
+    c->posted=now();
+    dispatch_async_f(dispatch_get_main_queue(),c,acknowledge);
+    emit(c->token,"probe",c->posted,c->index,0);
+    dispatch_after_f(dispatch_time(DISPATCH_TIME_NOW,100*NSEC_PER_MSEC),diagnostics,c,delayed);
+}
+void return225_init(thread_t main)
+{
+    if(!MACH_PORT_VALID(main))return;
+    main_port=main;
+    diagnostics=dispatch_queue_create("org.unixnu.settings.return.probe",DISPATCH_QUEUE_SERIAL);
+    writer=dispatch_queue_create("org.unixnu.settings.return.store",DISPATCH_QUEUE_SERIAL);
+}
+void return225_enable(void){enabled=true;}
+bool return225_watching(void){return enabled && diagnostics && writer;}
+void return225_invalidate_edge(void){latest=0;}
+bool return225_room(void){return used<Events;}
+static unsigned start(uint64_t touch,uint64_t window,const char *stage)
+{
+    if(!return225_watching() || used>=Events || !window)return 0;
+    struct attempt *a=&attempts[used];
+    unsigned token=++used;
+    a->token=token;a->touch=touch;a->window=window;
+    emit(token,stage,window,0,0);
+    for(unsigned i=0;i<Deadlines;i++){
+        struct check *c=&a->checks[i];c->token=token;c->index=i;
+        dispatch_after_f(dispatch_time(DISPATCH_TIME_NOW,(int64_t)delay_ms[i]*NSEC_PER_MSEC),
+                         diagnostics,c,probe);
+    }
+    return token;
+}
+unsigned return225_edge(uint64_t touch,uint64_t window)
+{
+    latest=touch && touch<=window ? start(touch,window,"edge") : 0;
+    return latest;
+}
+void return225_delivery(unsigned token,unsigned phase,bool entering,bool completed)
+{
+    emit(token,entering?"handler-enter":(completed?"handler-return":"handler-throw"),now(),phase,0);
+}
+unsigned return225_pop_enter(void)
+{
+    if(!latest)return 0;
+    unsigned t=latest;latest=0;
+    uint64_t at=now(),w=attempts[t-1].window;
+    if(at<w || at-w>1500000)return 0;
+    emit(t,"pop-enter",at,0,0);
+    return t;
+}
+void return225_pop_return(unsigned token){emit(token,"pop-return",now(),0,0);}
+unsigned return225_interactive(unsigned token)
+{
+    if(!token)token=start(0,now(),"native-interactive");
+    if(token)emit(token,"interactive",now(),0,0);
+    return token;
+}
+void return225_outcome(unsigned token,unsigned outcome){emit(token,"outcome",now(),outcome,0);}
