+/* SPDX-License-Identifier: MIT */
+#include "tap_pc225.h"
+#include "window_cpu223.h"
+#include <execinfo.h>
+#include <inttypes.h>
+#include <mach/arm/thread_status.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <uuid/uuid.h>
+
+enum { TapBudget = 6, Points = 2, LatestUs = 350000 };
+static const unsigned delays_ms[Points] = {45, 145};
+
+struct pc_point {
+    unsigned token;
+    uint64_t first_us, last_us;
+    struct image_offset addresses[2];
+};
+
+struct pc_event {
+    uint64_t touch_us, window_us;
+    struct pc_point points[Points];
+};
+
+/* The main thread publishes each slot once. Only the serial diagnostic
+ * queue writes the point times/addresses and later emits them at a matched push. */
+static struct pc_event events[TapBudget];
+static unsigned used;
+static _Atomic(unsigned) active;
+static thread_t main_port;
+static dispatch_queue_t diagnostic_queue;
+static void (*write_line)(char *, int);
+
+void settings_pc225_init(thread_t port, dispatch_queue_t queue, void (*writer)(char *, int))
+{
+    main_port = port;
+    diagnostic_queue = queue;
+    write_line = writer;
+}
+
+unsigned settings_pc225_end(void)
+{
+    return atomic_exchange_explicit(&active, 0, memory_order_acq_rel);
+}
+
+#ifndef THOR_PC225_TEST
+static bool sample_registers(struct image_offset addresses[2])
+{
+    arm_thread_state64_t state = {0};
+    mach_msg_type_number_t count = ARM_THREAD_STATE64_COUNT;
+    if (thread_get_state(main_port, ARM_THREAD_STATE64, (thread_state_t)&state, &count) != KERN_SUCCESS ||
+        count != ARM_THREAD_STATE64_COUNT)
+        return false;
+    void *pcs[2] = {(void *)arm_thread_state64_get_pc(state), (void *)arm_thread_state64_get_lr(state)};
+    backtrace_image_offsets(pcs, addresses, 2);
+    return true;
+}
+#else
+static bool sample_registers(struct image_offset addresses[2]);
+#endif
+
+static void capture(void *arg)
+{
+    struct pc_point *point = arg;
+    unsigned token = point->token;
+    if (atomic_load_explicit(&active, memory_order_acquire) != token)
+        return;
+    const uint64_t window = events[token - 1].window_us;
+    uint64_t first = settings_trace_uptime223();
+    if (first < window || first - window > LatestUs)
+        return;
+
+    struct image_offset addresses[2] = {0};
+    if (!sample_registers(addresses))
+        return;
+    uint64_t last = settings_trace_uptime223();
+    if (last < first || last - window > LatestUs ||
+        atomic_load_explicit(&active, memory_order_acquire) != token)
+        return;
+    memcpy(point->addresses, addresses, sizeof addresses);
+    point->first_us = first;
+    point->last_us = last;
+}
+
+#ifndef THOR_PC225_TEST
+static void schedule(unsigned delay, struct pc_point *point)
+{
+    dispatch_after_f(dispatch_time(DISPATCH_TIME_NOW, (int64_t)delay * NSEC_PER_MSEC),
+        diagnostic_queue, point, capture);
+}
+#else
+static void schedule(unsigned delay, struct pc_point *point);
+#endif
+
+void settings_pc225_arm(uint64_t touch, uint64_t window)
+{
+    if (used == TapBudget || !diagnostic_queue || !MACH_PORT_VALID(main_port) ||
+        !touch || !window || touch > window)
+        return;
+    unsigned token = ++used;
+    struct pc_event *event = &events[token - 1];
+    event->window_us = window;
+    event->touch_us = touch;
+    for (unsigned i = 0; i < Points; ++i)
+        event->points[i].token = token;
+    atomic_store_explicit(&active, token, memory_order_release);
+    for (unsigned i = 0; i < Points; ++i)
+        schedule(delays_ms[i], &event->points[i]);
+}
+
+static void image_label(const struct image_offset *addr, char out[48])
+{
+    if (uuid_is_null(addr->uuid)) {
+        strcpy(out, "-");
+        return;
+    }
+    uuid_string_t uuid;
+    uuid_unparse_upper(addr->uuid, uuid);
+    (void)snprintf(out, 48, "%s+%" PRIx32, uuid, addr->offset);
+}
+
+void settings_pc225_report(unsigned token, unsigned id, uint64_t touch,
+                           uint64_t window, uint64_t push)
+{
+    if (!token || token > TapBudget || !write_line)
+        return;
+    const struct pc_event *event = &events[token - 1];
+    if (touch != event->touch_us || window != event->window_us || push < window)
+        return;
+    for (unsigned i = 0; i < Points; ++i) {
+        const struct pc_point *p = &event->points[i];
+        if (!p->first_us || p->first_us < window || p->last_us < p->first_us || p->last_us >= push)
+            continue;
+        char pc[48], lr[48], line[256];
+        image_label(&p->addresses[0], pc);
+        image_label(&p->addresses[1], lr);
+        int len = snprintf(line, sizeof line, "Pong Settings: Trace tapPC225 id=%u ui=%" PRIu64
+            " w=%" PRIu64 " push=%" PRIu64 " n=%u first=%" PRIu64 " last=%" PRIu64
+            " pc=%s lr=%s", id, touch, window, push, i + 1, p->first_us, p->last_us, pc, lr);
+        if (len > 0 && (size_t)len < sizeof line)
+            write_line(line, len);
+    }
+}
