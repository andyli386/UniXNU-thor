+/* Sparse APFS journal for Thor freeze events. Include in the C TU owning the writer. */
+#ifndef THOR_STALL_STORE_H
+#define THOR_STALL_STORE_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+enum { thor_slot_bytes = 512, thor_slots = 128, thor_line_max = 383 };
+struct thor_journal_owner {
+    int fd;
+    uint64_t sequence, instance;
+    char boot[36];
+    bool active;
+};
+static struct thor_journal_owner thor_journal_owners[4];
+static pthread_mutex_t thor_journal_lock = PTHREAD_MUTEX_INITIALIZER;
+static const char *const thor_journal_roles[] = {"runningboardd", "SpringBoard", "backboardd","Preferences"};
+
+static inline uint32_t thor_journal_crc(const unsigned char *data, size_t n)
+{
+    uint32_t v = UINT32_MAX;
+    for (size_t i = 0; i < n; ++i) {
+        v ^= data[i];
+        for (unsigned b = 0; b < 8; ++b)
+            v = (v >> 1) ^ (0xedb88320u & (0u - (v & 1)));
+    }
+    return ~v;
+}
+
+static inline bool thor_journal_uuid(const char *s)
+{
+    if (!s || strnlen(s, 37) != 36) return false;
+    for (unsigned i = 0; i < 36; ++i) {
+        if (i == 8 || i == 13 || i == 18 || i == 23) {
+            if (s[i] != '-') return false;
+        } else if (!(s[i] >= '0' && s[i] <= '9') &&
+                   !(s[i] >= 'a' && s[i] <= 'f') &&
+                   !(s[i] >= 'A' && s[i] <= 'F')) return false;
+    }
+    return true;
+}
+
+static inline bool thor_journal_sync(int fd)
+{
+#ifdef F_FULLFSYNC
+    for (;;) {
+        if (fcntl(fd, F_FULLFSYNC) == 0) return true;
+        if (errno == EINTR) continue;
+        if (errno != ENOTSUP && errno != EINVAL && errno != ENOTTY &&
+            errno != EOPNOTSUPP) return false;
+        break;
+    }
+#endif
+    for (;;) {
+        if (fsync(fd) == 0) return true;
+        if (errno != EINTR) return false;
+    }
+}
+
+static inline uint64_t thor_journal_seq(const unsigned char *buf, size_t slot, int role)
+{
+    uint64_t seq;
+    uint32_t crc;
+    uint16_t n;
+    memcpy(&seq, buf + 8, sizeof(seq));
+    memcpy(&n, buf + 30, sizeof(n));
+    memcpy(&crc, buf + 508, sizeof(crc));
+    if (memcmp(buf, "TSJ1", 4) || buf[28] != role || !seq ||
+        (seq - 1) % thor_slots != slot || !n || n > thor_line_max ||
+        buf[68+n-1] != '\n' || crc != thor_journal_crc(buf, 508)) return 0;
+    return seq;
+}
+
+static inline int thor_journal_open_in(const char *dir, const char *role, const char *boot)
+{
+    if (!role || !thor_journal_uuid(boot)) return -1;
+    int id = 0;
+    while (id < 4 && strcmp(role, thor_journal_roles[id])) ++id;
+    if (id == 4) return -1;
+    int directory = open(dir, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    if (directory < 0) return -1;
+    char name[48];
+    int n = id == 3 ? snprintf(name, sizeof(name), "ThorSettingsReturn-v225.bin") :
+        snprintf(name, sizeof(name), "ThorStall-v220-%s.bin", role);
+    if (n <= 0 || (size_t)n >= sizeof(name)) { close(directory); return -1; }
+    int flags = O_RDWR | O_NOFOLLOW | O_CLOEXEC;
+    int fd = openat(directory, name, flags | O_CREAT | O_EXCL, 0600);
+    const bool created = fd >= 0;
+    if (fd < 0 && errno == EEXIST) fd = openat(directory, name, flags);
+    if (created) {
+        /* Persist the directory entry where the filesystem supports it. */
+        while (fsync(directory) != 0 && errno == EINTR) {}
+    }
+    close(directory);
+    if (fd < 0) return -1;
+    struct stat st;
+    if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_nlink != 1 ||
+        st.st_uid != geteuid() || (st.st_mode & 0777) != 0600 ||
+        st.st_size < 0 || st.st_size > thor_slots * thor_slot_bytes ||
+        flock(fd, LOCK_EX | LOCK_NB) != 0) { close(fd); return -1; }
+    uint64_t last = 0;
+    for (size_t i = 0; (off_t)((i + 1) * thor_slot_bytes) <= st.st_size; ++i) {
+        unsigned char record[thor_slot_bytes];
+        size_t used = 0;
+        while (used < sizeof(record)) {
+            ssize_t got = pread(fd, record + used, sizeof(record) - used, (off_t)(i * sizeof(record) + used));
+            if (got < 0 && errno == EINTR) continue;
+            if (got <= 0) { close(fd); return -1; }
+            used += (size_t)got;
+        }
+        uint64_t seq = thor_journal_seq(record, i, id);
+        if (seq > last) last = seq;
+    }
+    if (last == UINT64_MAX) { close(fd); return -1; }
+    pthread_mutex_lock(&thor_journal_lock);
+    /* The runtime can reopen a role after a write error. A descriptor number
+     * recycled by the kernel must refer only to its new journal. */
+    for (unsigned i = 0; i < 4; ++i)
+        if (thor_journal_owners[i].active && thor_journal_owners[i].fd == fd)
+            thor_journal_owners[i].active = false;
+    struct thor_journal_owner *owner = &thor_journal_owners[id];
+    owner->fd = fd;
+    owner->sequence = owner->instance = last + 1;
+    memcpy(owner->boot, boot, sizeof(owner->boot));
+    owner->active = true;
+    pthread_mutex_unlock(&thor_journal_lock);
+    return fd;
+}
+
+static inline int thor_stall_open(const char *role, const char *boot)
+{
+    uid_t uid = geteuid();
+    if (uid != 0 && uid != 501) return -1;
+    return thor_journal_open_in(uid == 0 ? "/private/var/logs" : "/private/var/mobile/Library/Logs", role, boot);
+}
+
+static inline bool thor_stall_write(int fd, const char *line, size_t length)
+{
+    if (fd < 0 || !line || !length || length > thor_line_max || line[length-1] != '\n' ||
+        memchr(line, 0, length) || memchr(line, '\n', length-1)) return false;
+    pthread_mutex_lock(&thor_journal_lock);
+    int id = 0;
+    while (id < 4 && (!thor_journal_owners[id].active || thor_journal_owners[id].fd != fd)) ++id;
+    bool ok = false;
+    if (id < 4) {
+        struct thor_journal_owner *owner = &thor_journal_owners[id];
+        if (owner->sequence != UINT64_MAX) {
+            unsigned char record[thor_slot_bytes] = {0};
+            uint32_t pid = (uint32_t)getpid();
+            uint16_t n = (uint16_t)length;
+            memcpy(record, "TSJ1", 4);
+            memcpy(record + 8, &owner->sequence, 8);
+            memcpy(record + 16, &owner->instance, 8);
+            memcpy(record + 24, &pid, 4);
+            record[28] = (unsigned char)id;
+            memcpy(record + 30, &n, 2);
+            memcpy(record + 32, owner->boot, 36);
+            memcpy(record + 68, line, length);
+            uint32_t crc = thor_journal_crc(record, 508);
+            memcpy(record + 508, &crc, 4);
+            off_t off = (off_t)((owner->sequence-1) % thor_slots) * thor_slot_bytes;
+            size_t used = 0;
+            while (used < sizeof(record)) {
+                ssize_t put = pwrite(fd, record + used, sizeof(record) - used, off + (off_t)used);
+                if (put < 0 && errno == EINTR) continue;
+                if (put <= 0) break;
+                used += (size_t)put;
+            }
+            if (used == sizeof(record)) {
+                /* A later event must not overwrite a complete but unacknowledged write. */
+                ++owner->sequence;
+                ok = true; /* The serial writer groups adjacent records for one durable flush. */
+            }
+        }
+    }
+    pthread_mutex_unlock(&thor_journal_lock);
+    return ok;
+}
+
+#endif
