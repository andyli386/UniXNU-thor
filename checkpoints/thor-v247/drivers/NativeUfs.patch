+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+
+// Pin the stock Thor metadata observed in both original slots.
+static constexpr unsigned kThorModemMdtPrefixBytes = 1076;
+static constexpr unsigned kThorModemDigestTableOffset = kThorModemMdtPrefixBytes + 288;
+static constexpr unsigned kThorModemDigestBytes = 48;
+static constexpr unsigned kThorModemMdtHeaders = 32;
+static constexpr uint64_t kThorModemBase = 0x8bc00000;
+static constexpr uint64_t kThorModemEnd = 0x9ee00000;
+
+static const uint8_t kThorModemMdtDigest[] = {
+    0x11, 0x58, 0x0f, 0x3e, 0xea, 0x62, 0x14, 0x0d,
+    0x0e, 0x7f, 0x67, 0xfb, 0xbd, 0x79, 0x16, 0x69,
+    0x45, 0x34, 0x69, 0x6c, 0x96, 0xa9, 0xed, 0xa3,
+    0x02, 0xf6, 0xbe, 0x30, 0xf3, 0xe3, 0x35, 0xd9,
+};
+
+static uint16_t thorModemMdt16(const uint8_t *p)
+{
+  return uint16_t(uint16_t(p[0]) | (uint16_t(p[1]) << 8));
+}
+
+// Only use after validating the pinned MDT digest and the program headers.
+static const uint8_t *thorModemSignedDigest(const ThorModemFatMetadata &metadata, unsigned index)
+{
+  static_assert(kThorModemDigestTableOffset +
+      kThorModemMdtHeaders * kThorModemDigestBytes <= sizeof(metadata.mdt));
+  return index < kThorModemMdtHeaders ?
+      metadata.mdt + kThorModemDigestTableOffset + index * kThorModemDigestBytes : nullptr;
+}
+
+static bool thorModemMdtLayout(const ThorModemFatMetadata &metadata)
+{
+  const auto *mdt = metadata.mdt;
+  constexpr uint64_t base = kThorModemBase;
+  constexpr uint64_t end = kThorModemEnd;
+  constexpr unsigned headerCount = kThorModemMdtHeaders;
+  constexpr unsigned headerBytes = 32;
+  constexpr unsigned prefixBytes = kThorModemMdtPrefixBytes;
+  constexpr unsigned hashBytes = 4808;
+  if (sizeof(metadata.mdt) != prefixBytes + hashBytes ||
+      memcmp(mdt, "\x7f" "ELF\x01\x01\x01", 7) != 0 ||
+      thorModemMdt16(mdt + 18) != 164 || le32(mdt + 20) != 1 ||
+      le32(mdt + 24) != base || le32(mdt + 28) != 52 ||
+      thorModemMdt16(mdt + 40) != 52 ||
+      thorModemMdt16(mdt + 42) != headerBytes ||
+      thorModemMdt16(mdt + 44) != headerCount)
+    return false;
+
+  const auto *headers = mdt + 52;
+  if (le32(headers + 4) != 0 || le32(headers + 16) != prefixBytes)
+    return false;
+  const auto *hash = headers + (headerCount - 1) * headerBytes;
+  if (((le32(hash + 24) >> 24) & 7U) != 2 || le32(hash + 16) != hashBytes)
+    return false;
+
+  unsigned loads = 0, pieces = 0;
+  uint64_t bytes = 0, lowest = end, highest = base;
+  struct Range { uint64_t first, end; };
+  Range checked[headerCount] = {};
+  for (unsigned index = 0; index < headerCount - 1; ++index) {
+    const auto *ph = headers + index * headerBytes;
+    const uint32_t flags = le32(ph + 24);
+    const uint32_t mem = le32(ph + 20);
+    if (((flags >> 24) & 7U) == 2)
+      return false;
+    if (le32(ph) != 1 || !mem)
+      continue;
+    const uint64_t at = le32(ph + 12);
+    const uint32_t file = le32(ph + 16);
+    const uint64_t offset = le32(ph + 4);
+    if (at < base || at >= end || mem > end - at || file > mem ||
+        !(flags & (1U << 27)))
+      return false;
+    const uint64_t top = at + mem;
+    for (unsigned j = 0; j < loads; ++j) {
+      if (at < checked[j].end && checked[j].first < top)
+        return false;
+    }
+    checked[loads++] = {at, top};
+    if (at < lowest) lowest = at;
+    if (top > highest) highest = top;
+    if (file && offset + file > sizeof(metadata.mdt)) {
+      if (!(metadata.pieceMask & (1U << index)) || metadata.pieceBytes[index] != file)
+        return false;
+      ++pieces;
+      bytes += file;
+    }
+  }
+  return loads == 30 && lowest == base && highest == end &&
+      pieces == 27 && bytes == 109060028;
+}
+
+static bool thorModemPayload(const ThorModemFatMetadata &metadata, unsigned index,
+                                  ThorModemFat::File &file)
+{
+  if (!index || index >= kThorModemMdtHeaders - 1 ||
+      !(metadata.pieceMask & (1U << index)))
+    return false;
+  const auto *ph = metadata.mdt + 52 + index * 32;
+  const uint32_t bytes = le32(ph + 16);
+  if (le32(ph) != 1 || !bytes ||
+      bytes > le32(ph + 20) || metadata.pieceBytes[index] != bytes ||
+      uint64_t(le32(ph + 4)) + bytes <= sizeof(metadata.mdt))
+    return false;
+  file = {metadata.pieceCluster[index], bytes};
+  return true;
+}
+
+static bool thorModemSmallPayload(const ThorModemFatMetadata &metadata, unsigned index,
+                                  ThorModemFat::File &file)
+{
+  return thorModemPayload(metadata, index, file) && file.size <= ThorModemFat::boundedFileBytes;
+}
