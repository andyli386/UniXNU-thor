@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include <stdint.h>
+
+// The caller owns the quiesced PAS session and maps its MPSS carveout.
+// Offsets are relative to that carveout. A null data pointer requests
+// zero fill. A failed load leaves provisional bytes; never reset/start
+// the modem until this call and the secure firmware authentication succeed.
+using ThorModemWrite = bool (*)(void *context, uint64_t offset,
+                               const uint8_t *data, uint32_t bytes);
+
+extern "C" int pong_thor_modem_load_firmware(uint64_t base, uint64_t length,
+                                             ThorModemWrite write, void *context);
