diff --git a/ThorAdspFirmware.h b/ThorAdspFirmware.h
new file mode 100644
index 0000000000000000000000000000000000000000..c98e1092685fd30232aa0a232b53bf204a1b3192
--- /dev/null
+++ b/ThorAdspFirmware.h
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include "ModemFirmwareFat.h"
+
+// Thor's signed cape ADSP MDT has a relocatable 49 MiB span. Only the stock
+// active-slot image is admitted. Boot control belongs to the PAS1 owner.
+namespace ThorAdspFirmware {
+constexpr uint64_t base = 0x9fd00000, size = 0x3100000, linkBase = 0x86300000;
+constexpr unsigned mdtBytes = 5404, digestTable = 1172, headers = 26, lastLoad = 24;
+constexpr uint8_t mdtDigest[] = {
+    0xcf,0x11,0x39,0x5d,0x02,0xa6,0xff,0xc2,0x12,0xde,0x4a,0x97,0x48,0x0c,0xdb,0x88,
+    0xb6,0xfa,0xa2,0xd7,0x77,0x7d,0xaf,0x41,0x62,0x6b,0x0f,0x07,0x35,0x6b,0x08,0x10};
+static_assert(digestTable + headers * 48 <= mdtBytes);
+struct Index {
+    ThorModemFat::File mdt{};
+    ThorModemFat::File pieces[headers]{};
+};
+inline bool find(const ThorModemFat::Volume &v, uint8_t (&scratch)[4096], Index &index)
+{
+    using namespace ThorModemFat;
+    uint16_t directory = 0;
+    if (!imageDirectory(v,scratch,directory)) return false;
+    if (!visitDirectory(v,directory,scratch,[&](const char *name,const uint8_t *entry) {
+        if (strncmp(name,"ADSP.",5) != 0) return true;
+        File *file;
+        if (strcmp(name+5,"MDT") == 0) file = &index.mdt;
+        else {
+            if (name[5] != 'B' || name[6] < '0' || name[6] > '9' ||
+                name[7] < '0' || name[7] > '9' || name[8] != 0) return true;
+            const unsigned i = (name[6]-'0')*10 + (name[7]-'0');
+            if (i >= headers) return true;
+            file = &index.pieces[i];
+        }
+        const File f{read16(entry+26),read32(entry+28)};
+        if (file->cluster || (entry[11]&0x10) || read16(entry+20) || !v.valid(f.cluster))
+            return false;
+        *file = f;
+        return true;
+    })) return false;
+    return index.mdt.size == mdtBytes;
+}
+
+inline bool layout(const uint8_t *mdt,const Index &index)
+{
+    using namespace ThorModemFat;
+    if (memcmp(mdt,"\x7f" "ELF\x01\x01\x01",7) != 0 || read16(mdt+18)!=164 ||
+        read32(mdt+28)!=52 || read16(mdt+42)!=32 || read16(mdt+44)!=headers) return false;
+    uint64_t end = 0;
+    for (unsigned i=1;i<=lastLoad;++i) {
+        const auto *p = mdt + 52 + i*32;
+        const uint64_t pa=read32(p+12), file=read32(p+16), mem=read32(p+20);
+        const uint32_t flags=read32(p+24);
+        if (read32(p)!=1 || !(flags & (1U<<27)) || ((flags>>24)&7U)==2 ||
+            !mem || file>mem || pa<linkBase || pa-linkBase<end || pa-linkBase>=size ||
+            mem>size-(pa-linkBase) || (i==1 && pa!=linkBase) ||
+            index.pieces[i].size!=file || (file!=0)!=(index.pieces[i].cluster!=0))
+            return false;
+        end=pa-linkBase+mem;
+    }
+    return end==size;
+}
+}
diff --git a/ThorAdspFirmwareAccess.inc b/ThorAdspFirmwareAccess.inc
new file mode 100644
index 0000000000000000000000000000000000000000..63bc5ce03d4d3df011c95ac522347b3810082d43
--- /dev/null
+++ b/ThorAdspFirmwareAccess.inc
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include "ThorAdspFirmware.h"
+
+static int thorAdspRead(ModemFirmwareProbe &probe, void *metadata, ThorModemWrite writer, void *context)
+{
+  using namespace ThorAdspFirmware;
+  modemFirmwareResetReads(probe);
+  probe.readBudget = writer ? 24000 : 512;
+  clock_interval_to_deadline(writer ? 30 : 3, NSEC_PER_SEC, &probe.deadline);
+  ThorModemFat::Volume volume{};
+  volume.read = modemFirmwareSlotRead;
+  volume.context = &probe;
+  volume.bytes = kModemFirmwareSlotBytes;
+  Index index{};
+  auto *mdt = probe.metadata.mdt;
+  static_assert(sizeof(probe.metadata.mdt) >= mdtBytes);
+  if (!volume.open(probe.fatScratch) || !find(volume,probe.fatScratch,index) ||
+      !volume.readFile(index.mdt,mdt)) return EIO;
+  SHA256_CTX checksum;
+  uint8_t digest[sizeof(mdtDigest)];
+  SHA256_Init(&checksum);
+  SHA256_Update(&checksum,mdt,mdtBytes);
+  SHA256_Final(digest,&checksum);
+  if (memcmp(digest,mdtDigest,sizeof(digest)) || !layout(mdt,index)) return EINVAL;
+  if (!writer) {
+    if (metadata) memcpy(metadata,mdt,mdtBytes);
+    return 0;
+  }
+  // Output is provisional until all segments and their secure metadata pass.
+  // The caller owns the reserved carveout and must not start a partial load.
+  for (unsigned i=1;i<=lastLoad;++i) {
+    const uint8_t *ph = mdt + 52 + 32*i;
+    const uint64_t offset = uint64_t(le32(ph+12))-linkBase;
+    const uint32_t file = le32(ph+16), memory = le32(ph+20);
+    if (file) {
+      struct Stream { ThorModemWrite write; void *context; uint64_t pos; SHA384_CTX hash; };
+      Stream s{writer,context,offset,{}};
+      SHA384_Init(&s.hash);
+      const auto sink=[](void *arg,const uint8_t *data,uint32_t bytes) {
+        auto &s=*static_cast<Stream *>(arg);
+        if (!s.write(s.context,s.pos,data,bytes)) return false;
+        SHA384_Update(&s.hash,data,bytes);
+        s.pos+=bytes;
+        return true;
+      };
+      if (!volume.streamFile(index.pieces[i],probe.transferScratch,sink,&s)) return EIO;
+      uint8_t segment[SHA384_DIGEST_LENGTH];
+      SHA384_Final(segment,&s.hash);
+      if (s.pos!=offset+file || memcmp(segment,mdt+digestTable+i*sizeof(segment),sizeof(segment))) return EIO;
+    }
+    for (uint32_t done=file;done<memory;) {
+      const uint32_t left=memory-done;
+      const uint32_t take=left<16384U?left:16384U;
+      if (mach_absolute_time()>=probe.deadline || !writer(context,offset+done,nullptr,take)) return EIO;
+      done+=take;
+    }
+  }
+  return 0;
+}
+
+static int thorAdspFirmwareAccess(void *metadata, ThorModemWrite writer, void *context)
+{
+  if (!__atomic_load_n(&gWifiUfsReady,__ATOMIC_ACQUIRE)) return EAGAIN;
+  auto *probe=static_cast<ModemFirmwareProbe *>(IOMallocData(sizeof(ModemFirmwareProbe)));
+  if (!probe) return ENOMEM;
+  probe->slot=THOR_MODEM_PREFLIGHT_SLOT;
+  int rc=modemFirmwareAdmit(*probe);
+  if (!rc) rc=thorAdspRead(*probe,metadata,writer,context);
+  IOLog("THOR ADSP FW V226: slot=%c phase=%s rc=%d\n",'a'+probe->slot,writer?"segments":"metadata",rc);
+  modemFirmwareFinish(probe);
+  return rc;
+}
