diff --git a/ThorWifiFirmware.h b/ThorWifiFirmware.h
new file mode 100644
index 0000000000000000000000000000000000000000..74b1f3e75cd5091b22c08c461c05e9be942ece1c
--- /dev/null
+++ b/ThorWifiFirmware.h
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include "ModemFirmwareFat.h"
+
+namespace ThorWifiFirmware {
+
+// The Thor CNSS recovery log selects amss20.bin for the QCA6490 rev 01 endpoint.
+// Stock CNSS requests regdb_xiaomi.bin (the generic file is the same size).
+// Digests describe this device's captured stock modem_a/image/qca6490 contents.
+struct Blob {
+    const char *name;
+    uint32_t size;
+    uint8_t digest[32];
+};
+static constexpr Blob blobs[] = {
+    {"AMSS20.BIN", 5296128, {
+        0x8a, 0x7b, 0xa0, 0x72, 0xff, 0x23, 0x28, 0xae, 0x22, 0xb4, 0xd5, 0x18, 0x86, 0x4d, 0xa9, 0x49,
+        0xdc, 0xf8, 0x6b, 0x34, 0xc3, 0x71, 0xd3, 0x5f, 0x56, 0x1a, 0x38, 0x64, 0x43, 0xd4, 0x08, 0xc3}},
+    {"M3.BIN", 266684, {
+        0xad, 0x23, 0x4a, 0xc8, 0x87, 0x9e, 0x29, 0xa1, 0x13, 0x89, 0x3b, 0x87, 0xdc, 0x90, 0x33, 0x5c,
+        0xff, 0x8e, 0xb8, 0x97, 0x17, 0x58, 0x0d, 0x5a, 0x06, 0xa4, 0x9e, 0x7b, 0x9e, 0x32, 0x2e, 0xd7}},
+    {"REGDB_XIAOMI.BIN", 24278, {
+        0xd2, 0xcf, 0x59, 0xdc, 0x04, 0xe6, 0xe9, 0x2b, 0xfa, 0x67, 0xc6, 0x82, 0xc7, 0x6b, 0x61, 0x7e,
+        0x0e, 0x8c, 0x62, 0x2d, 0x9a, 0x84, 0xb9, 0x24, 0xc2, 0xfc, 0x1d, 0x2b, 0x21, 0x69, 0xe0, 0xda}},
+};
+constexpr unsigned blobCount = sizeof(blobs) / sizeof(blobs[0]);
+
+static inline bool sameName(const char *a, const char *b)
+{
+    while (*a && *a == *b) { ++a; ++b; }
+    return *a == *b;
+}
+
+// Walk only the named directory in the admitted volume. The generic FAT walker
+// checks both mirror links and requires EOC even after a directory's end marker.
+static inline const char *find(const ThorModemFat::Volume &volume, uint8_t (&scratch)[4096],
+                               ThorModemFat::File (&files)[blobCount])
+{
+    using namespace ThorModemFat;
+    uint16_t image = 0, qca = 0;
+    if (!imageDirectory(volume, scratch, image) ||
+        !visitDirectory(volume, image, scratch, [&](const char *name, const uint8_t *entry) {
+            if (!sameName(name, "QCA6490")) return true;
+            const uint16_t cluster = read16(entry + 26);
+            if (qca || !(entry[11] & 0x10) || read16(entry + 20) || !volume.valid(cluster))
+                return false;
+            qca = cluster;
+            return true;
+        }) || !qca)
+        return "qca-directory";
+    if (!visitDirectory(volume, qca, scratch, [&](const char *name, const uint8_t *entry) {
+        for (unsigned i = 0; i != blobCount; ++i) {
+            if (!sameName(name, blobs[i].name)) continue;
+            const File candidate{read16(entry + 26), read32(entry + 28)};
+            if (files[i].cluster || (entry[11] & 0x10) || read16(entry + 20) ||
+                !volume.valid(candidate.cluster) || candidate.size != blobs[i].size)
+                return false;
+            files[i] = candidate;
+        }
+        return true;
+    })) return "qca-entries";
+    for (const auto &file : files)
+        if (!file.cluster) return "missing-file";
+    return nullptr;
+}
+} // namespace ThorWifiFirmware
