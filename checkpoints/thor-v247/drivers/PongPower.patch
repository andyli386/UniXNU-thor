+            if ((len | tail | head | offset[2]) & 7u || len < 16 || head >= len || tail >= len)
+                return QcomSmemCorrupt;
+            uint32_t position = tail, avail = head >= tail ? head - tail : len - tail + head;
+            /* Inspect only complete control records from the first unread byte.
+             * Stop at any other command; never search through a data payload. */
+            for (unsigned i = 0; i < 4 && avail >= 8; ++i) {
+                const uint32_t cmd = rd(s, offset[2] + position);
+                const uint32_t param = rd(s, offset[2] + position + 4);
+                position = (position + 8) % len;
+                avail -= 8;
+                if ((cmd & 0xffffu) <= 1 && (cmd >> 16)) {
