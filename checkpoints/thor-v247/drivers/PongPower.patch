+void thorPas4Probe()
+{
+    if (!pong_scm_call_lock()) {
+        IOLog("THOR PAS4 V163: state=lock-unavailable\n");
+        return;
+    }
+    const auto pil = [](uint32_t cmd) { return qcom_scm_fn(QCOM_SCM_SVC_PIL, cmd); };
+    const auto availableCall = [](uint32_t target) {
+        /* INFO receives the SiP owner and service/function identifier. The
+         * SMCCC width bit is used only for the actual call. */
+        return thorPas4ScmQuery(qcom_scm_fn(QCOM_SCM_SVC_INFO, QCOM_SCM_INFO_IS_CALL_AVAIL),
+            target & ~QCOM_SCM_SMC64);
+    };
+    const uint32_t supportFn = pil(QCOM_SCM_PAS_IS_SUPPORTED);
+    const auto availability = availableCall(supportFn);
+    const bool checkSupport = thorPasQueryTrue(availability);
+    auto last = availability;
+    ThorPas4ScmResult modem{}, zap{};
+    bool zapChecked = false;
+    if (checkSupport) {
+        last = modem = thorPas4ScmQuery(supportFn, 4);
+        /* Thor has already used PAS13 for Adreno ZAP by this preflight. Its
+         * support bit is a control for the PAS_IS_SUPPORTED result on PAS4. */
+        if (!thorPasQueryPending(last)) {
+            last = zap = thorPas4ScmQuery(supportFn, 13);
+            zapChecked = true;
+        }
+    }
+    const uint32_t commands[] = {
+        QCOM_SCM_PAS_INIT_IMAGE, QCOM_SCM_PAS_MEM_SETUP,
+        QCOM_SCM_PAS_AUTH_AND_RESET, QCOM_SCM_PAS_SHUTDOWN
+    };
+    ThorPas4ScmResult commandResults[sizeof(commands) / sizeof(commands[0])]{};
+    unsigned checked = 0;
+    /* Probe registration only. An interrupted or WAITQ result leaves a
+     * secure session pending. This driver has no waitqueue IRQ owner. */
+    for (uint32_t cmd : commands) {
+        if (thorPasQueryPending(last)) {
+            break;
+        }
+        last = commandResults[checked++] = availableCall(pil(cmd));
+    }
+    pong_scm_call_unlock();
+
+    IOLog("THOR PAS4 V163: phase=availability x0=%lld x1=%llu state=%s\n",
+        static_cast<long long>(availability.status), static_cast<unsigned long long>(availability.value),
+        thorPasQueryState(availability, "available", "unavailable"));
+    if (checkSupport) {
+        IOLog("THOR PAS4 V163: phase=support x0=%lld x1=%llu state=%s\n",
+            static_cast<long long>(modem.status), static_cast<unsigned long long>(modem.value),
+            thorPasQueryState(modem, "bit-set", "bit-clear"));
+    }
+    if (zapChecked) {
+        IOLog("THOR PAS V164: phase=support-control pas=13 x0=%lld x1=%llu state=%s\n",
+            static_cast<long long>(zap.status), static_cast<unsigned long long>(zap.value),
+            thorPasQueryState(zap, "bit-set", "bit-clear"));
+    }
+    for (unsigned i = 0; i < checked; ++i) {
+        const auto result = commandResults[i];
+        IOLog("THOR PAS V164: phase=method-availability svc=2 cmd=%u x0=%lld x1=%llu state=%s\n",
+            commands[i], static_cast<long long>(result.status), static_cast<unsigned long long>(result.value),
+            thorPasQueryState(result, "available", "unavailable"));
+    }
+
+    /* PAS13 authentication is a control for the support query, not for
+     * admission of PAS4. Xiaomi's cape driver starts from its compatible
+     * descriptor and the resource sequence, then actual PAS return codes. */
+    const bool zapAuthenticated = pong_adreno_native_status && pong_adreno_native_status();
+    const char *zapControl = !zapChecked ? "unqueried" :
+        zapAuthenticated ? thorPasQueryState(zap, "authenticated-bit-set", "authenticated-bit-clear") :
+        thorPasQueryState(zap, "bit-set-auth-unobserved", "bit-clear-auth-unobserved");
+    bool allMethods = checked == sizeof(commands) / sizeof(commands[0]);
+    for (unsigned i = 0; i < checked; ++i) {
+        allMethods = allMethods && thorPasQueryTrue(commandResults[i]);
+    }
+    __atomic_store_n(&pasMethodsAvailable, unsigned(allMethods), __ATOMIC_RELEASE);
+    IOLog("THOR PAS V174: pas=4 support-indicator=%s pas13-control=%s "
+        "methods=%s auth=not-attempted\n",
+        checkSupport ? thorPasQueryState(modem, "bit-set", "bit-clear") : "unqueried",
+        zapControl, allMethods ? "registered" : "incomplete");
+}
+}
