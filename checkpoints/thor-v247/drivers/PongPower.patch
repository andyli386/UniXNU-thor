+        if (rc == QcomSmemMissing) rc = find_mss_cached(s, &p, cached, id, &offset[n], &out->size[n]);
+        if (rc == QcomSmemMissing) continue;
+        if (rc) return rc;
+        out->present |= 1u << n;
+    }
+    out->part_offset = p.offset; out->part_size = p.size;
+    out->desc_offset = offset[0]; out->tx_offset = offset[1]; out->rx_offset = offset[2];
