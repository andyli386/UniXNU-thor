+// The Thor PCIe0 GDSC is a child of CX. Use only a live acknowledgement
+// from the shared RPMh owner, keeping its lock across the short bus lease.
+static void thorWifiHostClocks(bool firmwareReady)
+{
+    auto *domainMap = thorMapModemRange(0x17b000, 0x1000);
+    auto *voteMap = thorMapModemRange(0x162000, 0x1000);
+    auto *refMap = thorMapModemRange(0x19c000, 0x1000);
+    auto *fabricMap = thorMapModemRange(0x19d000, 0x1000);
+    initLock(&powerLock);
+    if (domainMap && voteMap && powerLock) {
+        struct ClockIo {
+            uintptr_t domainBase, voteBase, refBase, fabricBase;
+            volatile uint32_t *reg(unsigned offset) const {
+                return reinterpret_cast<volatile uint32_t *>(
+                    (offset >= 0x9d000 ? fabricBase : offset == ThorWifiPcie::refBranch ? refBase :
+                     offset >= 0x7b000 ? domainBase : voteBase) + (offset & 0xfff));
+            }
+            uint32_t read(unsigned offset) const {
+                const uint32_t value = *reg(offset);
+                __asm__ volatile("dmb oshld" ::: "memory");
+                return value;
+            }
+            void write(unsigned offset, uint32_t value) const {
+                *reg(offset) = value;
+                __asm__ volatile("dsb sy" ::: "memory");
+            }
+            void delay(unsigned us) const { IODelay(us); }
+        } io{domainMap->getVirtualAddress(), voteMap->getVirtualAddress(),
+             refMap ? refMap->getVirtualAddress() : 0, fabricMap ? fabricMap->getVirtualAddress() : 0};
+        IOLockLock(powerLock);
+        const auto *cx = modemArc.find(0x30000);
+        const uint32_t ack = cx && cx->known ? cx->ack : 0;
+        const auto *xo = modemArc.find(0x300b0);
+        const uint32_t xoAck = xo && xo->known ? xo->ack : 0;
+        const bool requestRef = wifiReference.claim(firmwareReady, ack, xoAck,
+            modemArcInputs.version == 1 && modemArcInputs.xo.address == 0x300b0 &&
+            modemArcInputs.xo.corner == 3);
+        ThorWifiPcie::Result bus{}, refBus{};
+        if (firmwareReady) bus = ThorWifiPcie::exerciseHostBus(io, ack != 0);
+        ThorWifiPcie::Reference ref;
+        ThorWifiPcie::AuxClock aux;
+        ThorWifiPcie::PipeParent pipe;
+        ThorWifiPcie::Fabric fabric;
+        const auto *mx = modemArc.find(0x30010);
+        const uint32_t mxAck = mx && mx->known ? mx->ack : 0;
+        const bool auxRailsReady = wifiMx.corner > 0 && wifiCx.corner > 0 &&
+            mxAck >= (unsigned)wifiMx.corner && mxAck <= (unsigned)wifiMx.highest &&
+            ack >= (unsigned)wifiCx.corner && ack <= (unsigned)wifiCx.highest;
+        const int mxFloor = wifiMx.corner, cxFloor = wifiCx.corner;
+        if (requestRef) {
+            if (firmwareReady && !bus.restored) {
+                ref.state = "prior-bus-unrestored";
+                refBus = bus;
+            } else if (!refMap) {
+                ref.state = "ref-map-unavailable";
+                refBus.state = "not-started";
+            } else {
+                refBus = ThorWifiPcie::exerciseHostBus(io, true, [&]() {
+                    return ThorWifiPcie::exerciseReference(io, ref, [&]() {
+                        if (!ThorWifiPcie::exerciseAux(io, aux, auxRailsReady)) return false;
+                        if (!aux.clocked || !aux.restored) return true;
+                        if (!ThorWifiPcie::exercisePipeParent(io, pipe)) return false;
+                        if (!pipe.attempted || !pipe.restored || pipe.active == UINT32_MAX ||
+                            (pipe.active & ThorWifiPcie::pipeSel)) return true;
+                        if (!fabricMap) {
+                            fabric.state = "map-unavailable";
+                            return true;
+                        }
+                        return ThorWifiPcie::exerciseFabric(io, fabric);
+                    });
+                });
+            }
+        }
+        IOLockUnlock(powerLock);
+        if (firmwareReady) {
+            IOLog("THOR WLAN V222: pcie0=%s cx=%u gdsc=0x%x powered=0x%x "
+              "collapse=0x%x gates=0x%x power_vote=%u acquired=0x%x running=0x%x "
+              "end_collapse=0x%x end_gates=0x%x restored=%u\n",
+              bus.state, ack, bus.initialDomain, bus.enabledDomain, bus.initialCollapse,
+              bus.initialGates, bus.ownsPower, bus.ownedGates, bus.runningGates,
+              bus.finalCollapse, bus.finalGates, bus.restored);
+        }
+        if (requestRef) {
+            IOLog("THOR WLAN V223: pcie0=%s cx=%u xo=%u bus=%s running=0x%x "
+                  "before=0x%x active=0x%x after=0x%x owned=%u ref_restored=%u "
+                  "bus_restored=%u aux_cmd=0x%x aux_cfg=0x%x aux=0x%x core_reset=0x%x pipe_mux=0x%x\n",
+                  ref.state, ack, xoAck, refBus.state, refBus.runningGates, ref.before, ref.active,
+                  ref.after, ref.owned, ref.restored, refBus.restored, ref.auxCmd, ref.auxCfg,
+                  ref.auxBranch, ref.coreReset, ref.pipeMux);
+            IOLog("THOR WLAN V224: aux=%s mx=%u/%d cx=%u/%d cfg=%#x initial_vote=%#x "
+                  "active_vote=%#x root=%#x cbcr=%#x final_vote=%#x owned=%u restored=%u\n",
+                  aux.state, mxAck, mxFloor, ack, cxFloor, aux.source, aux.before, aux.active,
+                  aux.root, aux.branch, aux.after, aux.owned, aux.restored);
+            IOLog("THOR WLAN V225: pipe=%s before=%#x active=%#x after=%#x vote=%#x branch=%#x "
+                  "end_vote=%#x end_branch=%#x attempted=%u restored=%u\n",
+                  pipe.state, pipe.before, pipe.active, pipe.after, pipe.vote, pipe.branch,
+                  pipe.endVote, pipe.endBranch, pipe.attempted, pipe.restored);
+            IOLog("THOR WLAN V225: noc_votes=%#x noc_branch=%#x rate_cmd=%#x rate_cfg=%#x rate_branch=%#x\n",
+                  pipe.nocVotes, pipe.nocBranch, pipe.rateCmd, pipe.rateCfg, pipe.rateBranch);
+            IOLog("THOR WLAN V226: fabric=%s before=%#x active=%#x after=%#x owned=%#x "
+                  "aggre0=%#x aggre1=%#x tbu=%#x restored=%u\n", fabric.state, fabric.before,
+                  fabric.active, fabric.after, fabric.owned, fabric.aggre0, fabric.aggre1,
+                  fabric.tbu, fabric.restored);
+        }
+    } else if (firmwareReady) {
+        IOLog("THOR WLAN V222: pcie0=host-map-unavailable\n");
+    } else {
+        IOLog("THOR WLAN V223: pcie0=host-map-unavailable\n");
+    }
+    if (fabricMap) fabricMap->release();
+    if (refMap) refMap->release();
+    if (voteMap) voteMap->release();
+    if (domainMap) domainMap->release();
+}
+
+// v229: with the Wi-Fi driver selected its worker owns PCIe0's power, clocks,
+// reset and the endpoint from early boot. The v221-v226 probes exercise and
+// restore those registers under a running link; keep them for driver-less boots.
+static bool thorWifiDriverSelected()
+{
+    unsigned mode = 0;
+    if (PE_parse_boot_argn("pong_wifi", &mode, sizeof(mode)) && mode == 1) return true;
+    IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+    auto data = chosen ? OSDynamicCast(OSData, chosen->getProperty("thor-wifi")) : nullptr;
+    uint32_t value = 0;
+    if (data && data->getLength() == sizeof(value)) memcpy(&value, data->getBytesNoCopy(), sizeof(value));
+    if (chosen) chosen->release();
+    return value == 1 || value == 2;
+}
+
+extern "C" void pong_thor_wifi_pcie_host(void)
+{
+    if (thorWifiDriverSelected()) {
+        IOLog("THOR WLAN V229: PCIe0 probes skipped; the Wi-Fi driver owns the controller\n");
+        return;
+    }
+    thorWifiHostClocks(true);
+}
