+/* Thor's stock FDT routes AOSS messages to IPCC (0,0). Poll the shared
+ * descriptor for ACKs, so this owner does not mask or clear receiver IRQs. */
+void thorModemAossOpenChannel()
+{
+    static unsigned attempted;
+    unsigned idle = 0;
+    if (!__atomic_compare_exchange_n(&attempted, &idle, 1u, false,
+                                     __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+        return;
+    }
+    if (thorAossUsesAdspOwner()) {
+        IOLog("THOR MODEM LOAD V186: request=not-sent state=adsp-mailbox-owner\n");
+        return;
+    }
+    constexpr uint64_t aossAddress = 0x0c300000;
+    constexpr uint64_t ipccAddress = 0x0ed18000;
+    constexpr uint32_t ipccBytes = 0x1000;
+    auto aossMap = thorMapModemRange(aossAddress, kThorAossRamBytes);
+    auto ipccMap = aossMap ? thorMapModemRange(ipccAddress, ipccBytes) : nullptr;
+    ThorAossChannelResult result{"map-failed", 0, 0};
+    uint64_t ackMs = 0;
+    if (aossMap && ipccMap) {
+        auto *regs = reinterpret_cast<volatile uint32_t *>(aossMap->getVirtualAddress());
+        auto *send = reinterpret_cast<volatile uint32_t *>(ipccMap->getVirtualAddress() + QCOM_IPCC_SEND);
+        const auto read = [regs](ThorAossSnapshot &out) {
+            ThorAossSnapshot samples[2]{};
+            for (auto &sample : samples) {
+                for (unsigned i = 0; i < sizeof(sample.words) / sizeof(sample.words[0]); ++i) {
+                    sample.words[i] = regs[i];
+                }
+                __asm__ volatile("dmb oshld" ::: "memory");
+            }
+            out = samples[1];
+            for (unsigned i = 0; i < sizeof(out.words) / sizeof(out.words[0]); ++i) {
+                if (samples[0].words[i] != out.words[i]) {
+                    return false;
+                }
+            }
+            return true;
+        };
+        const auto write = [regs](unsigned word, uint32_t value) {regs[word] = value;};
+        const auto kick = [send]() {
+            __asm__ volatile("dsb sy" ::: "memory");
+            *send = qcom_ipcc_id(QCOM_IPCC_CLIENT_AOP, QCOM_IPCC_SIGNAL_GLINK_QMP);
+            __asm__ volatile("dsb oshst" ::: "memory");
+        };
+        uint64_t deadline = 0;
+        const auto wait = [&deadline]() {
+            if (mach_absolute_time() >= deadline) {
+                return false;
+            }
+            IOSleep(1);
+            return mach_absolute_time() < deadline;
+        };
+        if (thorAossLock()) {
+            clock_interval_to_deadline(250, kMillisecondScale, &deadline);
+            result = thorAossOpenChannel(read, write, kick, wait);
+            thorAossUnlock();
+        } else {
+            result.state = "owner-allocation-failed";
+        }
+        if (result.freshAck) ackMs = now();
+        ipccMap->release();
+    }
+    if (aossMap) {
+        aossMap->release();
+    }
+    IOLog("THOR MODEM AOSS V177: state=%s ap-channel=0x%x ap-ack=0x%x mode=handshake-only\n",
+          result.state, result.apChannel, result.apAck);
+    if (result.freshAck) {
+        uint32_t ready = 0, stop = 0;
+        int status, hostStatus;
+        if (const char *failure = thorReadMss(hostStatus, stop, status, ready)) {
+            IOLog("THOR SMP2P V182: post-aoss-ack ack_ms=%llu sample_ms=%llu state=%s\n",
+                  (unsigned long long)ackMs, (unsigned long long)now(), failure);
+        } else {
+            IOLog("THOR SMP2P V182: post-aoss-ack ack_ms=%llu sample_ms=%llu "
+                  "item428=%s status428=%d stop_bit=%d item435=%s status435=%d ready_bit=%d\n",
+                  (unsigned long long)ackMs, (unsigned long long)now(),
+                  mss_smp2p_state(hostStatus), hostStatus, hostStatus == QcomSmemOk ? (int)stop : -1,
+                  mss_smp2p_state(status), status, status == QcomSmemOk ? (int)ready : -1);
+            if (hostStatus == QcomSmemMissing && status == QcomSmemMissing)
+                thorPublishMssStop();
+        }
+    } else if (!strcmp(result.state, "existing-open")) {
+        // Both endpoints already completed this handshake. The locked check
+        // preserves inherited items and only publishes into an empty link.
+        thorPublishMssStop();
+    }
+    if (result.freshAck || !strcmp(result.state, "existing-open"))
+        thorModemRequestLoadState(kThorMssChannel);
+    else
+        IOLog("THOR MODEM LOAD V186: request=not-sent state=aoss-channel-unavailable\n");
+}
