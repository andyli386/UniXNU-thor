diff --git a/PongCamBoard.h b/PongCamBoard.h
new file mode 100644
index 0000000000000000000000000000000000000000..57ff3cd45f85f3940f3ed1f3abcff3083050dc25
--- /dev/null
+++ b/PongCamBoard.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* THOR CAMERA V247: board constants of the front camera (qcom,cam-sensor1 of the live Android DT,
+ * thor-out/v226-intake/recovery-linux.dts). Pure data, shared by the kernel probe and the host test.
+ *  - bus: CCI1 0xac16000, cci-master = 1 (dts:24932). Master 1 of CCI1 is pinctrl cci3_active (dts:24813, 4682):
+ *    pads GPIO208/209, an eGPIO pair the active state claims for APPS (qcom,apps) and the suspend state hands back
+ *    (qcom,remote). GPIO112/113 are master 1 of CCI0 (dts:4622), which carries cam-sensor0, not the front camera.
+ *  - MCLK: cam_mclk on GPIO104 (cam_front_active_mclk, dts:5491) = cam_mclk4 (cam_sensor_mclk4_active, dts:4834),
+ *    19.2 MHz (clock-rates 0x124f800, dts:24928). The label CAMIF_MCLK1 (dts:24933) is only Xiaomi's table label.
+ *  - reset: GPIO108, driven low in the suspend state (cam_sensor_suspend_front, dts:5536).
+ *  - rails: RPMh VRM regulators of PM8010J (letter J, dts:6714): vio ldoj3 1.8 V (dts:6873), vana ldoj5 2.8 V (dts:6909),
+ *    vdig ldoj2 1.104 V (dts:6855). Only cam-sensor1 and eeprom1 reference them (dts:24918-24951).
+ *  - cam_clk-supply = cam_cc_titan_top_gdsc (dts:1002-1004, register 0xadf31dc). */
+#ifndef PONG_CAM_BOARD_H
+#define PONG_CAM_BOARD_H
+#include <stdint.h>
+
+enum {
+  CamBaseCamcc = 0x0ade0000, CamBaseGcc = 0x01000000, CamBaseTlmm = 0x0f100000,
+  CamBaseCci0 = 0x0ac15000, CamBaseCci1 = 0x0ac16000,
+  CamBaseCsid0 = 0x0acb7000, CamBaseCsidLite0 = 0x0acc6000, CamBaseIfeLite0 = 0x0acc6000,
+  CamBaseCmdDb = 0x80860000, CamBaseSpmiCore = 0x0c400000, CamBaseSpmiObserver = 0x0c440000,
+};
+
+/* CAM_CC offsets: Linux camcc-sm8450.c (mclk4 0x15070/0x15088, cci1 0x13148/0x13160, slow AHB 0x10034, fast AHB
+ * 0x10018, CAMNOC AXI 0x13194, CPAS AHB 0x13164, CAMNOC AXI branch 0x131ac, core AHB 0x131f0, titan_top 0x131dc);
+ * the GDSCs also as dts:904-1004. Status bits: bit 31 of a CBCR = CLK_OFF, of a GDSCR = PWR_ON, bit 0 = SW_COLLAPSE. */
+enum {
+  CamCcBpsGdsc = 0xf004, CamCcIfe0Gdsc = 0x11004, CamCcIfe1Gdsc = 0x12004, CamCcIfe2Gdsc = 0x12050,
+  CamCcIpe0Gdsc = 0x10078, CamCcSbiGdsc = 0x100d0, CamCcSfe0Gdsc = 0x13050, CamCcSfe1Gdsc = 0x13098,
+  CamCcTitanGdsc = 0x131dc,
+  CamCcSlowAhbRcg = 0x10034, CamCcFastAhbRcg = 0x10018, CamCcCamnocRcg = 0x13194,
+  CamCcCci0Rcg = 0x1312c, CamCcCci0Cbcr = 0x13144, CamCcCci1Rcg = 0x13148, CamCcCci1Cbcr = 0x13160,
+  CamCcCpasAhbCbcr = 0x13164, CamCcCamnocCbcr = 0x131ac, CamCcCoreAhbCbcr = 0x131f0,
+  CamMclkRcg = 0x15070, CamMclkCbcr = 0x15088,
+  CamGdscCount = 9,
+};
+#define CAM_CLK_OFF 0x80000000u
+#define CAM_GDSC_PWR_ON 0x80000000u
+#define CAM_GDSC_SW_COLLAPSE 1u
+
+/* GCC camera AHB and XO branches (Linux gcc-sm8450.c probe enables both; same addresses as the zizhan probe). */
+#define CAM_GCC_CAMERA_AHB_CBCR 0x136004u
+#define CAM_GCC_CAMERA_XO_CBCR 0x136020u
+#define CAM_GCC_CAMERA_BCR 0x136000u /* bit 0 set = the camera block is held in reset by the boot chain */
+#define CAM_TLMM_WINDOW_BYTES 0xd2000u /* GPIO0..209, 0x1000 each */
+
+enum { CamPinMclk = 104, CamPinReset = 108, CamPinScl = 208, CamPinSda = 209, CamPinCount = 4 };
+
+/* TLMM CFG register (pinctrl-msm.c, sm8450 groups): pull [1:0] (0 none, 1 down, 2 keeper, 3 up), function [5:2],
+ * drive [8:6] in 2 mA steps, output enable 9, eGPIO present 11 (read-only), eGPIO claimed for APPS 12.
+ * IO register: input bit 0, output bit 1. Function numbers from pinctrl-sm8450.c: cam_mclk = 1 on gpio100..107,
+ * cci_i2c = 1 on gpio110..115 and on gpio208/209, gpio = 0. */
+#define CAM_PIN_CTL_MASK 0x3ffu
+#define CAM_PIN_FUNC_SHIFT 2
+#define CAM_PIN_DRIVE_SHIFT 6
+#define CAM_PIN_OE (1u << 9)
+#define CAM_PIN_EGPIO_PRESENT (1u << 11)
+#define CAM_PIN_EGPIO_CLAIM (1u << 12)
+#define CAM_PIN_IO_IN (1u << 0)
+#define CAM_PIN_IO_OUT (1u << 1)
+enum { CamFuncGpio = 0, CamFuncCamMclk = 1, CamFuncCciI2c = 1 };
+enum { CamPullNone = 0, CamPullDown = 1, CamPullKeeper = 2, CamPullUp = 3 };
+
+/* RPMh VRM registers of one LDO (Linux qcom-rpmh-regulator.c): MODE at +8, VOLTAGE in millivolts at +0, ENABLE at +4.
+ * PMIC5 LDO modes: HPM 7, LPM 4. The Wi-Fi driver's supplies() uses the same three writes for its rails. */
+#define CAM_VRM_VOLTAGE 0u
+#define CAM_VRM_ENABLE 4u
+#define CAM_VRM_MODE 8u
+#define CAM_VRM_LDO_HPM 7u
+
+typedef struct { const char *name; unsigned mv, peripheral; } CamRail;
+
+/* PM8010J is SPMI slave 9: its temp alarm carries phandle 0x598 under qcom,pm8010@9 (dts:9982, 11114-11125).
+ * LDO n is expected at peripheral 0x40 + n - 1, the layout of PM8008; the DT does not list PM8010 LDOs. The guess
+ * only selects the SPMI observer channel of the physical read-back; when wrong, that read-back is unavailable. */
+#define CAM_PM8010J_SLAVE 9u
+#define CAM_RAIL_COUNT 3
+/* Power-up order vio, vana, vdig: the generic Qualcomm Sony order and the order the zizhan probe used for its front
+ * camera on this SoC. Thor's vendor sensor driver (which holds the real power-up table) is not on this Mac. */
+static const CamRail kCamRails[CAM_RAIL_COUNT] = {
+  {"ldoj3", 1800, 0x42}, /* vio 1.8 V */
+  {"ldoj5", 2800, 0x44}, /* vana 2.8 V */
+  {"ldoj2", 1104, 0x41}, /* vdig 1.104 V */
+};
+
+/* CFG word for one pin: everything outside pull/function/drive is kept from the saved word. */
+static inline uint32_t cam_pin_config(uint32_t saved, unsigned function, unsigned pull, unsigned drive_ma) {
+  return (saved & ~CAM_PIN_CTL_MASK) | ((drive_ma / 2) << CAM_PIN_DRIVE_SHIFT) | (function << CAM_PIN_FUNC_SHIFT) | pull;
+}
+/* An eGPIO-capable pad only drives for APPS once ownership is claimed (bit 12); bit 11 says whether it is one. */
+static inline uint32_t cam_pin_claim_egpio(uint32_t cfg) {
+  return (cfg & CAM_PIN_EGPIO_PRESENT) ? (cfg | CAM_PIN_EGPIO_CLAIM) : cfg;
+}
+/* SPMI PPID of a rail: slave in bits 11:8 and the peripheral's base byte in 7:0 (0x4200 -> 0x42). */
+static inline uint32_t cam_rail_ppid(const CamRail *rail) { return (CAM_PM8010J_SLAVE << 8) | rail->peripheral; }
+
+#endif
diff --git a/PongCamCc.h b/PongCamCc.h
new file mode 100644
index 0000000000000000000000000000000000000000..897726e4f73803095567f714322b5d6ac17a6e9c
--- /dev/null
+++ b/PongCamCc.h
@@ -0,0 +1,142 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* THOR CAMERA V247: CAM_CC steps for one sensor MCLK and for the CCI buses (adapted from the zizhan probe's
+ * ZizhanCamCc.h / ZizhanCci.h, which read chip ids on this SoC; host tested again in hosttest/).
+ * CAM_CC at 0xade0000 (Linux camcc-sm8450.c; it sits in MMCX, the domain the running display keeps up):
+ *   titan_top GDSCR 0x131dc (bit 0 SW_COLLAPSE, bit 31 PWR_ON),
+ *   RCG = CMD +0, CFG +4, M +8, N +0xc, D +0x10; 19.2 MHz = BI_TCXO (source 0), pre-div 1, M/N unused,
+ *   branch CBCR (bit 0 CLK_ENABLE, bit 31 CLK_OFF).
+ * Order on: GDSC, RCG, branch. Every wait is bounded by the caller's poll count; a step that fails undoes
+ * what it did. Off restores the saved RCG words so no rate change is left behind. */
+#ifndef PONG_CAM_CC_H
+#define PONG_CAM_CC_H
+#include <stdint.h>
+#include "PongCamBoard.h"
+
+enum { CamCcOk = 0, CamCcArgument, CamCcTimeout };
+
+typedef struct {
+  void *context;
+  uint32_t (*read)(void *context, uint32_t offset);
+  void (*write)(void *context, uint32_t offset, uint32_t value);
+  void (*pause_us)(void *context, unsigned us);
+  unsigned polls; /* bound of every wait, e.g. 1000 x 10 us */
+} CamCcOps;
+
+typedef struct { uint32_t cmd, cfg, m, n, d; } CamCcRcg;
+
+static inline int cam_cc_usable(const CamCcOps *o) {
+  return o && o->read && o->write && o->pause_us && o->polls;
+}
+
+static inline int cam_cc_gdsc(const CamCcOps *o, uint32_t gdscr, int on) {
+  if (!cam_cc_usable(o)) return CamCcArgument;
+  const uint32_t v = o->read(o->context, gdscr);
+  o->write(o->context, gdscr, on ? (v & ~CAM_GDSC_SW_COLLAPSE) : (v | CAM_GDSC_SW_COLLAPSE));
+  for (unsigned i = 0; i < o->polls; ++i) {
+    const int powered = (o->read(o->context, gdscr) & CAM_GDSC_PWR_ON) != 0;
+    if (powered == !!on) return CamCcOk;
+    o->pause_us(o->context, 10);
+  }
+  return CamCcTimeout;
+}
+
+/* 19.2 MHz from the XO: CFG source 0, pre-div field 1, mode 0; M/N untouched. UPDATE (CMD bit 0) latches it. */
+static inline int cam_cc_rcg_xo(const CamCcOps *o, uint32_t rcg) {
+  if (!cam_cc_usable(o)) return CamCcArgument;
+  const uint32_t cfg = o->read(o->context, rcg + 4);
+  o->write(o->context, rcg + 4, (cfg & ~0x1037ffu) | 1u);
+  o->write(o->context, rcg, o->read(o->context, rcg) | 1u);
+  for (unsigned i = 0; i < o->polls; ++i) {
+    if (!(o->read(o->context, rcg) & 1u)) return CamCcOk;
+    o->pause_us(o->context, 10);
+  }
+  return CamCcTimeout;
+}
+
+static inline int cam_cc_branch(const CamCcOps *o, uint32_t cbcr, int on) {
+  if (!cam_cc_usable(o)) return CamCcArgument;
+  const uint32_t v = o->read(o->context, cbcr);
+  o->write(o->context, cbcr, on ? (v | 1u) : (v & ~1u));
+  for (unsigned i = 0; i < o->polls; ++i) {
+    const int off = (o->read(o->context, cbcr) & CAM_CLK_OFF) != 0;
+    if (off == !on) return CamCcOk;
+    o->pause_us(o->context, 10);
+  }
+  return CamCcTimeout;
+}
+
+static inline void cam_cc_rcg_save(const CamCcOps *o, uint32_t rcg, CamCcRcg *s) {
+  s->cmd = o->read(o->context, rcg);
+  s->cfg = o->read(o->context, rcg + 4);
+  s->m = o->read(o->context, rcg + 8);
+  s->n = o->read(o->context, rcg + 12);
+  s->d = o->read(o->context, rcg + 16);
+}
+
+/* Puts the saved words back and latches them with an UPDATE, so the running divider is the boot one again. */
+static inline int cam_cc_rcg_restore(const CamCcOps *o, uint32_t rcg, const CamCcRcg *s) {
+  if (!cam_cc_usable(o)) return CamCcArgument;
+  o->write(o->context, rcg + 4, s->cfg);
+  o->write(o->context, rcg + 8, s->m);
+  o->write(o->context, rcg + 12, s->n);
+  o->write(o->context, rcg + 16, s->d);
+  o->write(o->context, rcg, s->cmd | 1u);
+  for (unsigned i = 0; i < o->polls; ++i) {
+    if (!(o->read(o->context, rcg) & 1u)) return CamCcOk;
+    o->pause_us(o->context, 10);
+  }
+  return CamCcTimeout;
+}
+
+/* Any sensor MCLK at 19.2 MHz. *stage (1 GDSC, 2 RCG, 3 branch) says where it stopped; on any failure the
+ * steps already taken are undone in reverse. */
+static inline int cam_cc_mclk_on(const CamCcOps *o, uint32_t rcg, uint32_t cbcr, unsigned *stage) {
+  if (stage) *stage = 0;
+  int rc = cam_cc_gdsc(o, CamCcTitanGdsc, 1);
+  if (stage) *stage = 1;
+  if (rc) { (void)cam_cc_gdsc(o, CamCcTitanGdsc, 0); return rc; }
+  rc = cam_cc_rcg_xo(o, rcg);
+  if (stage) *stage = 2;
+  if (rc) { (void)cam_cc_gdsc(o, CamCcTitanGdsc, 0); return rc; }
+  rc = cam_cc_branch(o, cbcr, 1);
+  if (stage) *stage = 3;
+  if (rc) { (void)cam_cc_branch(o, cbcr, 0); (void)cam_cc_gdsc(o, CamCcTitanGdsc, 0); return rc; }
+  return CamCcOk;
+}
+
+/* Branch, then RCG words, then the GDSC. */
+static inline int cam_cc_mclk_off(const CamCcOps *o, uint32_t rcg, uint32_t cbcr, const CamCcRcg *saved) {
+  const int a = cam_cc_branch(o, cbcr, 0);
+  const int b = saved ? cam_cc_rcg_restore(o, rcg, saved) : CamCcOk;
+  const int c = cam_cc_gdsc(o, CamCcTitanGdsc, 0);
+  return a ? a : b ? b : c;
+}
+
+/* Clocks the CCI needs, all from the 19.2 MHz XO (no camera PLL): GDSC (already on from MCLK, harmless again),
+ * slow AHB, CAMNOC AXI and the CCI root generators, then core AHB (halt-delay branch: enable only, no poll),
+ * then CPAS AHB, CAMNOC AXI and the CCI branch. cci_rcg/cci_cbcr: CCI0 0x1312c/0x13144, CCI1 0x13148/0x13160.
+ * Returns the 1-based index of the step that failed (0 = on); the caller undoes with cam_cc_cci_off. */
+static inline int cam_cc_cci_on(const CamCcOps *c, uint32_t cci_rcg, uint32_t cci_cbcr) {
+  const uint32_t rcgs[3] = {CamCcSlowAhbRcg, CamCcCamnocRcg, cci_rcg};
+  const uint32_t branches[3] = {CamCcCpasAhbCbcr, CamCcCamnocCbcr, cci_cbcr};
+  if (!cam_cc_usable(c)) return -1;
+  if (cam_cc_gdsc(c, CamCcTitanGdsc, 1)) return 1;
+  for (unsigned i = 0; i < 3; ++i) if (cam_cc_rcg_xo(c, rcgs[i])) return (int)(2 + i);
+  c->write(c->context, CamCcCoreAhbCbcr, c->read(c->context, CamCcCoreAhbCbcr) | 1u);
+  for (unsigned i = 0; i < 3; ++i) if (cam_cc_branch(c, branches[i], 1)) return (int)(5 + i);
+  return 0;
+}
+
+/* Reverse of cam_cc_cci_on without the GDSC (the MCLK step switches it off last); the RCG words go back. */
+static inline int cam_cc_cci_off(const CamCcOps *c, uint32_t cci_rcg, uint32_t cci_cbcr, const CamCcRcg *saved) {
+  const uint32_t rcgs[3] = {CamCcSlowAhbRcg, CamCcCamnocRcg, cci_rcg};
+  const uint32_t branches[3] = {CamCcCpasAhbCbcr, CamCcCamnocCbcr, cci_cbcr};
+  if (!cam_cc_usable(c)) return -1;
+  int first = 0;
+  for (unsigned i = 3; i-- > 0;) { const int rc = cam_cc_branch(c, branches[i], 0); if (rc && !first) first = (int)(1 + i); }
+  c->write(c->context, CamCcCoreAhbCbcr, c->read(c->context, CamCcCoreAhbCbcr) & ~1u);
+  for (unsigned i = 3; i-- > 0;) if (saved) { const int rc = cam_cc_rcg_restore(c, rcgs[i], &saved[i]); if (rc && !first) first = (int)(4 + i); }
+  return first;
+}
+
+#endif
diff --git a/PongCamCci.h b/PongCamCci.h
new file mode 100644
index 0000000000000000000000000000000000000000..b55ed90fc5b2e5462c12231484028440133eda6c
--- /dev/null
+++ b/PongCamCci.h
@@ -0,0 +1,160 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* THOR CAMERA V247: CCI (camera control interface) transactions, polled (adapted from the zizhan probe's
+ * ZizhanCci.h, which read four chip ids on this SoC; host tested again in hosttest/). CCI is its own hardware
+ * block, not a QUP/GENI serial engine. Register names follow Linux i2c-qcom-cci.c: CCI_HW_VERSION 0x0,
+ * RESET_CMD 0x004, QUEUE_START 0x008, IRQ_MASK/CLEAR/STATUS_0 0xc04/c08/c0c, GLOBAL_CLEAR 0xc00.
+ * Per master m and queue q: data 0x310 + 0x200*m + 0x100*q, EXEC_WORD_CNT 0x300 + 0x200*m + 0x100*q (current
+ * count at +4), READ_DATA 0x118 + 0x100*m, READ_BUF_LEVEL 0x11c + 0x100*m; SCL_CTL 0x200 + 0x100*m.
+ * A sensor register read is a write of the 16-bit register address (queue 0) then a read (queue 1): CCI has no
+ * repeated start. Every wait is bounded by the poll count. */
+#ifndef PONG_CAM_CCI_H
+#define PONG_CAM_CCI_H
+#include <string.h>
+#include <stdint.h>
+#include "PongCamBoard.h"
+#include "PongCamCc.h"
+
+enum { CamCciOk = 0, CamCciArgument, CamCciTimeout, CamCciNack, CamCciError, CamCciLength, CamCciClock };
+#define CAM_CCI_IRQ_STATUS_0 0xc0cu
+#define CAM_CCI_IRQ_CLEAR_0 0xc08u
+#define CAM_CCI_IRQ_GLOBAL_CLEAR 0xc00u
+#define CAM_CCI_RESET_CMD 0x004u
+#define CAM_CCI_QUEUE_START 0x008u
+
+typedef CamCcOps CamCciOps; /* same read/write/pause/poll shape, offsets relative to the CCI base */
+
+static inline int cam_cci_usable(const CamCciOps *o, unsigned master) {
+  return o && o->read && o->write && o->pause_us && o->polls && master <= 1;
+}
+
+/* Polls IRQ_STATUS_0 until done_mask, a NACK or another error shows; clears what it read. */
+static inline int cam_cci_wait(const CamCciOps *o, uint32_t done_mask, uint32_t nack_mask, uint32_t err_mask) {
+  for (unsigned i = 0; i < o->polls; ++i) {
+    const uint32_t st = o->read(o->context, CAM_CCI_IRQ_STATUS_0);
+    if (st) { o->write(o->context, CAM_CCI_IRQ_CLEAR_0, st); o->write(o->context, CAM_CCI_IRQ_GLOBAL_CLEAR, 1); }
+    if (st & nack_mask) return CamCciNack;
+    if (st & err_mask) return CamCciError;
+    if (st & done_mask) return CamCciOk;
+    o->pause_us(o->context, 10);
+  }
+  return CamCciTimeout;
+}
+
+/* Reset the controller, then standard mode (100 kHz) timings of the zizhan probe for a 19.2 MHz CCI clock. */
+static inline int cam_cci_reset_init_m(const CamCciOps *o, unsigned m) {
+  if (!cam_cci_usable(o, m)) return CamCciArgument;
+  const uint32_t b = 0x100u * m;
+  o->write(o->context, 0xc04u, 0x7fffffffu & (0x00111111u | 0x07000000u | 0x18000ee6u | 0x60ee6000u)); /* IRQ_MASK_0, both masters */
+  o->write(o->context, CAM_CCI_RESET_CMD, 0x0f73f3f7u);
+  const int rc = cam_cci_wait(o, 1u << 24, 0, 0); /* RST_DONE_ACK */
+  if (rc) return rc;
+  o->write(o->context, b + 0x200, 78u << 16 | 114u); /* SCL_CTL thigh/tlow */
+  o->write(o->context, b + 0x204, 28u << 16 | 28u); /* SDA_CTL_0 tsu_sto/tsu_sta */
+  o->write(o->context, b + 0x208, 10u << 16 | 77u); /* SDA_CTL_1 thd_dat/thd_sta */
+  o->write(o->context, b + 0x20c, 118u); /* SDA_CTL_2 tbuf */
+  o->write(o->context, b + 0x210, 1u << 8 | 6u << 4 | 1u); /* MISC_CTL stretch, trdhld, tsp */
+  return CamCciOk;
+}
+
+/* Starts one queue. IRQ_STATUS_0 bits per master (i2c-qcom-cci.c): RD_DONE 0/12, Q0 report 4/16, Q1 report 8/20,
+ * NACK Q0 27/29, Q1 28/30, other errors 0xee6 / 0xee6000. */
+static inline int cam_cci_run_m(const CamCciOps *o, unsigned m, unsigned queue, uint32_t done_mask) {
+  const uint32_t q = 0x200u * m + 0x100u * queue;
+  const uint32_t cur = o->read(o->context, 0x304 + q);
+  o->write(o->context, 0x300 + q, cur);
+  o->write(o->context, CAM_CCI_QUEUE_START, 1u << (m * 2 + queue));
+  const uint32_t nack = m ? (queue ? (1u << 30) : (1u << 29)) : (queue ? (1u << 28) : (1u << 27));
+  return cam_cci_wait(o, done_mask, nack, m ? 0x00ee6000u : 0x00000ee6u);
+}
+
+/* Read len (1..11) bytes at a 16-bit register of a 7-bit slave on master m. */
+static inline int cam_cci_read16_m(const CamCciOps *o, unsigned m, uint8_t addr7, uint16_t reg, uint8_t *buf, unsigned len) {
+  if (!cam_cci_usable(o, m) || !buf || addr7 > 0x7f) return CamCciArgument;
+  if (len < 1 || len > 11) return CamCciLength;
+  const uint32_t q0 = 0x310u + 0x200u * m, q1 = q0 + 0x100u;
+  o->write(o->context, q0, 1u | (uint32_t)addr7 << 4); /* write param: address */
+  o->write(o->context, q0, 9u | 2u << 4 | (uint32_t)(reg >> 8) << 8 | (uint32_t)(reg & 0xff) << 16); /* 2 data bytes */
+  o->write(o->context, q0, 8u | 1u << 8); /* report, stop */
+  int rc = cam_cci_run_m(o, m, 0, m ? (1u << 16) : (1u << 4));
+  if (rc) return rc;
+  o->write(o->context, q1, 1u | (uint32_t)addr7 << 4);
+  o->write(o->context, q1, 10u | (uint32_t)len << 4); /* read len */
+  rc = cam_cci_run_m(o, m, 1, m ? (1u << 12) : (1u << 0));
+  if (rc) return rc;
+  const uint32_t words = o->read(o->context, 0x11c + 0x100u * m); /* READ_BUF_LEVEL */
+  if (words != len / 4 + 1) return CamCciLength;
+  unsigned index = 0;
+  int first = 1;
+  for (uint32_t w = 0; w < words; ++w) {
+    const uint32_t v = o->read(o->context, 0x118 + 0x100u * m); /* READ_DATA: the first byte echoes the slave id */
+    for (unsigned b = 0; b < 4 && index < len; ++b) {
+      if (first) { first = 0; continue; }
+      buf[index++] = (uint8_t)(v >> (8 * b));
+    }
+  }
+  return CamCciOk;
+}
+
+/* One chip-id profile to try. The part number and slave address of thor's front camera are in no local source
+ * (the DT node has no reg property, the vendor CamX module is not on this Mac, MiCode publishes no thor kernel),
+ * so an ordered, bounded list is tried and the line says which one answered. */
+typedef struct { uint8_t addr7; uint16_t reg; uint8_t len; const char *family; } CamIdAttempt;
+enum { CamIdAttemptCount = 8 };
+static const CamIdAttempt kCamIdAttempts[CamIdAttemptCount] = {
+  {0x10, 0x0016, 2, "sony"},        /* IMX596-style write address 0x20: zizhan's front camera answered here */
+  {0x1a, 0x0016, 2, "sony"},        /* IMX586/663/766/989-style write address 0x34 */
+  {0x37, 0x0016, 2, "sony"},        /* third Sony address of the zizhan front list */
+  {0x36, 0x300a, 3, "omnivision"},  /* OV13B10-style write address 0x6c: model id at 0x300a */
+  {0x10, 0x300a, 3, "omnivision"},
+  {0x20, 0x300a, 3, "omnivision"},
+  {0x2a, 0x0000, 2, "samsung"},     /* S5K write address 0x54: chip id at 0x0000 */
+  {0x5a, 0x0000, 2, "samsung"},
+};
+
+typedef struct { const CamIdAttempt *attempt; uint8_t id[3]; int rc; } CamIdResult;
+typedef struct {
+  void *context;
+  /* Called once per attempt with its result (CamCciOk = the device answered). */
+  void (*attempt)(void *context, unsigned index, const CamIdAttempt *a, int rc, const uint8_t *id);
+} CamIdReport;
+
+/* What counts as an answer: not all zeros or ones, and for a Sony model id the high byte below 0x10. */
+static inline int cam_id_plausible(const CamIdAttempt *a, const uint8_t *id) {
+  unsigned any = 0, ones = 0xff;
+  for (unsigned i = 0; i < a->len; ++i) { any |= id[i]; ones &= id[i]; }
+  if (!any || ones == 0xff) return 0;
+  return a->reg != 0x0016 || (id[0] & 0xf0) == 0;
+}
+
+/* Resets master m, then tries each attempt once. A NACK leaves the queue halted, so the controller is reset
+ * before the next address; a reset that is not acknowledged ends the search. Never loops: at most one read per
+ * table entry, each bounded by the poll count. */
+static inline int cam_cci_identify(const CamCciOps *o, unsigned master, const CamIdAttempt *attempts, unsigned count,
+                                   const CamIdReport *report, CamIdResult *out) {
+  memset(out, 0, sizeof *out);
+  out->attempt = attempts && count ? attempts + count : 0;
+  if (!cam_cci_usable(o, master) || !attempts || !count) return CamCciArgument;
+  int init = cam_cci_reset_init_m(o, master);
+  for (unsigned i = 0; i < count; ++i) {
+    const CamIdAttempt *a = &attempts[i];
+    uint8_t id[3] = {0, 0, 0};
+    if (init) { /* the controller does not acknowledge its reset: stop here */
+      if (report && report->attempt) report->attempt(report->context, i, a, init, id);
+      out->rc = init;
+      break;
+    }
+    const int rc = cam_cci_read16_m(o, master, a->addr7, a->reg, id, a->len);
+    if (report && report->attempt) report->attempt(report->context, i, a, rc, id);
+    if (!rc && cam_id_plausible(a, id)) {
+      out->attempt = a;
+      out->rc = CamCciOk;
+      for (unsigned b = 0; b < 3; ++b) out->id[b] = b < a->len ? id[b] : 0;
+      return CamCciOk;
+    }
+    out->rc = rc;
+    init = cam_cci_reset_init_m(o, master); /* a NACK halts the queue: reset before the next address */
+  }
+  return out->rc;
+}
+
+#endif
diff --git a/PongCamInventory.h b/PongCamInventory.h
new file mode 100644
index 0000000000000000000000000000000000000000..ebb561fb9a0c5b767950751970f9768b333ce013
--- /dev/null
+++ b/PongCamInventory.h
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* THOR CAMERA V247: read-only inventory of the camera clock, power, pin and CCI state (pure logic, host tested
+ * in hosttest/). It reads through a table that has no write entry at all, so level 1 cannot write anything by
+ * construction; the kernel maps its windows read-only as well. Two hardware gates are built in: CAM_CC
+ * (0xade0000) is only read while GCC_CAMERA_AHB_CLK runs, and the CCI, CSID and IFE blocks (they sit in
+ * titan_top) are only read while the titan_top GDSC is powered and both of its AHB branches run. A read past
+ * either gate can fault the bus, so at a normal boot the titan blocks are reported as not read. */
+#ifndef PONG_CAM_INVENTORY_H
+#define PONG_CAM_INVENTORY_H
+#include <string.h>
+#include "PongCamBoard.h"
+
+enum { CamWinGcc = 0, CamWinCamcc, CamWinTlmm, CamWinCci0, CamWinCci1, CamWinCsid0, CamWinCsidLite0, CamWinIfeLite0, CamWinSpmi, CamWinCount };
+
+typedef struct { void *context; uint32_t (*read)(void *context, unsigned window, uint32_t offset); } CamReadIo;
+
+static const uint32_t kCamGdscOffsets[CamGdscCount] = {
+  CamCcBpsGdsc, CamCcIfe0Gdsc, CamCcIfe1Gdsc, CamCcIfe2Gdsc, CamCcIpe0Gdsc, CamCcSbiGdsc, CamCcSfe0Gdsc, CamCcSfe1Gdsc, CamCcTitanGdsc,
+};
+enum { CamGdscTitan = 8 };
+static const unsigned kCamPins[CamPinCount] = {CamPinMclk, CamPinReset, CamPinScl, CamPinSda};
+
+typedef struct {
+  uint32_t gcc_ahb, gcc_xo, gcc_bcr; /* GCC_CAMERA_AHB_CLK and GCC_CAMERA_XO_CLK branches, GCC_CAMERA_BCR */
+  uint32_t pin_cfg[CamPinCount], pin_io[CamPinCount]; /* GPIO104, 108, 208, 209 */
+  unsigned camcc_read; /* 0: the camera AHB clock is off and CAM_CC was not touched */
+  uint32_t gdscr[CamGdscCount]; /* bps, ife0..2, ipe0, sbi, sfe0, sfe1, titan_top */
+  uint32_t mclk_rcg_cmd, mclk_rcg_cfg, mclk_cbcr; /* MCLK4 */
+  uint32_t cci_rcg_cmd, cci_rcg_cfg, cci_cbcr; /* CCI1 */
+  uint32_t slow_rcg_cmd, slow_rcg_cfg, fast_rcg_cmd, fast_rcg_cfg, camnoc_rcg_cmd, camnoc_rcg_cfg;
+  uint32_t cpas_cbcr, camnoc_cbcr, core_cbcr;
+  unsigned titan_read; /* 0: titan_top is off or its AHB branches are stopped and the blocks were not touched */
+  uint32_t cci0_version, cci1_version, csid0_version, csid_lite0_version, ife_lite0_version; /* register 0 */
+} CamInventory;
+
+static inline uint32_t cam_read(const CamReadIo *io, unsigned window, uint32_t offset) {
+  return io && io->read ? io->read(io->context, window, offset) : 0;
+}
+
+static inline void cam_inventory(const CamReadIo *io, CamInventory *out) {
+  memset(out, 0, sizeof *out);
+  if (!io || !io->read) return;
+  out->gcc_ahb = cam_read(io, CamWinGcc, CAM_GCC_CAMERA_AHB_CBCR);
+  out->gcc_xo = cam_read(io, CamWinGcc, CAM_GCC_CAMERA_XO_CBCR);
+  out->gcc_bcr = cam_read(io, CamWinGcc, CAM_GCC_CAMERA_BCR);
+  for (unsigned i = 0; i < CamPinCount; ++i) {
+    out->pin_cfg[i] = cam_read(io, CamWinTlmm, kCamPins[i] * 0x1000u);
+    out->pin_io[i] = cam_read(io, CamWinTlmm, kCamPins[i] * 0x1000u + 4);
+  }
+  if (out->gcc_ahb & CAM_CLK_OFF) return;
+  out->camcc_read = 1;
+  for (unsigned i = 0; i < CamGdscCount; ++i) out->gdscr[i] = cam_read(io, CamWinCamcc, kCamGdscOffsets[i]);
+  out->mclk_rcg_cmd = cam_read(io, CamWinCamcc, CamMclkRcg);
+  out->mclk_rcg_cfg = cam_read(io, CamWinCamcc, CamMclkRcg + 4);
+  out->mclk_cbcr = cam_read(io, CamWinCamcc, CamMclkCbcr);
+  out->cci_rcg_cmd = cam_read(io, CamWinCamcc, CamCcCci1Rcg);
+  out->cci_rcg_cfg = cam_read(io, CamWinCamcc, CamCcCci1Rcg + 4);
+  out->cci_cbcr = cam_read(io, CamWinCamcc, CamCcCci1Cbcr);
+  out->slow_rcg_cmd = cam_read(io, CamWinCamcc, CamCcSlowAhbRcg);
+  out->slow_rcg_cfg = cam_read(io, CamWinCamcc, CamCcSlowAhbRcg + 4);
+  out->fast_rcg_cmd = cam_read(io, CamWinCamcc, CamCcFastAhbRcg);
+  out->fast_rcg_cfg = cam_read(io, CamWinCamcc, CamCcFastAhbRcg + 4);
+  out->camnoc_rcg_cmd = cam_read(io, CamWinCamcc, CamCcCamnocRcg);
+  out->camnoc_rcg_cfg = cam_read(io, CamWinCamcc, CamCcCamnocRcg + 4);
+  out->cpas_cbcr = cam_read(io, CamWinCamcc, CamCcCpasAhbCbcr);
+  out->camnoc_cbcr = cam_read(io, CamWinCamcc, CamCcCamnocCbcr);
+  out->core_cbcr = cam_read(io, CamWinCamcc, CamCcCoreAhbCbcr);
+  if (!(out->gdscr[CamGdscTitan] & CAM_GDSC_PWR_ON) || (out->cpas_cbcr & CAM_CLK_OFF) || (out->core_cbcr & CAM_CLK_OFF)) return;
+  out->titan_read = 1;
+  out->cci0_version = cam_read(io, CamWinCci0, 0);
+  out->cci1_version = cam_read(io, CamWinCci1, 0);
+  out->csid0_version = cam_read(io, CamWinCsid0, 0);
+  out->csid_lite0_version = cam_read(io, CamWinCsidLite0, 0);
+  out->ife_lite0_version = cam_read(io, CamWinIfeLite0, 0);
+}
+
+/* SPMI arbiter v7: the mapping word at core + 0x2000 + 4*i of channel i carries its PPID in bits 19:8 (the
+ * table the Wi-Fi driver reads); core + 4 holds the channel count in bits 10:0. -1 when no channel is mapped. */
+static inline unsigned cam_spmi_channels(const CamReadIo *io) { return cam_read(io, CamWinSpmi, 4) & 0x7ffu; }
+
+static inline int cam_spmi_channel(const CamReadIo *io, unsigned channels, unsigned ppid) {
+  for (unsigned i = 0; i < channels && i < 1024; ++i)
+    if (((cam_read(io, CamWinSpmi, 0x2000 + 4 * i) >> 8) & 0xfffu) == ppid) return (int)i;
+  return -1;
+}
+
+#endif
diff --git a/PongCamPower.h b/PongCamPower.h
new file mode 100644
index 0000000000000000000000000000000000000000..d7dffd7972515f174ab2f9e953dc888542a1010c
--- /dev/null
+++ b/PongCamPower.h
@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* THOR CAMERA V247: rail votes and the attended power sequence (pure logic, host tested in hosttest/).
+ * The front camera's rails are PM8010J LDOs behind RPMh VRM (Linux qcom-rpmh-regulator.c): MODE 7 = HPM at
+ * address + 8, VOLTAGE in millivolts at + 0, ENABLE at + 4. The kernel sends them with pong_rpmh_vote(), the
+ * same vote the Wi-Fi driver's supplies() sends for its rails. The power-up order is reset low, camera AHB
+ * clock, vio, vana, vdig, MCLK4, reset released, CCI bus; power-down is the strict reverse and always runs. */
+#ifndef PONG_CAM_POWER_H
+#define PONG_CAM_POWER_H
+#include <string.h>
+#include "PongCamBoard.h"
+#include "ThorModemCmdDb.h"
+
+/* CMD DB entry of one RPMh resource in the layout thorCmdDirectory parses: 24 bytes, the 8-byte name first,
+ * the ARC address at +16. 0 = found. */
+static inline int cam_cmd_db_find(const uint8_t *db, size_t bytes, const char *name, uint32_t *address) {
+  ThorCmdDirectory directory;
+  uint8_t key[8] = {0};
+  unsigned n = 0;
+  memset(&directory, 0, sizeof directory);
+  if (!db || !name || !address) return 1;
+  while (name[n] && n < sizeof key) { key[n] = (uint8_t)name[n]; ++n; }
+  if (name[n] || !thorCmdDirectory(db, bytes, directory)) return 1;
+  for (unsigned t = 0; t < directory.count; ++t) {
+    const ThorCmdTable table = directory.tables[t];
+    for (size_t pos = table.start; pos < table.end; pos += kThorCmdEntryBytes) {
+      const uint8_t *entry = db + pos;
+      if (memcmp(entry, key, sizeof key)) continue;
+      const uint32_t found = thorCmdLe32(entry + 16);
+      if (!found || (found & 3)) return 1;
+      *address = found;
+      return 0;
+    }
+  }
+  return 1;
+}
+
+typedef struct { void *context; int (*vote)(void *context, uint32_t address, uint32_t value); } CamRpmhOps;
+
+/* One LDO: on = mode, voltage, enable in that order; off = enable 0 only, which is what Linux sends. Returns 0,
+ * else the 1-based index of the write that failed (-1 = bad argument). Nothing is retried. */
+static inline int cam_rail_switch(const CamRpmhOps *o, uint32_t address, unsigned mv, int on) {
+  if (!o || !o->vote || !address || (address & 3) || mv < 320 || mv > 3544) return -1;
+  if (!on) return o->vote(o->context, address + CAM_VRM_ENABLE, 0) ? 0 : 1;
+  if (!o->vote(o->context, address + CAM_VRM_MODE, CAM_VRM_LDO_HPM)) return 1;
+  if (!o->vote(o->context, address + CAM_VRM_VOLTAGE, mv)) return 2;
+  return o->vote(o->context, address + CAM_VRM_ENABLE, 1) ? 0 : 3;
+}
+
+/* LDO peripheral read through the SPMI observer (the same registers as the Wi-Fi driver's railReady): TYPE 4,
+ * SUBTYPE 5, STATUS 8 (bit 7 = ready), ENABLE 0x46 (bit 7), VSET 0x40/0x41 in millivolts. */
+typedef struct { uint8_t type, subtype, status, enable; unsigned mv; } CamRailSample;
+static inline int cam_rail_settled(const CamRailSample *s, unsigned mv) {
+  return (s->status & 0x80) != 0 && (s->enable & 0x80) != 0 && s->mv == mv;
+}
+
+typedef struct {
+  void *context;
+  int (*sample)(void *context, CamRailSample *s); /* one complete observer read; 0 when it failed */
+  void (*pause_ms)(void *context);
+} CamRailWaitOps;
+
+/* Bounded: at most polls samples; 1 = the rail is enabled at exactly mv. A rail that never gets there costs
+ * polls x pause and ends as a failure. */
+static inline int cam_rail_wait(const CamRailWaitOps *o, unsigned mv, unsigned polls) {
+  CamRailSample s;
+  if (!o || !o->sample || !o->pause_ms) return 0;
+  for (unsigned i = 0; i < polls; ++i) {
+    memset(&s, 0, sizeof s);
+    if (o->sample(o->context, &s) && cam_rail_settled(&s, mv)) return 1;
+    o->pause_ms(o->context);
+  }
+  return 0;
+}
+
+typedef struct {
+  void *context;
+  int (*reset)(void *context, int release); /* GPIO108: 0 = driven low, 1 = released */
+  int (*ahb)(void *context, int on); /* GCC_CAMERA_AHB_CBCR when it was off; off does nothing unless this run enabled it */
+  int (*rail)(void *context, unsigned index, int on);
+  int (*mclk)(void *context, int on); /* CAM_CC titan GDSC, MCLK4 RCG and branch, GPIO104 */
+  int (*bus)(void *context, int on); /* CCI clocks, pads GPIO208/209 */
+  int (*identify)(void *context); /* CCI1 master 1 chip-id attempts; 0 = an address answered */
+} CamSeqOps;
+
+enum { CamStepNone = 0, CamStepResetAssert = 1, CamStepAhb, CamStepRail, CamStepMclk, CamStepResetRelease, CamStepBus };
+#define CAM_SEQ_LEFT_BUS 0x01u /* the CCI clocks or pads could not be switched off */
+#define CAM_SEQ_LEFT_RESET 0x02u
+#define CAM_SEQ_LEFT_MCLK 0x04u
+#define CAM_SEQ_LEFT_AHB 0x08u
+#define CAM_SEQ_LEFT_RAIL 0x10u /* << rail index */
+#define CAM_SEQ_MAX_RAILS 4
+
+typedef struct {
+  int failed_step; /* CamStep*: the power-up step that stopped the sequence; 0 = the CCI bus came up */
+  int failed_rc; /* what that step returned */
+  unsigned failed_rail;
+  int id_rc; /* identify(): 0 = an address answered, else its error; -1 when there is no identify step */
+  unsigned left; /* CAM_SEQ_LEFT_* of what could not be switched off again; 0 = everything is off */
+} CamSeqResult;
+
+/* Power-up as above, then identify(). Power-down is the strict reverse of the power-up order and runs whatever
+ * happened before it: every step that was attempted is switched off again, the failed one included. An off
+ * call that fails sets its bit in left; the first power-up failure is failed_step. Returns failed_step. */
+static inline int cam_sequence(const CamSeqOps *o, unsigned rails, CamSeqResult *r) {
+  memset(r, 0, sizeof *r);
+  r->id_rc = -1;
+  if (!o || !o->reset || !o->ahb || !o->rail || !o->mclk || !o->bus || !rails || rails > CAM_SEQ_MAX_RAILS) return -1;
+  unsigned attempted_rails = 0;
+  int mclk_attempted = 0, bus_attempted = 0, rc;
+  if ((rc = o->reset(o->context, 0))) { r->failed_step = CamStepResetAssert; r->failed_rc = rc; }
+  if (!r->failed_step && (rc = o->ahb(o->context, 1))) { r->failed_step = CamStepAhb; r->failed_rc = rc; }
+  if (!r->failed_step) {
+    for (unsigned i = 0; i < rails; ++i) {
+      attempted_rails |= 1u << i;
+      if ((rc = o->rail(o->context, i, 1))) { r->failed_step = CamStepRail; r->failed_rc = rc; r->failed_rail = i; break; }
+    }
+  }
+  if (!r->failed_step) { mclk_attempted = 1; if ((rc = o->mclk(o->context, 1))) { r->failed_step = CamStepMclk; r->failed_rc = rc; } }
+  if (!r->failed_step && (rc = o->reset(o->context, 1))) { r->failed_step = CamStepResetRelease; r->failed_rc = rc; }
+  if (!r->failed_step) { bus_attempted = 1; if ((rc = o->bus(o->context, 1))) { r->failed_step = CamStepBus; r->failed_rc = rc; } }
+  if (!r->failed_step) r->id_rc = o->identify ? o->identify(o->context) : -1;
+  if (bus_attempted && o->bus(o->context, 0)) r->left |= CAM_SEQ_LEFT_BUS;
+  if (o->reset(o->context, 0)) r->left |= CAM_SEQ_LEFT_RESET;
+  if (mclk_attempted && o->mclk(o->context, 0)) r->left |= CAM_SEQ_LEFT_MCLK;
+  for (unsigned i = rails; i-- > 0;)
+    if (attempted_rails & (1u << i))
+      if (o->rail(o->context, i, 0)) r->left |= CAM_SEQ_LEFT_RAIL << i;
+  if (o->ahb(o->context, 0)) r->left |= CAM_SEQ_LEFT_AHB;
+  return r->failed_step;
+}
+
+#endif
diff --git a/PongCamProbe.h b/PongCamProbe.h
new file mode 100644
index 0000000000000000000000000000000000000000..0a33b9fb87c54e45700e556ec71c9cdb9777c097
--- /dev/null
+++ b/PongCamProbe.h
@@ -0,0 +1,474 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* THOR CAMERA V247: front-camera probe, default off. Gate: /chosen thor-camera (u32), read once in start().
+ * Absent or 0 = off: nothing is mapped. 1 = read-only inventory (register reads only; every window is mapped
+ * read-only and the snapshot code has no write entry at all). 2 = ATTENDED ONLY, first power-up of the front
+ * camera (qcom,cam-sensor1): reset GPIO108 low -> PM8010J ldoj3 vio 1.8 V, ldoj5 vana 2.8 V, ldoj2 vdig 1.104 V
+ * through RPMh -> CAM_CC titan_top GDSC -> MCLK4 19.2 MHz (XO) on GPIO104 -> reset released -> CCI clocks and
+ * pads GPIO208/209 -> CCI1 master 1 chip-id attempts -> everything off in strict reverse. CSID, IFE and the SMMU
+ * are never programmed; the rear cameras are never touched. Every wait is bounded; a failed step is reported and
+ * undone. The logic is in PongCamCc.h, PongCamCci.h, PongCamPower.h and PongCamInventory.h (host tested in
+ * hosttest/); this file only maps registers and prints. The worker is started from the platform start path and
+ * waits for the root volume plus 30 s, after the Wi-Fi and modem workers that share powerLock and the RPMh TCS.
+ * Helpers used: pong_rpmh_vote (rail votes), thorCmdDirectory (CMD DB names), the Wi-Fi driver's SPMI observer
+ * read and its GPIO mode word, the zizhan probe's window and CCI steps. */
+#pragma once
+#include <IOKit/IOLib.h>
+#include <IOKit/IODeviceMemory.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IORegistryEntry.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <mach/mach_time.h>
+#include <pexpert/pexpert.h>
+#include <libkern/c++/OSData.h>
+#include <string.h>
+#include "PongCamBoard.h"
+#include "PongCamCc.h"
+#include "PongCamCci.h"
+#include "PongCamPower.h"
+#include "PongCamInventory.h"
+#include "PongPlatformResources.h"
+#include "ThorModemCmdDb.h"
+#include "../PongProbe.h"
+
+extern "C" struct vnode *rootvnode;
+
+/* Level 2 only continues when every PM8010J LDO can be read back through the SPMI observer. 0 = continue on
+ * the RPMh acknowledgements alone, as stock Android does. */
+#define CAM_REQUIRE_RAIL_READBACK 1
+
+namespace thor_cam_probe {
+
+struct Win {
+  IOMemoryMap *map = nullptr;
+  volatile uint8_t *va = nullptr;
+  bool writable = false;
+  bool open(uint64_t base, uint64_t bytes, bool write) {
+    auto memory = IODeviceMemory::withRange(base, bytes);
+    map = memory ? memory->map(kIOMapAnywhere | kIOMapInhibitCache | (write ? 0 : kIOMapReadOnly)) : nullptr;
+    if (memory) memory->release();
+    va = map ? reinterpret_cast<volatile uint8_t *>(map->getVirtualAddress()) : nullptr;
+    writable = write && va != nullptr;
+    return va != nullptr;
+  }
+  uint32_t r(uint32_t at) const {
+    const uint32_t v = *reinterpret_cast<const volatile uint32_t *>(va + at);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return v;
+  }
+  void w(uint32_t at, uint32_t v) {
+    if (!writable) return; /* a read-only window drops writes instead of faulting */
+    __asm__ volatile("dmb oshst" ::: "memory");
+    *reinterpret_cast<volatile uint32_t *>(va + at) = v;
+    __asm__ volatile("dsb sy" ::: "memory");
+  }
+  ~Win() { if (map) map->release(); }
+};
+
+static uint32_t win_read(void *c, uint32_t at) { return static_cast<Win *>(c)->r(at); }
+static void win_write(void *c, uint32_t at, uint32_t v) { static_cast<Win *>(c)->w(at, v); }
+static void pause_us(void *, unsigned us) { IODelay(us); }
+static void pause_ms(void *) { IOSleep(1); }
+static uint32_t io_read(void *c, unsigned window, uint32_t at) { return static_cast<Win **>(c)[window]->r(at); }
+static uint32_t one_read(void *c, unsigned window, uint32_t at) { (void)window; return static_cast<Win *>(c)->r(at); }
+static uint64_t now_ms() {
+  uint64_t ns = 0;
+  absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+  return ns / 1000000;
+}
+
+/* ---- level 1: read-only inventory ------------------------------------------------------------------------------- */
+
+/* Addresses of the three rails in the CMD DB (DRAM, read-only mapping copied to heap like the modem preflight). */
+static int cmd_db_rails(uint32_t *address) {
+  Win db;
+  if (!db.open(CamBaseCmdDb, kThorCmdDbBytes, false)) {
+    IOLog("THOR CAMERA V247: FAIL cmd-db map\n");
+    return -1;
+  }
+  auto *copy = static_cast<uint8_t *>(IOMallocData(kThorCmdDbBytes));
+  if (!copy) {
+    IOLog("THOR CAMERA V247: FAIL cmd-db memory\n");
+    return -1;
+  }
+  for (unsigned i = 0; i < kThorCmdDbBytes; i += 4) {
+    const uint32_t v = db.r(i);
+    memcpy(copy + i, &v, 4);
+  }
+  __asm__ volatile("dmb oshld" ::: "memory");
+  int rc = 0;
+  for (unsigned i = 0; i < CAM_RAIL_COUNT; ++i) {
+    address[i] = 0;
+    const int found = cam_cmd_db_find(copy, kThorCmdDbBytes, kCamRails[i].name, &address[i]);
+    if (found) address[i] = 0;
+    rc |= found;
+  }
+  IOFreeData(copy, kThorCmdDbBytes);
+  return rc ? -1 : 0;
+}
+
+/* Reads only: every window is mapped kIOMapReadOnly and the snapshot has no write entry. 0 = a window did not map. */
+static bool inventory(const char *when) {
+  Win gcc, camcc, tlmm, cci0, cci1, csid0, csidl0, ifel0, core;
+  const bool mapped = gcc.open(0x100000, 0xa0000, false) && camcc.open(0xade0000, 0x20000, false) &&
+                      tlmm.open(0xf100000, CAM_TLMM_WINDOW_BYTES, false) && cci0.open(0xac15000, 0x1000, false) &&
+                      cci1.open(0xac16000, 0x1000, false) && csid0.open(0xacb7000, 0x1000, false) &&
+                      csidl0.open(0xacc6000, 0x1000, false) && ifel0.open(0xacc6000, 0x1000, false) &&
+                      core.open(0xc400000, 0x3000, false);
+  if (!mapped) {
+    IOLog("THOR CAMERA V247: FAIL map (%s); nothing was read\n", when);
+    return false;
+  }
+  Win *windows[CamWinCount] = {&gcc, &camcc, &tlmm, &cci0, &cci1, &csid0, &csidl0, &ifel0, &core};
+  const CamReadIo io = {windows, io_read};
+  CamInventory in;
+  cam_inventory(&io, &in);
+  IOLog("THOR CAMERA V247: %s gcc camera_ahb=%x camera_xo=%x camera_bcr=%x (bit31 = clock off; bcr bit0 = held in reset)\n", when,
+        in.gcc_ahb, in.gcc_xo, in.gcc_bcr);
+  for (unsigned i = 0; i < CamPinCount; ++i) {
+    const uint32_t cfg = in.pin_cfg[i], iov = in.pin_io[i];
+    IOLog("THOR CAMERA V247: %s pin=%u cfg=%x func=%u oe=%u pull=%u drive=%umA egpio=%u/%u in=%u out=%u\n", when,
+          kCamPins[i], cfg, (cfg >> CAM_PIN_FUNC_SHIFT) & 15, (cfg >> 9) & 1, cfg & 3,
+          ((cfg >> CAM_PIN_DRIVE_SHIFT) & 7) * 2, (cfg >> 11) & 1, (cfg >> 12) & 1, iov & 1, (iov >> 1) & 1);
+  }
+  IOLog("THOR CAMERA V247: %s camcc read=%u (0 = camera AHB clock off, CAM_CC not touched)\n", when, in.camcc_read);
+  if (in.camcc_read) {
+    IOLog("THOR CAMERA V247: %s camcc gdscr titan=%x bps=%x ife0=%x ife1=%x ife2=%x ipe0=%x sbi=%x sfe0=%x sfe1=%x\n", when,
+          in.gdscr[8], in.gdscr[0], in.gdscr[1], in.gdscr[2], in.gdscr[3], in.gdscr[4], in.gdscr[5], in.gdscr[6], in.gdscr[7]);
+    IOLog("THOR CAMERA V247: %s camcc mclk4 rcg=%x/%x branch=%x cci1 rcg=%x/%x branch=%x slow_ahb=%x/%x fast_ahb=%x/%x camnoc=%x/%x\n",
+          when, in.mclk_rcg_cmd, in.mclk_rcg_cfg, in.mclk_cbcr, in.cci_rcg_cmd, in.cci_rcg_cfg, in.cci_cbcr,
+          in.slow_rcg_cmd, in.slow_rcg_cfg, in.fast_rcg_cmd, in.fast_rcg_cfg, in.camnoc_rcg_cmd, in.camnoc_rcg_cfg);
+    IOLog("THOR CAMERA V247: %s camcc cpas_ahb=%x camnoc_axi=%x core_ahb=%x (bit31 = off)\n", when, in.cpas_cbcr,
+          in.camnoc_cbcr, in.core_cbcr);
+    IOLog("THOR CAMERA V247: %s titan blocks read=%u (0 = titan_top off or its AHB stopped) cci0=%x cci1=%x csid0=%x csid_lite0=%x ife_lite0=%x\n",
+          when, in.titan_read, in.cci0_version, in.cci1_version, in.csid0_version, in.csid_lite0_version, in.ife_lite0_version);
+  }
+  uint32_t address[CAM_RAIL_COUNT] = {};
+  (void)cmd_db_rails(address); /* only reads; prints its own FAIL line */
+  IOLog("THOR CAMERA V247: %s cmd-db ldoj3=%x ldoj5=%x ldoj2=%x (0 = absent)\n", when, address[0], address[1], address[2]);
+  const CamReadIo spmi = {&core, one_read};
+  const unsigned channels = cam_spmi_channels(&spmi);
+  for (unsigned i = 0; i < CAM_RAIL_COUNT; ++i) {
+    const int channel = cam_spmi_channel(&spmi, channels, cam_rail_ppid(&kCamRails[i]));
+    IOLog("THOR CAMERA V247: %s spmi %s slave=%u peripheral=%x channel=%d of %u\n", when, kCamRails[i].name,
+          CAM_PM8010J_SLAVE, kCamRails[i].peripheral, channel, channels);
+  }
+  IOLog("THOR CAMERA V247: %s snapshot done camcc_read=%u writes=0\n", when, in.camcc_read);
+  return true;
+}
+
+/* ---- level 2: attended power-up ------------------------------------------------------------------------------- */
+
+struct Ctx {
+  Win gcc, camcc, cci, tlmm, core, obs, cci0, csid0, csidl0, ifel0;
+  uint32_t saved_cfg[CamPinCount] = {}, saved_io[CamPinCount] = {};
+  CamCcRcg saved_mclk{}, saved_cci[3]{};
+  CamRpmhOps rpmh{};
+  uint32_t rail_address[CAM_RAIL_COUNT] = {};
+  int rail_channel[CAM_RAIL_COUNT] = {-1, -1, -1};
+  unsigned sample_index = 0;
+  bool ahb_owned = false, after_taken = false;
+  uint32_t after[6] = {}; /* titan GDSCR, MCLK4, CCI1, CPAS AHB, CAMNOC AXI, core AHB */
+  CamIdResult id{};
+};
+enum { CtxReset = 1, CtxScl = 2 }; /* indexes into kCamPins after GPIO104 at 0 */
+
+static int rpmh_vote(void *, uint32_t address, uint32_t value) { return pong_rpmh_vote(address, value) ? 0 : 1; }
+
+/* The output level goes first, then the mode word, then the level again: no glitch when the mode changes (the
+ * Wi-Fi driver's pin()). */
+static void pin_apply(Win &tlmm, unsigned index, uint32_t cfg, unsigned out) {
+  const uint32_t at = kCamPins[index] * 0x1000u;
+  tlmm.w(at + 4, out);
+  tlmm.w(at, cfg);
+  tlmm.w(at + 4, out);
+}
+
+/* SPMI observer read of one LDO register: the Wi-Fi driver's railReady path (arbiter v7 observer at 0xc440000,
+ * 0x20 bytes per channel: command word, status at +8, data at +0x18). Bounded at 2 ms. */
+static bool spmi_read(Win &obs, unsigned channel, unsigned reg, uint8_t *out, unsigned bytes) {
+  if (!bytes || bytes > 8 || channel >= 1024) return false;
+  const uint32_t base = channel * 0x20;
+  obs.w(base, (1u << 27) | (reg << 4) | (bytes - 1));
+  const uint64_t end = now_ms() + 2;
+  uint32_t status = 0;
+  do {
+    status = obs.r(base + 8);
+  } while (!(status & 1) && now_ms() < end);
+  if ((status & 15) != 1) return false;
+  const uint32_t words[2] = {obs.r(base + 0x18), bytes > 4 ? obs.r(base + 0x1c) : 0};
+  for (unsigned i = 0; i < bytes; ++i) out[i] = (uint8_t)(words[i / 4] >> (8 * (i % 4)));
+  return true;
+}
+
+/* One complete sample of the rail Ctx::sample_index points at; 0 when any register could not be read. */
+static int rail_sample(void *ctx, CamRailSample *s) {
+  auto *c = static_cast<Ctx *>(ctx);
+  uint8_t voltage[2] = {};
+  memset(s, 0, sizeof *s);
+  const int channel = c->rail_channel[c->sample_index];
+  if (channel < 0) return 0;
+  const unsigned ch = unsigned(channel);
+  if (!spmi_read(c->obs, ch, 4, &s->type, 1) || !spmi_read(c->obs, ch, 5, &s->subtype, 1) ||
+      !spmi_read(c->obs, ch, 8, &s->status, 1) || !spmi_read(c->obs, ch, 0x46, &s->enable, 1) ||
+      !spmi_read(c->obs, ch, 0x40, voltage, 2)) return 0;
+  s->mv = unsigned(voltage[0]) | (unsigned(voltage[1]) << 8);
+  return 1;
+}
+
+static int reset_op(void *ctx, int release) {
+  auto *c = static_cast<Ctx *>(ctx);
+  pin_apply(c->tlmm, CtxReset, cam_pin_config(c->saved_cfg[CtxReset], CamFuncGpio, CamPullDown, 2) | CAM_PIN_OE,
+            release ? CAM_PIN_IO_OUT : 0);
+  if (release) IOSleep(20); /* Sony sensors want >= 8 ms after XCLR; the zizhan probe waited 10 ms before the CCI */
+  const uint32_t at = kCamPins[CtxReset] * 0x1000u;
+  IOLog("THOR CAMERA V247: reset gpio%u %s cfg=%x io=%x\n", kCamPins[CtxReset], release ? "released" : "asserted low",
+        c->tlmm.r(at), c->tlmm.r(at + 4));
+  return 0;
+}
+
+/* What the power-down left in CAM_CC: titan GDSCR, MCLK4, CCI1, CPAS AHB, CAMNOC AXI, core AHB. */
+static void take_after(Ctx &c) {
+  const uint32_t offsets[6] = {CamCcTitanGdsc, CamMclkCbcr, CamCcCci1Cbcr, CamCcCpasAhbCbcr, CamCcCamnocCbcr, CamCcCoreAhbCbcr};
+  for (unsigned i = 0; i < 6; ++i) c.after[i] = c.camcc.r(offsets[i]);
+  c.after_taken = true;
+}
+
+static int ahb_op(void *ctx, int on) {
+  auto *c = static_cast<Ctx *>(ctx);
+  if (!on) {
+    if (c->ahb_owned && !c->after_taken) take_after(*c); /* read CAM_CC while its clock still runs */
+    if (c->ahb_owned) {
+      c->gcc.w(CAM_GCC_CAMERA_AHB_CBCR, c->gcc.r(CAM_GCC_CAMERA_AHB_CBCR) & ~1u);
+      c->ahb_owned = false;
+    }
+    IOLog("THOR CAMERA V247: gcc camera ahb off reg=%x owned=0\n", c->gcc.r(CAM_GCC_CAMERA_AHB_CBCR));
+    return 0;
+  }
+  const uint32_t before = c->gcc.r(CAM_GCC_CAMERA_AHB_CBCR);
+  if (!(before & CAM_CLK_OFF)) {
+    IOLog("THOR CAMERA V247: gcc camera ahb already running reg=%x owned=0\n", before);
+    return 0;
+  }
+  c->gcc.w(CAM_GCC_CAMERA_AHB_CBCR, before | 1u);
+  for (unsigned i = 0; i < 1000 && (c->gcc.r(CAM_GCC_CAMERA_AHB_CBCR) & CAM_CLK_OFF); ++i) IODelay(10);
+  c->ahb_owned = !(c->gcc.r(CAM_GCC_CAMERA_AHB_CBCR) & CAM_CLK_OFF);
+  IOLog("THOR CAMERA V247: gcc camera ahb was=%x now=%x owned=%u\n", before, c->gcc.r(CAM_GCC_CAMERA_AHB_CBCR),
+        unsigned(c->ahb_owned));
+  if (c->ahb_owned) return 0;
+  c->gcc.w(CAM_GCC_CAMERA_AHB_CBCR, c->gcc.r(CAM_GCC_CAMERA_AHB_CBCR) & ~1u);
+  return 1;
+}
+
+static int rail_op(void *ctx, unsigned index, int on) {
+  auto *c = static_cast<Ctx *>(ctx);
+  const CamRail &rail = kCamRails[index];
+  const int rc = cam_rail_switch(&c->rpmh, c->rail_address[index], rail.mv, on);
+  if (!on) {
+    IOLog("THOR CAMERA V247: rail off %s addr=%x rc=%d\n", rail.name, c->rail_address[index], rc);
+    return rc ? 1 : 0;
+  }
+  CamRailSample s{};
+  c->sample_index = index;
+  const CamRailWaitOps wait = {c, rail_sample, pause_ms};
+  const int settled = rc ? 0 : cam_rail_wait(&wait, rail.mv, 100);
+  (void)rail_sample(c, &s);
+  IOLog("THOR CAMERA V247: rail %s %umV addr=%x channel=%d rpmh_rc=%d type=%x/%x status=%x enable=%x mv=%u settled=%u\n",
+        rail.name, rail.mv, c->rail_address[index], c->rail_channel[index], rc, s.type, s.subtype, s.status, s.enable,
+        s.mv, unsigned(settled));
+  return settled ? 0 : (rc ? rc : 2);
+}
+
+static int mclk_op(void *ctx, int on) {
+  auto *c = static_cast<Ctx *>(ctx);
+  const CamCcOps cc = {&c->camcc, win_read, win_write, pause_us, 1000};
+  if (on) {
+    cam_cc_rcg_save(&cc, CamMclkRcg, &c->saved_mclk);
+    unsigned stage = 0;
+    const int rc = cam_cc_mclk_on(&cc, CamMclkRcg, CamMclkCbcr, &stage);
+    IOLog("THOR CAMERA V247: mclk rc=%d stage=%u gdscr=%x rcg=%x/%x branch=%x\n", rc, stage, c->camcc.r(CamCcTitanGdsc),
+          c->camcc.r(CamMclkRcg), c->camcc.r(CamMclkRcg + 4), c->camcc.r(CamMclkCbcr));
+    if (rc) return (int)(100 + stage); /* cam_cc_mclk_on has already undone its steps; the RCG words go back in the off call */
+    pin_apply(c->tlmm, 0, cam_pin_config(c->saved_cfg[0], CamFuncCamMclk, CamPullNone, 4), c->saved_io[0]);
+    IOSleep(1);
+    IOLog("THOR CAMERA V247: mclk pin gpio%u cfg=%x\n", kCamPins[0], c->tlmm.r(kCamPins[0] * 0x1000u));
+    return 0;
+  }
+  pin_apply(c->tlmm, 0, c->saved_cfg[0], c->saved_io[0]);
+  const int rc = cam_cc_mclk_off(&cc, CamMclkRcg, CamMclkCbcr, &c->saved_mclk);
+  IOLog("THOR CAMERA V247: mclk off rc=%d branch=%x rcg=%x/%x gdscr=%x\n", rc, c->camcc.r(CamMclkCbcr),
+        c->camcc.r(CamMclkRcg), c->camcc.r(CamMclkRcg + 4), c->camcc.r(CamCcTitanGdsc));
+  return rc ? 1 : 0;
+}
+
+static const uint32_t kCciRcgs[3] = {CamCcSlowAhbRcg, CamCcCamnocRcg, CamCcCci1Rcg};
+
+static int bus_op(void *ctx, int on) {
+  auto *c = static_cast<Ctx *>(ctx);
+  const CamCcOps cc = {&c->camcc, win_read, win_write, pause_us, 1000};
+  if (on) {
+    for (unsigned i = 0; i < 3; ++i) cam_cc_rcg_save(&cc, kCciRcgs[i], &c->saved_cci[i]);
+    const int step = cam_cc_cci_on(&cc, CamCcCci1Rcg, CamCcCci1Cbcr);
+    if (step) {
+      const int undone = cam_cc_cci_off(&cc, CamCcCci1Rcg, CamCcCci1Cbcr, c->saved_cci);
+      IOLog("THOR CAMERA V247: FAIL cci clocks step=%d undone=%d gdscr=%x\n", step, undone, c->camcc.r(CamCcTitanGdsc));
+      return step;
+    }
+    /* cci3_active: function cci_i2c, 4 mA, pull-up, and the eGPIO pair claimed for APPS (qcom,apps). */
+    for (unsigned i = CtxScl; i < CamPinCount; ++i)
+      pin_apply(c->tlmm, i, cam_pin_claim_egpio(cam_pin_config(c->saved_cfg[i], CamFuncCciI2c, CamPullUp, 4)), c->saved_io[i]);
+    IOLog("THOR CAMERA V247: cci clocks on gdscr=%x cci1 rcg=%x/%x branch=%x core_ahb=%x cpas_ahb=%x camnoc=%x\n",
+          c->camcc.r(CamCcTitanGdsc), c->camcc.r(CamCcCci1Rcg), c->camcc.r(CamCcCci1Rcg + 4), c->camcc.r(CamCcCci1Cbcr),
+          c->camcc.r(CamCcCoreAhbCbcr), c->camcc.r(CamCcCpasAhbCbcr), c->camcc.r(CamCcCamnocCbcr));
+    IOLog("THOR CAMERA V247: cci pads gpio%u=%x gpio%u=%x\n", kCamPins[2], c->tlmm.r(kCamPins[2] * 0x1000u),
+          kCamPins[3], c->tlmm.r(kCamPins[3] * 0x1000u));
+    return 0;
+  }
+  for (unsigned i = CtxScl; i < CamPinCount; ++i) pin_apply(c->tlmm, i, c->saved_cfg[i], c->saved_io[i]);
+  const int step = cam_cc_cci_off(&cc, CamCcCci1Rcg, CamCcCci1Cbcr, c->saved_cci);
+  IOLog("THOR CAMERA V247: cci clocks off step=%d cci1=%x cpas_ahb=%x camnoc=%x core_ahb=%x slow_ahb=%x/%x camnoc_rcg=%x/%x\n",
+        step, c->camcc.r(CamCcCci1Cbcr), c->camcc.r(CamCcCpasAhbCbcr), c->camcc.r(CamCcCamnocCbcr),
+        c->camcc.r(CamCcCoreAhbCbcr), c->camcc.r(CamCcSlowAhbRcg), c->camcc.r(CamCcSlowAhbRcg + 4),
+        c->camcc.r(CamCcCamnocRcg), c->camcc.r(CamCcCamnocRcg + 4));
+  return step ? 1 : 0;
+}
+
+static void id_attempt(void *, unsigned index, const CamIdAttempt *a, int rc, const uint8_t *id) {
+  IOLog("THOR CAMERA V247: cci m1 try=%u %s addr=%02x reg=%04x rc=%d id=%02x%02x%02x\n", index, a->family, a->addr7,
+        a->reg, rc, id[0], id[1], id[2]);
+}
+
+/* Titan is powered and its AHB branches run here, so the hardware version words can be read safely. */
+static int identify_op(void *ctx) {
+  auto *c = static_cast<Ctx *>(ctx);
+  IOLog("THOR CAMERA V247: titan hw cci1=%x cci0=%x csid0=%x csid_lite0=%x ife_lite0=%x (reads only)\n", c->cci.r(0),
+        c->cci0.r(0), c->csid0.r(0), c->csidl0.r(0), c->ifel0.r(0));
+  const CamCciOps co = {&c->cci, win_read, win_write, pause_us, 2000};
+  const CamIdReport report = {c, id_attempt};
+  const int rc = cam_cci_identify(&co, 1, kCamIdAttempts, CamIdAttemptCount, &report, &c->id);
+  if (!rc)
+    IOLog("THOR CAMERA V247: ID ANSWERED %s addr=%02x reg=%04x id=%02x%02x%02x\n", c->id.attempt->family,
+          c->id.attempt->addr7, c->id.attempt->reg, c->id.id[0], c->id.id[1], c->id.id[2]);
+  else
+    IOLog("THOR CAMERA V247: ID no answer tries=%u rc=%d\n", CamIdAttemptCount, rc);
+  return rc;
+}
+
+static void attended() {
+  IOLog("THOR CAMERA V247: ATTENDED front camera: reset gpio108 low; vio ldoj3 1800 mV, vana ldoj5 2800 mV, vdig ldoj2 1104 mV (RPMh); MCLK4 19.2 MHz on gpio104; reset released; CCI1 master 1 on gpio208/209\n");
+  inventory("before");
+  PongProbeRecord(8, "thor-camera", PongProbeRunning, "level 2, attended power-up of the front camera", 2);
+  Ctx c;
+  if (!c.gcc.open(0x100000, 0xa0000, true) || !c.camcc.open(0xade0000, 0x20000, true) || !c.cci.open(0xac16000, 0x1000, true) ||
+      !c.tlmm.open(0xf100000, CAM_TLMM_WINDOW_BYTES, true) || !c.core.open(0xc400000, 0x3000, false) ||
+      !c.obs.open(0xc440000, 0x80000, true) || !c.cci0.open(0xac15000, 0x1000, false) ||
+      !c.csid0.open(0xacb7000, 0x1000, false) || !c.csidl0.open(0xacc6000, 0x1000, false) ||
+      !c.ifel0.open(0xacc6000, 0x1000, false)) {
+    IOLog("THOR CAMERA V247: FAIL map (attended); nothing was switched on\n");
+    PongProbeRecord(8, "thor-camera", PongProbeSkip, "map failed before anything was switched on", 0);
+    return;
+  }
+  c.rpmh = CamRpmhOps{&c, rpmh_vote};
+  for (unsigned i = 0; i < CamPinCount; ++i) {
+    c.saved_cfg[i] = c.tlmm.r(kCamPins[i] * 0x1000u);
+    c.saved_io[i] = c.tlmm.r(kCamPins[i] * 0x1000u + 4);
+  }
+  if (cmd_db_rails(c.rail_address)) {
+    IOLog("THOR CAMERA V247: SKIP cmd-db lacks ldoj3/ldoj5/ldoj2; nothing was switched on\n");
+    PongProbeRecord(8, "thor-camera", PongProbeSkip, "CMD DB has no ldoj3, ldoj5 or ldoj2", 0);
+    return;
+  }
+  IOLog("THOR CAMERA V247: cmd-db ldoj3=%x ldoj5=%x ldoj2=%x\n", c.rail_address[0], c.rail_address[1], c.rail_address[2]);
+  /* Pre-flight, with everything still off: the observer channel of each rail and its present state. */
+  const CamReadIo spmi = {&c.core, one_read};
+  const unsigned channels = cam_spmi_channels(&spmi);
+  unsigned missing = 0;
+  for (unsigned i = 0; i < CAM_RAIL_COUNT; ++i) {
+    c.rail_channel[i] = cam_spmi_channel(&spmi, channels, cam_rail_ppid(&kCamRails[i]));
+    c.sample_index = i;
+    CamRailSample s{};
+    const int got = c.rail_channel[i] >= 0 && rail_sample(&c, &s);
+    IOLog("THOR CAMERA V247: spmi %s slave=%u peripheral=%x channel=%d of %u read=%d type=%x/%x status=%x enable=%x mv=%u\n",
+          kCamRails[i].name, CAM_PM8010J_SLAVE, kCamRails[i].peripheral, c.rail_channel[i], channels, got, s.type, s.subtype,
+          s.status, s.enable, s.mv);
+    if (c.rail_channel[i] < 0) missing |= 1u << i;
+  }
+  if (missing && CAM_REQUIRE_RAIL_READBACK) {
+    IOLog("THOR CAMERA V247: SKIP no SPMI observer channel for PM8010J LDOs mask=%x; nothing was switched on\n", missing);
+    PongProbeRecord(8, "thor-camera", PongProbeSkip, "no SPMI observer channel for the rails", missing);
+    return;
+  }
+  const CamSeqOps ops = {&c, reset_op, ahb_op, rail_op, mclk_op, bus_op, identify_op};
+  CamSeqResult r;
+  const int failed = cam_sequence(&ops, CAM_RAIL_COUNT, &r);
+  pin_apply(c.tlmm, CtxReset, c.saved_cfg[CtxReset], c.saved_io[CtxReset]); /* the reset pin goes back to its boot state */
+  if (!c.after_taken) take_after(c);
+  unsigned pins_restored = 0;
+  for (unsigned i = 0; i < CamPinCount; ++i)
+    pins_restored += c.tlmm.r(kCamPins[i] * 0x1000u) == c.saved_cfg[i] && c.tlmm.r(kCamPins[i] * 0x1000u + 4) == c.saved_io[i];
+  const uint32_t off = c.after[1] & c.after[2] & c.after[3] & c.after[4] & c.after[5]; /* every branch CLK_OFF */
+  const int clocks_off = !(c.after[0] & CAM_GDSC_PWR_ON) && (off & CAM_CLK_OFF) != 0;
+  unsigned rails_off = 0;
+  for (unsigned i = 0; i < CAM_RAIL_COUNT; ++i) {
+    c.sample_index = i;
+    CamRailSample s{};
+    const int got = rail_sample(&c, &s); /* a rail that cannot be read is not counted as off */
+    if (got && !(s.enable & 0x80)) ++rails_off;
+    IOLog("THOR CAMERA V247: after rail %s read=%d status=%x enable=%x mv=%u\n", kCamRails[i].name, got, s.status, s.enable, s.mv);
+  }
+  IOLog("THOR CAMERA V247: after camcc titan_gdscr=%x mclk4=%x cci1=%x cpas_ahb=%x camnoc=%x core_ahb=%x gcc_camera_ahb=%x\n",
+        c.after[0], c.after[1], c.after[2], c.after[3], c.after[4], c.after[5], c.gcc.r(CAM_GCC_CAMERA_AHB_CBCR));
+  IOLog("THOR CAMERA V247: power-down failed_step=%d rail=%u id=%d left=%x\n", r.failed_step, r.failed_rail, r.id_rc, r.left);
+  const int ok = !failed && !r.id_rc && !r.left && pins_restored == CamPinCount && clocks_off && rails_off == CAM_RAIL_COUNT;
+  IOLog("THOR CAMERA V247: DONE attended id_rc=%d failed_step=%d left=%x rails_off=%u clocks_off=%d pins_restored=%u\n",
+        r.id_rc, failed, r.left, rails_off, clocks_off, pins_restored);
+  PongProbeRecord(8, "thor-camera", ok ? PongProbePass : PongProbeFail,
+                  ok ? "front camera answered; rails, clocks and GDSC off again" : "see the THOR CAMERA V247 lines",
+                  (uint64_t)r.left << 32 | (uint64_t)(unsigned)failed << 16 | (unsigned)(r.id_rc == 0));
+}
+
+static uint32_t probe_mode;
+
+static void worker(void *, wait_result_t) {
+  for (unsigned i = 0; i < 1200 && !__atomic_load_n(&rootvnode, __ATOMIC_ACQUIRE); ++i) IOSleep(100);
+  IOSleep(30000); /* after the Wi-Fi bring-up and the modem probes, which share powerLock and the RPMh TCS */
+  if (probe_mode == 1) {
+    const bool read = inventory("inventory");
+    PongProbeRecord(8, "thor-camera", read ? PongProbePass : PongProbeFail, read ? "read-only inventory, no write" : "a window did not map", 0);
+  } else {
+    attended();
+  }
+  thread_terminate(current_thread());
+  thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* Reads /chosen thor-camera once (the same lookup the Wi-Fi and BT gates use). Absent or 0: off, nothing is
+ * mapped and no thread is started. Without a device tree plane yet it returns and a later call reads the gate. */
+static void start() {
+  static uint32_t started;
+  if (__atomic_load_n(&started, __ATOMIC_ACQUIRE)) return;
+  IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+  if (!chosen) return;
+  auto data = OSDynamicCast(OSData, chosen->getProperty("thor-camera"));
+  uint32_t value = 0;
+  if (data && data->getLength() == sizeof value) memcpy(&value, data->getBytesNoCopy(), sizeof value);
+  chosen->release();
+  if (__atomic_exchange_n(&started, 1u, __ATOMIC_ACQ_REL)) return; /* one reader per boot */
+  if (!value) return;
+  if (value > 2) {
+    IOLog("THOR CAMERA V247: SKIP unsupported-mode=%u\n", value);
+    PongProbeRecord(8, "thor-camera", PongProbeSkip, "unsupported thor-camera value", value);
+    return;
+  }
+  probe_mode = value;
+  thread_t thread = THREAD_NULL;
+  if (kernel_thread_start(worker, nullptr, &thread) != KERN_SUCCESS) {
+    IOLog("THOR CAMERA V247: FAIL worker-start mode=%u\n", value);
+    PongProbeRecord(8, "thor-camera", PongProbeFail, "worker thread not started", value);
+    return;
+  }
+  thread_deallocate(thread);
+  IOLog("THOR CAMERA V247: RUNNING mode=%u readonly=%u\n", value, unsigned(value == 1));
+}
