+// The Adreno interconnect clock votes share one physical register with PCIe.
+// The Adreno clock core supplies a full sampled word; merge only its own
+// two bits here, from a fresh read while excluding the PCIe lease.
+extern "C" bool pong_thor_gpu_gcc_vote(volatile uint32_t *reg)
+{
+    constexpr uint32_t mask = (1U << 15) | (1U << 16);
+    initLock(&powerLock);
+    if (!powerLock || !reg) return false;
+    IOLockLock(powerLock);
+    const uint32_t before = *reg;
+    bool ok = false;
+    if (before != UINT32_MAX) {
+        if ((before & mask) != mask) {
+            *reg = before | mask;
+            __asm__ volatile("dsb sy" ::: "memory");
+        }
+        const uint32_t active = *reg;
+        ok = active != UINT32_MAX && (active & mask) == mask;
+    }
+    IOLockUnlock(powerLock);
+    return ok;
+}
