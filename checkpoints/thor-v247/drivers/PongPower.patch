+    uint64_t value;
+};
+
+/* Only one value argument is needed. Keep the Qualcomm A6 resume token
+ * across an interrupted call and report other transport results directly. */
+ThorPas4ScmResult thorPas4ScmQuery(uint32_t function, uint32_t argument)
+{
+    const uint64_t began = now();
+    uint64_t next = function, session = 0;
+    for (unsigned resumes = 0; ; ++resumes) {
+        register uint64_t x0 __asm__("x0") = next;
+        register uint64_t x1 __asm__("x1") = qcom_scm_args(1, QCOM_SCM_VAL, 0, 0);
+        register uint64_t x2 __asm__("x2") = argument, x3 __asm__("x3") = 0;
+        register uint64_t x4 __asm__("x4") = 0, x5 __asm__("x5") = 0;
+        register uint64_t x6 __asm__("x6") = session, x7 __asm__("x7") = 0;
+        __asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3),
+            "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+            :: "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+        if (x0 != QCOM_SCM_INTERRUPTED || resumes == 9999 || now() - began >= 1000) {
+            return {static_cast<int64_t>(x0), x1};
+        }
+        next = QCOM_SCM_INTERRUPTED;
+        session = x6;
+    }
+}
+
+bool thorPasQueryTrue(ThorPas4ScmResult result)
+{
+    return result.status == 0 && result.value != 0;
+}
+
+bool thorPasQueryPending(ThorPas4ScmResult result)
+{
+    return result.status == QCOM_SCM_INTERRUPTED ||
+        result.status == QCOM_SCM_WAITQ_SLEEP || result.status == QCOM_SCM_WAITQ_WAKE;
+}
+
+const char *thorPasQueryState(ThorPas4ScmResult result, const char *yes, const char *no)
+{
+    switch (result.status) {
+    case QCOM_SCM_INTERRUPTED: return "resume-budget-exhausted";
+    case QCOM_SCM_WAITQ_SLEEP:
+    case QCOM_SCM_WAITQ_WAKE: return "waitq-owner-missing";
+    case QCOM_SCM_V2_EBUSY: return "busy";
+    case 0: return result.value ? yes : no;
+    default: return "transport-error";
+    }
+}
