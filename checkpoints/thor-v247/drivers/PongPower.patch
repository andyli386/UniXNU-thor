+static void thorReadMssWords(IOMemoryMap *map, int &host, uint32_t &stop, int &remote, uint32_t &word)
+{
+    QcomSmem smem{reinterpret_cast<volatile uint8_t *>(map->getVirtualAddress()),
+                  static_cast<uint32_t>(map->getLength())};
+    remote = qcom_smem_mss_inbound(&smem, &word);
+    host = qcom_smem_mss_host_stop(&smem, &stop);
+}
+
+static const char *thorReadMss(int &host, uint32_t &stop, int &remote, uint32_t &ready)
+{
+    auto map = thorMapMss();
+    if (!map) return "map-failed";
+    uint32_t word = 0;
+    thorReadMssWords(map, host, stop, remote, word);
+    ready = !!(word & QcomMssReady);
+    map->release();
+    return nullptr;
+}
