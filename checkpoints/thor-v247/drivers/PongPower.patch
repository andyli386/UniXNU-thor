+static int find_mss_cached(const QcomSmem *smem, const QcomSmemPartition *part,
+    uint32_t cached, uint16_t item, uint32_t *offset, uint32_t *length)
+{
+    const uint32_t header = align_up(ENTRY, part->cacheline);
+    uint32_t high = part->size;
