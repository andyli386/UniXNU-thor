+/* Revalidate the AP/MSS partition under hardware mutex 3. Ring the stock
+ * (MSS, SMP2P) send doorbell only for a newly published and verified item. */
+void thorPublishMssStop()
+{
+    auto *smemMap = thorMapModemRange(0x80900000, 0x200000);
+    auto *lockMap = smemMap ? thorMapModemRange(0x1f43000, 0x1000) : nullptr;
+    auto *ipccMap = lockMap ? thorMapModemRange(0x0ed18000, 0x1000) : nullptr;
+    const char *state = "map-failed";
+    int status = kIOReturnNotReady;
+    uint32_t stop = UINT32_MAX;
+    if (ipccMap) {
+        QcomSmem smem{reinterpret_cast<volatile uint8_t *>(smemMap->getVirtualAddress()), 0x200000};
+        auto *mutex = reinterpret_cast<volatile uint32_t *>(lockMap->getVirtualAddress());
+        state = "mutex-unavailable";
+        if (pong_smem_lock(mutex)) {
+            status = qcom_smem_mss_publish_stop(&smem);
+            state = status == QcomSmemExists ? "existing" : "allocation-refused";
+            if (status == QcomSmemOk) {
+                status = qcom_smem_mss_host_stop(&smem, &stop);
+                state = "readback-failed";
+                if (status == QcomSmemOk && stop == 0) {
+                    auto *send = reinterpret_cast<volatile uint32_t *>(ipccMap->getVirtualAddress() + QCOM_IPCC_SEND);
+                    __asm__ volatile("dsb oshst" ::: "memory");
+                    *send = qcom_ipcc_id(2, QCOM_IPCC_SIGNAL_SMP2P);
+                    __asm__ volatile("dsb oshst" ::: "memory");
+                    state = "published-and-notified";
+                    uint32_t location = 0;
+                    if (!qcom_smem_mss_owned_stop(&smem, &location, -1))
+                        __atomic_store_n(&pasFreshStop, location, __ATOMIC_RELEASE);
+                }
+            }
+            pong_smem_unlock(mutex);
+        }
+    }
+    if (ipccMap) ipccMap->release();
+    if (lockMap) lockMap->release();
+    if (smemMap) smemMap->release();
+    IOLog("THOR SMP2P V183: item=428 state=%s status=%d stop_bit=%d\n",
+          state, status, status == QcomSmemOk && stop != UINT32_MAX ? (int)stop : -1);
+    if (status == QcomSmemExists || (status == QcomSmemOk && stop == 0)) {
+        thorSampleMssPhase("after-publish");
+    }
+}
