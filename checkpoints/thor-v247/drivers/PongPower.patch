+/* Snapshot existing MSS state after IOKit mapping is ready. This does not
+ * negotiate SMP2P, ring an IPCC doorbell, or start the remote processor. */
+static IOMemoryMap *thorMapMss()
+{
+    constexpr uint32_t size = 0x200000;
+    auto memory = IODeviceMemory::withRange(0x80900000, size);
+    if (!memory) return nullptr;
+    auto map = memory->map(kIOMapAnywhere | kIOMapInhibitCache | kIOMapReadOnly);
+    memory->release();
+    if (map && (!map->getVirtualAddress() || map->getLength() != size)) {
+        map->release();
+        return nullptr;
+    }
+    return map;
+}
