+static int find_mss_uncached(const QcomSmem *smem, const QcomSmemPartition *part,
+    uint32_t end, uint16_t item, uint32_t *offset, uint32_t *length)
+{
+    uint32_t at = PART_HEADER;
+    for (unsigned count = 0; at < end; ++count) {
+        if (count >= 4096 || (at & 3) || !fits(at, ENTRY, end)) {
+            return QcomSmemCorrupt;
+        }
+        const uint32_t address = part->offset + at;
+        const uint32_t id = rd(smem, address);
+        const uint32_t bytes = rd(smem, address + 4);
+        const uint32_t pads = rd(smem, address + 8);
+        const uint64_t data = (uint64_t)at + ENTRY + (pads >> 16);
+        const uint32_t padding_data = pads & 0xffff;
+        if ((id & 0xffff) != CANARY || padding_data > bytes ||
+            (data & 3) || !fits(data, bytes, end)) {
+            return QcomSmemCorrupt;
+        }
+        if ((id >> 16) == item) {
