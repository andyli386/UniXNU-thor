+/* The same static firmware CMD DB address is already read on Thor in the
+ * Adreno path. Snapshot it via read-only word loads; no RPMh or AOP traffic. */
+void thorModemPowerPreflight()
+{
+    __atomic_store_n(&modemIccHeld, false, __ATOMIC_RELEASE);
+    thorModemIccClearDescriptions();
+    constexpr uint64_t address = 0x80860000;
+    const auto *state = "descriptor-failed";
+    auto memory = IODeviceMemory::withRange(address, kThorCmdDbBytes);
+    if (memory) {
+        auto map = memory->map(kIOMapAnywhere | kIOMapInhibitCache | kIOMapReadOnly);
+        memory->release();
+        if (map && map->getVirtualAddress() && map->getLength() == kThorCmdDbBytes) {
+            state = "allocation-failed";
+            auto *snapshot = static_cast<uint8_t *>(IOMallocData(kThorCmdDbBytes));
+            if (snapshot) {
+                auto *words = reinterpret_cast<volatile const uint32_t *>(map->getVirtualAddress());
+                for (size_t offset = 0; offset < kThorCmdDbBytes; offset += sizeof(uint32_t)) {
+                    const uint32_t word = words[offset / sizeof(uint32_t)];
+                    memcpy(snapshot + offset, &word, sizeof(word));
+                }
+                __asm__ volatile("dmb oshld" ::: "memory");
+                ThorModemCmdDb records{};
+                const auto status = thorModemCmdDbRead(snapshot, kThorCmdDbBytes, records);
+                if (status == kThorCmdOk) {
+                    pong_rpmh_init();
+                    if (powerLock) {
+                        IOLockLock(powerLock);
+                        modemArcInputs = records;
+                        const ThorCmdRailSpec adspRequest[]={{"lcx.lvl",384,false},{"lmx.lvl",384,false}};
+                        ThorModemRail adsp[2]{};
+                        if (thorCmdReadRails(snapshot,kThorCmdDbBytes,adspRequest,adsp)==kThorCmdOk) {
+                            adspRails[0]=adsp[0];adspRails[1]=adsp[1];
+                        }
+                        const ThorCmdRailSpec minimum[] = {{"mx.lvl", 256, false}, {"cx.lvl", 256, false}};
+                        ThorModemRail supplies[2]{};
+                        if (thorCmdReadRails(snapshot, kThorCmdDbBytes, minimum, supplies) == kThorCmdOk &&
+                            records.version == 1 && supplies[0].address == 0x30010 && supplies[1].address == 0x30000) {
+                            wifiMx = supplies[0]; wifiCx = supplies[1];
+                        } else {
+                            wifiMx = {}; wifiCx = {};
+                        }
+                        IOLockUnlock(powerLock);
+                    }
+                }
+                ThorModemBcmPaths paths{};
+                const auto bcmStatus = thorModemReadBcmPaths(snapshot, kThorCmdDbBytes, paths);
+                thorModemIccDescribe(thorCmdLe32(snapshot), bcmStatus, paths);
+                IOFreeData(snapshot, kThorCmdDbBytes);
+                map->release();
+                // Preserve the established V175 provenance marker while
+                // carrying the V188 admission state in the same record.
+                IOLog("THOR MODEM POWER V175: cmd-db-status=%u version=%u "
+                    "cx=0x%x cx-level-index=%d mss=0x%x mss-level-index=%d xo=0x%x "
+                    "aop=unprobed icc=baseline-unknown auth=blocked\n",
+                    status, records.version, records.cx.address, records.cx.corner,
+                    records.mss.address, records.mss.corner, records.xo.address);
+                IOLog("THOR MODEM ICC V184: cmd-db-status=%u resolved=0x%x "
+                      "rproc_ddr=%u crypto_ddr=%u mode=lookup\n", bcmStatus, paths.present,
+                      (unsigned)((paths.present & kThorRprocDdrMask) == kThorRprocDdrMask),
+                      (unsigned)(paths.present == kThorCryptoDdrMask));
+                for (unsigned i = 0; i < sizeof(paths.resources) / sizeof(paths.resources[0]); ++i) {
+                    if (!(paths.present & (1u << i))) continue;
+                    const auto &bcm = paths.resources[i];
+                    IOLog("THOR MODEM ICC V184: bcm=%s addr=0x%x unit=%u width=%u vcd=%u\n",
+                          kThorModemBcmNames[i], bcm.address, bcm.unit, bcm.width, bcm.vcd);
+                }
+                const unsigned modemPaths[] = {kThorRprocDdrMask, kThorCryptoDdrMask};
+                for (unsigned mask : modemPaths) {
+                    ThorIccPlan plan{};
+                    const char *name = mask == kThorRprocDdrMask ? "rproc_ddr" : "crypto_ddr";
+                    if (!thorIccPlan(paths, mask, plan)) {
+                        IOLog("THOR MODEM ICC V185: path=%s state=plan-rejected\n", name);
+                        continue;
+                    }
+                    IOLog("THOR MODEM ICC V185: path=%s state=modem-demand commands=%u commit_slots=0x%x "
+                          "peak_kBps=%u words=%x/%x/%x/%x/%x/%x tx=deferred-no-inherited-baseline\n",
+                          name, plan.count, plan.commitSlots, UINT32_MAX,
+                          plan.commands[0].data, plan.commands[1].data, plan.commands[2].data,
+                          plan.commands[3].data, plan.commands[4].data, plan.commands[5].data);
+                }
+                return;
+            }
+        } else {
+            state = "map-failed";
+        }
+        if (map) {
+            map->release();
+        }
+    }
+    IOLog("THOR MODEM POWER V188: state=%s aop=unprobed icc=baseline-unknown auth=blocked\n", state);
+    thorModemIccLog("cmd-db-unavailable", thorModemIccSnapshot());
+}
+
+/* This Thor range is the AOSS mailbox RAM in the stock live FDT.
+ * Snapshot only its descriptor, before any owner tries to open it. */
+void thorModemAossPreflight()
+{
+    constexpr uint64_t address = 0x0c300000;
+    ThorAossStatus status{"descriptor-failed", 0, 0, 0, 0, 0};
+    auto memory = IODeviceMemory::withRange(address, kThorAossRamBytes);
+    if (memory) {
+        auto map = memory->map(kIOMapAnywhere | kIOMapInhibitCache | kIOMapReadOnly);
+        memory->release();
+        status.state = "map-failed";
+        if (map && map->getVirtualAddress() && map->getLength() == kThorAossRamBytes) {
+            const auto *regs = reinterpret_cast<volatile const uint32_t *>(map->getVirtualAddress());
+            ThorAossSnapshot snapshots[2]{};
+            for (auto &sample : snapshots) {
+                for (unsigned i = 0; i < sizeof(sample.words) / sizeof(sample.words[0]); ++i) {
+                    sample.words[i] = regs[i];
+                }
+                __asm__ volatile("dmb oshld" ::: "memory");
+            }
+            status = thorAossStatus(snapshots[0], snapshots[1]);
+        }
+        if (map) {
+            map->release();
+        }
+    }
+    IOLog("THOR MODEM AOSS V176: state=%s version=%u ap-box=0x%x ap-box-bytes=0x%x "
+        "aop-up=0x%x ap-up=0x%x mode=read-only\n",
+        status.state, status.version, status.box, status.boxBytes, status.aopUp, status.appsUp);
+}
+
+IOMemoryMap *thorMapModemRange(uint64_t address, uint32_t bytes)
+{
+    auto memory = IODeviceMemory::withRange(address, bytes);
+    if (!memory) {
+        return nullptr;
+    }
+    auto mapping = memory->map(kIOMapAnywhere | kIOMapInhibitCache);
+    memory->release();
+    if (mapping && (!mapping->getVirtualAddress() || mapping->getLength() != bytes)) {
+        mapping->release();
+        return nullptr;
+    }
+    return mapping;
+}
