+/* Qualcomm hardware uses the same APPS token for all AP threads. */
+extern "C" bool pong_smem_lock(volatile uint32_t *mutex)
+{
+    initLock(&smemLock);
+    IOLock *local = __atomic_load_n(&smemLock, __ATOMIC_ACQUIRE);
+    if (!local || !mutex) return false;
+    IOLockLock(local);
+    for (unsigned i = 0; i < 1000; ++i) {
+        if (*mutex == 0) {
+            *mutex = 1;
+            __asm__ volatile("dsb sy" ::: "memory");
+            if (*mutex == 1) {
+                __asm__ volatile("dmb osh" ::: "memory");
+                return true;
+            }
+        }
+        IODelay(10);
+    }
+    IOLockUnlock(local);
+    return false;
+}
+
+extern "C" void pong_smem_unlock(volatile uint32_t *mutex)
+{
+    __asm__ volatile("dsb osh" ::: "memory");
+    *mutex = 0;
+    __asm__ volatile("dsb sy" ::: "memory");
+    IOLockUnlock(smemLock);
+}
