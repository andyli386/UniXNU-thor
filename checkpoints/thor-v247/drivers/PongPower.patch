+// A profile requesting ADSP firmware boot reserves the mailbox for its ADSP
+// owner. Thor uses the standalone resource driver without this boot argument.
+static bool thorAossUsesAdspOwner()
+{
+    unsigned mode = 0;
+    return PE_parse_boot_argn("pong_adsp", &mode, sizeof(mode)) && mode >= 2;
+}
+
+bool thorAossLock()
+{
+    initLock(&aossLock);
+    IOLock *lock = __atomic_load_n(&aossLock, __ATOMIC_ACQUIRE);
+    if (!lock) return false;
+    IOLockLock(lock);
+    return true;
+}
+
+void thorAossUnlock()
+{
+    IOLockUnlock(__atomic_load_n(&aossLock, __ATOMIC_RELAXED));
+}
+
+// A single Thor mailbox transaction owns publication through peer consumption.
+// Both producers below are in the resource-only Thor archive.
+template <unsigned N>
+static const char *thorAossRequestLocked(const char (&packet)[N], bool &published)
+{
+    auto aoss = thorMapModemRange(0x0c300000, kThorAossRamBytes);
+    auto ipcc = aoss ? thorMapModemRange(0x0ed18000, 0x1000) : nullptr;
+    if (!ipcc) {
+        if (aoss) aoss->release();
+        return "transport-map-failed";
+    }
+    auto *ram = reinterpret_cast<volatile uint32_t *>(aoss->getVirtualAddress());
+    auto *send = reinterpret_cast<volatile uint32_t *>(ipcc->getVirtualAddress() + QCOM_IPCC_SEND);
+    auto read = [ram](unsigned i) {
+        const uint32_t value = ram[i];
+        __asm__ volatile("dmb oshld" ::: "memory");
+        return value;
+    };
+    auto write = [ram](unsigned i, uint32_t value) {
+        ram[i] = value;
+        __asm__ volatile("dsb oshst" ::: "memory");
+    };
+    auto kick = [send]() {
+        *send = qcom_ipcc_id(QCOM_IPCC_CLIENT_AOP, QCOM_IPCC_SIGNAL_GLINK_QMP);
+        __asm__ volatile("dsb oshst" ::: "memory");
+    };
+    uint64_t deadline = 0;
+    clock_interval_to_deadline(1000, kMillisecondScale, &deadline);
+    auto wait = [deadline]() {
+        if (mach_absolute_time() >= deadline) return false;
+        IOSleep(1);
+        return mach_absolute_time() < deadline;
+    };
+    const char *result = thorAossSend(packet, read, write, kick, wait, published);
+    ipcc->release();
+    aoss->release();
+    return result;
+}
+
+template <unsigned N>
+static const char *thorAossRequest(const char (&packet)[N], bool &published)
+{
+    published = false;
+    if (thorAossUsesAdspOwner()) return "adsp-mailbox-owner";
+    if (!thorAossLock()) return "owner-allocation-failed";
+    const char *result = thorAossRequestLocked(packet, published);
+    thorAossUnlock();
+    return result;
+}
+
+static void thorModemDdrSample()
+{
+    static unsigned attempted;
+    if (__atomic_exchange_n(&attempted, 1u, __ATOMIC_ACQ_REL)) return;
+    auto memory = IODeviceMemory::withRange(kThorDdrPageBase, kThorDdrPageBytes);
+    auto stats = memory ? memory->map(kIOMapAnywhere | kIOMapInhibitCache | kIOMapReadOnly) : nullptr;
+    if (memory) memory->release();
+    const bool mapped = stats && stats->getVirtualAddress() && stats->getLength() == kThorDdrPageBytes;
+    const auto *page = mapped ? reinterpret_cast<volatile const uint32_t *>(stats->getVirtualAddress()) : nullptr;
+    auto readStats = [page](unsigned i) {
+        const uint32_t value = page[i];
+        __asm__ volatile("dmb oshld" ::: "memory");
+        return value;
+    };
+    ThorDdrVotes before{}, after{};
+    const char *prior = mapped ? thorDdrVotes(readStats, before) : "stats-map-failed";
+    bool published = false;
+    const char *query = thorAossRequest(kThorDdrPacket, published);
+    const char *result = query ? "no-ack" : (mapped ? thorDdrVotes(readStats, after) : "stats-map-failed");
+    if (stats) stats->release();
+    if (result) {
+        IOLog("THOR MODEM DDR V185: query=%s stats=%s\n", query ? query : "acked", result);
+        thorModemIccObserveDdr(!mapped || query ? ThorIccDdrSampleState::Unavailable : ThorIccDdrSampleState::Rejected);
+        return;
+    }
+    thorModemIccObserveDdr(ThorIccDdrSampleState::Stable);
+    unsigned absent = 0, invalid = 0, changed = 0;
+    const bool comparable = !prior && before.offset == after.offset && before.modes == after.modes;
+    for (unsigned i = 0; i < kThorDdrDrivers; ++i) {
+        if (after.rows[i] == kThorDdrAbsent) absent |= 1u << i;
+        if (after.rows[i] == kThorDdrInvalid) invalid |= 1u << i;
+        if (comparable && after.rows[i] != before.rows[i]) changed |= 1u << i;
+    }
+    IOLog("THOR MODEM DDR V185: query=acked stats=stable offset=%#x modes=%u drivers=%u "
+          "absent=%#x invalid=%#x comparable=%u changed=%#x\n", after.offset, after.modes,
+          kThorDdrDrivers, absent, invalid, unsigned(comparable), changed);
+    for (unsigned i = 0; i < kThorDdrDrivers; i += 6)
+        IOLog("THOR MODEM DDR V185: first_drv=%u raw=%08x,%08x,%08x,%08x,%08x,%08x\n",
+              i, after.rows[i], after.rows[i + 1], after.rows[i + 2], after.rows[i + 3],
+              after.rows[i + 4], after.rows[i + 5]);
+}
+
+// Acquire a boot-lifetime minimum only for the three Cape ARC resources.
+// The crypto/rproc BCM path has different packing/aggregation and ownership.
+static bool thorModemAcquireRails()
+{
+    pong_rpmh_init();
+    if (!powerLock) {
+        IOLog("THOR MODEM ARC V187: state=owner-unavailable\n");
+        return false;
+    }
+    IOLockLock(powerLock);
+    const auto demand = modemArcInputs;
+    auto result = modemArc.acquire(demand, [](uint32_t address, uint32_t level) {
+        return mapped() && rawVote(address, level);
+    });
+    IOLockUnlock(powerLock);
+    IOLog("THOR MODEM ARC V187: state=%s prior_ack=%#x write_attempt=%#x satisfied=%#x "
+          "cx=%u mss=%u xo=%u modem_min=%d/%d/%d\n", result.state, result.inherited, result.sent,
+          result.acknowledged, result.level[0], result.level[1], result.level[2],
+          demand.cx.corner, demand.mss.corner, demand.xo.corner);
+    return result.acknowledged == 7;
+}
+
+static void thorLogStagedBcm()
+{
+    ThorStagedBcm view{};
+    bool layout = false;
+    if (powerLock) {
+        IOLockLock(powerLock);
+        if (rsc && stagedBcmAddresses[0]) {
+            struct Reader { uint32_t read(unsigned off) { return rd(off); } } reader;
+            layout = view.collect(reader, stagedBcmAddresses);
+        }
+        IOLockUnlock(powerLock);
+    }
+    IOLog("THOR BCM V206: phase=auth-gate drv=2 layout=%s version=%#x caps=%#x "
+          "source=enabled-tcs active=unobserved ownership=unobserved\n",
+          layout ? "matched" : "unavailable", view.version, view.caps);
+    if (!layout) return;
+    for (unsigned i = 0; i < 2; i++) {
+        const auto &set = view.sets[i];
+        const char *name = i ? "wake" : "sleep";
+        IOLog("THOR BCM V206: set=%s enabled=%#x/%#x unstable_slots=%#x malformed_slots=%#x "
+              "seen=%#x duplicate=%#x unsupported=%#x\n", name, set.enabled[0], set.enabled[1],
+              set.unstable, set.malformed, set.seen, set.duplicate, set.unsupported);
+        for (unsigned r = 0; r < ThorStagedBcm::resources; r++) {
+            if (!(set.seen & (1u << r)) || ((set.unsupported | set.duplicate) & (1u << r))) continue;
+            uint32_t word = set.words[r];
+            IOLog("THOR BCM V206: set=%s resource=%s staged_word=%#x valid=%u commit=%u x=%u y=%u\n",
+                  name, kThorModemBcmNames[r], word, (word >> 29) & 1, (word >> 30) & 1,
+                  (word >> 14) & 0x3fff, word & 0x3fff);
+        }
+    }
+}
+
+static bool thorModemIccHeld()
+{
+    thorLogStagedBcm();
+    const auto r = thorModemIccSnapshot();
+    thorModemIccLog("auth-gate", r);
+    // The diagnostic inventory cannot grant admission, even if a future
+    // caller accidentally changes the legacy hold flag without a provider.
+    return __atomic_load_n(&modemIccHeld, __ATOMIC_ACQUIRE) && r.authAllowed;
+}
+
+// A signed metadata readback and a usable AP/MSS control link precede this
+// boot's one modem load vote. AOP clearing the mailbox is a transport ACK;
+// the PAS owner will still need rails, segment loading, authentication and READY.
+static void thorModemRequestLoadState(ThorAossPrerequisite event)
+{
+    static unsigned prerequisites;
+    if (!thorModemMayRequest(prerequisites, event)) return;
+    // The one-shot signed PAS trial admits a cold modem through its own checks.
+    // Normal bring-up must own the ICC path before requesting AOSS or rail power.
+    if (!pasProbeRequested() && !thorModemIccHeld()) {
+        IOLog("THOR MODEM LOAD V212: deferred before load-on, ICC ownership unavailable\n");
+        return;
+    }
+    int hostStatus = 0, remoteStatus = 0;
+    uint32_t stop = 0, ready = 0;
+    const char *failure = thorReadMss(hostStatus, stop, remoteStatus, ready);
+    if (!failure) {
+        if (hostStatus != QcomSmemOk) failure = "host-signal-unavailable";
+        else if (stop) failure = "host-stop-asserted";
+        else if (remoteStatus == QcomSmemOk)
+            failure = ready ? "remote-ready" : "existing-remote-ready-clear-owner-unknown";
+        else if (remoteStatus != QcomSmemMissing) failure = "remote-snapshot-unverified";
+    }
+    if (failure) {
+        IOLog("THOR MODEM LOAD V186: request=not-sent state=%s host=%d stop=%d remote=%d ready=%d\n",
+              failure, hostStatus, hostStatus == QcomSmemOk ? int(stop) : -1,
+              remoteStatus, remoteStatus == QcomSmemOk ? int(ready) : -1);
+        return;
+    }
+    bool published = false;
+    const uint64_t begin = mach_absolute_time();
+    const char *result = thorAossRequest(kThorModemOnPacket, published);
+    uint64_t elapsedNs = 0;
+    absolutetime_to_nanoseconds(mach_absolute_time() - begin, &elapsedNs);
+    IOLog("THOR MODEM LOAD V186: request=on bytes=%u published=%u ack=%u result=%s attempt=1 elapsed_us=%llu\n",
+          unsigned(sizeof(kThorModemOnPacket)), unsigned(published), unsigned(!result),
+          result ? result : "aop-consumed", (unsigned long long)(elapsedNs / 1000));
+    if (!result && thorModemAcquireRails()) {
+        pong_thor_pas4_resources_ready();
+        // The modem's own lifetime vote now supplies a known CXO parent.
+        // Recheck it under the same lock as the WLAN lease and all RPMh writes.
+        thorWifiHostClocks(false);
+    }
+}
