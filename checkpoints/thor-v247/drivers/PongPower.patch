+    *out = (QcomMssGlinkSample){0};
+    QcomSmemPartition p;
+    int rc = qcom_smem_partition(s, QCOM_SMEM_HOST_APPS, 1, &p);
+    if (rc) return rc;
+    const uint32_t uncached = rd(s, p.offset + 12), cached = rd(s, p.offset + 16);
