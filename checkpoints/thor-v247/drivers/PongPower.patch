+extern "C" int pong_ufs_factory_nv(unsigned, uint64_t, void *, uint32_t, uint64_t *)
+    __attribute__((weak_import));
+
+/* Verify the addresses a modem consumer would use without mapping or
+ * sharing them. Probe one block at either end of every factory NV slot.
+ * The same partition-sized query and read ABI feeds Pong's RAM shadow. */
+extern "C" void pong_thor_rmtfs_preflight(void)
+{
+    uint64_t metadata = 0, rmtfs = 0;
+    const bool metadataReady = PongLowDma::modemMetadataAddress(metadata);
+    const bool rmtfsReady = PongLowDma::rmtfsAddress(rmtfs);
+    if (!metadataReady || !rmtfsReady) {
+        IOLog("THOR RMTFS V162: state=dma-unavailable metadata=%u rmtfs=%u\n",
+            unsigned(metadataReady), unsigned(rmtfsReady));
+        return;
+    }
+    IOLog("THOR RMTFS V162: state=dma-admitted metadata=0x%llx rmtfs=0x%llx\n",
+        static_cast<unsigned long long>(metadata), static_cast<unsigned long long>(rmtfs));
+    if (!pong_ufs_factory_nv) {
+        IOLog("THOR RMTFS V162: state=ufs-unavailable\n");
+        return;
+    }
+    constexpr uint64_t MiB = 1024 * 1024;
+    constexpr uint64_t expected[] = {8 * MiB, 8 * MiB, 8 * MiB, MiB};
+    constexpr uint32_t blockBytes = 4096;
+    auto *scratch = static_cast<uint8_t *>(IOMallocData(blockBytes));
+    if (!scratch) {
+        IOLog("THOR RMTFS V162: state=allocation-failed\n");
+        return;
+    }
+
+    unsigned complete = 0;
+    for (unsigned slot = 0; slot < sizeof(expected) / sizeof(expected[0]); ++slot) {
+        uint64_t bytes = 0;
+        const int geometry = pong_ufs_factory_nv(slot, 0, nullptr, 0, &bytes);
+        if (geometry || bytes != expected[slot]) {
+            IOLog("THOR RMTFS V162: state=geometry-failed slot=%u status=%d bytes=%llu\n",
+                slot, geometry, static_cast<unsigned long long>(bytes));
+            break;
+        }
+
+        const uint64_t offsets[] = {0, bytes - blockBytes};
+        bool readable = true;
+        for (const uint64_t offset : offsets) {
+            uint64_t observed = 0;
+            const int status = pong_ufs_factory_nv(slot, offset, scratch, blockBytes, &observed);
+            bzero(scratch, blockBytes);
+            if (status || observed != bytes) {
+                IOLog("THOR RMTFS V162: state=read-failed slot=%u offset=%llu status=%d bytes=%llu\n",
+                    slot, static_cast<unsigned long long>(offset), status,
+                    static_cast<unsigned long long>(observed));
+                readable = false;
+                break;
+            }
+        }
+        if (!readable) {
+            break;
+        }
+        ++complete;
+        IOLog("THOR RMTFS V162: state=slot-verified slot=%u bytes=%llu sample_bytes=%u\n",
+            slot, static_cast<unsigned long long>(bytes), 2 * blockBytes);
+    }
+    IOFreeData(scratch, blockBytes);
+    if (complete == sizeof(expected) / sizeof(expected[0])) {
+        IOLog("THOR RMTFS V162: state=read-only-preflight-pass slots=%u\n", complete);
+        thorPas4Probe();
+        thorModemPowerPreflight();
+        thorModemAossPreflight();
+        thorModemAossOpenChannel();
+    }
+}
