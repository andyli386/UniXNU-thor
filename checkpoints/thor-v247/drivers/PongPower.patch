+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include "QcomSmem.h"
+
+namespace ThorMssVersion {
+enum class State { Wait, Agreed, Epoch, Blocked, Unsupported, NoCold, Missing, Budget, Timeout };
+struct Frame { bool tx; uint32_t cmd, version, features, txHead, rxTail; };
+struct Session {
+    QcomMssGlinkSample cold{}, ring{};
+    uint32_t txHead{}, rxTail{}, previousTxTail{}, previousRxHead{}, lastOfferHead{};
+    uint32_t offers{}, peerVersion{}, peerFeatures{}, sentAck{}, matchingAck{};
+    uint32_t frames{}, blockedCmd{65535};
+    bool bound{};
+    Frame log[16]{};
+    void record(bool tx,uint32_t cmd,uint32_t version,uint32_t features) {
+        log[frames++] = {tx,cmd,version,features,txHead,rxTail};
+    }
+};
+inline bool inside(uint32_t addr,uint32_t n,const QcomMssGlinkSample &s) {
+    const uint64_t end=uint64_t(s.part_offset)+s.part_size;
+    return !(addr&7u) && s.part_size<=0x200000 && end<=0x200000 &&
+           addr>=uint64_t(s.part_offset)+32 && uint64_t(addr)+n<=end;
+}
+inline bool separate(uint32_t a,uint32_t n,uint32_t b,uint32_t m) {
+    return uint64_t(a)+n<=b || uint64_t(b)+m<=a;
+}
+inline bool coldOk(const QcomMssGlinkSample &c) {
+    return c.present==3 && c.size[0]==32 && c.size[1]==16384 && !c.size[2] &&
+           inside(c.desc_offset,32,c) && inside(c.tx_offset,16384,c) &&
+           separate(c.desc_offset,32,c.tx_offset,16384) && !c.rx_offset &&
+           !(c.cursor[0]|c.cursor[1]|c.cursor[2]|c.cursor[3]);
+}
+inline bool sameLocal(const QcomMssGlinkSample &a,const QcomMssGlinkSample &b) {
+    return a.part_offset==b.part_offset && a.part_size==b.part_size &&
+           a.desc_offset==b.desc_offset && a.tx_offset==b.tx_offset &&
+           a.size[0]==b.size[0] && a.size[1]==b.size[1];
+}
+inline bool sameSample(const QcomMssGlinkSample &a,const QcomMssGlinkSample &b) {
+    if (!sameLocal(a,b) || a.present!=b.present || a.rx_offset!=b.rx_offset || a.size[2]!=b.size[2]) return false;
+    for (unsigned i=0;i<4;++i) if (a.cursor[i]!=b.cursor[i]) return false;
+    return true;
+}
+template<class Port> State step(Session &s,Port &port) {
+    if (!coldOk(s.cold)) return State::NoCold;
+    if (!port.live()) return State::Epoch;
+    QcomMssGlinkSample r{};
+    int rc=port.snapshot(r);
+    if (rc==QcomSmemUnstable) return State::Wait;
+    if (rc || !sameLocal(s.cold,r)) return State::Epoch;
+    if (r.present==3 && !s.bound) return State::Wait;
+    if (r.present!=7 || r.size[2]!=16384 || !inside(r.rx_offset,r.size[2],r) ||
+        !separate(r.rx_offset,r.size[2],r.desc_offset,32) ||
+        !separate(r.rx_offset,r.size[2],r.tx_offset,r.size[1])) return State::Epoch;
+    if (s.bound && r.rx_offset!=s.ring.rx_offset) return State::Epoch;
+    const uint32_t txTail=r.cursor[0],txHead=r.cursor[1],rxTail=r.cursor[2],rxHead=r.cursor[3];
+    if ((txTail|txHead|rxTail|rxHead)&7u || txHead>=r.size[1] || rxHead>=r.size[2] ||
+        txHead!=s.txHead || rxTail!=s.rxTail || txTail>txHead || rxHead<rxTail ||
+        txTail<s.previousTxTail || rxHead<s.previousRxHead) return State::Epoch;
+    s.previousTxTail=txTail; s.previousRxHead=rxHead;
+    if (s.offers && s.peerVersion==1 && s.sentAck && s.matchingAck) {
+        if (txTail!=txHead) return State::Wait;
+        if (!port.inTime()) return State::Timeout;
+        return port.live() ? State::Agreed : State::Epoch;
+    }
+    if (rxTail==rxHead) return State::Wait;
+    const auto a=port.read(r.rx_offset+rxTail), features=port.read(r.rx_offset+rxTail+4);
+    const uint32_t cmd=a&0xffff, version=a>>16;
+    // A fresh baseline plus exactly one unsolicited peer VERSION excludes
+    // any pre-existing ACK from satisfying our own offer.
+    if (!s.bound && (rxTail || rxHead!=8 || cmd || version!=1)) return State::Missing;
+    if (cmd>1) { s.blockedCmd=cmd; return State::Blocked; }
+    if (version!=1) return State::Unsupported;
+    const bool initial=!s.bound;
+    const bool peerOffer=!initial && cmd==0;
+    if (cmd==1 && txTail<s.lastOfferHead) return State::Wait;
+    const bool counter=!initial && cmd==1 && features;
+    const bool tx=initial || peerOffer || counter;
+    const uint32_t txCmd=peerOffer ? 1u : 0u;
+    if ((!initial && !peerOffer && s.matchingAck) || (counter && s.offers>=3) ||
+        (peerOffer && s.sentAck>=3) || s.frames+unsigned(!initial)+unsigned(tx)>16) return State::Budget;
+    // All cursors start at zero. At most sixteen 8-byte control records
+    // are permitted, so no local producer or consumer can wrap this FIFO.
+    if (tx && (r.size[1]-(txHead-txTail)<24 || txHead+8>=r.size[1])) return State::Wait;
+    QcomMssGlinkSample checked{};
+    rc=port.snapshot(checked);
+    if (rc==QcomSmemUnstable) return State::Wait;
+    if (rc || !sameLocal(r,checked) || checked.present!=7 ||
+        checked.rx_offset!=r.rx_offset || checked.size[2]!=r.size[2] ||
+        checked.cursor[1]!=txHead || checked.cursor[2]!=rxTail ||
+        checked.cursor[0]<txTail || checked.cursor[3]<rxHead || !port.live()) return State::Epoch;
+    if (!sameSample(r,checked)) return State::Wait;
+    if (port.read(r.rx_offset+rxTail)!=a || port.read(r.rx_offset+rxTail+4)!=features) return State::Epoch;
+    if (!port.inTime()) return State::Timeout;
+    if (initial) { s.bound=true; s.ring=r; }
+    if (!initial) {
+        port.beforeConsume();
+        port.write(r.desc_offset+8,rxTail+8);
+        s.rxTail+=8;
+        s.record(false,cmd,version,features);
+        if (peerOffer) { s.peerVersion=version; s.peerFeatures=features; }
+        else if (!features) s.matchingAck=1;
+    }
+    // Publish RX consumption and TX payload before advertising a new TX
+    // head. The doorbell follows publication and never rewinds a cursor.
+    if (tx) {
+        port.write(r.tx_offset+txHead,(1u<<16)|txCmd);
+        port.write(r.tx_offset+txHead+4,0);
+        port.beforePublish();
+        port.write(r.desc_offset+4,txHead+8);
+        s.txHead+=8;
+        s.record(true,txCmd,1,0);
+        if (txCmd) ++s.sentAck; else { ++s.offers; s.lastOfferHead=s.txHead; }
+        port.kick();
+    }
+    return State::Wait;
+}
+}
diff --git a/ThorMssVersionKernel.inc b/ThorMssVersionKernel.inc
new file mode 100644
index 0000000000000000000000000000000000000000..fafd9d612f6d34e8904a6596d1a21c7d35e79cfd
--- /dev/null
+++ b/ThorMssVersionKernel.inc
@@ -0,0 +1,311 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Included by Thor's PAS4 worker. No other worker writes these rings.
+#include "ThorMssChannel.h"
+static unsigned glinkVersionClaimed;
+static uint32_t pasGlinkValue(const char *name,uint32_t fallback)
+{
+    IORegistryEntry *chosen=IORegistryEntry::fromPath("/chosen",gIODTPlane);
+    auto data=chosen ? OSDynamicCast(OSData,chosen->getProperty(name)) : nullptr;
+    uint32_t value=fallback;
+    if (data && data->getLength()==sizeof(value)) memcpy(&value,data->getBytesNoCopy(),sizeof(value));
+    if (chosen) chosen->release();
+    return value;
+}
+static bool pasGlinkFlag(const char *name) { return pasGlinkValue(name,0)==1; }
+static bool pasVersionSelected() { return pasGlinkFlag("thor-glink-version"); }
+struct PasVersionPort {
+    QcomSmem smem;
+    volatile uint32_t *doorbell;
+    uint64_t deadline;
+    bool live() const {
+        uint32_t stop=0,word=0;
+        return !qcom_smem_mss_host_stop(&smem,&stop) && !stop &&
+               !qcom_smem_mss_inbound(&smem,&word) && (word&QcomMssReady) &&
+               !(word&(QcomMssFatal|QcomMssStopAck|QcomMssShutdownAck));
+    }
+    bool inTime() const { return mach_absolute_time()<deadline; }
+    int snapshot(QcomMssGlinkSample &s) const { return qcom_smem_mss_glink_snapshot(&smem,&s); }
+    uint32_t read(uint32_t at) const { return qcom_smem_read32(&smem,at); }
+    void write(uint32_t at,uint32_t v) const { qcom_smem_write32(&smem,at,v); }
+    void beforeConsume() const { __asm__ volatile("dmb osh" ::: "memory"); }
+    void beforePublish() const { __asm__ volatile("dmb oshst" ::: "memory"); }
+    void kick() const {
+        __asm__ volatile("dsb oshst" ::: "memory");
+        *doorbell=qcom_ipcc_id(2,QCOM_IPCC_SIGNAL_GLINK_QMP);
+        __asm__ volatile("dsb oshst" ::: "memory");
+    }
+};
+struct PasVersionTrial {
+    bool enabled{};
+    const bool channelRequested=pasGlinkFlag("thor-glink-ipcrtr");
+    // Only the successful cold, one-shot VERSION owner may publish this
+    // pointer. Keep directory payloads and their wire receipts off its stack.
+    ThorMssChannel::Session *ownedChannel{};
+    ThorMssChannel::Result channelResult=ThorMssChannel::Result::NoVersion;
+    void runChannel(PasVersionPort &port) {
+        using Result=ThorMssChannel::Result;
+        static ThorMssChannel::Session channel{};
+        if (!begin(channel,session,final)) return;
+        ownedChannel=&channel;
+        channel.one.selected=pasGlinkFlag("thor-qrtr-rx-one");
+        channel.localNode=pasGlinkValue("thor-qrtr-ap-node",ThorQrtrProbe::Broadcast);
+        channel.followup.selected=channel.one.selected && channel.localNode!=ThorQrtrProbe::Broadcast &&
+                                  pasGlinkFlag("thor-qrtr-rx-followup");
+        channel.serviceWindow=channel.followup.selected && pasGlinkFlag("thor-qrtr-service-window");
+        uint64_t receiveDeadline=0;
+        channel.fields.enabled=channel.serviceWindow && pasGlinkFlag("thor-qrtr-ssctl-fields");
+        channel.fields.pdState=channel.serviceWindow && pasGlinkFlag("thor-qrtr-pd-state");
+        channel.fields.enabled|=channel.fields.pdState;
+        channel.postReplySelected=channel.fields.enabled;
+        channel.uim.enabled=channel.fields.pdState;
+        channel.locator.enabled=channel.fields.pdState;
+        uint64_t directoryStart=0, withdrawDeadline=0;
+        bool postReplyWindow=false;
+        clock_interval_to_deadline(channel.fields.enabled ? 600 : 150,NSEC_PER_MSEC,&receiveDeadline);
+        clock_interval_to_deadline(channel.fields.enabled ? 750 : 250,NSEC_PER_MSEC,&port.deadline);
+        channelResult=Result::Timeout;
+        for (unsigned polls=0; polls<(directoryStart ? 2800u : postReplyWindow ? 1024u : channel.fields.enabled ? 512u : 128u) && port.inTime(); ++polls) {
+            if (channel.one.selected && mach_absolute_time()>=receiveDeadline) channel.one.stop=true;
+            if(channel.locator.deleteEnd && !channel.locator.deleteDone) {
+                if(!withdrawDeadline) clock_interval_to_deadline(30,NSEC_PER_MSEC,&withdrawDeadline);
+                channel.locator.forceClose=mach_absolute_time()>=withdrawDeadline;
+            }
+            const auto result=step(channel,session,port);
+            if (result!=Result::Waiting) {channelResult=result;break;}
+            if (channel.postReplySelected && !postReplyWindow && channel.fields.responseIntent && !channel.one.stop) {
+                postReplyWindow=true;
+                const bool waitForUim=channel.uim.enabled && ThorUimStatus::rootUp(channel.fields);
+                if (waitForUim) directoryStart=mach_absolute_time();
+                const unsigned ms=waitForUim ? 5000u : 1200u;
+                clock_interval_to_deadline(ms,NSEC_PER_MSEC,&receiveDeadline);
+                clock_interval_to_deadline(ms+150,NSEC_PER_MSEC,&port.deadline);
+            }
+            IOSleep(2);
+        }
+        if (directoryStart) {
+            uint64_t elapsed=0;
+            absolutetime_to_nanoseconds(mach_absolute_time()-directoryStart,&elapsed);
+            channel.directoryMs=unsigned(elapsed/NSEC_PER_MSEC);
+        }
+    }
+    void reportChannel() const {
+        if (!channelRequested) return;
+        if (!ownedChannel) {
+            IOLog("THOR IPCRTR V212: final=version-unconfirmed established=0 rcid=0 local_ack=0 remote_close=0 close_ack=0 blocked_cmd=65535 tx_head=0 tx_tail=0 rx_tail=0 rx_head=0\n");
+            return;
+        }
+        const auto &channel=*ownedChannel;
+        using Result=ThorMssChannel::Result;
+        const char *name="timeout";
+        switch(channelResult) {
+        case Result::Closed:name="closed";break;
+        case Result::EarlyClose:name="peer-closed-early";break;
+        case Result::Blocked:name="blocked";break;
+        case Result::Invalid:name="invalid";break;
+        case Result::Epoch:name="epoch";break;
+        case Result::NoVersion:name="version-unconfirmed";break;
+        default:break;
+        }
+        for(unsigned i=0;i<channel.count;i++) {
+            const auto &event=channel.log[i];
+            if (event.qmi) {
+                IOLog("THOR IPCRTR V222: frame=%u op=%s cmd=%u cid=%u value=%u chunk=%u left=%u tx_head=%u rx_tail=%u\n",
+                      i+1,event.tx?"tx":"rx",event.cmd,event.cid,event.value,event.intentCount,event.intentPackets,
+                      event.txHead,event.rxTail);
+                continue;
+            }
+            if(event.locator!=ThorPdLocator::Transfer::None) {
+                IOLog("THOR LOCATOR: frame=%u op=%s cmd=%u cid=%u action=%u credit=%u bytes=%u tx_head=%u rx_tail=%u\n",
+                      i+1,event.tx?"tx":"rx",event.cmd,event.cid,unsigned(event.locator),
+                      event.value,event.intentCount,event.txHead,event.rxTail);
+                continue;
+            }
+            if (event.serviceIntent) {
+                IOLog("THOR IPCRTR V221: frame=%u op=%s cmd=%u cid=%u value=%u chunk=%u left=%u tx_head=%u rx_tail=%u intent=%u grant_tail=%u\n",
+                      i+1,event.tx?"tx":"rx",event.cmd,event.cid,event.value,event.intentCount,event.intentPackets,
+                      event.txHead,event.rxTail,unsigned(event.serviceIntent),
+                      !event.tx && event.cmd==ThorMssChannel::IntentReq ?
+                          channel.grantTail[event.serviceIntent-ThorQrtrProbe::FollowupIntent-1] : 0u);
+                continue;
+            }
+            if (event.followup) {
+                IOLog("THOR IPCRTR V219: frame=%u op=%s cmd=%u cid=%u value=%u chunk=%u left=%u tx_head=%u rx_tail=%u\n",
+                      i+1,event.tx?"tx":"rx",event.cmd,event.cid,event.value,event.intentCount,event.intentPackets,event.txHead,event.rxTail);
+                continue;
+            }
+            if ((event.tx && event.cmd==ThorMssChannel::Data) ||
+                (!event.tx && (event.cmd==ThorMssChannel::Done || event.cmd==ThorMssChannel::DoneReuse))) {
+                IOLog("THOR IPCRTR V218: frame=%u op=%s cmd=%u cid=%u value=%u chunk=%u left=%u tx_head=%u rx_tail=%u\n",
+                      i+1,event.tx?"tx":"rx",event.cmd,event.cid,event.value,event.intentCount,event.intentPackets,event.txHead,event.rxTail);
+                continue;
+            }
+            if ((event.tx && event.cmd==ThorMssChannel::Intent) || event.cmd==ThorMssChannel::Done ||
+                event.cmd==ThorMssChannel::Data || event.cmd==ThorMssChannel::DataCont) {
+                IOLog("THOR IPCRTR V216: frame=%u op=%s cmd=%u cid=%u value=%u chunk=%u left=%u tx_head=%u rx_tail=%u\n",
+                      i+1,event.tx?"tx":"rx",event.cmd,event.cid,event.value,event.intentCount,event.intentPackets,event.txHead,event.rxTail);
+                continue;
+            }
+            if (event.cmd==ThorMssChannel::Intent) {
+                IOLog("THOR IPCRTR V214: frame=%u op=retire cmd=5 cid=%u packets=%u intents=%u tx_head=%u rx_tail=%u\n",
+                      i+1,event.cid,event.intentPackets,event.intentCount,event.txHead,event.rxTail);
+                continue;
+            }
+            if (event.cmd==ThorMssChannel::IntentReq || event.cmd==ThorMssChannel::IntentReqAck) {
+                IOLog("THOR IPCRTR V215: frame=%u op=%s cmd=%u cid=%u value=%u tx_head=%u rx_tail=%u\n",
+                      i+1,event.tx?"tx":"rx",event.cmd,event.cid,event.value,event.txHead,event.rxTail);
+                continue;
+            }
+            if (event.held) {
+                const auto &held=channel.deferred[event.held-1];
+                IOLog("THOR IPCRTR V213: frame=%u op=hold cmd=2 cid=%u len=%u priority=%u name=%s tx_head=%u rx_tail=%u\n",
+                      i+1,held.cid,held.length,held.priority,held.name,event.txHead,event.rxTail);
+                continue;
+            }
+            IOLog("THOR IPCRTR V212: frame=%u op=%s cmd=%u cid=%u tx_head=%u rx_tail=%u\n",
+                  i+1,event.tx?"tx":"rx",event.cmd,event.cid,event.txHead,event.rxTail);
+        }
+        if (channel.one.selected) {
+            const auto &q=channel.one;
+            IOLog("THOR QRTR V216: credit=%u grant_end=%u fragments=%u bytes=%u complete=%u version=%u type=%u length=%u port=%u command=%u control=%u\n",
+                  q.size,q.grantEnd,q.fragments,q.used,unsigned(q.completed),q.used>=32?q.word(0):0,
+                  q.used>=32?q.word(4):0,q.used>=32?q.word(20):0,q.used>=32?q.word(28):0,
+                  q.used>=36?q.word(32):0,q.control());
+            // Route and endpoint metadata only after receipt of an entire classified message.
+            // HELLO and the other control types carry no server announcement here.
+            if (const unsigned kind=q.control()) {
+                const bool server=kind==4;
+                IOLog("THOR QRTR V217: type=%u src_node=%u src_port=%u dst_node=%u service=%u instance=%u node=%u port=%u\n",
+                      kind,q.word(8),q.word(12),q.word(24),server?q.word(36):0,server?q.word(40):0,
+                      server?q.word(44):0,server?q.word(48):0);
+            }
+        }
+        if (channel.one.selected && channel.localNode!=ThorQrtrProbe::Broadcast)
+            IOLog("THOR QRTR V218: local=%u credit_frame=%u credit_id=%u credit_size=%u tx_end=%u done=%u\n",
+                  channel.localNode,channel.creditFrame,channel.peerIntent,channel.peerCapacity,channel.replyEnd,channel.replyDone);
+        if (channel.followup.selected) {
+            const auto &q=channel.followup;
+            const bool hdr=q.used>=32;
+            const auto control=q.control();
+            const bool server=control==4;
+            IOLog("THOR QRTR V219: credit=%u grant_end=%u fragments=%u bytes=%u complete=%u version=%u type=%u length=%u src_node=%u src_port=%u dst_node=%u dst_port=%u confirm=%u command=%u control=%u service=%u instance=%u node=%u port=%u valid_server=%u\n",
+                  q.size,q.grantEnd,q.fragments,q.used,unsigned(q.completed),hdr?q.word(0):0,hdr?q.word(4):0,hdr?q.word(20):0,
+                  hdr?q.word(8):0,hdr?q.word(12):0,hdr?q.word(24):0,hdr?q.word(28):0,hdr?q.word(16):0,
+                  q.used>=36?q.word(32):0,control,server?q.word(36):0,server?q.word(40):0,
+                  server?q.word(44):0,server?q.word(48):0,unsigned(channel.replyDone && q.peerServer(channel.localNode,channel.one.word(8))));
+        }
+        for (unsigned i=0;i<ThorMssChannel::ServiceSlots && channel.services[i].size;++i) {
+            const auto &q=channel.services[i];
+            const bool hdr=q.used>=32;
+            const unsigned control=q.control();
+            const bool server=control==4;
+            IOLog("THOR QRTR V221: intent=%u credit=%u grant_end=%u fragments=%u bytes=%u complete=%u version=%u type=%u length=%u src_node=%u src_port=%u dst_node=%u dst_port=%u confirm=%u command=%u control=%u service=%u instance=%u node=%u port=%u valid_server=%u\n",
+                  ThorQrtrProbe::FollowupIntent+1+i,q.size,q.grantEnd,q.fragments,q.used,unsigned(q.completed),
+                  hdr?q.word(0):0,hdr?q.word(4):0,hdr?q.word(20):0,hdr?q.word(8):0,hdr?q.word(12):0,
+                  hdr?q.word(24):0,hdr?q.word(28):0,hdr?q.word(16):0,q.used>=36?q.word(32):0,control,
+                  server?q.word(36):0,server?q.word(40):0,server?q.word(44):0,server?q.word(48):0,
+                  unsigned(channel.replyDone && q.peerServer(channel.localNode,channel.one.word(8))));
+        }
+        if (channel.fields.enabled) {
+            const auto &q=channel.fields;
+            if (q.pdState)
+                IOLog("THOR QMI V224: source_intent=%u peer_node=%u peer_port=%u local_port=16384 txn=2 msg=33 tx_end=%u send_tail=%u done=%u response_intent=%u body=%u tlvs=%u result=%u error=%u state_valid=%u state=%u\n",
+                      q.sourceIntent,q.peerNode,q.peerPort,q.end,q.sendTail,q.done,q.responseIntent,q.bodyLength,q.tlvCount,q.result,q.error,unsigned(q.stateValid),q.state);
+            else IOLog("THOR QMI V222: selected=1 source_intent=%u peer_node=%u peer_port=%u local_port=16384 txn=1 msg=31 queried=34 tx_end=%u send_tail=%u done=%u response_intent=%u body=%u tlvs=%u result=%u error=%u\n",
+                  q.sourceIntent,q.peerNode,q.peerPort,q.end,q.sendTail,q.done,q.responseIntent,q.bodyLength,q.tlvCount,q.result,q.error);
+        }
+        if (channel.postReplySelected) {
+            const unsigned response=channel.fields.responseIntent;
+            unsigned grants=0,announcements=0;
+            for (unsigned i=0;response && i<ThorMssChannel::ServiceSlots;++i) {
+                const auto &slot=channel.services[i];
+                const unsigned id=ThorQrtrProbe::FollowupIntent+1+i;
+                if (id>response && slot.size) {
+                    ++grants;
+                    if (slot.peerServer(channel.localNode,channel.one.word(8))) ++announcements;
+                }
+            }
+            IOLog("THOR QRTR V223: response=%u grants=%u announcements=%u\n",response,grants,announcements);
+        }
+        if (channel.uim.enabled) {
+            const auto &u=channel.uim;
+            IOLog("THOR UIM V226: directory_ms=%u announced=%u node=%u port=%u tx_end=%u done=%u response=%u result=%u error=%u status=%u slots=%u present=%u absent=%u fault=%u\n",
+                  channel.directoryMs,u.announced,u.peerNode,u.peerPort,u.end,u.done,u.response,
+                  u.result,u.error,unsigned(u.statusValid),u.slots,u.present,u.absent,u.fault);
+        }
+        if(channel.locator.enabled) {
+            const auto &l=channel.locator;
+            for(unsigned i=0;i<ThorMssChannel::ServiceSlots;++i) {
+                const unsigned id=ThorQrtrProbe::FollowupIntent+1+i;
+                if(!(l.requestMask&(1u<<id))) continue;
+                const auto &request=channel.services[i];
+                ThorPdLocator::Wire wire{};
+                if(!ThorPdLocator::respond(request,channel.localNode,channel.one.word(8),wire)) continue;
+                const auto *q=request.bytes+32;
+                IOLog("THOR LOCATOR QUERY: intent=%u node=%u port=%u txn=%u msg=%u total=%u listed=%u error=%u bytes=%u answered=%u\n",
+                      id,request.word(8),request.word(12),unsigned(q[1])+(unsigned(q[2])<<8),
+                      unsigned(q[3])+(unsigned(q[4])<<8),wire.totalDomains,wire.listedDomains,wire.qmiError,
+                      wire.size,unsigned(bool(l.answeredMask&(1u<<id))));
+            }
+            IOLog("THOR LOCATOR: published=%u requests=%#x replies=%u withdrawal_end=%u withdrawal_done=%u\n",
+                  l.published,l.requestMask,l.responses,l.deleteEnd,l.deleteDone);
+        }
+        if (channel.sawBlockedRequest)
+            IOLog("THOR IPCRTR V215: request_head cid=%u size=%u available=%u\n",
+                  channel.blockedRequestCid,channel.blockedRequestSize,channel.blockedRequestAvail);
+        if (channel.sawBlockedIntent)
+            IOLog("THOR IPCRTR V214: intent_head cid=%u count=%u available=%u\n",
+                  channel.blockedIntentCid,channel.blockedIntentCount,channel.blockedIntentAvail);
+        if (channel.sawBlockedOpen)
+            IOLog("THOR IPCRTR V213: held_head cid=%u len=%u priority=%u available=%u\n",
+                  channel.blockedId,channel.blockedNameLength,channel.blockedPriority,channel.blockedAvailable);
+        IOLog("THOR IPCRTR V212: final=%s established=%u rcid=%u local_ack=%u remote_close=%u close_ack=%u blocked_cmd=%u tx_head=%u tx_tail=%u rx_tail=%u rx_head=%u\n",
+              name,unsigned(channel.established),channel.remoteId,unsigned(channel.localAck),unsigned(channel.remoteClose),
+              unsigned(channel.localCloseAck),channel.blockedCmd,channel.txHead,channel.prevTxTail,channel.rxTail,channel.prevRxHead);
+    }
+    ThorMssVersion::Session session{};
+    ThorMssVersion::State final=ThorMssVersion::State::Missing;
+    bool run(IOMemoryMap *smem,IOMemoryMap *ipcc) {
+        using namespace ThorMssVersion;
+        PasVersionPort port{{reinterpret_cast<volatile uint8_t *>(smem->getVirtualAddress()),0x200000},
+            reinterpret_cast<volatile uint32_t *>(ipcc->getVirtualAddress()+QCOM_IPCC_SEND),0};
+        unsigned was=0;
+        if (!__atomic_compare_exchange_n(&glinkVersionClaimed,&was,1,false,__ATOMIC_ACQ_REL,__ATOMIC_ACQUIRE)) {
+            final=State::Epoch;
+            return port.live();
+        }
+        if (glinkCold.rc || !coldOk(glinkCold.data)) {
+            final=State::NoCold;
+            return port.live();
+        }
+        session.cold=glinkCold.data;
+        // A separate, explicitly selected trial keeps the remote started
+        // only for this bounded interval. Every exit rejoins PAS teardown.
+        clock_interval_to_deadline(250,NSEC_PER_MSEC,&port.deadline);
+        final=State::Timeout;
+        for (unsigned polls=0; polls<128 && port.inTime(); ++polls) {
+            const auto next=step(session,port);
+            if (next!=State::Wait) { final=next; break; }
+            if (port.inTime()) IOSleep(2);
+        }
+        if (channelRequested && final==State::Agreed) runChannel(port);
+        return port.live();
+    }
+    void report() const {
+        if (!enabled) return;
+        const auto &s=session;
+        using State=ThorMssVersion::State;
+        const char *name=final==State::Agreed ? "agreed" : final==State::Epoch ? "epoch" :
+            final==State::Blocked ? "blocked" : final==State::Unsupported ? "unsupported" :
+            final==State::NoCold ? "no-cold" : final==State::Missing ? "evidence-missing" :
+            final==State::Budget ? "budget" : "timeout";
+        for (unsigned i=0;i<s.frames;++i) {
+            const auto &f=s.log[i];
+            IOLog("THOR GLINK V209: frame=%u op=%s cmd=%u version=%u features=%#x tx_head=%u rx_tail=%u\n",
+                  i+1,f.tx?"tx":"rx",f.cmd,f.version,f.features,f.txHead,f.rxTail);
+        }
+        IOLog("THOR GLINK V209: final=%s offer=%u peer_version=%u peer_features=%#x sent_ack=%u matching_ack=%u "
+              "frames=%u managed=%u tx_head=%u rx_tail=%u blocked_cmd=%u tx_tail=%u rx_head=%u\n",name,s.offers,s.peerVersion,
+              s.peerFeatures,s.sentAck,s.matchingAck,s.frames,unsigned(s.bound),s.txHead,s.rxTail,s.blockedCmd,s.previousTxTail,s.previousRxHead);
+        reportChannel();
+    }
+};
diff --git a/ThorPas1Boot.h b/ThorPas1Boot.h
new file mode 100644
index 0000000000000000000000000000000000000000..83946620929661dbebcc2640ca2fdbb8ed9635c2
--- /dev/null
+++ b/ThorPas1Boot.h
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+namespace ThorPas1 {
+constexpr uint64_t Base=0x9fd00000,Bytes=0x3100000;
+constexpr unsigned MetadataBytes=5404,AllocationBytes=8192;
+enum class Stage { Inputs, Metadata, Edge, LoadOn, Rails, Cold, Init, Setup, Segments, ColdAfterLoad, Auth, Ready, Live };
+template<class Ops> Stage start(Ops &o) {
+    if (!o.inputs()) return Stage::Inputs;
+    if (!o.metadata()) return Stage::Metadata;
+    if (!o.prepare()) return Stage::Edge;
+    if (!o.on()) return Stage::LoadOn;
+    if (!o.rails()) return Stage::Rails;
+    if (!o.cold()) return Stage::Cold;
+    if (!o.init()) return Stage::Init;
+    if (!o.setup()) return Stage::Setup;
+    if (!o.load()) return Stage::Segments;
+    if (!o.cold()) return Stage::ColdAfterLoad;
+    if (!o.auth()) return Stage::Auth;
+    if (!o.ready()) return Stage::Ready;
+    o.notify();
+    return Stage::Live;
+}
+}
diff --git a/ThorPas1Kernel.inc b/ThorPas1Kernel.inc
new file mode 100644
index 0000000000000000000000000000000000000000..60fc6290b643599afaf635a591023fec10c28b92
--- /dev/null
+++ b/ThorPas1Kernel.inc
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Same PAS thread, secure-call gate, AOSS mailbox and WAITQ/IRQ owner as PAS4.
+#include "ThorPas1Boot.h"
+extern "C" bool pmap_pong_pa_valid(uint64_t);
+extern "C" int pong_thor_adsp_read_metadata(void *,uint32_t) __attribute__((weak_import));
+extern "C" int pong_thor_adsp_load_firmware(uint64_t,uint64_t,ThorPas4Write,void *) __attribute__((weak_import));
+extern "C" int pong_thor_adsp_prepare_cold(void) __attribute__((weak_import));
+extern "C" int pong_thor_adsp_edge_state(void) __attribute__((weak_import));
+extern "C" bool pong_thor_adsp_proxy_handover(void) __attribute__((weak_import));
+extern "C" void pong_thor_adsp_ready_notify(void) __attribute__((weak_import));
+static IOBufferMemoryDescriptor *adspMetadataOwner;
+struct PasAdspOps {
+    uint64_t metadataPhys{};
+    bool loadActive{}, initIssued{}, prepared{}, authConfirmed{}, uncertain{}, waitingHandover{}, proxyReleased{};
+    IOBufferMemoryDescriptor *descriptor{};
+    IOMemoryMap *ipcc{};
+    bool inputs() {
+        if (!pasGlinkFlag("thor-adsp-pas1") || adspMetadataOwner || thorAossUsesAdspOwner() || !pasBoardWindow() || !powerLock ||
+            !pong_thor_adsp_read_metadata || !pong_thor_adsp_load_firmware ||
+            !pong_thor_adsp_prepare_cold || !pong_thor_adsp_edge_state || !pong_thor_adsp_proxy_handover || !pong_thor_adsp_ready_notify) return false;
+        // Test every physical page against XNU's actual sparse bank list.
+        for (uint64_t off=0;off<ThorPas1::Bytes;off+=4096)
+            if (pmap_pong_pa_valid(ThorPas1::Base+off)) return false;
+        bool admitted=false;
+        IOLockLock(powerLock);
+        const auto &a=adspRails[0], &b=adspRails[1];
+        // Match both real regulator-specific level tables before any write.
+        admitted=a.address && b.address && a.address!=b.address &&
+                 !modemArc.find(a.address) && !modemArc.find(b.address) &&
+                 a.corner>0 && b.corner>0 && a.highest>=a.corner && a.highest<=15 &&
+                 b.highest>=b.corner && b.highest<=15 &&
+                 modemArc.retainedMask()==ThorModemArc::allRetained;
+        IOLockUnlock(powerLock);
+        if (!admitted) return false;
+        ipcc=thorMapModemRange(0x0ed18000,0x1000);
+        return ipcc && ipcc->getVirtualAddress();
+    }
+    bool metadata() {
+        constexpr unsigned bytes=ThorPas1::AllocationBytes;
+        descriptor=IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+                    IOOptionBits(kIODirectionInOut)|kIOMemoryHostPhysicallyContiguous,bytes,0xfffff000ULL);
+        if (!descriptor || descriptor->prepare()!=kIOReturnSuccess) return false;
+        prepared=true;
+        IOByteCount length=0;
+        metadataPhys=descriptor->getPhysicalSegment(0,&length,kIOMemoryMapperNone);
+        void *dst=descriptor->getBytesNoCopy();
+        if (!dst || !metadataPhys || (metadataPhys&4095) || length<bytes ||
+            metadataPhys>0x100000000ULL-bytes || !pmap_pong_pa_valid(metadataPhys) ||
+            !pmap_pong_pa_valid(metadataPhys+bytes-4096)) return false;
+        bzero(dst,bytes);
+        const int rc=pong_thor_adsp_read_metadata(dst,ThorPas1::MetadataBytes);
+        if (rc) { IOLog("THOR PAS1 V226: metadata_errno=%d\n",rc); return false; }
+        for (unsigned i=0;i<bytes;i+=64)
+            __asm__ volatile("dc cvac,%0"::"r"(static_cast<uint8_t *>(dst)+i):"memory");
+        __asm__ volatile("dsb sy" ::: "memory");
+        return true;
+    }
+    bool prepare() { return pong_thor_adsp_prepare_cold()==0 && cold(); }
+    bool cold() {
+        const bool owned=pong_thor_adsp_edge_state()==0;
+        if (!owned && loadActive) uncertain=true; // Remote changed owner before our AUTH.
+        return owned;
+    }
+    bool on() {
+        static constexpr char packet[64]="{class: image, res: load_state, name: adsp, val: on}";
+        bool sent=false;const char *rc=thorAossRequest(packet,sent);
+        if (rc) IOLog("THOR PAS1 V226: load_on=%s published=%u\n",rc,unsigned(sent));
+        // An unexpected acknowledgment after publication retains the transaction.
+        // Sending OFF here could overtake the pending ON.
+        if (rc && sent) uncertain=true;
+        loadActive=!rc;return loadActive;
+    }
+    bool rails() {
+        // v228: the order upstream Pong and Fold 2 verify for cape-adsp-pas, and the
+        // one the modem's CX/MSS/XO floors already use here: one write per rail with
+        // the highest legal ARC row, and no read. v226/v227 first read each rail
+        // through a scoped TCS transaction, which may retire only on its TCS interrupt
+        // status; only ACTIVE0 has that interrupt enabled on this board, so the read
+        // always timed out ("response-timeout-retained"), the entry it left armed
+        // quarantined lcx.lvl, and ADSP stopped before PAS_INIT_IMAGE on every boot.
+        // LCX/LMX are shared rails: ARC takes the maximum of all voters, so this
+        // boot-lifetime vote never lowers anything and nothing needs restoring.
+        IOLockLock(powerLock);
+        bool held=mapped();
+        unsigned corner[2]{},top[2]{};
+        for (unsigned i=0;held && i<2;++i) {
+            const auto &r=adspRails[i];
+            corner[i]=unsigned(r.corner);top[i]=unsigned(r.highest);
+            held=rawVote(r.address,top[i]);
+        }
+        IOLockUnlock(powerLock);
+        IOLog("THOR PAS1 V228: rails=%u lcx=%u/%u lmx=%u/%u retained=1 xo=pas4-retained\n",
+              unsigned(held),corner[0],top[0],corner[1],top[1]);
+        return held;
+    }
+    void releaseProxy() {
+        // No baseline was read, so there is none to put back. A zero vote here would
+        // drive the shared LCX/LMX parents below what the GPU and modem already hold.
+        proxyReleased=true;
+        IOLog("THOR PAS1 V228: proxy_retained=1\n");
+    }
+    bool command(unsigned id,Args args) {
+        const auto r=ThorPas4::transact(args,pasInvoke,pasWait,pasSignal,[]{ IOSleep(30); });
+        IOLog("THOR PAS1 V226: cmd=%u smc=%lld service=%lld\n",id,(long long)r.status,(long long)r.value);
+        uncertain=r.status!=0;
+        return !r.status && !r.value;
+    }
+    bool init() {
+        initIssued=true;adspMetadataOwner=descriptor;
+        return command(QCOM_SCM_PAS_INIT_IMAGE,{qcom_scm_fn(QCOM_SCM_SVC_PIL,QCOM_SCM_PAS_INIT_IMAGE),
+                       qcom_scm_args(2,QCOM_SCM_VAL,QCOM_SCM_RW,0),1,metadataPhys,0});
+    }
+    bool setup() {
+        return command(QCOM_SCM_PAS_MEM_SETUP,{qcom_scm_fn(QCOM_SCM_SVC_PIL,QCOM_SCM_PAS_MEM_SETUP),
+                       qcom_scm_args(3,QCOM_SCM_VAL,QCOM_SCM_VAL,QCOM_SCM_VAL),1,ThorPas1::Base,ThorPas1::Bytes});
+    }
+    bool load() {
+        PasWindow window{};window.base=ThorPas1::Base;window.capacity=ThorPas1::Bytes;
+        const int rc=pong_thor_adsp_load_firmware(window.base,window.capacity,pasStore,&window);
+        __asm__ volatile("dsb sy" ::: "memory");
+        if (window.map) window.map->release();
+        IOLog("THOR PAS1 V226: segments_errno=%d file=%llu zero=%llu\n",rc,
+              (unsigned long long)window.file,(unsigned long long)window.zero);
+        return !rc && window.file && window.zero;
+    }
+    bool auth() {
+        authConfirmed=command(QCOM_SCM_PAS_AUTH_AND_RESET,ThorPas4::authAndReset(1));
+        return authConfirmed;
+    }
+    bool ready() {
+        // Notify LPASS of our published SMP2P descriptor. Do not drain IPCC
+        // interrupts or consume GLINK VERSION on the battery worker's edge.
+        auto send=reinterpret_cast<volatile uint32_t *>(ipcc->getVirtualAddress()+QCOM_IPCC_SEND);
+        __asm__ volatile("dsb oshst" ::: "memory");
+        *send=qcom_ipcc_id(QCOM_IPCC_CLIENT_LPASS,QCOM_IPCC_SIGNAL_SMP2P);
+        __asm__ volatile("dsb oshst" ::: "memory");
+        uint64_t until=0;clock_interval_to_deadline(5,NSEC_PER_SEC,&until);
+        int state;bool handover=false;
+        do {
+            state=pong_thor_adsp_edge_state();
+            handover|=pong_thor_adsp_proxy_handover();
+            if (state==1) {
+                // A startup proxy may be released only if LPASS took over.
+                // If this trial never raised a rail, the inherited AP vote suffices.
+                IOLockLock(powerLock);
+                const bool raised=adspProxy.raised();
+                IOLockUnlock(powerLock);
+                if (handover || !raised) return true;
+                if (!waitingHandover) {
+                    waitingHandover=true;clock_interval_to_deadline(5,NSEC_PER_SEC,&until);
+                }
+            }
+            if (state==2) break;
+            IOSleep(20);
+        } while(mach_absolute_time()<until);
+        IOLog("THOR PAS1 V226: ready_edge=%d handover=%u\n",state,unsigned(handover));
+        return false;
+    }
+    void notify() { releaseProxy();pong_thor_adsp_ready_notify(); }
+    void finish(bool live) {
+        if (!live && authConfirmed && !uncertain) {
+            const bool stopped=command(QCOM_SCM_PAS_SHUTDOWN,
+                {qcom_scm_fn(QCOM_SCM_SVC_PIL,QCOM_SCM_PAS_SHUTDOWN),qcom_scm_args(1,QCOM_SCM_VAL,0,0),1,0,0});
+            if (stopped) authConfirmed=false;
+            IOLog("THOR PAS1 V226: shutdown_confirmed=%u\n",unsigned(stopped));
+        }
+        if (!live && !uncertain && !authConfirmed && loadActive) {
+            releaseProxy();
+            static constexpr char off[64]="{class: image, res: load_state, name: adsp, val: off}";
+            bool sent=false;const char *rc=thorAossRequest(off,sent);
+            IOLog("THOR PAS1 V226: rollback_load=%s published=%u\n",rc?rc:"off",unsigned(sent));
+        }
+        if (!initIssued && descriptor) {
+            if (prepared) descriptor->complete();
+            descriptor->release();
+        }
+        if (!live && (uncertain || authConfirmed))
+            IOLog("THOR PAS1 V226: cleanup=retained uncertain=%u auth_confirmed=%u\n",
+                  unsigned(uncertain),unsigned(authConfirmed));
+        if (ipcc) ipcc->release();
+    }
+};
+static void pasStartAdsp()
+{
+    PasAdspOps ops{};
+    const auto stage=ThorPas1::start(ops);
+    static const char *const states[]={"inputs","metadata","cold-prepare","load-on","rails","cold-pre-init",
+                                       "init","setup","segments","cold-pre-auth","auth","ready-timeout-or-fatal","ready"};
+    IOLog("THOR PAS1 V226: final=%s\n",states[unsigned(stage)]);
+    ops.finish(stage==ThorPas1::Stage::Live);
+}
diff --git a/ThorPas4Kernel.inc b/ThorPas4Kernel.inc
new file mode 100644
index 0000000000000000000000000000000000000000..9e6abd4bbc8ac0d12624baaa07da5817010d4e60
--- /dev/null
+++ b/ThorPas4Kernel.inc
@@ -0,0 +1,485 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// Included by the Thor resource-only translation unit.
+#include <IOKit/IORegistryEntry.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSData.h>
+#include <kern/thread.h>
+#include <kern/thread_call.h>
+#include "ThorPas4Session.h"
+#include "ThorPasProbe.h"
+#include "ThorMssVersion.h"
+
+extern "C" IOReturn armcpu_spi_attach(uint32_t, bool, void (*)(void *), void *, uint32_t *, uint64_t *) __attribute__((weak_import));
+using ThorPas4Write = bool (*)(void *, uint64_t, const uint8_t *, uint32_t);
+extern "C" int pong_thor_modem_load_firmware(uint64_t, uint64_t, ThorPas4Write, void *) __attribute__((weak_import));
+
+namespace {
+using ThorPas4::Args;
+using ThorPas4::Result;
+constexpr uint64_t pasBase = 0x8bc00000ULL, pasBytes = 0x13200000;
+constexpr uint32_t scmIntid = 32 + 0x3a2; // Thor live FDT: SPI 930, rising edge
+IOLock *pasEvents;
+ThorPas4::WakeQueues pasQueues;
+thread_call_t pasIrqWork;
+uint32_t pasLaunched;
+bool pasQueueError;
+
+static Result pasSmc(Args args, uint64_t a6)
+{
+    register uint64_t x0 __asm__("x0") = args.function, x1 __asm__("x1") = args.types;
+    register uint64_t x2 __asm__("x2") = args.a, x3 __asm__("x3") = args.b;
+    register uint64_t x4 __asm__("x4") = args.c, x5 __asm__("x5") = 0;
+    register uint64_t x6 __asm__("x6") = a6, x7 __asm__("x7") = 0;
+    __asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4),
+        "+r"(x5), "+r"(x6), "+r"(x7) :: "x8","x9","x10","x11","x12","x13","x14","x15","x16","x17","cc","memory");
+    return {static_cast<int64_t>(x0), x1, x2, x3, x6};
+}
+
+static Result pasInvoke(Args a)
+{
+    // Serialize the whole A6 continuation chain. WAITQ sleeps and EBUSY
+    // backoff occur in the caller after this shared gate has been released.
+    if (!pong_scm_call_lock()) return {-2005,0,0,0,0};
+    const auto r = ThorPas4::uninterrupted(a,pasSmc);
+    pong_scm_call_unlock();
+    return r;
+}
+static bool pasSignal(uint32_t queue, uint32_t flags)
+{
+    IOLockLock(pasEvents);
+    const bool ok = pasQueues.signal(queue, flags);
+    if (!ok) pasQueueError = true;
+    IOLockWakeup(pasEvents, &pasQueues, false);
+    IOLockUnlock(pasEvents);
+    return ok;
+}
+
+static void pasDrain(void *, void *)
+{
+    // The shipping Cape kernel uses a standard SMC for GET_WQ_CTX and
+    // drains more_pending in work context, outside the hardware handler.
+    for (unsigned n = 0; n < 32; ++n) {
+        const Args get = ThorPas4::waitCommand(ThorPas4::GetContext, 0);
+        Result r = pasInvoke(get);
+        for (unsigned busy = 0; r.status == QCOM_SCM_V2_EBUSY && busy < 20; ++busy) {
+            IOSleep(30);
+            r = pasInvoke(get);
+        }
+        if (r.status || r.value > UINT32_MAX || (r.token != 1 && r.token != 2) ||
+            !pasSignal(uint32_t(r.value), uint32_t(r.token))) {
+            IOLog("THOR PAS4 V187: GET_WQ_CTX status=%lld queue=%llu flags=%llu\n",
+                  (long long)r.status,(unsigned long long)r.value,(unsigned long long)r.token);
+            return;
+        }
+        if (!r.flags) return;
+    }
+    thread_call_enter(pasIrqWork);
+}
+static void pasIrq(void *) { thread_call_enter(pasIrqWork); }
+
+static bool pasWait(uint32_t queue)
+{
+    uint64_t deadline;
+    clock_interval_to_deadline(2, NSEC_PER_SEC, &deadline);
+    IOLockLock(pasEvents);
+    const bool ok = ThorPas4::waitForWake(pasQueues,queue,pasQueueError,[&](bool) {
+        if (IOLockSleepDeadline(pasEvents, &pasQueues, deadline, THREAD_UNINT) != THREAD_TIMED_OUT)
+            return false;
+        // Fail safely after the recovery budget. Keep the session and any
+        // late queue token owned; never resume or replay the command.
+        pasQueueError = true;
+        IOLockUnlock(pasEvents);
+        IOLog("THOR PAS4 V188: waitq=%u deadline expired, protocol stopped; token retained\n",queue);
+        IOLockLock(pasEvents);
+        return true;
+    });
+    IOLockUnlock(pasEvents);
+    return ok;
+}
+
+static Result pasCommandResult(uint32_t cmd, Args args, bool &direct)
+{
+    // Retain the v187 stage marker for release provenance; the V188 suffix is
+    // reserved for the new bounded-wait and admission states below.
+    IOLog("THOR PAS4 V187: state=submit cmd=%u\n",cmd);
+    const auto r = ThorPas4::transact(args, [&](Args current) {
+        direct = current.function == args.function;
+        return pasInvoke(current);
+    }, pasWait, pasSignal, [] { IOSleep(30); });
+    IOLog("THOR PAS4 V187: cmd=%u smc=%lld service=%lld accepted=%u\n",cmd,(long long)r.status,
+          (long long)r.value,unsigned(!r.status && !r.value));
+    if (r.status <= -2001 && r.status >= -2006)
+        IOLog("THOR PAS4 V188: state=protocol-stopped ctx=%#llx a6=%#llx\n",
+              (unsigned long long)r.token,(unsigned long long)r.a6);
+    return r;
+}
+
+static bool pasCommand(uint32_t cmd, Args args)
+{
+    bool direct = false;
+    const auto r = pasCommandResult(cmd,args,direct);
+    return !r.status && !r.value;
+}
+
+// Decode the inbound flags together. Host STOP is an independent outbound word.
+static void pasLogMss(const char *phase, int host, uint32_t stop, int remote, uint32_t word)
+{
+    const bool valid = remote == QcomSmemOk;
+    IOLog("THOR PAS4 SMP2P: phase=%s host=%d stop=%d remote=%d inbound_word=%#x "
+          "fatal=%d ready=%d handover=%d stop_ack=%d shutdown_ack=%d\n",
+          phase, host, host == QcomSmemOk ? int(stop) : -1, remote, word,
+          valid ? !!(word & QcomMssFatal) : -1, valid ? !!(word & QcomMssReady) : -1,
+          valid ? !!(word & QcomMssHandover) : -1, valid ? !!(word & QcomMssStopAck) : -1,
+          valid ? !!(word & QcomMssShutdownAck) : -1);
+}
+
+static bool pasCheckColdMss(const char *phase)
+{
+    auto map = thorMapMss();
+    if (!map) {
+        IOLog("THOR PAS4 SMP2P: phase=%s state=map-failed\n", phase);
+        return false;
+    }
+    int host, remote;
+    uint32_t stop, word;
+    thorReadMssWords(map, host, stop, remote, word);
+    map->release();
+    pasLogMss(phase, host, stop, remote, word);
+    return host == QcomSmemOk && !stop && remote == QcomSmemMissing;
+}
+
+static bool pasWaitReady()
+{
+    auto map = thorMapMss();
+    if (!map) {
+        IOLog("THOR PAS4 SMP2P: phase=ready-wait state=map-failed\n");
+        return false;
+    }
+    const uint64_t began = mach_absolute_time();
+    uint64_t deadline = 0;
+    clock_interval_to_deadline(5, NSEC_PER_SEC, &deadline);
+    unsigned samples = 0;
+    int lastHost = 0, lastRemote = 0;
+    uint32_t lastStop = 0, lastWord = 0;
+    const char *state;
+    bool accepted = false;
+    for (;;) {
+        int host, remote;
+        uint32_t stop, word;
+        thorReadMssWords(map, host, stop, remote, word);
+        if (!samples || host != lastHost || remote != lastRemote || stop != lastStop || word != lastWord)
+            pasLogMss("ready-wait", host, stop, remote, word);
+        ++samples;
+        lastHost = host;
+        lastRemote = remote;
+        lastStop = stop;
+        lastWord = word;
+        if (remote == QcomSmemOk && (word & QcomMssFatal)) {
+            state = "remote-fatal";
+            break;
+        }
+        if (remote == QcomSmemOk && (word & QcomMssReady) && host == QcomSmemOk && !stop) {
+            state = "ready";
+            accepted = true;
+            break;
+        }
+        if (mach_absolute_time() >= deadline) {
+            state = "ready-timeout";
+            break;
+        }
+        IOSleep(20);
+    }
+    map->release();
+    uint64_t elapsed = 0;
+    absolutetime_to_nanoseconds(mach_absolute_time() - began, &elapsed);
+    IOLog("THOR PAS4 SMP2P: phase=ready-wait state=%s elapsed_ms=%llu samples=%u\n",
+          state, (unsigned long long)(elapsed / 1000000), samples);
+    return accepted;
+}
+static bool pasProbeRequested()
+{
+    IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+    auto p = chosen ? OSDynamicCast(OSData, chosen->getProperty("thor-pas4-probe")) : nullptr;
+    uint32_t value = 0;
+    if (p && p->getLength() == sizeof(value)) memcpy(&value,p->getBytesNoCopy(),sizeof(value));
+    if (chosen) chosen->release();
+    int arg = 0;
+    if (PE_parse_boot_argn("pas4trial", &arg, sizeof(arg))) return arg == 1;
+    return value == 1;
+}
+
+// No ownership is released after a failed or indeterminate secure call.
+// The dedicated test image never restarts the remote or registers a consumer.
+#include "ThorMssGlinkObserve.inc"
+#include "ThorMssVersionKernel.inc"
+#include "ThorMssServe.inc"
+
+struct PasProbeOps {
+    IOMemoryMap *smemMap, *mutexMap, *ipccMap;
+    uint32_t stopOffset;
+    PasVersionTrial version{};
+
+    bool graceful{};
+    bool changeStop(bool set) {
+        QcomSmem smem{reinterpret_cast<volatile uint8_t *>(smemMap->getVirtualAddress()),0x200000};
+        auto *mutex = reinterpret_cast<volatile uint32_t *>(mutexMap->getVirtualAddress());
+        int rc = QcomSmemUnstable;
+        if (pong_smem_lock(mutex)) {
+            uint32_t word = 0;
+            rc = set ? qcom_smem_mss_inbound(&smem,&word) : QcomSmemOk;
+            if (!rc && set && (word & (QcomMssStopAck | QcomMssShutdownAck | QcomMssFatal))) rc = QcomSmemInvalidSignal;
+            if (!rc) rc = qcom_smem_mss_owned_stop(&smem,&stopOffset,set ? 1 : 0);
+            if (!rc) {
+                auto *send = reinterpret_cast<volatile uint32_t *>(ipccMap->getVirtualAddress() + QCOM_IPCC_SEND);
+                __asm__ volatile("dsb oshst" ::: "memory");
+                *send = qcom_ipcc_id(2, QCOM_IPCC_SIGNAL_SMP2P);
+                __asm__ volatile("dsb oshst" ::: "memory");
+            }
+            pong_smem_unlock(mutex);
+        }
+        IOLog("THOR PAS4 PROBE: stop=%s rc=%d\n",set?"assert":"clear",rc);
+        return rc == QcomSmemOk;
+    }
+    bool authenticate() { return pasCommand(QCOM_SCM_PAS_AUTH_AND_RESET,ThorPas4::authAndReset(4)); }
+    bool observeReady() {
+        const bool ready = pasWaitReady();
+        if (ready) pasGlinkPhase(GlinkPhase::Ready);
+        // v228: with thor-rmtfs-serve the AP answers the modem's QRTR HELLO with the
+        // two services it waits for (locator, rmtfs) and keeps it up to finish its
+        // initialization. Either way the caller continues to the unchanged stop path.
+        if (ready && pasGlinkFlag("thor-rmtfs-serve")) { ThorServe::run(smemMap,mutexMap,ipccMap); return true; }
+        return ready && (!version.enabled || version.run(smemMap,ipccMap));
+    }
+    bool requestStop() { pasGlinkPhase(GlinkPhase::StopRequested); return changeStop(true); }
+    bool clearStop() { const bool cleared=changeStop(false); graceful=graceful && cleared; return cleared; }
+    void waitStopAck() {
+        uint64_t deadline = 0; clock_interval_to_deadline(5,NSEC_PER_SEC,&deadline);
+        int host, remote; uint32_t stop, word;
+        do {
+            thorReadMssWords(smemMap,host,stop,remote,word);
+            if (host != QcomSmemOk || !stop || remote != QcomSmemOk || (word & (QcomMssFatal|QcomMssStopAck))) break;
+            IOSleep(20);
+        } while (mach_absolute_time() < deadline);
+        graceful=host==QcomSmemOk && stop && remote==QcomSmemOk &&
+                 (word&QcomMssStopAck) && !(word&QcomMssFatal);
+        pasLogMss("probe-stop",host,stop,remote,word);
+    }
+    bool shutdown() {
+        pasGlinkPhase(GlinkPhase::Shutdown);
+        const Args args{qcom_scm_fn(QCOM_SCM_SVC_PIL,QCOM_SCM_PAS_SHUTDOWN),
+                        qcom_scm_args(1,QCOM_SCM_VAL,0,0),4,0,0};
+        return ThorPasProbe::stopOwned([&](unsigned attempt) {
+            bool direct = false;
+            const auto r = pasCommandResult(QCOM_SCM_PAS_SHUTDOWN,args,direct);
+            const auto classification = ThorPasProbe::classifyShutdown(direct,r.status,r.value);
+            IOLog("THOR PAS4 STOP V207: attempt=%u direct=%u x0=%#llx x1=%#llx result=%s\n",
+                  attempt,unsigned(direct),(unsigned long long)r.status,(unsigned long long)r.value,
+                  classification == ThorPasProbe::StopResult::Confirmed ? "confirmed" :
+                  classification == ThorPasProbe::StopResult::ReturnedRefusal ? "returned-refusal" : "unknown");
+            return classification;
+        }, [](unsigned ms) { IOSleep(ms); });
+    }
+    bool loadOff() {
+        constexpr char off[64] = "{class: image, res: load_state, name: modem, val: off}";
+        bool published = false;
+        auto failure = thorAossRequest(off, published);
+        IOLog("THOR PAS4 PROBE: aoss-off=%s published=%u\n",failure ? failure : "acked",unsigned(published));
+        return !failure && published;
+    }
+};
+
+static bool pasRunProbe()
+{
+    auto r = thorModemIccSnapshot();
+    const auto offset = __atomic_load_n(&pasFreshStop,__ATOMIC_ACQUIRE);
+    unsigned heldRails = 0;
+    if (powerLock) {
+        IOLockLock(powerLock);
+        heldRails = modemArc.retainedMask();
+        IOLockUnlock(powerLock);
+    }
+    const bool absent = r.diagnosticOnly && !r.authAllowed && r.baselineSources == 0 &&
+                        !__atomic_load_n(&modemIccHeld,__ATOMIC_ACQUIRE);
+    ThorPasProbe::Admission admission{true, bool(__atomic_load_n(&pasMethodsAvailable,__ATOMIC_ACQUIRE)), bool(offset),
+        r.description == ThorIccDescriptionState::Complete && r.validatedPlans == 3,
+        heldRails == ThorModemArc::allRetained, absent};
+    IOLog("THOR PAS4 PROBE: methods=%u fresh_stop=%u routes=%u rails=%u provider_absent=%u held_mask=%#x\n",
+          unsigned(admission.methods),unsigned(admission.newOutbound),unsigned(admission.routes),unsigned(heldRails == ThorModemArc::allRetained),unsigned(absent),heldRails);
+    if (!admission.allowed()) return false;
+    bool closed=false;
+    auto smem = thorMapModemRange(0x80900000,0x200000);
+    auto mutex = smem ? thorMapModemRange(0x1f43000,0x1000) : nullptr;
+    auto ipcc = mutex ? thorMapModemRange(0x0ed18000,0x1000) : nullptr;
+    if (ipcc && pasCheckColdMss("probe-pre-auth")) {
+        PasProbeOps ops{smem,mutex,ipcc,offset};
+        ops.version.enabled=!pasGlinkFlag("thor-rmtfs-serve") && pasVersionSelected();
+        pasGlinkBegin(smem);
+        auto outcome = ThorPasProbe::run(ops);
+        closed = outcome==ThorPasProbe::End::Stopped && ops.graceful;
+        pasGlinkReport();
+        ops.version.report();
+        IOLog("THOR PAS4 PROBE: final=%s rails=boot-retained carveout=boot-retained auth-retry=none shutdown-policy=cape-bounded\n",
+              outcome == ThorPasProbe::End::Stopped ? "shutdown-accepted-load-off" :
+              outcome == ThorPasProbe::End::AuthUnknown ? "auth-not-confirmed" :
+              outcome == ThorPasProbe::End::ShutdownUnknown ? "shutdown-not-confirmed" :
+              outcome == ThorPasProbe::End::StopBitUnconfirmed ? "shutdown-accepted-stop-bit-unconfirmed" : "shutdown-accepted-load-off-unconfirmed");
+    } else IOLog("THOR PAS4 PROBE: state=stop-transport-or-cold-owner-unavailable\n");
+    if (ipcc) ipcc->release();
+    if (mutex) mutex->release();
+    if (smem) smem->release();
+    return closed;
+}
+
+struct PasWindow {
+    IOMemoryMap *map;
+    uint64_t offset, bytes, file, zero;
+    uint64_t base=pasBase, capacity=pasBytes;
+};
+static bool pasStore(void *context, uint64_t offset, const uint8_t *source, uint32_t length)
+{
+    auto &w = *static_cast<PasWindow *>(context);
+    if (!length || offset >= w.capacity || length > w.capacity - offset) return false;
+    if (!w.map || offset < w.offset || offset + length > w.offset + w.bytes) {
+        if (w.map) { __asm__ volatile("dsb sy" ::: "memory"); w.map->release(); w.map = nullptr; }
+        w.offset = offset & ~uint64_t(4095);
+        // Amortize mappings across small contiguous FAT clusters without
+        // reserving a contiguous 306 MiB VA window. Store only actual spans.
+        const uint64_t left = w.capacity - w.offset;
+        w.bytes = left < 0x100000 ? left : 0x100000;
+        IODeviceMemory *memory = IODeviceMemory::withRange(w.base + w.offset, w.bytes);
+        if (!memory) return false;
+        w.map = memory->map(kIOMapAnywhere | kIOMapWriteCombineCache);
+        memory->release();
+        if (!w.map || !w.map->getVirtualAddress() || w.map->getLength() != w.bytes ||
+            offset + length > w.offset + w.bytes) return false;
+    }
+    uint8_t *target = reinterpret_cast<uint8_t *>(w.map->getVirtualAddress()) + (offset - w.offset);
+    if (source) { memcpy(target, source, length); w.file += length; }
+    else { bzero(target,length); w.zero += length; }
+    return true;
+}
+
+static bool pasEdgeConfigured()
+{
+    // armcpu_spi_attach's route word echoes the requested trigger type.
+    // Read the actual distributor configuration on the FDT-validated board.
+    IODeviceMemory *memory = IODeviceMemory::withRange(0x17100000,4096);
+    if (!memory) return false;
+    IOMemoryMap *map = memory->map(kIOMapAnywhere | kIOMapInhibitCache | kIOMapReadOnly);
+    memory->release();
+    if (!map) return false;
+    const auto addr = map->getVirtualAddress();
+    const uint32_t cfg = addr && map->getLength() == 4096 ?
+        *reinterpret_cast<volatile uint32_t *>(addr + 0xc00 + 4 * (scmIntid / 16)) : 0;
+    __asm__ volatile("dmb oshld" ::: "memory");
+    map->release();
+    return ((cfg >> (2 * (scmIntid % 16))) & 2) != 0;
+}
+
+static bool pasBoardWindow()
+{
+    // The kernel's metadata lease already verified that all four FDT
+    // carveouts are disjoint from VM. Check the exact MPSS range being mapped.
+    IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+    auto data = chosen ? OSDynamicCast(OSData, chosen->getProperty("thor-cellular-profile")) : nullptr;
+    uint32_t words[28]{};
+    const bool found = data && data->getLength() == sizeof(words);
+    if (found) memcpy(words, data->getBytesNoCopy(), sizeof(words));
+    if (chosen) chosen->release();
+    return found && words[2] == 0xc141accf && words[10] == pasBase && words[11] == pasBytes;
+}
+
+#include "ThorPas1Kernel.inc"
+
+static void pasWorker(void *, wait_result_t)
+{
+    thread_set_thread_name(current_thread(),"thor_pas4");
+    uint64_t metadata = 0;
+    uint32_t stop = 0, ready = 0;
+    int host = 0, remote = 0;
+    if (!armcpu_spi_attach || !pong_thor_modem_load_firmware || !PongLowDma::modemMetadataAddress(metadata) ||
+        !metadata || (metadata & 4095) || metadata > 0x100000000ULL - PongLowDma::ModemMetadataBytes ||
+        !pasBoardWindow() || thorReadMss(host,stop,remote,ready) || host != QcomSmemOk ||
+        stop || remote != QcomSmemMissing) {
+        IOLog("THOR PAS4 V187: state=memory-or-cold-owner-unavailable\n");
+        return;
+    }
+    pasEvents = IOLockAlloc();
+    if (!pasEvents) { IOLog("THOR PAS4 V187: state=wait-lock-allocation-failed\n"); return; }
+    pasIrqWork = thread_call_allocate_with_options(pasDrain,nullptr,THREAD_CALL_PRIORITY_KERNEL,THREAD_CALL_OPTIONS_ONCE);
+    if (!pasIrqWork) { IOLockFree(pasEvents); IOLog("THOR PAS4 V187: state=irq-work-allocation-failed\n"); return; }
+    uint32_t route = 0;
+    uint64_t affinity = 0;
+    const IOReturn irq = armcpu_spi_attach(scmIntid,true,pasIrq,nullptr,&route,&affinity);
+    IOLog("THOR PAS4 V187: irq=%u rc=%#x route=%#x\n",scmIntid,unsigned(irq),route);
+    if (irq != kIOReturnSuccess) { thread_call_free(pasIrqWork); IOLockFree(pasEvents); return; }
+    if ((route & 7) != 7 || !pasEdgeConfigured()) {
+        IOLog("THOR PAS4 V187: state=irq-edge-readback-failed\n");
+        return; // The registered IRQ still owns its callback.
+    }
+    PasWindow window{};
+    int rc = 0;
+    const auto stage = ThorPas4::stageImage(metadata,pasBase,pasBytes,pasCommand,[&] {
+        rc = pong_thor_modem_load_firmware(pasBase,pasBytes,pasStore,&window);
+        __asm__ volatile("dsb sy" ::: "memory");
+        if (window.map) window.map->release();
+        return rc == 0;
+    });
+    if (stage == ThorPas4::Stage::InitRejected) return;
+    if (stage == ThorPas4::Stage::MemoryRejected) {
+        IOLog("THOR PAS4 V187: state=init-owned memory-unconfigured\n");
+        return;
+    }
+    // An initialized but unstarted PAS session keeps its metadata and its
+    // carveout for this boot, including on error. Cape SHUTDOWN is a stop
+    // for a running owned session. Never authenticate partial segments.
+    if (rc) {
+        IOLog("THOR PAS4 V188: state=load-failed-owned file=%llu zero=%llu rc=%d auth-reset=not-issued\n",
+            (unsigned long long)window.file,(unsigned long long)window.zero,rc);
+        return;
+    }
+    IOLog("THOR PAS4 V188: state=segments-loaded-owned file=%llu zero=%llu rc=0 "
+          "icc=deferred-no-inherited-baseline\n",
+        (unsigned long long)window.file,(unsigned long long)window.zero);
+    if (pasProbeRequested()) {
+        thorLogStagedBcm();
+        if (pasRunProbe()) pasStartAdsp();
+        return;
+    }
+    if (!thorModemIccHeld()) {
+        // Do not authenticate a modem while the shared APSS ICC baseline is
+        // unknown. Keep the PAS session, metadata and carveout owned for this
+        // boot; a later owner-aware implementation may resume this phase.
+        pasCheckColdMss("auth-gate");
+        IOLog("THOR PAS4 V188: state=auth-gated icc=baseline-unknown "
+              "auth-reset=not-issued\n");
+        return;
+    }
+    // Staging the signed segments can take several seconds. The AP STOP
+    // request and inbound MSS item may have changed since the initial check.
+    if (!pasCheckColdMss("pre-auth")) {
+        IOLog("THOR PAS4 SMP2P: phase=pre-auth state=cold-owner-unconfirmed session=retained\n");
+        return;
+    }
+    if (!pasCommand(QCOM_SCM_PAS_AUTH_AND_RESET, ThorPas4::authAndReset(4))) {
+        IOLog("THOR PAS4 V188: state=auth-reset-failed ready=not-observed stop=not-observed "
+              "fatal=not-probed\n");
+        return;
+    }
+    IOLog("THOR PAS4 V188: state=auth-reset-accepted ready=pending stop=pending fatal=not-probed\n");
+    if (!pasWaitReady()) {
+        IOLog("THOR PAS4 V188: state=auth-reset-no-ready session=retained\n");
+        return;
+    }
+    IOLog("THOR PAS4 V188: state=modem-ready auth-reset=accepted icc=held\n");
+}
+}
+
+extern "C" void pong_thor_pas4_resources_ready(void)
+{
+    if (__atomic_exchange_n(&pasLaunched,1U,__ATOMIC_ACQ_REL)) return;
+    thread_t t = THREAD_NULL;
+    const int rc = kernel_thread_start(pasWorker,nullptr,&t);
+    if (rc == KERN_SUCCESS) thread_deallocate(t);
+    else IOLog("THOR PAS4 V187: state=worker-unavailable rc=%d\n",rc);
+}
diff --git a/ThorPas4Session.h b/ThorPas4Session.h
new file mode 100644
index 0000000000000000000000000000000000000000..e64c249e94ef151a2f7f77a29c1ef83526ea42c0
--- /dev/null
+++ b/ThorPas4Session.h
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include "QcomScm.h"
+
+namespace ThorPas4 {
+constexpr uint32_t WaitService = 0x24, Ack = 1, Resume = 2, GetContext = 3;
+struct Args { uint32_t function, types; uint64_t a, b, c; };
+struct Result { int64_t status; uint64_t value, token, flags, a6; };
+
+static inline Args waitCommand(uint32_t op, uint32_t token)
+{
+    return {qcom_scm_fn(WaitService, op), op == GetContext ? 0U : 1U, token, 0, 0};
+}
+
+// PAS AUTH_AND_RESET takes the peripheral id as its only value argument.
+// Keep this constructor beside the other mutating session commands so the
+// caller cannot accidentally reuse the INIT_IMAGE argument layout.
+static inline Args authAndReset(uint32_t peripheral)
+{
+    return {qcom_scm_fn(QCOM_SCM_SVC_PIL, QCOM_SCM_PAS_AUTH_AND_RESET),
+            qcom_scm_args(1, QCOM_SCM_VAL, 0, 0), peripheral, 0, 0};
+}
+
+// One PAS4 worker, independently draining IRQ records. Keep an early wake
+// until its matching queue is consumed. Firmware context IDs are opaque.
+struct WakeQueues {
+    struct Slot { uint32_t id, permits; };
+    Slot slots[16]{};
+    bool signal(uint32_t id, uint32_t flags)
+    {
+        if (flags != 1 && flags != 2) return false;
+        Slot *free = nullptr;
+        for (auto &s : slots) {
+            if (s.permits && s.id == id) {
+                if (flags == 2) s.permits = UINT32_MAX;
+                else if (s.permits != UINT32_MAX && s.permits < UINT32_MAX - 1) ++s.permits;
+                return true;
+            }
+            if (!s.permits && !free) free = &s;
+        }
+        if (!free) return false;
+        *free = {id, flags == 2 ? UINT32_MAX : 1U};
+        return true;
+    }
+    bool take(uint32_t id)
+    {
+        for (auto &s : slots) {
+            if (s.permits && s.id == id) {
+                if (s.permits != UINT32_MAX) --s.permits;
+                return true;
+            }
+        }
+        return false;
+    }
+};
+
+// Called with the event lock held. Sleep atomically releases and reacquires
+// that lock. Sleep can mark failed after its deadline; a timeout never
+// consumes a token or grants a wake.
+template<class Sleep> static bool waitForWake(WakeQueues &queues, uint32_t id, const bool &failed, Sleep sleep)
+{
+    bool timedOut = false;
+    while (!failed && !queues.take(id))
+        timedOut = sleep(timedOut) || timedOut;
+    return !failed;
+}
+
+// The Qualcomm A6 quirk restores the original argument registers except x0
+// and the firmware-supplied x6. Never replay the initial mutating command.
+template<class Call>
+static Result uninterrupted(Args a, Call call)
+{
+    uint64_t a6 = 0;
+    for (unsigned n = 0; ; ++n) {
+        Result r = call(a, a6);
+        if (r.status != QCOM_SCM_INTERRUPTED) return r;
+        if (n == 1023) return {-2006, r.value, r.token, r.flags, r.a6};
+        a.function = QCOM_SCM_INTERRUPTED;
+        a6 = r.a6;
+    }
+}
+
+// A WAITQ wake grants its queue only after the matching ACK returns success.
+// EBUSY retries the exact pending SMCCC operation; a live token never causes
+// a fresh PAS_INIT_IMAGE. The WAITQ/EBUSY paths run outside the SCM gate.
+template<class Invoke, class Wait, class Signal, class Backoff>
+static Result transact(Args a, Invoke invoke, Wait wait, Signal signal, Backoff backoff)
+{
+    bool ackPending = false;
+    uint32_t ackQueue = 0, ackFlags = 0;
+    unsigned busy = 0;
+    for (;;) {
+        Result r = invoke(a);
+        if (r.status == QCOM_SCM_V2_EBUSY && busy < 20) {
+            ++busy;
+            backoff();
+            continue;
+        }
+        if (r.status != QCOM_SCM_WAITQ_SLEEP && r.status != QCOM_SCM_WAITQ_WAKE) {
+            if (!r.status && ackPending && !signal(ackQueue, ackFlags))
+                return {-2001, r.value, r.token, r.flags, 0};
+            return r;
+        }
+        busy = 0;
+        if (r.value > UINT32_MAX || r.token > UINT32_MAX) return {-2002,r.value,r.token,r.flags,0};
+        ackPending = r.status == QCOM_SCM_WAITQ_WAKE;
+        if (ackPending) {
+            if (r.flags != 1 && r.flags != 2) return {-2003,r.value,r.token,r.flags,0};
+            ackQueue = uint32_t(r.value);
+            ackFlags = uint32_t(r.flags);
+        } else if (!wait(uint32_t(r.value))) {
+            return {-2004,r.value,r.token,r.flags,0};
+        }
+        a = waitCommand(ackPending ? Ack : Resume, uint32_t(r.token));
+    }
+}
+
+enum class Stage { InitRejected, MemoryRejected, LoadFailed, SegmentsLoaded };
+template<class Command, class Load>
+static Stage stageImage(uint64_t metadata, uint64_t base, uint64_t bytes, Command command, Load load)
+{
+    const uint32_t init = QCOM_SCM_PAS_INIT_IMAGE, setup = QCOM_SCM_PAS_MEM_SETUP;
+    if (!command(init, {qcom_scm_fn(QCOM_SCM_SVC_PIL, init),
+            qcom_scm_args(2, QCOM_SCM_VAL, QCOM_SCM_RW, 0), 4, metadata, 0}))
+        return Stage::InitRejected;
+    if (!command(setup, {qcom_scm_fn(QCOM_SCM_SVC_PIL, setup),
+            qcom_scm_args(3, QCOM_SCM_VAL, QCOM_SCM_VAL, QCOM_SCM_VAL), 4, base, bytes}))
+        return Stage::MemoryRejected;
+    return load() ? Stage::SegmentsLoaded : Stage::LoadFailed;
+}
+}
diff --git a/ThorPasProbe.h b/ThorPasProbe.h
new file mode 100644
index 0000000000000000000000000000000000000000..21bf947222842671724b258ec9d454eeec1535c6
--- /dev/null
+++ b/ThorPasProbe.h
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include <stdint.h>
+
+namespace ThorPasProbe {
+// Successful local characterization of the six resource paths is distinct
+// from registering an ICC writer. Only this one-shot diagnostic can use
+// Cape's absent-provider path and it requests no BCM transactions.
+struct Admission {
+    bool requested, methods, newOutbound, routes, railsHeld, noProvider;
+    bool allowed() const { return requested && methods && newOutbound && routes && railsHeld && noProvider; }
+};
+
+enum class End { AuthUnknown, ShutdownUnknown, OffUnknown, StopBitUnconfirmed, Stopped };
+template<class Ops> End run(Ops &ops)
+{
+    // Missing ACK or FATAL cannot invalidate ownership established by a
+    // successful AUTH. Always issue one owned SHUTDOWN on that path.
+    if (!ops.authenticate()) return End::AuthUnknown;
+    bool ready = ops.observeReady();
+    bool stopSent = ready && ops.requestStop();
+    bool cleared = true;
+    if (stopSent) { ops.waitStopAck(); cleared = ops.clearStop(); }
+    bool shut = ops.shutdown();
+    if (!shut) return End::ShutdownUnknown;
+    if (!ops.loadOff()) return End::OffUnknown;
+    return cleared ? End::Stopped : End::StopBitUnconfirmed;
+}
+}
+
+namespace ThorPasProbe {
+enum class StopResult { Confirmed, ReturnedRefusal, Unknown };
+
+// Cape sets free_after_auth_reset, which selects 100 ms x 50 shutdown
+// retries in its downstream remoteproc driver. This probe uses that policy
+// only for the completed shutdown response reproduced on this board.
+template<class Submit, class Delay>
+bool stopOwned(Submit submit, Delay delay)
+{
+    constexpr unsigned retryLimit = 50;
+    for (unsigned attempt = 1; attempt <= 1 + retryLimit; ++attempt) {
+        const auto state = submit(attempt);
+        if (state == StopResult::Confirmed) return true;
+        if (state != StopResult::ReturnedRefusal || attempt == 1 + retryLimit) return false;
+        delay(100);
+    }
+    return false;
+}
+
+inline StopResult classifyShutdown(bool direct, int64_t raw, uint64_t service)
+{
+    if (raw == 0 && service == 0) return StopResult::Confirmed;
+    constexpr int32_t observed = -3145800; // observed PAS SHUTDOWN x0 low 32 = 0xffcfffb8.
+    if (direct && !service && (raw == observed || raw == int64_t(uint32_t(observed))))
+        return StopResult::ReturnedRefusal;
+    return StopResult::Unknown;
+}
+}
diff --git a/ThorPdLocator.h b/ThorPdLocator.h
new file mode 100644
index 0000000000000000000000000000000000000000..ed1b449c50316154af5efec2075e3bdec50874eb
--- /dev/null
+++ b/ThorPdLocator.h
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include <stdint.h>
+#include <string.h>
+
+namespace ThorPdLocator {
+constexpr uint32_t Port = 0x4002, Service = 0x40, Instance = 0x101;
+constexpr uint32_t Control = 0xfffffffeu;
+constexpr unsigned MaxWire = 256, FullListBytes = 252, RxCapacity = 128;
+enum class Transfer : uint8_t { None, Publish, Respond, Withdraw };
+struct Domain { const char *name; uint32_t instance; };
+// These are the service-registry directories in Thor's stock modem_a FAT.
+// A directory entry describes a provider, irrespective of its current UP state.
+constexpr Domain domains[] = {
+    {"msm/modem/root_pd",180}, {"msm/adsp/root_pd",74},
+    {"msm/adsp/audio_pd",74}, {"msm/adsp/charger_pd",74},
+    {"msm/cdsp/root_pd",76}, {"msm/slpi/root_pd",90}, {"msm/slpi/sensor_pd",90}
+};
+constexpr uint8_t All = (1u << 7) - 1;
+inline uint32_t get32(const uint8_t *p) {
+    return uint32_t(p[0]) | uint32_t(p[1])<<8 | uint32_t(p[2])<<16 | uint32_t(p[3])<<24;
+}
+inline void put16(uint8_t *p, uint32_t n) { p[0]=uint8_t(n); p[1]=uint8_t(n>>8); }
+inline void put32(uint8_t *p, uint32_t n) { put16(p,n); put16(p+2,n>>16); }
+inline bool named(const uint8_t *s, unsigned len, const char *name) {
+    return s && len==strlen(name) && memcmp(s,name,len)==0;
+}
+inline uint8_t providers(const uint8_t *name, unsigned len) {
+    if (named(name,len,"tms/servreg")) return All;
+    if (named(name,len,"gps/gps_service")) return 1;
+    if (named(name,len,"avs/audio")) return 1u<<2;
+    return 0;
+}
+struct Wire {
+    uint8_t bytes[MaxWire]{};
+    unsigned size=0, totalDomains=0, listedDomains=0, qmiError=0;
+    void header(uint32_t type, uint32_t local, uint32_t src, uint32_t peer, uint32_t dst, unsigned body) {
+        put32(bytes,1); put32(bytes+4,type); put32(bytes+8,local); put32(bytes+12,src);
+        put32(bytes+16,0); put32(bytes+20,body); put32(bytes+24,peer); put32(bytes+28,dst);
+        size=32+((body+3)&~3u);
+    }
+    void announce(uint32_t local, uint32_t peer, bool publish) {
+        const unsigned type=publish ? 4u : 5u;
+        header(type,local,Control,peer,Control,20);
+        put32(bytes+32,type); put32(bytes+36,Service); put32(bytes+40,Instance);
+        put32(bytes+44,local); put32(bytes+48,Port);
+    }
+    template<class P> void write(P &p, unsigned at) const {
+        p.write(at+8,size); p.write(at+12,0);
+        for(unsigned i=0;i<((size+7)&~7u);i+=4)
+            p.write(at+16+i,i<size ? get32(bytes+i) : 0);
+    }
+};
+// Build a reply only for a complete request on this edge and private port.
+// All seven directory entries fit a single real credit >= MaxWire.
+template<class R>
+bool respond(const R &r, uint32_t local, uint32_t peer, Wire &w) {
+    if (!r.completed || r.used<40 || r.word(0)!=1 || r.word(4)!=1 || r.word(8)!=peer ||
+        !r.word(12) || r.word(12)>=Control || r.word(16) || r.word(24)!=local || r.word(28)!=Port)
+        return false;
+    const uint32_t n=r.word(20);
+    if (n<7 || n>RxCapacity-32 || 32+((n+3)&~3u)!=r.used) return false;
+    const uint8_t *q=r.bytes+32;
+    if (q[0]!=0 || (q[5]|(unsigned(q[6])<<8))!=n-7) return false;
+    const unsigned msg=q[3]|(unsigned(q[4])<<8);
+    const uint8_t *name=nullptr;
+    unsigned length=0;
+    uint32_t offset=0;
+    bool offsetSeen=false;
+    unsigned error=msg==0x21 ? 0u : 94u; // QMI_ERR_NOT_SUPPORTED_V01.
+    for(unsigned at=7; !error && at<n;) {
+        if(n-at<3) {error=1; break;}
+        unsigned tag=q[at], len=q[at+1]|(unsigned(q[at+2])<<8);
+        at+=3;
+        if(len>n-at) {error=1; break;}
+        if(tag==1) {
+            if(name || !len || len>64 || memchr(q+at,0,len)) {error=1; break;}
+            name=q+at; length=len;
+        } else if(tag==0x10) {
+            if(offsetSeen || len!=4) {error=1; break;}
+            offsetSeen=true; offset=get32(q+at);
+        } else if(tag<0x10) {error=1; break;}
+        at+=len;
+    }
+    if(!error && !name) error=1;
+    uint8_t *b=w.bytes+32;
+    b[0]=2; memcpy(b+1,q+1,4);
+    unsigned at=7;
+    b[at++]=2; put16(b+at,4); at+=2; put16(b+at,error?1:0); at+=2; put16(b+at,error); at+=2;
+    w.qmiError=error;w.totalDomains=0;w.listedDomains=0;
+    if(!error) {
+        const uint8_t mask=providers(name,length);
+        unsigned total=0;
+        for(unsigned i=0;i<7;++i) if(mask&(1u<<i)) ++total;
+        w.totalDomains=total;
+        b[at++]=0x10; put16(b+at,2); at+=2; put16(b+at,total); at+=2;
+        b[at++]=0x11; put16(b+at,2); at+=2; put16(b+at,1); at+=2;
+        if(mask) {
+            b[at++]=0x12;
+            const unsigned lenAt=at; at+=2;
+            const unsigned countAt=at++; unsigned count=0,index=0;
+            for(unsigned i=0;i<7;++i) {
+                if(!(mask&(1u<<i)) || index++<offset) continue;
+                const unsigned chars=unsigned(strlen(domains[i].name));
+                if(at+chars+10>MaxWire-32) return false;
+                b[at++]=uint8_t(chars); memcpy(b+at,domains[i].name,chars); at+=chars;
+                put32(b+at,domains[i].instance); at+=4;
+                b[at++]=0; put32(b+at,0); at+=4; ++count;
+            }
+            w.listedDomains=count;
+            b[countAt]=uint8_t(count); put16(b+lenAt,at-countAt);
+        }
+    }
+    put16(b+5,at-7);
+    w.header(1,local,Port,peer,r.word(12),at);
+    for(unsigned i=32+at;i<w.size;++i)w.bytes[i]=0;
+    return true;
+}
+}
+
+
diff --git a/ThorQrtrProbe.h b/ThorQrtrProbe.h
new file mode 100644
index 0000000000000000000000000000000000000000..a8825dcf511fd75b419a44156b6833052689cc84
--- /dev/null
+++ b/ThorQrtrProbe.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+namespace ThorQrtrProbe {
+constexpr uint32_t Broadcast=0xffffffffu, ControlPort=0xfffffffeu;
+constexpr unsigned HelloBytes=52;
+// Socket address is configured from Thor's stock AF_QIPCRTR getsockname result.
+constexpr unsigned Capacity=64, MaxFragments=4, LocalIntent=1, FollowupIntent=2;
+struct Receiver {
+    bool selected{}, stop{}, grantPending{}, completed{};
+    unsigned size{}, grantEnd{}, used{}, remaining{}, fragments{};
+    uint8_t bytes[504]{}; // Larger grants are confined to a pending UIM transaction.
+    uint32_t word(unsigned off) const {
+        return uint32_t(bytes[off]) | (uint32_t(bytes[off+1])<<8) |
+               (uint32_t(bytes[off+2])<<16) | (uint32_t(bytes[off+3])<<24);
+    }
+    // Accept a complete v1 control record with an independently matching
+    // payload command. Unrecognized or data packets remain unclassified.
+    unsigned control() const {
+        if (!completed || used!=52 || word(0)!=1 || word(20)!=20 ||
+            (word(28)!=0xfffffffe && word(28)!=0xffff) || word(4)!=word(32)) return 0;
+        const unsigned cmd=word(4);
+        return cmd>=2 && cmd<=11 ? cmd : 0;
+    }
+    bool addressedHello(uint32_t local) const {
+        return local!=Broadcast && local!=ControlPort && control()==2 && word(8)!=Broadcast &&
+               word(8)!=local && word(8)!=ControlPort && word(12)==ControlPort && word(28)==ControlPort &&
+               (word(24)==local || word(24)==Broadcast) && word(16)==0;
+    }
+    // Accept only an announcement for an endpoint on the directly identified peer.
+    bool peerServer(uint32_t local,uint32_t peer) const {
+        return control()==4 && local!=Broadcast && local!=ControlPort && peer!=local &&
+               peer!=Broadcast && peer!=ControlPort && word(8)==peer && word(12)==ControlPort &&
+               (word(24)==local || word(24)==Broadcast) && word(28)==ControlPort &&
+               word(16)==0 && word(36)!=0 && word(44)==peer && word(48)!=0 && word(48)<ControlPort;
+    }
+    bool fits(unsigned cmd,unsigned n,unsigned left) const {
+        if (!n || n>size-used || left>size-used-n || fragments>=MaxFragments ||
+            (left && fragments+1==MaxFragments)) return false;
+        return fragments ? cmd==12 && n+left==remaining : cmd==9;
+    }
+};
+}
diff --git a/ThorSsctlFields.h b/ThorSsctlFields.h
new file mode 100644
index 0000000000000000000000000000000000000000..d6c778b2989c5ce5b44d7499fd8dd909bfe05e4a
--- /dev/null
+++ b/ThorSsctlFields.h
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include "ThorQrtrProbe.h"
+
+namespace ThorPdrState {
+// QMI SERVREG v1 QUERY_STATE; 0xb4 is the modem root process-domain instance.
+constexpr unsigned Service=0x42, Instance=0xb401, Message=0x21, Transaction=2;
+constexpr char Domain[]="msm/modem/root_pd";
+constexpr unsigned NameBytes=sizeof(Domain)-1, BodyBytes=7+3+NameBytes;
+constexpr unsigned PacketBytes=32+((BodyBytes+3)&~3u), FrameBytes=16+((PacketBytes+7)&~7u);
+inline bool validState(unsigned value) {
+    return value==0x0fffffffu || value==0x1fffffffu || value==0x2fffffffu || value==0x7fffffffu;
+}
+template<class Port> void writeRequest(Port &p,uint32_t at,uint32_t local,uint32_t peer,uint32_t port) {
+    uint32_t words[(FrameBytes-8)/4]={PacketBytes,0,1,1,local,0x4000,0,BodyBytes,peer,port};
+    // Emit only a single QMI string TLV; no trailing NUL or adjacent memory.
+    const unsigned char prefix[]={0,Transaction,0,Message,0,3+NameBytes,0,1,NameBytes,0};
+    for (unsigned i=0;i<BodyBytes;++i) {
+        const unsigned byte=i<sizeof(prefix)?prefix[i]:(unsigned char)Domain[i-sizeof(prefix)];
+        words[10+i/4]|=uint32_t(byte)<<(8*(i%4));
+    }
+    for (unsigned i=0;i<sizeof(words)/sizeof(words[0]);++i) p.write(at+8+i*4,words[i]);
+}
+}
+namespace ThorSsctlFields {
+// QMI common GET_SUPPORTED_FIELDS asks about SSCTL v2 GET_FAILURE_REASON.
+// The latter identifier is data in a capability query, never a request opcode.
+constexpr unsigned LocalPort=0x4000, Transaction=1, Message=0x001f, Queried=0x0022;
+constexpr unsigned PacketBytes=44, ResponseCapacity=160;
+static_assert(sizeof(ThorQrtrProbe::Receiver::bytes)>=ResponseCapacity,"response storage");
+struct Query {
+    bool enabled{}, pdState{}, stateValid{};
+    uint32_t state{};
+    unsigned sourceIntent{}, peerNode{}, peerPort{}, end{}, sendTail{}, done{};
+    unsigned responseIntent{}, bodyLength{}, tlvCount{}, result{}, error{};
+};
+inline bool endpoint(const ThorQrtrProbe::Receiver &r,uint32_t local,uint32_t peer) {
+    return r.peerServer(local,peer) && r.word(36)==0x2b && (r.word(40)&0xff)==2;
+}
+template<class Port> void writeRequest(Port &p,uint32_t at,uint32_t local,uint32_t peer,uint32_t port) {
+    // GLINK fragment header, QRTR v1 DATA header, QMI request and zero alignment.
+    const uint32_t body[]={
+        PacketBytes,0, 1,1,local,LocalPort,0,12,peer,port,
+        (Message<<24)|(Transaction<<8), 0x01000500, (Queried<<16)|2, 0
+    };
+    static_assert(sizeof(body)+8==64,"request frame");
+    for (unsigned i=0;i<sizeof(body)/sizeof(body[0]);++i) p.write(at+8+i*4,body[i]);
+}
+inline unsigned le16(const uint8_t *p) { return unsigned(p[0])|(unsigned(p[1])<<8); }
+inline bool match(Query &q,const ThorQrtrProbe::Receiver &rx,unsigned intent,uint32_t local) {
+    if (!q.end || q.responseIntent || !rx.completed || intent<=q.sourceIntent ||
+        rx.used<48 || rx.used>ResponseCapacity || rx.word(0)!=1 || rx.word(4)!=1 ||
+        rx.word(8)!=q.peerNode || rx.word(12)!=q.peerPort || rx.word(16)!=0 ||
+        rx.word(24)!=local || rx.word(28)!=LocalPort) return false;
+    const unsigned body=rx.word(20);
+    if (body<14 || body>ResponseCapacity-32 || 32+((body+3)&~3u)!=rx.used) return false;
+    const auto *data=rx.bytes+32;
+    const unsigned transaction=q.pdState ? ThorPdrState::Transaction : Transaction;
+    const unsigned message=q.pdState ? ThorPdrState::Message : Message;
+    if (data[0]!=2 || le16(data+1)!=transaction || le16(data+3)!=message ||
+        le16(data+5)!=body-7) return false;
+    bool found=false,haveState=false;
+    uint32_t state=0;
+    unsigned result=0,error=0,count=0;
+    for (unsigned at=7;at<body;) {
+        if (body-at<3) return false;
+        const unsigned type=data[at],len=le16(data+at+1);
+        at+=3;
+        if (len>body-at) return false;
+        if (type==2) {
+            if (found || len!=4) return false;
+            found=true;
+            result=le16(data+at);error=le16(data+at+2);
+            if (result>1 || (result==0)!=(error==0)) return false;
+        }
+        if (q.pdState && type==0x10) {
+            if (haveState || len!=4) return false;
+            state=uint32_t(le16(data+at))|(uint32_t(le16(data+at+2))<<16);
+            if (!ThorPdrState::validState(state)) return false;
+            haveState=true;
+        }
+        ++count;
+        at+=len;
+    }
+    if (!found || (result && haveState)) return false;
+    q.stateValid=haveState;q.state=state;
+    q.responseIntent=intent;q.bodyLength=body;q.tlvCount=count;q.result=result;q.error=error;
+    return true;
+}
+}
diff --git a/ThorStagedBcm.h b/ThorStagedBcm.h
new file mode 100644
index 0000000000000000000000000000000000000000..ee75b9dbb7af0b306a4b4fbc1c1efad78f481682
--- /dev/null
+++ b/ThorStagedBcm.h
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+
+#include <stdint.h>
+#include <string.h>
+#include "ThorActiveTcs.h"
+
+// A staged low-power command is a future message, not a readback of
+// the BCM hardware voter. This observer cannot submit or authorize votes.
+struct ThorStagedBcm {
+    static constexpr unsigned resources = 6;
+    struct Set {
+        uint32_t enabled[2] = {};
+        unsigned unstable = 0, malformed = 0, seen = 0, duplicate = 0, unsupported = 0;
+        uint32_t words[resources] = {};
+    } sets[2]; // FDT order: TCS3/4 sleep, TCS5/6 wake.
+    uint32_t version = 0, caps = 0;
+
+    template<class Reader>
+    bool collect(Reader &io, const uint32_t (&addresses)[resources])
+    {
+        *this = {};
+        version = io.read(0);
+        caps = io.read(0xc);
+        // Match the v2.7 APSS DRV2 and command geometry seen on this board.
+        if (version != 0x20700 || ((caps >> 12) & 63) != 8 || (caps >> 27) != 16)
+            return false;
+        for (unsigned r = 0; r < resources; r++) {
+            if ((addresses[r] & 3) || (addresses[r] >> 16) != 5) return false;
+            for (unsigned j = 0; j < r; j++) if (addresses[j] == addresses[r]) return false;
+        }
+        struct Command { uint32_t msg, addr, data; };
+        for (unsigned id = 3; id <= 6; id++) {
+            auto &s = sets[(id - 3) / 2];
+            unsigned slot = (id - 3) % 2;
+            unsigned base = ThorActiveTcs::base(id);
+            auto mask = io.read(base + 0x1c);
+            s.enabled[slot] = mask;
+            if (mask >> 16) { s.malformed |= 1u << slot; continue; }
+            Command first[16] = {};
+            bool changed = false;
+            for (unsigned pass = 0; pass < 2; pass++) {
+                for (unsigned i = 0; i < 16; i++) {
+                    if (!(mask & (1u << i))) continue;
+                    unsigned b = base + 20 * i;
+                    Command c{io.read(b + 0x30), io.read(b + 0x34), io.read(b + 0x38)};
+                    if (!pass) first[i] = c;
+                    else if (first[i].msg != c.msg || first[i].addr != c.addr || first[i].data != c.data)
+                        changed = true;
+                }
+                if (io.read(base + 0x1c) != mask) { changed = true; break; }
+            }
+            if (changed) { s.unstable |= 1u << slot; continue; }
+            for (unsigned i = 0; i < 16; i++) {
+                if (!(mask & (1u << i))) continue;
+                const auto &c = first[i];
+                for (unsigned r = 0; r < resources; r++) {
+                    if (addresses[r] != c.addr) continue;
+                    const unsigned bit = 1u << r;
+                    if (s.seen & bit) s.duplicate |= bit;
+                    else s.words[r] = c.data;
+                    s.seen |= bit;
+                    if ((c.msg & ~(1u << 8)) != 0x10008 || (c.data & 0x90000000))
+                        s.unsupported |= bit;
+                    break;
+                }
+            }
+        }
+        return true;
+    }
+};
diff --git a/ThorUimStatus.h b/ThorUimStatus.h
new file mode 100644
index 0000000000000000000000000000000000000000..b8737bbcffd93edcefec072e5652742fcdb73ac0
--- /dev/null
+++ b/ThorUimStatus.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include "ThorSsctlFields.h"
+
+namespace ThorUimStatus {
+constexpr unsigned Service=11, Version=1, Transaction=3, Message=0x2f, LocalPort=0x4001;
+constexpr unsigned RequestBytes=40, Capacity=504;
+struct Query {
+    bool enabled{}, statusValid{};
+    unsigned announced{}, peerNode{}, peerPort{}, end{}, done{}, response{};
+    unsigned result{}, error{}, slots{}, present{}, absent{}, fault{};
+};
+inline bool rootUp(const ThorSsctlFields::Query &q) {
+    return q.pdState && q.stateValid && q.responseIntent && !q.result && q.state==0x1fffffffu;
+}
+inline bool endpoint(const ThorQrtrProbe::Receiver &r,uint32_t local,uint32_t peer) {
+    return r.peerServer(local,peer) && r.word(36)==Service && (r.word(40)&255u)==Version;
+}
+template<class Port> void request(Port &p,uint32_t at,uint32_t local,const Query &q) {
+    const uint32_t payload[]={RequestBytes,0,1,1,local,LocalPort,0,7,q.peerNode,q.peerPort,
+                              (Message<<24)|(Transaction<<8),0};
+    for(unsigned i=0;i<sizeof(payload)/sizeof(*payload);++i)p.write(at+8+4*i,payload[i]);
+}
+// Standard UIM card-status TLV. Walk every nested application including its
+// length-prefixed AID. Retain only counts of physical card states.
+inline bool cards(const uint8_t *p,unsigned bytes,Query &q) {
+    if(bytes<9)return false;
+    const unsigned count=p[8];
+    unsigned at=9,present=0,absent=0,fault=0;
+    for(unsigned i=0;i<count;++i) {
+        if(bytes-at<6)return false;
+        switch(p[at]) {
+        case 0:++absent;break;
+        case 1:++present;break;
+        case 2:++fault;break;
+        default:return false;
+        }
+        const unsigned apps=p[at+5];
+        at+=6;
+        for(unsigned j=0;j<apps;++j) {
+            if(bytes-at<14)return false;
+            const unsigned aid=p[at+6];
+            if(aid>bytes-at-14)return false;
+            at+=14+aid;
+        }
+    }
+    if(at!=bytes)return false;
+    q.statusValid=true;q.slots=count;q.present=present;q.absent=absent;q.fault=fault;
+    return true;
+}
+inline bool match(Query &q,const ThorQrtrProbe::Receiver &r,unsigned id,uint32_t local) {
+    if(!q.end || q.response || !r.completed || r.used<48 || r.used>Capacity ||
+       r.word(0)!=1 || r.word(4)!=1 || r.word(8)!=q.peerNode || r.word(12)!=q.peerPort ||
+       r.word(16) || r.word(24)!=local || r.word(28)!=LocalPort)return false;
+    const auto body=r.word(20);
+    if(body<14 || body>Capacity-32 || r.used!=32+((body+3)&~3u))return false;
+    const auto *data=r.bytes+32;
+    using ThorSsctlFields::le16;
+    if(data[0]!=2 || le16(data+1)!=Transaction || le16(data+3)!=Message || le16(data+5)!=body-7)return false;
+    Query parsed=q;
+    bool haveResult=false;
+    for(unsigned at=7;at<body;) {
+        if(body-at<3)return false;
+        const unsigned type=data[at],len=le16(data+at+1);
+        at+=3;
+        if(len>body-at)return false;
+        if(type==2) {
+            if(haveResult || len!=4)return false;
+            parsed.result=le16(data+at);parsed.error=le16(data+at+2);
+            if(parsed.result>1 || (parsed.result==0)!=(parsed.error==0))return false;
+            haveResult=true;
+        } else if(type==0x10 && (parsed.statusValid || !cards(data+at,len,parsed)))return false;
+        at+=len;
+    }
+    if(!haveResult || (parsed.result && parsed.statusValid))return false;
+    parsed.response=id;q=parsed;return true;
+}
+}
diff --git a/ThorWifiPcie.h b/ThorWifiPcie.h
new file mode 100644
index 0000000000000000000000000000000000000000..2b52502cefefb4ab7e5c22c36b4c8b0dfa4ecd08
--- /dev/null
+++ b/ThorWifiPcie.h
@@ -0,0 +1,364 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include <stdint.h>
+
+namespace ThorWifiPcie {
+// SM8475 GCC register offsets. The Thor DT "collapse-vote" is an AP-specific
+// syscon. The stock GDSC driver writes that vote instead of touching GDSCR.
+constexpr unsigned domain = 0x7b004;
+constexpr unsigned collapseVote = 0x62128;
+constexpr unsigned gateVote = 0x62008;
+constexpr uint32_t busMask = (1U << 0) | (1U << 1) | (1U << 2) | (1U << 5);
+constexpr uint32_t powerOn = 1U << 31;
+constexpr uint32_t clockOff = 1U << 31;
+
+struct Result {
+    const char *state;
+    uint32_t initialDomain, enabledDomain, initialCollapse, initialGates;
+    uint32_t ownedGates, runningGates, finalCollapse, finalGates;
+    bool ownsPower, restored;
+};
+
+template<class IO, class WhileClocked>
+Result exerciseHostBus(IO &io, bool parentReady, WhileClocked whileClocked)
+{
+    Result r{};
+    r.initialDomain = io.read(domain);
+    r.initialCollapse = io.read(collapseVote);
+    r.initialGates = io.read(gateVote);
+    r.state = "parent-unavailable";
+    if (!parentReady) return r;
+    // Respect hardware-controlled domains and an AP owner whose vote existed
+    // before us. 0xffffffff from an inaccessible bus must never be used for RMW.
+    if (r.initialDomain == UINT32_MAX || r.initialCollapse == UINT32_MAX ||
+        r.initialGates == UINT32_MAX || (r.initialDomain & 6U)) {
+        r.state = "invalid-handoff";
+        return r;
+    }
+    if (!(r.initialCollapse & 1U) && !(r.initialDomain & powerOn)) {
+        r.state = "existing-vote-off";
+        return r;
+    }
+    r.ownsPower = (r.initialCollapse & 1U) != 0;
+    if (r.ownsPower) io.write(collapseVote, r.initialCollapse & ~1U);
+    io.delay(1);
+    r.state = "domain-timeout";
+    if (!(io.read(collapseVote) & 1U)) {
+        // Same 500 us GDSC status bound as Thor's live regulator node.
+        for (unsigned i=0; i<500; ++i) {
+            r.enabledDomain = io.read(domain);
+            if (r.enabledDomain == UINT32_MAX || (r.enabledDomain & powerOn)) break;
+            io.delay(1);
+        }
+        if (r.enabledDomain != UINT32_MAX && (r.enabledDomain & powerOn)) {
+            io.delay(2); // memory power-up settling before enabling the branches
+            const uint32_t current=io.read(gateVote);
+            r.state = "gate-handoff-changed";
+            if (current != UINT32_MAX && (current & busMask) == (r.initialGates & busMask)) {
+                r.ownedGates = busMask & ~current;
+                if (r.ownedGates) io.write(gateVote, current | r.ownedGates);
+                r.state = "gate-vote-failed";
+                const uint32_t voted = io.read(gateVote);
+                if (voted != UINT32_MAX && (voted & busMask) == busMask) {
+                    // Master/slave/configuration AHB and Q2A. PIPE is clocked by
+                    // the PHY, which this stage does not configure or release.
+                    const struct { unsigned off; uint32_t bit; } gates[] = {
+                        {0x7b020,1U}, {0x7b028,2U}, {0x7b030,4U}, {0x7b01c,32U}
+                    };
+                    r.state = "clock-timeout";
+                    for (unsigned i=0; i<200; ++i) {
+                        r.runningGates=0;
+                        for (const auto &g:gates)
+                            if (!(io.read(g.off) & clockOff)) r.runningGates |= g.bit;
+                        if (r.runningGates == busMask) {
+                            r.state = "bus-clocked";
+                            if (!whileClocked()) {
+                                // A child clock could still be enabled. Keep its supply.
+                                r.state = "child-restore-failed";
+                                r.finalGates = io.read(gateVote);
+                                r.finalCollapse = io.read(collapseVote);
+                                return r;
+                            }
+                            break;
+                        }
+                        io.delay(1);
+                    }
+                }
+            }
+        }
+    } else r.state = "domain-vote-failed";
+    uint32_t current = io.read(gateVote);
+    if (r.ownedGates && current != UINT32_MAX)
+        io.write(gateVote, current & ~r.ownedGates);
+    r.finalGates = io.read(gateVote);
+    // Never cut power from a remaining bus vote after a failed rollback.
+    const bool gatesRestored = r.finalGates != UINT32_MAX &&
+        (r.finalGates & busMask) == (r.initialGates & busMask);
+    if (r.ownsPower && gatesRestored) {
+        io.delay(1);
+        current = io.read(collapseVote);
+        if (current != UINT32_MAX) io.write(collapseVote, current | 1U);
+        io.delay(100); // qcom,no-status-check-on-disable
+    }
+    r.finalCollapse = io.read(collapseVote);
+    r.restored = gatesRestored && r.finalCollapse != UINT32_MAX &&
+        ((r.finalCollapse ^ r.initialCollapse) & 1U) == 0;
+    return r;
+}
+template<class IO>
+Result exerciseHostBus(IO &io, bool parentReady)
+{
+    return exerciseHostBus(io, parentReady, [] { return true; });
+}
+
+// GCC_PCIE_0_CLKREF_EN (called pcie_0_ldo in the RC0 DT) is a dedicated
+// clock branch. The separate RPMh XO parent must be acknowledged before use.
+struct ReferenceHandoff {
+    bool firmwareVerified = false, attempted = false;
+    // Called under powerLock. Either the stock image or the shared parent
+    // announcement can arrive first. An unknown XO vote does not enable this gate.
+    bool claim(bool firmwareReady, uint32_t cx, uint32_t xo, bool stockXo)
+    {
+        firmwareVerified |= firmwareReady;
+        if (!firmwareVerified || attempted || !cx || xo != 3 || !stockXo) return false;
+        attempted = true;
+        return true;
+    }
+};
+
+constexpr unsigned refBranch = 0x9c004;
+struct Reference {
+    const char *state = "bus-unavailable";
+    uint32_t before = UINT32_MAX, active = UINT32_MAX, after = UINT32_MAX;
+    uint32_t auxCmd = UINT32_MAX, auxCfg = UINT32_MAX, auxBranch = UINT32_MAX;
+    uint32_t coreReset = UINT32_MAX, pipeMux = UINT32_MAX;
+    bool owned = false, restored = false;
+};
+
+// Thor's live RC0 requests 19.2 MHz. The GCC table provides this rate on
+// BI_TCXO, with no fractional divider. Both bypass (HID 0) and HID 1 are 1:1.
+// Only acquire the AP branch vote for an already configured source. Leave the
+// shared RCG configuration, its other votes and external consumers intact.
+constexpr unsigned auxCmd = 0x7b064, auxCfg = 0x7b068, auxCbcr = 0x7b034;
+constexpr uint32_t auxVote = 1U << 3;
+struct AuxClock {
+    const char *state = "not-run";
+    uint32_t source = UINT32_MAX, before = UINT32_MAX, active = UINT32_MAX;
+    uint32_t root = UINT32_MAX, branch = UINT32_MAX, after = UINT32_MAX;
+    bool owned = false, restored = false, clocked = false;
+};
+inline bool auxAtXoRate(uint32_t cmd, uint32_t cfg)
+{
+    // Reject UPDATE and dirty shadow registers while the active source is unknown.
+    return cmd != UINT32_MAX && !(cmd & 0xf1U) && cfg != UINT32_MAX &&
+           !(cfg & ((7U << 8) | (3U << 12))) && (cfg & 31U) <= 1;
+}
+template<class IO>
+bool exerciseAux(IO &io, AuxClock &aux, bool railsReady)
+{
+    if (!railsReady) { aux.state = "rails-unconfirmed"; return true; }
+    const uint32_t cmd = io.read(auxCmd);
+    aux.source = io.read(auxCfg);
+    if (!auxAtXoRate(cmd, aux.source)) { aux.state = "source-unconfirmed"; return true; }
+    aux.before = io.read(gateVote);
+    if (aux.before == UINT32_MAX || (aux.before & busMask) != busMask) {
+        aux.state = "bus-vote-unconfirmed";
+        return true;
+    }
+    aux.owned = !(aux.before & auxVote);
+    if (aux.owned) io.write(gateVote, aux.before | auxVote);
+    aux.state = "aux-timeout";
+    for (unsigned i = 0; i < 200; ++i) {
+        aux.active = io.read(gateVote);
+        aux.root = io.read(auxCmd);
+        aux.branch = io.read(auxCbcr);
+        const uint32_t cfg = io.read(auxCfg);
+        if (aux.active == UINT32_MAX || (aux.active & (busMask | auxVote)) != (busMask | auxVote)) {
+            aux.state = "aux-vote-unconfirmed";
+            break;
+        }
+        if (!auxAtXoRate(aux.root, cfg) || cfg != aux.source) {
+            aux.state = "source-changed";
+            break;
+        }
+        if (!(aux.branch & clockOff) && !(aux.root & clockOff)) {
+            aux.clocked = true;
+            aux.state = "aux-clocked";
+            break;
+        }
+        io.delay(1);
+    }
+    uint32_t gates = io.read(gateVote);
+    if (aux.owned && gates != UINT32_MAX && (gates & auxVote))
+        io.write(gateVote, gates & ~auxVote);
+    aux.after = io.read(gateVote);
+    aux.restored = aux.after != UINT32_MAX && !((aux.after ^ aux.before) & auxVote);
+    // BRANCH_HALT_VOTED can stay running for a foreign voter. The AP bit
+    // is our ownership boundary. On ambiguous release retain our parents.
+    return !aux.owned || aux.restored;
+}
+
+// The Thor PCIe host selects the external PIPE parent after GDSC power-up.
+// Only repoint the dedicated mux with the branch idle.
+constexpr unsigned pipeMuxReg = 0x7b060, pipeCbcr = 0x7b03c;
+constexpr uint32_t pipeGate = 1U << 4, pipeSel = 3U, parkedXo = 2U;
+struct PipeParent {
+    const char *state = "not-run";
+    uint32_t before = UINT32_MAX, active = UINT32_MAX, after = UINT32_MAX;
+    uint32_t vote = UINT32_MAX, branch = UINT32_MAX;
+    uint32_t endVote = UINT32_MAX, endBranch = UINT32_MAX;
+    uint32_t nocVotes = UINT32_MAX, nocBranch = UINT32_MAX;
+    uint32_t rateCmd = UINT32_MAX, rateCfg = UINT32_MAX, rateBranch = UINT32_MAX;
+    bool attempted = false, restored = false;
+};
+
+inline bool pipeIsIdle(uint32_t vote, uint32_t cbcr)
+{
+    return vote != UINT32_MAX && !(vote & pipeGate) && cbcr != UINT32_MAX &&
+           (cbcr & clockOff) && !(cbcr & 1U);
+}
+
+template<class IO>
+bool exercisePipeParent(IO &io, PipeParent &p)
+{
+    p.nocVotes = io.read(0x62000);
+    p.nocBranch = io.read(0x7b08c);
+    p.rateCmd = io.read(0x7b048);
+    p.rateCfg = io.read(0x7b04c);
+    p.rateBranch = io.read(0x7b044);
+    p.vote = io.read(gateVote);
+    p.branch = io.read(pipeCbcr);
+    p.before = io.read(pipeMuxReg);
+    if (!pipeIsIdle(p.vote, p.branch)) {
+        p.state = "pipe-busy-or-unknown";
+        return true;
+    }
+    if (p.before == UINT32_MAX || (p.before & pipeSel) != parkedXo) {
+        p.state = (p.before & pipeSel) == 0 ? "external-inherited" : "source-unknown";
+        return true;
+    }
+    p.attempted = true;
+    io.write(pipeMuxReg, p.before & ~pipeSel);
+    p.active = io.read(pipeMuxReg);
+    p.endVote = io.read(gateVote);
+    p.endBranch = io.read(pipeCbcr);
+    p.after = io.read(pipeMuxReg);
+    if (!pipeIsIdle(p.endVote, p.endBranch)) {
+        p.state = "gate-changed";
+        return false; // Preserve the supplies of the unexpected PIPE consumer.
+    }
+    if (p.after != UINT32_MAX && (p.after & pipeSel) == 0) {
+        io.write(pipeMuxReg, (p.after & ~pipeSel) | parkedXo);
+        p.after = io.read(pipeMuxReg);
+    }
+    p.restored = p.after != UINT32_MAX && (p.after & pipeSel) == parkedXo;
+    p.state = !p.restored ? "restore-unconfirmed" :
+              p.active != UINT32_MAX && !(p.active & pipeSel) ? "external-selected" :
+              "select-unconfirmed";
+    return p.restored;
+}
+
+// Thor's live RC0 DT requests both aggregate PCIe branches and DDRSS SF TBU.
+// Their vendor halt policy is BRANCH_HALT_SKIP: AP votes can be verified even
+// when hardware gates an idle fabric. CLK_OFF alone cannot prove a failed vote.
+constexpr unsigned fabricVote = 0x62000, aggre0Cbcr = 0x7b08c;
+constexpr unsigned aggre1Cbcr = 0x9d098, tbuCbcr = 0x9d094;
+constexpr uint32_t fabricMask = (1U << 12) | (1U << 11) | (1U << 19);
+struct Fabric {
+    const char *state = "not-run";
+    uint32_t before = UINT32_MAX, active = UINT32_MAX, after = UINT32_MAX;
+    uint32_t aggre0 = UINT32_MAX, aggre1 = UINT32_MAX, tbu = UINT32_MAX;
+    uint32_t owned = 0;
+    bool restored = false;
+};
+
+// Caller owns powerLock. The Thor GPU's votes in the same register are
+// merged from a fresh read under that same lock.
+template<class IO>
+bool exerciseFabric(IO &io, Fabric &f)
+{
+    f.before = io.read(fabricVote);
+    if (f.before == UINT32_MAX) {
+        f.state = "vote-unavailable";
+        return true;
+    }
+    f.owned = fabricMask & ~f.before;
+    if (f.owned) io.write(fabricVote, f.before | f.owned);
+    f.active = io.read(fabricVote);
+    if (f.active != UINT32_MAX && (f.active & fabricMask) == fabricMask) {
+        io.delay(10);
+        f.aggre0 = io.read(aggre0Cbcr);
+        f.aggre1 = io.read(aggre1Cbcr);
+        f.tbu = io.read(tbuCbcr);
+        f.state = "fabric-voted";
+    } else {
+        f.state = "vote-unconfirmed";
+    }
+    const uint32_t current = io.read(fabricVote);
+    if (f.owned && current != UINT32_MAX && (current & f.owned))
+        io.write(fabricVote, current & ~f.owned);
+    f.after = io.read(fabricVote);
+    f.restored = f.after != UINT32_MAX && !((f.after ^ f.before) & fabricMask);
+    if (f.owned && !f.restored) {
+        f.state = "restore-unconfirmed";
+        return false;
+    }
+    return true;
+}
+
+template<class IO, class WhileReferenced>
+bool exerciseReference(IO &io, Reference &r, WhileReferenced whileReferenced)
+{
+    r.auxCmd = io.read(0x7b064);
+    r.auxCfg = io.read(0x7b068);
+    r.auxBranch = io.read(0x7b034);
+    r.coreReset = io.read(0x7b000);
+    r.pipeMux = io.read(0x7b060);
+    r.before = io.read(refBranch);
+    if (r.before == UINT32_MAX) {
+        r.state = "ref-unreadable";
+        return true;
+    }
+    r.owned = !(r.before & 1U);
+    if (r.owned) io.write(refBranch, r.before | 1U);
+    r.state = "ref-timeout";
+    for (unsigned i = 0; i < 200; ++i) {
+        r.active = io.read(refBranch);
+        if (r.active == UINT32_MAX || !(r.active & 1U)) {
+            r.state = "ref-vote-unconfirmed";
+            break;
+        }
+        if (!(r.active & clockOff)) {
+            r.state = "ref-clocked";
+            if (!whileReferenced()) {
+                r.after = io.read(refBranch);
+                return false;
+            }
+            break;
+        }
+        io.delay(1);
+    }
+    if (!r.owned) {
+        // We did not acquire the inherited gate and must never release it.
+        r.after = io.read(refBranch);
+        r.restored = r.after != UINT32_MAX && (r.after & 1U);
+        return true;
+    }
+    uint32_t current = io.read(refBranch);
+    if (current != UINT32_MAX && (current & 1U)) io.write(refBranch, current & ~1U);
+    for (unsigned i = 0; i < 200; ++i) {
+        r.after = io.read(refBranch);
+        if (r.after != UINT32_MAX && !((r.after ^ r.before) & (clockOff | 1U))) {
+            r.restored = true;
+            return true;
+        }
+        io.delay(1);
+    }
+    return false;
+}
+template<class IO>
+bool exerciseReference(IO &io, Reference &r)
+{
+    return exerciseReference(io, r, [] { return true; });
+}
+} // namespace ThorWifiPcie
