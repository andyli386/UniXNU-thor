 private:
+    // A scanout worker must be able to report a failed handoff.  Metal's
+    // waitUntilCompleted() has no deadline and would strand this thread if
+    // the queue or command buffer stops retiring.  The completion callback
+    // keeps the command and its imported resources alive after a timeout;
+    // the caller then quarantines the DMA mapping instead of racing CPU copy.
+    static bool submitAndWait(id<MTLCommandBuffer> commands) {
+        if (!commands) return false;
+        dispatch_semaphore_t completed = dispatch_semaphore_create(0);
+        [commands addCompletedHandler:^(id<MTLCommandBuffer>) {
+            dispatch_semaphore_signal(completed);
+        }];
+        [commands commit];
+        constexpr int64_t kTimeoutNs = 500LL * NSEC_PER_MSEC;
+        if (dispatch_semaphore_wait(completed, dispatch_time(DISPATCH_TIME_NOW, kTimeoutNs))) return false;
+        return commands.status == MTLCommandBufferStatusCompleted;
+    }
