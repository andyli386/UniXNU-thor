++/*
++ * Put a rectangle of a 32-bit surface on the screen. `dst` is in display coordinates; the
++ * panel may be of another size, and the layer itself may be scaled: both are done in one
++ * step, bilinear (or nearest neighbour: fb_filter=0).
++ */
++void
++IOMobileFramebuffer::drawLayer(MiniIOSurface * s, const int32_t * src, const int32_t * dst)
++{
++	if (!canDrawLinearBGRA(s)) return;
++	int32_t sx = src[0], sy = src[1], sw = src[2], sh = src[3];
++	int32_t dx = dst[0], dy = dst[1], dw = dst[2], dh = dst[3];
++	int32_t px0, py0, px1, py1, cx0, cx1;
++	bool filter = gFilter != 0;
++	RowJob job;
++
++	if (sw <= 0 || sh <= 0) {
++		sx = sy = 0;
++		sw = (int32_t) s->info.width;
++		sh = (int32_t) s->info.height;
++	}
++	if (dw <= 0 || dh <= 0) {
++		dx = dy = 0;
++		dw = (int32_t) fWidth;
++		dh = (int32_t) fHeight;
++	}
++	if (sw <= 0 || sh <= 0 || dw <= 0 || dh <= 0 || fWidth == 0 || fHeight == 0 ||
++	    sx < 0 || sy < 0 || (uint64_t) sx + (uint32_t) sw > s->info.width ||
++	    (uint64_t) sy + (uint32_t) sh > s->info.height) {
++		return;
++	}
++	/* Preserve the unclipped transform for sampling, without overflowing
++	 * 32-bit endpoint additions or narrowing a large off-screen position. */
++	int64_t left = (int64_t) dx * fPanelWidth / fWidth;
++	int64_t top = (int64_t) dy * fPanelHeight / fHeight;
++	int64_t right = ((int64_t) dx + dw) * fPanelWidth / fWidth;
++	int64_t bottom = ((int64_t) dy + dh) * fPanelHeight / fHeight;
++	if (right <= left || bottom <= top || right <= 0 || bottom <= 0 ||
++	    left >= fPanelWidth || top >= fPanelHeight ||
++	    left < INT32_MIN || top < INT32_MIN || right > INT32_MAX || bottom > INT32_MAX ||
++	    right - left > INT32_MAX || bottom - top > INT32_MAX) {
++		return;
++	}
++	px0 = (int32_t) left;
++	py0 = (int32_t) top;
++	px1 = (int32_t) right;
++	py1 = (int32_t) bottom;
++	cx0 = px0 < 0 ? 0 : px0;
++	cx1 = px1 > (int32_t) fPanelWidth ? (int32_t) fPanelWidth : px1;
++	int32_t visibleY0 = py0 < 0 ? 0 : py0;
++	int32_t visibleY1 = py1 > (int32_t) fPanelHeight ? (int32_t) fPanelHeight : py1;
++	if (cx0 >= cx1 || visibleY0 >= visibleY1) return;
++	beginGraphics();
++	/* (blending, a row of the picture mixed from two: room for it, for every one who draws rows) */
++	if (filter && fBlendRowSize < (uint32_t) sw) {
++		uint32_t capacity = (uint32_t) sw;
++		uint32_t * row = IONew(uint32_t, capacity);
++		uint32_t * helpers[7] = { NULL };
++		bool ready = row != NULL;
++		for (unsigned i = 0; ready && i + 1 < fThreads; i++) {
++			helpers[i] = IONew(uint32_t, capacity);
++			ready = helpers[i] != NULL;
++		}
++		if (ready) {
++			if (fBlendRow != NULL) IODelete(fBlendRow, uint32_t, fBlendRowSize);
++			for (unsigned i = 0; i < 7; i++) {
++				if (fHelperBlend[i] != NULL) IODelete(fHelperBlend[i], uint32_t, fBlendRowSize);
++				fHelperBlend[i] = helpers[i];
++			}
++			fBlendRow = row;
++			fBlendRowSize = capacity;
++		} else {
++			if (row != NULL) IODelete(row, uint32_t, capacity);
++			for (unsigned i = 0; i < 7; i++) {
++				if (helpers[i] != NULL) IODelete(helpers[i], uint32_t, capacity);
++			}
++		}
++	}
++	filter = filter && fBlendRow != NULL && fBlendRowSize >= (uint32_t) sw;
++	/* which pixel of a source row each pixel of a panel row takes: worked out once, not 2.6 million times */
++	for (int32_t x = cx0; x < cx1; x++) {
++		if (filter) {
++			int64_t at = sample_at(x - px0, sw, px1 - px0);
++
++			fColumn[x] = (uint32_t) (at >> 8);              /* (in the blended row: from sx on) */
++			fColumnWeight[x] = (uint16_t) (fColumn[x] + 1 < (uint32_t) sw ? at & 255 : 0);
++		} else {
++			fColumn[x] = (uint32_t) (sx + (int64_t) (x - px0) * sw / (px1 - px0));
++		}
++	}
++	job.pixels = s->pixels();
++	job.stride = s->info.bytesPerRow;
++	job.sx = sx;
++	job.sy = sy;
++	job.sw = sw;
++	job.sh = sh;
++	job.px0 = px0;
++	job.py0 = py0;
++	job.px1 = px1;
++	job.py1 = py1;
++	job.cx0 = cx0;
++	job.cx1 = cx1;
++	job.filter = filter;
++	job.unscaled = px1 - px0 == sw && py1 - py0 == sh && px0 >= 0 && (uint32_t) px1 <= fPanelWidth;
++	if (fThreads <= 1 || fDiff) {
++		drawRows(&job, visibleY0, visibleY1, fBlendRow);
++		return;
++	}
++	/* shared out: the helpers take their rows, this thread the first share, then waits for them */
++	IOLockLock(fHelperLock);
++	if (fHelpersStarted + 1 < fThreads) {
++		IOLockUnlock(fHelperLock);
++		drawRows(&job, visibleY0, visibleY1, fBlendRow);
++		return;
++	}
++	fHelperJob = &job;
++	fHelpersBusy = fThreads - 1;
++	fHelperGeneration++;
++	IOLockWakeup(fHelperLock, &fHelperGeneration, false);
++	IOLockUnlock(fHelperLock);
++	drawRows(&job, visibleY0, visibleY0 + (visibleY1 - visibleY0) / fThreads, fBlendRow);
++	IOLockLock(fHelperLock);
++	while (fHelpersBusy != 0) {
++		IOLockSleep(fHelperLock, &fHelpersBusy, THREAD_UNINT);
++	}
++	IOLockUnlock(fHelperLock);
++}
