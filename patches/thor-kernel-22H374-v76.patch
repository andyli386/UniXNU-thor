++/* Four bytes per element alone does not imply one pixel per element:
++ * compressed/block layouts can have shorter rows. Check the complete linear
++ * view before any CPU read or first-frame console handoff. */
++static bool
++canDrawLinearBGRA(const MiniIOSurface * surface)
++{
++	if (surface == NULL || surface->kpixels == NULL) return false;
++	const minisurf_result & info = surface->info;
++	if (info.pixelFormat != FOURCC('B', 'G', 'R', 'A') || info.planeCount != 0 ||
++	    info.bytesPerElement != 4 || info.elementWidth != 1 || info.elementHeight != 1 ||
++	    info.width == 0 || info.height == 0 || info.bytesPerRow < (uint64_t)info.width * 4) return false;
++	uint64_t lastRow = (uint64_t)info.width * 4;
++	if (info.offset > info.allocSize || lastRow > (uint64_t)info.allocSize - info.offset) return false;
++	/* Divide the available span rather than multiplying untrusted geometry
++	 * and then adding the offset, which could itself overflow uint64_t. */
++	return (uint64_t)(info.height - 1) <=
++	       ((uint64_t)info.allocSize - info.offset - lastRow) / info.bytesPerRow;
++}
