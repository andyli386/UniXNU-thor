++		int32_t first = job->py0 < 0 ? 0 : job->py0;
++		int32_t last = job->py1 > (int32_t) fb->fPanelHeight ? (int32_t) fb->fPanelHeight : job->py1;
++		rows = last - first;
++		y0 = first + (int32_t) ((int64_t) rows * (index + 1) / fb->fThreads);
++		y1 = first + (int32_t) ((int64_t) rows * (index + 2) / fb->fThreads);
