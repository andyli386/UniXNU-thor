++IOReturn
++IOMobileFramebufferUserClient::clientClose(void)
++{
++	if (fLock != NULL) {
++		IOLockLock(fLock);
++		fClosed = true;
++		IOLockUnlock(fLock);
++	}
++	if (fVSyncCall != NULL) {
++		thread_call_cancel_wait(fVSyncCall);
++	}
++	if (!isInactive()) {
