++/*
++ * Put a rectangle of a 32-bit surface on the screen. `dst` is in display coordinates; the
++ * panel may be of another size, and the layer itself may be scaled: both are done in one
++ * step, bilinear (or nearest neighbour: fb_filter=0).
++ */
++void
++IOMobileFramebuffer::drawLayer(MiniIOSurface * s, const int32_t * src, const int32_t * dst)
++{
++	if (!canDrawLinearBGRA(s)) return;
++	int32_t sx = src[0], sy = src[1], sw = src[2], sh = src[3];
++	int32_t dx = dst[0], dy = dst[1], dw = dst[2], dh = dst[3];
++	int32_t px0, py0, px1, py1, cx0, cx1;
++	bool filter = gFilter != 0;
++	RowJob job;
++
++	if (sw <= 0 || sh <= 0) {
++		sx = sy = 0;
++		sw = (int32_t) s->info.width;
++		sh = (int32_t) s->info.height;
++	}
++	if (dw <= 0 || dh <= 0) {
++		dx = dy = 0;
++		dw = (int32_t) fWidth;
++		dh = (int32_t) fHeight;
++	}
++	if (sw <= 0 || sh <= 0 || dw <= 0 || dh <= 0 || fWidth == 0 || fHeight == 0 ||
++	    sx < 0 || sy < 0 || (uint64_t) sx + (uint32_t) sw > s->info.width ||
++	    (uint64_t) sy + (uint32_t) sh > s->info.height) {
++		return;
++	}
++	/* Preserve the unclipped transform for sampling, without overflowing
++	 * 32-bit endpoint additions or narrowing a large off-screen position. */
++	int64_t left = (int64_t) dx * fPanelWidth / fWidth;
++	int64_t top = (int64_t) dy * fPanelHeight / fHeight;
++	int64_t right = ((int64_t) dx + dw) * fPanelWidth / fWidth;
++	int64_t bottom = ((int64_t) dy + dh) * fPanelHeight / fHeight;
++	if (right <= left || bottom <= top || right <= 0 || bottom <= 0 ||
++	    left >= fPanelWidth || top >= fPanelHeight ||
++	    left < INT32_MIN || top < INT32_MIN || right > INT32_MAX || bottom > INT32_MAX ||
++	    right - left > INT32_MAX || bottom - top > INT32_MAX) {
++		return;
++	}
++	px0 = (int32_t) left;
++	py0 = (int32_t) top;
++	px1 = (int32_t) right;
++	py1 = (int32_t) bottom;
++	cx0 = px0 < 0 ? 0 : px0;
++	cx1 = px1 > (int32_t) fPanelWidth ? (int32_t) fPanelWidth : px1;
++	int32_t visibleY0 = py0 < 0 ? 0 : py0;
++	int32_t visibleY1 = py1 > (int32_t) fPanelHeight ? (int32_t) fPanelHeight : py1;
++	if (cx0 >= cx1 || visibleY0 >= visibleY1) return;
++	beginGraphics();
++	/* (blending, a row of the picture mixed from two: room for it, for every one who draws rows) */
++	if (filter && fBlendRowSize < (uint32_t) sw) {
++		uint32_t capacity = (uint32_t) sw;
++		uint32_t * row = IONew(uint32_t, capacity);
++		uint32_t * helpers[7] = { NULL };
++		bool ready = row != NULL;
++		for (unsigned i = 0; ready && i + 1 < fThreads; i++) {
++			helpers[i] = IONew(uint32_t, capacity);
++			ready = helpers[i] != NULL;
