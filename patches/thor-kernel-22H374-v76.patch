diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index d5d5b16..11134d0 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -78,6 +78,7 @@
 
 #include <sys/param.h>
 #include <sys/systm.h>
+#include <sys/sysctl.h>
 #include <sys/ioctl.h>
 #include <sys/proc_internal.h>
 #include <sys/proc.h>
@@ -139,6 +140,38 @@
 
 #include <pexpert/pexpert.h>
 
+#if defined(PONG)
+extern void pong_ramoops_diagnostic_write(const char *, int);
+
+/* A write-only, small diagnostic endpoint for the Settings adapter. No
+ * process can read kernel memory or choose a physical address through it.
+ * Resolve its MIB once in userspace before installing fatal signal handlers.
+ */
+static int
+pong_diagnostic_sysctl SYSCTL_HANDLER_ARGS
+{
+	char text[1024], line[1152];
+	proc_t process = current_proc();
+	if (!process) return EPERM;
+	bool settings = strcmp(process->p_comm, "Preferences") == 0;
+	bool renderer = strcmp(process->p_comm, "backboardd") == 0 ||
+	    strcmp(process->p_comm, "SpringBoard") == 0;
+	if (!settings && !renderer) return EPERM;
+	if (!req->newptr || !req->newlen || req->newlen >= sizeof(text)) return EINVAL;
+	int error = SYSCTL_IN(req, text, req->newlen);
+	if (error) return error;
+	text[req->newlen] = 0;
+	int length = snprintf(line, sizeof(line), "%s[%d]: %s\n",
+	    settings ? "PONG SETTINGS" : "PONG GPU", proc_getpid(process), text);
+	if (length > 0) pong_ramoops_diagnostic_write(line,
+	    length < (int)sizeof(line) ? length : (int)sizeof(line)-1);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, pong_diagnostic,
+    CTLTYPE_STRING | CTLFLAG_WR | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    0, 0, pong_diagnostic_sysctl, "A", "Pong Settings and renderer failure record");
+#endif
+
 #include <kdp/kdp_dyld.h>
 
 #if SYSV_SHM
@@ -1892,6 +1925,40 @@ proc_prepareexit(proc_t p, int rv, boolean_t perf_notify)
 	task_t task = proc_task(p);
 
 
+#if defined(PONG)
+	/* THOR v73: v72 field data - audiomxd crashed twice but "Corpse
+	 * failure, too many" ate the diagnostics. This record is written
+	 * BEFORE corpse preparation from the original exit state, so it
+	 * survives corpse failure. The Preferences entry is the original
+	 * bounded example; the list covers the daemons whose crash reasons
+	 * this port keeps losing. */
+	if (strcmp(p->p_comm, "Preferences") == 0 ||
+	    strcmp(p->p_comm, "audiomxd") == 0 ||
+	    strcmp(p->p_comm, "mediaremoted") == 0 ||
+	    strcmp(p->p_comm, "PosterBoard") == 0 ||
+	    strcmp(p->p_comm, "fairplayd.A2") == 0 ||
+	    strncmp(p->p_comm, "com.apple.migrat", 16) == 0) {
+		char line[768];
+		os_reason_t reason = p->p_exit_reason;
+		const char *description = reason ? exit_reason_get_string_desc(reason) : NULL;
+		int length = snprintf(line, sizeof(line),
+		    "PONG EXIT %s pid=%d signal=%d status=%d namespace=%u code=0x%llx description=%.512s\n",
+		    p->p_comm, proc_getpid(p), WTERMSIG(rv), WEXITSTATUS(rv), reason ? reason->osr_namespace : 0,
+		    reason ? reason->osr_code : 0ULL, description ? description : "none");
+		if (length > 0) {
+			pong_ramoops_diagnostic_write(line,
+			    length < (int)sizeof(line) ? length : (int)sizeof(line)-1);
+			/* THOR v74: the phone's Recovery does not export this
+			 * ramoops range (its pstore sits elsewhere), so the
+			 * bounded original exit reason also goes to the console,
+			 * which PongConsole.txt does capture. The address
+			 * contract needs loader/Darwin/Recovery alignment and is
+			 * deliberately not patched here. */
+			printf("%.*s", length < (int)sizeof(line) ? length : (int)sizeof(line)-1, line);
+		}
+	}
+#endif
+
 	if (p->p_crash_behavior != 0 || p == initproc) {
 		proc_handle_critical_exit(p, rv);
 	}
