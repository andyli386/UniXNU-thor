++			 * Use a VM-backed descriptor and wire it before exposing its
++			 * state/pixels. This is real backing memory, not a larger quota
++			 * or an unprepared pageable surface handed to the GPU. */
++			memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
++			    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMemoryPageable,
++			    bytes, PAGE_SIZE);
++			if (memory != NULL && memory->prepare() != kIOReturnSuccess) {
