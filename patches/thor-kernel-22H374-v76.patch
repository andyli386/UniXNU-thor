++	if (fColumn != NULL) { IODelete(fColumn, uint32_t, fPanelWidth); fColumn = NULL; }
++	if (fColumnWeight != NULL) { IODelete(fColumnWeight, uint16_t, fPanelWidth); fColumnWeight = NULL; }
++	if (fHelperLock != NULL) { IOLockFree(fHelperLock); fHelperLock = NULL; }
++	if (fSwapLock != NULL) { IOLockFree(fSwapLock); fSwapLock = NULL; }
