++/* 22H374 _kern_SwapEnd sends 0x514 bytes from client+0x18. SwapBegin
++ * writes the ID at client+0xb0; SwapSetLayer writes surface IDs at +0xb4,
++ * rects at +0xc4/+0x124, and masks at +0x164/+0x168. Four layers remain.
++ */
++#define SWAP_SIZE               0x514
++#define SWAP_ID                 0x98
++#define SWAP_SURFACE(layer)     (0x9c + 4 * (layer))    /* surface number, 0 = none */
++#define SWAP_SOURCE(layer)      (0xac + 16 * (layer))   /* x, y, width, height in the surface */
++#define SWAP_ENABLED(layer)     (0xec + 4 * (layer))
++#define SWAP_DEST(layer)        (0x10c + 16 * (layer))  /* x, y, width, height on the display */
++#define SWAP_LAYERS_SET         0x14c                   /* bit per layer given in this swap */
++#define SWAP_LAYERS_CLEARED     0x150
++#define SWAP_LAYERS             4
++
++#define kFBNotifyVSync          5
++#define kFBNotifyTypes          8
++#define kFBRefreshHz            120                     /* Pong NT37705; fb_hz may select a lower mode */
++
++#define FRAME_TIMES             64                      /* milliseconds told apart between two frames */
++#define FRAME_PAUSE             90                      /* from so many on, nothing was moving: not a slow frame */
++#define SWAP_GPU_MS             500                     /* keep the previous picture when this frame is unfinished */
++#define SWAP_HELD_MS            700                     /* a swap that cannot be taken by then is not shown at all */
++
++#define FOURCC(a, b, c, d) ((uint32_t)(a) << 24 | (uint32_t)(b) << 16 | (uint32_t)(c) << 8 | (uint32_t)(d))
++
++static uint64_t gFBLogged[2];           /* selectors already reported */
++static uint8_t  gFBCalls[128];          /* how many calls of each selector were traced */
