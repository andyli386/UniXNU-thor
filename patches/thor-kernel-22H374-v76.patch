+ * lowpri band stops stalling UFS reads behind background I/O).
+ * debug.lowpri_throttle_enabled stays writable for A/B. */
+int     lowpri_throttle_enabled = 0;
 
 
 static void throttle_info_end_io_internal(struct _throttle_io_info_t *info, int throttle_level);
