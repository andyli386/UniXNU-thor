@@ -247,7 +247,12 @@ struct _throttle_io_info_t {
 struct _throttle_io_info_t _throttle_io_info[LOWPRI_MAX_NUM_DEV];
 
 
-int     lowpri_throttle_enabled = 1;
+/* THOR v58: default off. No driver on this board answers DKIOCISSOLIDSTATE,
+ * so every mount lands on an HDD throttle tier and paged-in images crawl
