++bool
++IOMobileFramebuffer::start(IOService * provider)
++{
++	thread_t thread;
++
++	if (!IOService::start(provider)) {
++		return false;
++	}
++	uint32_t gpuOnly = 0;
++	PE_parse_boot_argn("pong_gpu_only", &gpuOnly, sizeof(gpuOnly));
++	fGpuOnly = gpuOnly != 0;
++	if (vinfo.v_baseaddr == 0 || vinfo.v_width == 0 || vinfo.v_height == 0 || vinfo.v_depth != 32) {
++		IOLog("MiniIOMobileFramebuffer: no usable boot framebuffer (%ux%u, depth %u)\n", vinfo.v_width, vinfo.v_height,
++		    vinfo.v_depth);
++		return false;
++	}
++	if (vinfo.v_width > 16384 || vinfo.v_height > 16384 ||
++	    vinfo.v_rowbytes < vinfo.v_width * 4 ||
++	    (uint64_t)vinfo.v_baseaddr > ~0ULL - (uint64_t)vinfo.v_rowbytes * vinfo.v_height) {
++		IOLog("MiniIOMobileFramebuffer: invalid boot framebuffer range\n");
++		return false;
++	}
++	fBase = (uint8_t *) vinfo.v_baseaddr;
++	fPanelWidth = vinfo.v_width;
++	fPanelHeight = vinfo.v_height;
++	fRowBytes = vinfo.v_rowbytes;
++	fLock = IOLockAlloc();
++	fSwapLock = IOLockAlloc();
++	fHelperLock = IOLockAlloc();
++	fColumn = IONewZero(uint32_t, vinfo.v_width);
++	fColumnWeight = IONewZero(uint16_t, vinfo.v_width);
++	if (!fLock || !fSwapLock || !fHelperLock || !fColumn || !fColumnWeight) {
++		IOLog("MiniIOMobileFramebuffer: no memory for display state\n");
++		return failStart(provider);
++	}
++	fThreads = gThreads >= 1 && gThreads <= 8 ? gThreads : 1;
++#if XNU_PONG_ADRENO_PLATFORM
++	pong_scanout_initialize((uint64_t)fBase,(size_t)fRowBytes*fPanelHeight,
++	    fRowBytes,fPanelWidth,fPanelHeight);
++#endif
++	fWidth = gFBWidth ? gFBWidth : fPanelWidth;
++	fHeight = gFBHeight ? gFBHeight : fPanelHeight;
++	uint32_t nativeScale = kFBDefaultScale;
++	IORegistryEntry * chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
++	if (chosen != NULL) {
++		OSData * data = OSDynamicCast(OSData, chosen->getProperty("display-scale"));
++		uint32_t scale = 0;
++		if (data != NULL && data->getLength() == sizeof(scale)) {
++			memcpy(&scale, data->getBytesNoCopy(), sizeof(scale));
++			if (scale >= 1 && scale <= 8) nativeScale = scale;
++		}
++		chosen->release();
++	}
++	if (gFBScale != 0 && gFBScale != nativeScale) {
++		static const char * const places[][2] = { { "/chosen", "display-scale" }, { "/product", "artwork-scale-factor" } };
++		uint32_t scale = gFBScale;
++		uint64_t width = (uint64_t) fPanelWidth * scale / nativeScale;
++		uint64_t height = (uint64_t) fPanelHeight * scale / nativeScale;
++
++		if (scale <= 8 && width != 0 && height != 0 && width <= 16384 && height <= 16384) {
++			fWidth = (uint32_t) width;
++			fHeight = (uint32_t) height;
++			/* Keep the published logical size and MobileGestalt scale in agreement. */
++			for (unsigned i = 0; i < sizeof(places) / sizeof(places[0]); i++) {
++				IORegistryEntry * node = IORegistryEntry::fromPath(places[i][0], gIODTPlane);
++				if (node != NULL) {
++					node->setProperty(places[i][1], &scale, sizeof(scale));
++					node->release();
++				}
++			}
++		} else {
++			IOLog("MiniIOMobileFramebuffer: invalid fbscale=%u; retain native workspace\n", scale);
++		}
++	}
++	fDiff = gDiff != 0;
++	fDiffLeft = fDiffTop = ~0u;
++	IOLog("MiniIOMobileFramebuffer: display %ux%u on a panel of %ux%u (%u bytes per row)\n", fWidth, fHeight,
++	    fPanelWidth, fPanelHeight, fRowBytes);
++
++	if (!setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient") ||
++	    !setProperty("PongSoftwareRenderer", kOSBooleanTrue) || !publishModes()) {
++		IOLog("MiniIOMobileFramebuffer: incomplete display mode; service not published\n");
++		return failStart(provider);
++	}
++	/* Pong REC DRM and its selected NT37705 timing expose 1080x2412 at
++	 * 120/90/60 Hz. Publish the native CoreAnimation heartbeat contract as
++	 * well as IOMFB mode timing; without it AppleDisplay retains its 60 Hz
++	 * minimum despite a faster synthetic vsync timer. A fixed step does not
++	 * claim APT/VRR that this framebuffer does not implement. */
++	OSDictionary *refresh = OSDictionary::withCapacity(2);
++	OSNumber *interval = OSNumber::withNumber((1ULL << 32) / refreshHz(), 32);
++	OSNumber *step = OSNumber::withNumber(0ULL, 32);
++	if (!refresh || !interval || !step) {
++		OSSafeReleaseNULL(interval); OSSafeReleaseNULL(step); OSSafeReleaseNULL(refresh);
++		return failStart(provider);
++	}
++	refresh->setObject("displayMinRefreshInterval", interval);
++	refresh->setObject("displayRefreshStepMachTime", step);
++	setProperty("IOMFBDisplayRefresh", refresh);
++	OSSafeReleaseNULL(interval); OSSafeReleaseNULL(step); OSSafeReleaseNULL(refresh);
++	IOLog("MiniIOMobileFramebuffer: Pong fixed refresh %u Hz, 1080x2412 NT37705 mode; GPU frame rate observed separately\n", refreshHz());
++	fStartingDisplayNode = createDisplayNode();
++	if (fStartingDisplayNode == NULL) {
++		IOLog("MiniIOMobileFramebuffer: incomplete display DT node; service not published\n");
++		return failStart(provider);
++	}
++	/* All fallible display-state setup finishes before persistent workers
++	 * start. A failed mode/allocation must leave neither orphan threads nor
++	 * a registered display with incomplete properties. */
++	if (kernel_thread_start(&IOMobileFramebuffer::presenterMain, this, &thread) != KERN_SUCCESS) {
++		IOLog("MiniIOMobileFramebuffer: no thread to put frames on the panel with\n");
++		return failStart(provider);
++	}
++	thread_set_thread_name(thread, "frames to the panel");
++	thread_deallocate(thread);
++	for (unsigned i = 0; i + 1 < fThreads; i++) {
++		if (kernel_thread_start(&IOMobileFramebuffer::helperMain, this, &thread) != KERN_SUCCESS) {
++			fThreads = i + 1;
++			break;
++		}
++		thread_set_thread_name(thread, "frames to the panel: a helper");
++		thread_deallocate(thread);
++	}
++	setName("disp0");
++	registerService();
++	fStartingDisplayNode->release(); /* the DT plane retains the committed node */
++	fStartingDisplayNode = NULL;
++	return true;
++}
