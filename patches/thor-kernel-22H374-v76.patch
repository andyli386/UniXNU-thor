++/*
++ * One refresh: tell the client, which gets three 64-bit numbers as six 32-bit halves --
++ * the time of this refresh, the same again (the time it was presented), and a counter.
++ */
++void
++IOMobileFramebufferUserClient::vsync(void)
++{
++	OSAsyncReference64 ref = { 0 };
++	io_user_reference_t args[6];
++	uint64_t now, count = 0;
++	mach_port_t port = IPC_PORT_NULL;
++	bool send = false;
++
++	IOLockLock(fLock);
++	now = fVSyncTime;
++	if (fClosed || fCallbacks[kFBNotifyVSync] == 0 || fPorts[kFBNotifyVSync] == NULL) {
++		fVSyncRunning = false;
++	} else {
++		port = ipc_port_copy_send_mqueue(fPorts[kFBNotifyVSync]);
++		if (!IPC_PORT_VALID(port)) {
++			fVSyncRunning = false;
++			IOLockUnlock(fLock);
++			return;
++		}
++		count = ++fVSyncCount;
++		/* Registration can replace/release fPorts after this lock drops.
++		 * Keep our own send right until notification delivery finishes. */
++		setAsyncReference64(ref, (mach_port_t) port, fCallbacks[kFBNotifyVSync], fRefcons[kFBNotifyVSync], fTask);
++		args[0] = (uint32_t) now;
++		args[1] = now >> 32;
++		args[2] = (uint32_t) now;
++		args[3] = now >> 32;
++		args[4] = (uint32_t) fVSyncCount;
++		args[5] = fVSyncCount >> 32;
++		send = true;
++		armVSync();
++	}
++	IOLockUnlock(fLock);
++	if (send) {
++		IOReturn result = sendAsyncResult64WithOptions(ref, kIOReturnSuccess, args, 6, kIOUserNotifyOptionCanDrop);
++		ipc_port_release_send(port);
++		if (count <= 2) {
++			IOLog("MiniIOMobileFramebuffer: refresh notification %llu result=%x\n", count, result);
++		}
++	}
++}
