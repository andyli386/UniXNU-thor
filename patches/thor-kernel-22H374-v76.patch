++/* 22H374 IOMFBDisplay::is_ready/update_power_state use ID zero before
++ * the first SwapBegin. Zero means the queued work, not an invalid frame.
++ * High-bit flags are readiness polls (can_update expects Busy); they must
++ * never sleep for a future frame and stall the render server. */
++IOReturn IOMobileFramebuffer::waitSwap(uint32_t id,uint32_t flags,uint64_t timeout)
++{
++    uint64_t deadline;
++    clock_interval_to_deadline((uint32_t)(timeout && timeout<1000?timeout:1000),kMillisecondScale,&deadline);
++    IOLockLock(fSwapLock);
++    if(!id) {
++        if(!fSwapsWaiting){IOLockUnlock(fSwapLock);return kIOReturnSuccess;}
++        const unsigned last=(fSwapFirst+fSwapsWaiting-1)%SWAP_QUEUE;
++        id=swapWord(fSwap[last],SWAP_ID);
++    }
++    while(fRetired[id%64].id!=id) {
++        if(flags&0x80000000u){IOLockUnlock(fSwapLock);return kIOReturnBusy;}
++        if(IOLockSleepDeadline(fSwapLock,&fSwapsWaiting,deadline,THREAD_ABORTSAFE)!=THREAD_AWAKENED) {
++            IOLockUnlock(fSwapLock);return kIOReturnTimeout;
++        }
++    }
++    IOReturn result=fRetired[id%64].result;IOLockUnlock(fSwapLock);return result;
++}
