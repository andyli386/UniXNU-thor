++void
++IOMobileFramebufferUserClient::free(void)
++{
++	/* free can follow a failed start/termination without clientClose. Stop
++	 * self-rearming callbacks before cancel_wait, or they can outlive us. */
++	if (fLock != NULL) {
++		IOLockLock(fLock);
++		fClosed = true;
++		IOLockUnlock(fLock);
++	}
++	if (fVSyncCall != NULL) {
++		thread_call_cancel_wait(fVSyncCall);
++		thread_call_free(fVSyncCall);
++		fVSyncCall = NULL;
++	}
++	for (unsigned i = 0; i < kFBNotifyTypes; i++) {
++		if (fPorts[i] != NULL) {
++			releaseNotificationPort(fPorts[i]);
++			fPorts[i] = NULL;
++		}
++	}
++	if (fLock != NULL) {
