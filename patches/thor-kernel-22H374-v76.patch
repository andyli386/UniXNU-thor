++IOReturn
++IOMobileFramebufferUserClient::registerNotificationPort(mach_port_t port, UInt32 type, io_user_reference_t refCon)
++{
++	mach_port_t old;
++
++	IOLog("MiniIOMobileFramebuffer: notification port for type %u\n", (unsigned) type);
++	if (type >= kFBNotifyTypes) {
++		return kIOReturnBadArgument;
++	}
++	IOLockLock(fLock);
++	if (fClosed) {
++		IOLockUnlock(fLock);
++		return kIOReturnNotOpen;
++	}
++	old = fPorts[type];
++	fPorts[type] = port;
++	/* Either registration order is valid. A callback installed before its
++	 * port must not lose the refresh clock when the first timer fires. */
++	if (type == kFBNotifyVSync && port != NULL && fCallbacks[type] != 0 &&
++	    !fVSyncRunning && !fClosed) {
++		fVSyncRunning = true;
++		armVSync();
++	}
++	IOLockUnlock(fLock);
++	if (old != NULL) {
++		releaseNotificationPort(old);
++	}
++	return kIOReturnSuccess;
++}
