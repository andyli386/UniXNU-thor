++/*
++ * The modes of the display, the way CoreAnimation reads them (the properties TimingElements
++ * and ColorElements; without a mode it draws nothing). One timing, the panel's size at
++ * 60 Hz (boot-arg fb_hz=N: at N), with one colour mode, 8-bit RGB. The identifiers are what "the current mode"
++ * (block 0x40) answers with.
++ */
++#define kFBTimingID     1
++#define kFBColorID      1
++
++bool
++IOMobileFramebuffer::publishModes(void)
++{
++	OSDictionary * timing = OSDictionary::withCapacity(8);
++	OSDictionary * horizontal = OSDictionary::withCapacity(4);
++	OSDictionary * vertical = OSDictionary::withCapacity(4);
++	OSDictionary * color = OSDictionary::withCapacity(8);
++	OSArray * timings = OSArray::withCapacity(1);
++	OSArray * colors = OSArray::withCapacity(1);
++	const uint32_t rate = refreshHz() << 16;                /* 16.16 fixed point */
++	bool success = false;
++
++	if (timing == NULL || horizontal == NULL || vertical == NULL || color == NULL || timings == NULL || colors == NULL) {
++		goto out;
++	}
++	if (!setNumber(color, "ID", kFBColorID) ||
++	    !setNumber(color, "PixelEncoding", 0) ||             /* RGB 4:4:4 */
++	    !setNumber(color, "Depth", 8) || !setNumber(color, "Colorimetry", 1) ||
++	    !setNumber(color, "EOTF", 1) || !setNumber(color, "DynamicRange", 0) ||
++	    !setNumber(color, "Score", 1) || !color->setObject("IsVirtual", kOSBooleanFalse) ||
++	    !colors->setObject(color) ||
++	    !setNumber(horizontal, "Active", fWidth) || !setNumber(horizontal, "Total", fWidth) ||
++	    !setNumber(horizontal, "SyncRate", rate) || !setNumber(horizontal, "PreciseSyncRate", rate) ||
++	    !setNumber(vertical, "Active", fHeight) || !setNumber(vertical, "Total", fHeight) ||
++	    !setNumber(vertical, "SyncRate", rate) || !setNumber(vertical, "PreciseSyncRate", rate) ||
++	    !setNumber(timing, "ID", kFBTimingID) || !setNumber(timing, "Score", 1) ||
++	    !timing->setObject("IsVirtual", kOSBooleanFalse) || !timing->setObject("IsOverscanned", kOSBooleanFalse) ||
++	    !timing->setObject("HorizontalAttributes", horizontal) || !timing->setObject("VerticalAttributes", vertical) ||
++	    !timing->setObject("ColorModes", colors) || !timings->setObject(timing)) goto out;
++	if (!setProperty("TimingElements", timings)) goto out;
++	if (!setProperty("ColorElements", colors)) {
++		removeProperty("TimingElements");
++		goto out;
++	}
++	success = true;
++out:
++	OSSafeReleaseNULL(timings);
++	OSSafeReleaseNULL(colors);
++	OSSafeReleaseNULL(timing);
++	OSSafeReleaseNULL(horizontal);
++	OSSafeReleaseNULL(vertical);
++	OSSafeReleaseNULL(color);
++	return success;
++}
