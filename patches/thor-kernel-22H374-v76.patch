++/* The Metal frontend brackets actual submissions with authorized send
++ * rights. Reading starts only after those GPU jobs and cache acquisition
++ * completed; subsequent writers wait until the display finishes copying. */
++bool MiniIOSurfaceDrawn(MiniIOSurface *surface,uint64_t milliseconds)
++{
++    if(!surface)return false;
++    uint64_t deadline;clock_interval_to_deadline((uint32_t)(milliseconds>1000?1000:milliseconds),kMillisecondScale,&deadline);
++    IOLockLock(gSurfaceLock);
++    while(surface->gpuWriters && !surface->gpuFailed) {
++        if(IOLockSleepDeadline(gSurfaceLock,surface,deadline,THREAD_ABORTSAFE)!=THREAD_AWAKENED) {
++            IOLockUnlock(gSurfaceLock);return false;
++        }
++    }
++    const bool ready=!surface->gpuFailed && !surface->drawn;
++    if(ready)++surface->displayReaders;
++    IOLockUnlock(gSurfaceLock);return ready;
++}
++void MiniIOSurfaceDisplayDone(MiniIOSurface *surface)
++{
++    IOLockLock(gSurfaceLock);
++    if(surface->displayReaders)--surface->displayReaders;
++    IOLockWakeup(gSurfaceLock,surface,false);IOLockUnlock(gSurfaceLock);
++}
