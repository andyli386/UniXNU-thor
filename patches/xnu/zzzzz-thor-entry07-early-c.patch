+/* ENTRY07: fixed-grant normal bootstrap and bounded early-C diagnostic.
+ * All pre-MMU helpers are stackless. Only 64MiB owned RAM and the previously
+ * proved framebuffer rows64..127 are addressed. No firmware service is used.
+ */
+        .align 2
+        .globl EXT(thor_entry07_enter)
+LEXT(thor_entry07_enter)
+        mrs     x9, CurrentEL
+        cmp     x9, #4
+        b.ne    EXT(thor_entry07_park)
+        msr     daifset, #15
+
+        /* Exact 64 MiB grant, wholly inside the published low DXE heap. */
+        movz    x9, #0x0400, lsl #16
+        cmp     x3, x9
+        b.ne    EXT(thor_entry07_park)
+        movz    x9, #0xf800, lsl #16
+        cmp     x2, x9
+        b.lo    EXT(thor_entry07_park)
+        movz    x9, #0xfbc0, lsl #16 /* 0xffc00000 - 64 MiB */
+        cmp     x2, x9
+        b.hi    EXT(thor_entry07_park)
+        and     x9, x2, #0x1fffff
+        movz    x10, #0x4000
+        cmp     x9, x10
+        b.ne    EXT(thor_entry07_park)
+
+        /* The actual branch destination must be this image's real __start. */
+        adr     x9, EXT(_start)
+        cmp     x1, x9
+        b.ne    EXT(thor_entry07_park)
+        cmp     x1, x2
+        b.lo    EXT(thor_entry07_park)
+        sub     x10, x1, x2
+        cmp     x10, x3
+        b.hs    EXT(thor_entry07_park)
+
+        /* Install only after proving the whole 2 KiB vector span is owned. */
+        adr     x9, EXT(LowExceptionVectorBase)
+        tst     x9, #0x7ff
+        b.ne    EXT(thor_entry07_park)
+        cmp     x9, x2
+        b.lo    EXT(thor_entry07_park)
+        sub     x10, x9, x2
+        cmp     x10, x3
+        b.hs    EXT(thor_entry07_park)
+        sub     x10, x3, x10
+        cmp     x10, #0x800
+        b.lo    EXT(thor_entry07_park)
+        msr     VBAR_EL1, x9
+        isb
+
+        /* Require EL1 stage-1 translation and data/instruction caching off. */
+        mrs     x9, SCTLR_EL1
+        movz    x10, #0x1005       /* M | C | I */
+        tst     x9, x10
+        b.ne    EXT(thor_entry07_reset)
+        tbnz    x9, #25, EXT(thor_entry07_reset) /* reject big-endian EL1 data */
+
+        /* Full 0x480-byte ARM64 boot_args must fit before the first load. */
+        tst     x0, #0x3fff        /* caller places Args on a 16 KiB boundary */
+        b.ne    EXT(thor_entry07_reset)
+        cmp     x0, x2
+        b.lo    EXT(thor_entry07_reset)
+        sub     x9, x0, x2
+        sub     x10, x3, #0x480
+        cmp     x9, x10
+        b.hi    EXT(thor_entry07_reset)
+
+        ldr     w9, [x0, #0]
+        movz    w10, #2
+        movk    w10, #2, lsl #16  /* Revision 2, Version 2, little endian */
+        cmp     w9, w10
+        b.ne    EXT(thor_entry07_reset)
+        ldr     x9, [x0, #0x8]
+        movz    x10, #0x4000
+        movk    x10, #0x0700, lsl #16
+        movk    x10, #0xfff0, lsl #32
+        movk    x10, #0xffff, lsl #48
+        cmp     x9, x10           /* fixed mainline VirtualBase */
+        b.ne    EXT(thor_entry07_reset)
+        ldr     x9, [x0, #0x10]
+        cmp     x9, x2
+        b.ne    EXT(thor_entry07_reset)
+        ldr     x9, [x0, #0x18]
+        cmp     x9, x3
+        b.ne    EXT(thor_entry07_reset)
+        ldr     x9, [x0, #0x478]
+        cmp     x9, x3
+        b.ne    EXT(thor_entry07_reset)
+
+        /* Truthful Top: aligned, covers Args, and keeps the 2 MiB tail. */
+        ldr     x9, [x0, #0x20]
+        tst     x9, #0x3fff
+        b.ne    EXT(thor_entry07_reset)
+        add     x10, x0, #0x480
+        cmp     x9, x10
+        b.lo    EXT(thor_entry07_reset)
+        sub     x9, x9, x2
+        movz    x10, #0x20, lsl #16
+        sub     x10, x3, x10
+        cmp     x9, x10
+        b.hi    EXT(thor_entry07_reset)
+        ldr     w9, [x0, #0x58]    /* machineType */
+        cbnz    w9, EXT(thor_entry07_reset)
+        /* ADT is an owned KVA pointer; validate its entire fixed 544 bytes. */
+        ldr     x9, [x0, #0x60]
+        tst     x9, #3
+        b.ne    EXT(thor_entry07_reset)
+        MOV64   x10, VM_KERNEL_LINK_ADDRESS
+        cmp     x9, x10
+        b.lo    EXT(thor_entry07_reset)
+        sub     x9, x9, x10
+        sub     x10, x3, #544
+        cmp     x9, x10
+        b.hi    EXT(thor_entry07_reset)
+        add     x9, x9, x2
+        add     x9, x9, #544
+        ldr     x10, [x0, #0x20]
+        cmp     x9, x10
+        b.hi    EXT(thor_entry07_reset)
+        ldr     w9, [x0, #0x68]
+        cmp     w9, #544
+        b.ne    EXT(thor_entry07_reset)
+        ldrb    w9, [x0, #0x6c]    /* empty command line */
+        cbnz    w9, EXT(thor_entry07_reset)
+        ldr     x9, [x0, #0x470]   /* bootFlags */
+        cbnz    x9, EXT(thor_entry07_reset)
+
+        /* Exact observed GOP contract; compare full 64-bit Video fields. */
+        ldr     x19, [x0, #0x28]
+        movz    x9, #0xb800, lsl #16
+        cmp     x19, x9
+        b.ne    EXT(thor_entry07_reset)
+        ldr     x9, [x0, #0x30]
+        cmp     x9, #1
+        b.ne    EXT(thor_entry07_reset)
+        ldr     x20, [x0, #0x38]
+        movz    x9, #5760
+        cmp     x20, x9
+        b.ne    EXT(thor_entry07_reset)
+        ldr     x9, [x0, #0x40]
+        cmp     x9, #1440
+        b.ne    EXT(thor_entry07_reset)
+        ldr     x9, [x0, #0x48]
+        cmp     x9, #3200
+        b.ne    EXT(thor_entry07_reset)
+        ldr     x9, [x0, #0x50]
+        cmp     x9, #32
+        b.ne    EXT(thor_entry07_reset)
+
+        /* Actual header, full pool and both stack spans must be owned.
+         * These checks precede the first pool store or virtual SP assignment. */
+        adrp    x9, EXT(_mh_execute_header)@page
+        add     x9, x9, EXT(_mh_execute_header)@pageoff
+        cmp     x9, x2
+        b.ne    EXT(thor_entry07_reset)
+        adrp    x9, EXT(bootstrap_pagetables)@page
+        cmp     x9, x2
+        b.lo    EXT(thor_entry07_reset)
+        add     x10, x9, #16, lsl #12
+        add     x11, x2, x3
+        cmp     x10, x11
+        b.hi    EXT(thor_entry07_reset)
+        adrp    x9, EXT(intstack)@page
+        add     x9, x9, EXT(intstack)@pageoff
+        cmp     x9, x2
+        b.lo    EXT(thor_entry07_reset)
+        add     x10, x9, #4, lsl #12
+        cmp     x10, x11
+        b.hi    EXT(thor_entry07_reset)
+        adrp    x12, EXT(intstack_top)@page
+        add     x12, x12, EXT(intstack_top)@pageoff
+        cmp     x10, x12
+        b.ne    EXT(thor_entry07_reset)
+        adrp    x9, EXT(excepstack)@page
+        add     x9, x9, EXT(excepstack)@pageoff
+        cmp     x9, x2
+        b.lo    EXT(thor_entry07_reset)
+        add     x10, x9, #4, lsl #12
+        cmp     x10, x11
+        b.hi    EXT(thor_entry07_reset)
+        adrp    x12, EXT(excepstack_top)@page
+        add     x12, x12, EXT(excepstack_top)@pageoff
+        cmp     x10, x12
+        b.ne    EXT(thor_entry07_reset)
+
+        /* Counter is independently checked at the real kernel entry. */
+        mrs     x22, CNTFRQ_EL0
+        movz    x9, #0xf800
+        movk    x9, #0x0124, lsl #16 /* 19,200,000 Hz */
+        cmp     x22, x9
+        b.ne    EXT(thor_entry07_reset)
+        isb
+        mrs     x23, CNTVCT_EL0
+        movz    w12, #4096
+L_entry07_counter_probe:
+        isb
+        mrs     x9, CNTVCT_EL0
+        cmp     x9, x23
+        b.ne    L_entry07_enter_mark
+        subs    w12, w12, #1
+        b.ne    L_entry07_counter_probe
+        b       EXT(thor_entry07_reset)
+
+L_entry07_enter_mark:
+        mov     x27, x0
+        mov     x0, #0
+        movz    w1, #0x00ff
+        movk    w1, #0x00ff, lsl #16
+        bl      EXT(thor_entry07_mark)
+        mov     x0, x27
+        b       EXT(start_first_cpu)
+
+/* Fixed geometry, freshly zeroed entire 16-page pool, ten pages used.
+ * Inputs: x0=owned PA, x1=KVA, x2=64MiB, x3=pool PA, x4=pool bytes.
+ * x19..x30 and SP are untouched. All failures precede ordinary startup.
+ * Pool: 0/1 roots; 2,3,4 identity L2/edge L3; 5,6,7 KVA;
+ * 8,9 framebuffer L2/L3. No leaf extends beyond either allowed range.
+ */
+.align 2
+.globl EXT(thor_entry07_build_tables)
+LEXT(thor_entry07_build_tables)
+        mov     x5, #0x04000000
+        cmp     x2, x5
+        b.ne    EXT(thor_entry07_reset)
+        MOV64   x5, VM_KERNEL_LINK_ADDRESS
+        cmp     x1, x5
+        b.ne    EXT(thor_entry07_reset)
+        mov     x5, #0xf8000000
+        cmp     x0, x5
+        b.lo    EXT(thor_entry07_reset)
+        mov     x5, #0xfbc00000
+        cmp     x0, x5
+        b.hi    EXT(thor_entry07_reset)
+        and     x5, x0, #0x1fffff
+        cmp     x5, #0x4000
+        b.ne    EXT(thor_entry07_reset)
+        cmp     x4, #16, lsl #12
+        b.ne    EXT(thor_entry07_reset)
+        tst     x3, #0xfff
+        b.ne    EXT(thor_entry07_reset)
+        cmp     x3, x0
+        b.lo    EXT(thor_entry07_reset)
+        add     x5, x3, x4
+        add     x6, x0, x2
+        cmp     x5, x6
+        b.hi    EXT(thor_entry07_reset)
+        ubfx    x5, x0, #21, #9
+        cmp     x5, #479
+        b.hi    EXT(thor_entry07_reset)
+        ubfx    x5, x1, #21, #9
+        cmp     x5, #479
+        b.hi    EXT(thor_entry07_reset)
+
+        /* Zero precedes every install, including all unused root entries. */
+        mov     x5, x3
+        mov     x6, #8192
+L_entry07_zero:
+        str     xzr, [x5], #8
+        subs    x6, x6, #1
+        b.ne    L_entry07_zero
+
+        mov     x5, x3
+        add     x6, x3, #2, lsl #12
+        mov     x9, x0
+        mov     w11, #2
+L_entry07_map:
+        ubfx    x12, x9, #30, #9
+        add     x12, x5, x12, lsl #3
+        orr     x13, x6, #3
+        str     x13, [x12]
+        ubfx    x12, x9, #21, #9
+        add     x12, x6, x12, lsl #3
+        add     x7, x6, #1, lsl #12
+        add     x8, x6, #2, lsl #12
+        orr     x13, x7, #3
+        str     x13, [x12], #8
+        add     x14, x7, #32
