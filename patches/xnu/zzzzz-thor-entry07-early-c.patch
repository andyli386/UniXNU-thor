+/* Included only in the actual arm_init.c under XNU_THOR_EARLY_C=1.
+ * No allocator, console, scheduler or VM bootstrap is introduced here.
+ */
+#include "../../pexpert/arm/thor_entry07_clock.h"
+
+extern void thor_entry07_mark(uint64_t band, uint32_t rgb);
+extern uint32_t thor_entry07_c_state(const boot_args *args);
+extern void thor_entry07_fail(void) __attribute__((noreturn));
+extern void thor_entry07_stop(void) __attribute__((noreturn));
+extern void thor_entry07_reset(void) __attribute__((noreturn));
+
+static void
+thor_entry07_c_enter(const boot_args *args)
+{
+    if (thor_entry07_c_state(args) != 1) {
+        thor_entry07_reset();
+    }
+    /* A fixed, unslid MH_EXECUTE with no threaded starts takes the real
+     * normal rebase function's minimal branch. Other formats are refused. */
+    if ((uintptr_t)&_mh_execute_header != (uintptr_t)VM_KERNEL_LINK_ADDRESS ||
+        _mh_execute_header.magic != MH_MAGIC_64 ||
+        _mh_execute_header.filetype != MH_EXECUTE ||
+        (_mh_execute_header.flags & MH_DYLIB_IN_CACHE) != 0 ||
+        &__thread_starts_sect_start[0] != &__thread_starts_sect_end[0]) {
+        thor_entry07_fail();
+    }
+    thor_entry07_mark(2, 0x00ffff00U);
+}
+
+static void __attribute__((noreturn))
+thor_entry07_c_finish(boot_args *args)
+{
+    DTEntry chosen = NULL;
+    void const *property = NULL;
+    unsigned int size = 0;
+    const unsigned char *bytes;
+    uint64_t unknown_frequencies;
+
+    if (thor_entry07_c_state(args) != 1) {
+        thor_entry07_reset();
+    }
+    if (BootArgs != args || args != &const_boot_args || vm_kernel_slide != 0 ||
+        static_kernelcache || PE_state.initialized != TRUE ||
+        PE_state.bootArgs != args || PE_state.deviceTreeHead != args->deviceTreeP ||
+        PE_state.deviceTreeSize != 544 || args->deviceTreeLength != 544 ||
+        PE_state.video.v_baseAddr != 0xb8000000ULL ||
+        PE_state.video.v_rowBytes != 5760 || PE_state.video.v_width != 1440 ||
+        PE_state.video.v_height != 3200 || PE_state.video.v_depth != 32 ||
+        PE_state.video.v_display != 1) {
+        thor_entry07_fail();
+    }
+    if (gThorEntry07ClockReport.version != 1 ||
+        gThorEntry07ClockReport.status != 1 ||
+        gThorEntry07ClockReport.valid_mask != 3 ||
+        gThorEntry07ClockReport.cpu_count != 1 ||
+        gThorEntry07ClockReport.counter_hz != 19200000 ||
+        gThorEntry07ClockReport.dt_timebase_hz != 19200000 ||
+        gThorEntry07ClockReport.reserved != 0) {
+        thor_entry07_fail();
+    }
+    unknown_frequencies = gPEClockFrequencyInfo.bus_clock_rate_hz |
+        gPEClockFrequencyInfo.cpu_clock_rate_hz |
+        gPEClockFrequencyInfo.bus_clock_rate_num |
+        gPEClockFrequencyInfo.bus_clock_rate_den |
+        gPEClockFrequencyInfo.bus_to_cpu_rate_num |
+        gPEClockFrequencyInfo.bus_to_cpu_rate_den |
+        gPEClockFrequencyInfo.bus_to_dec_rate_num |
+        gPEClockFrequencyInfo.bus_to_dec_rate_den |
+        gPEClockFrequencyInfo.timebase_frequency_num |
+        gPEClockFrequencyInfo.timebase_frequency_den |
+        gPEClockFrequencyInfo.bus_frequency_hz |
+        gPEClockFrequencyInfo.bus_frequency_min_hz |
+        gPEClockFrequencyInfo.bus_frequency_max_hz |
+        gPEClockFrequencyInfo.cpu_frequency_hz |
+        gPEClockFrequencyInfo.cpu_frequency_min_hz |
+        gPEClockFrequencyInfo.cpu_frequency_max_hz |
+        gPEClockFrequencyInfo.prf_frequency_hz |
+        gPEClockFrequencyInfo.prf_frequency_min_hz |
+        gPEClockFrequencyInfo.prf_frequency_max_hz |
+        gPEClockFrequencyInfo.mem_frequency_hz |
+        gPEClockFrequencyInfo.mem_frequency_min_hz |
+        gPEClockFrequencyInfo.mem_frequency_max_hz |
+        gPEClockFrequencyInfo.fix_frequency_hz;
+    if (unknown_frequencies != 0 ||
+        gPEClockFrequencyInfo.dec_clock_rate_hz != 19200000 ||
+        gPEClockFrequencyInfo.timebase_frequency_hz != 19200000) {
+        thor_entry07_fail();
+    }
+    if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+        SecureDTGetProperty(chosen, "entry07-diagnostic", &property, &size) != kSuccess ||
+        size != 4 || property == NULL) {
+        thor_entry07_fail();
+    }
+    bytes = (const unsigned char *)property;
+    if (bytes[0] != 1 || bytes[1] != 0 || bytes[2] != 0 || bytes[3] != 0) {
+        thor_entry07_fail();
+    }
+    /* Fifth band is dominated by the genuine PE(FALSE) return and checks. */
+    thor_entry07_mark(4, 0x0000ff00U);
+    thor_entry07_stop();
+}
