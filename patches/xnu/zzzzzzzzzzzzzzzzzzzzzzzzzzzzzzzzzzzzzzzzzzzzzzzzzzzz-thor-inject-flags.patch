+++ b/bsd/kern/kern_minimac.c	2026-11-10 07:57:10
@@ -71,7 +71,16 @@
  * our own library be loaded into stock daemons (DYLD_INSERT_LIBRARIES).
  */
 #define AMFI_SYSCALL_CHECK_DYLD_POLICY  0x5a
-#define AMFI_DYLD_OUTPUT_ALLOW_ALL      0xffULL
+/*
+ * Everything is allowed - @paths, the DYLD_* variables, interposing, embedded
+ * vars - except AMFI_DYLD_OUTPUT_ALLOW_FAILED_LIBRARY_INSERTION (0x20).
+ * With that bit set dyld only warns when DYLD_INSERT_LIBRARIES names a
+ * library it cannot load, and the process carries on, which is exactly how
+ * a broken injection can look like a working one. Without it dyld aborts the
+ * process, so a failed insertion becomes a SIGABRT that the THOR EXIT line
+ * reports instead of silence.
+ */
+#define AMFI_DYLD_OUTPUT_ALLOW_ALL      0xdfULL
 
 /*
