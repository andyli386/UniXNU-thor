+
+	/*
+	 * THOR: SpringBoard died five times in a row on 2026-11-09 and the only
+	 * console evidence was "Too many corpses being created", which is the
+	 * corpse-budget message, not a cause. Report the signal, the exit status
+	 * and the exit reason here, in the one path every exit goes through, so
+	 * a library-load abort (SIGABRT) is distinguishable from a real crash
+	 * (SIGSEGV/SIGBUS) and from a kill (SIGKILL).
+	 */
+	if (strcmp(p->p_comm, "SpringBoard") == 0) {
+		static int thor_sb_exits;
+		if (thor_sb_exits < 20) {
+			os_reason_t sb_reason = p->p_exit_reason;
+			thor_sb_exits++;
+			printf("THOR EXIT: SpringBoard[%d] rv=%#x signaled=%d sig=%d "
+			    "exited=%d status=%d behavior=%#x\n",
+			    proc_getpid(p), rv,
+			    WIFSIGNALED(rv) ? 1 : 0, WIFSIGNALED(rv) ? WTERMSIG(rv) : 0,
+			    WIFEXITED(rv) ? 1 : 0, WIFEXITED(rv) ? WEXITSTATUS(rv) : -1,
+			    p->p_crash_behavior);
+			if (sb_reason != OS_REASON_NULL) {
+				printf("THOR EXIT: reason ns=%u code=%#llx flags=%#llx\n",
+				    sb_reason->osr_namespace, sb_reason->osr_code,
+				    sb_reason->osr_flags);
+			}
+		}
+	}
 
