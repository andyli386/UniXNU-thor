+/*
+ * THOR: boot-arg gate for the device-vnode hash trace (thor_spec_trace=1).
+ * speclisth[11] was seen holding 0x271 during the Data mount; these lines name
+ * every insert and removal together with the CPU so the first bad write can be
+ * attributed. cpu_number() is declared here to avoid a header dependency.
+ */
+extern int cpu_number(void);
+
+static bool
+thor_spec_trace(void)
+{
+	static int state = -1;
+
+	if (state < 0) {
+		int value = 0;
+		if (!PE_parse_boot_argn("thor_spec_trace", &value, sizeof(value))) {
+			value = 0;
+		}
+		state = value != 0;
+	}
+	return state != 0;
+}
