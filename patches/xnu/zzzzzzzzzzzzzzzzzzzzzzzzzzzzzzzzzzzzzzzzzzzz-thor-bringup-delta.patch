+		} else {
+			printf("THOR WATCHDOG: no exit reason recorded\n");
+		}
+		if (guarded) {
+			return false;
+		}
+	}
+
 	if (p == initproc || (p->p_crash_behavior & POSIX_SPAWN_PANIC_ON_EXIT) != 0) {
 		/* Always panic for launchd or equivalents */
+		if (p == initproc) {
+			printf("THOR EXIT2: initproc panic path, rv=%d\n", rv);
+		}
