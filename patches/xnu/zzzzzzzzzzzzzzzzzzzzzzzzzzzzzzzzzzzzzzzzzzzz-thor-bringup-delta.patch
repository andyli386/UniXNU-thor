diff --color -ruN -x *.orig -x *.rej base/iokit/Kernel/MiniAppleKeyStore.cpp b/iokit/Kernel/MiniAppleKeyStore.cpp
--- a/iokit/Kernel/MiniAppleKeyStore.cpp	1970-01-01 08:00:00
+++ b/iokit/Kernel/MiniAppleKeyStore.cpp	2026-11-08 07:16:59
@@ -0,0 +1,281 @@
+/*
+ * Pong development AppleKeyStore compatibility service, adapted from the
+ * supplied HackiOS MiniAppleKeyStore (MIT).
+ *
+ * This is explicitly a volatile software keybag with no passcode and no
+ * hardware-backed secrets. It implements HackiOS's complete development
+ * keybag protocol, including reversible software wrapping, so MobileKeyBag
+ * and keychain clients can run without a SEP. Wrapping is not encryption.
+ */
+#include <pexpert/arm64/board_config.h>
+#if (DEVELOPMENT || DEBUG) && !SECURE_KERNEL
+#include <IOKit/IOLib.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <sys/proc.h>
+#include <sys/systm.h>
+
+#include "MiniDrivers.h"
+
+enum {
+	kAKSOpenCheck           = 0x00,
+	kAKSGetLockState        = 0x07,
+	kAKSLockDevice          = 0x08,
+	kAKSUnlockDevice        = 0x09,
+	kAKSWrapKey             = 0x0a,
+	kAKSUnwrapKey           = 0x0b,
+	kAKSUnlockBag           = 0x0c,
+	kAKSGetSystem           = 0x0e,
+	kAKSGetDeviceState      = 0x11,
+	kAKSGetBagUUID          = 0x17,
+	kAKSAssertHold          = 0x1a,
+	kAKSAssertDrop          = 0x1b,
+	kAKSGetConfiguration    = 0x1f,
+	kAKSLockDeviceNow       = 0x20,
+	kAKSGetExtendedState    = 0x23,
+	kAKSGeneration          = 0x28,
+	kAKSAssertPromote       = 0x64,
+	kAKSAssertConsume       = 0x65,
+	kAKSNotifyStateSet      = 0x66,
+	kAKSNotifyStateIsSet    = 0x67,
+	kAKSPrewarm             = 0x73,
+};
+
+#define kAKSStateFlags        0x6 /* no passcode, unlocked since boot */
+#define kAKSLockStateDisabled 3
+
+static uint64_t gAKSLogged[4];
+static bool gAKSNotifyState;
+
+static size_t
+derPut(uint8_t *buf, size_t length, const char *key, uint8_t value)
+{
+	size_t keyLength = strlen(key);
+	buf[length++] = 0x30;
+	buf[length++] = (uint8_t)(keyLength + 5);
+	buf[length++] = 0x0c;
+	buf[length++] = (uint8_t)keyLength;
+	memcpy(buf + length, key, keyLength);
+	length += keyLength;
+	buf[length++] = 0x02;
+	buf[length++] = 0x01;
+	buf[length++] = value;
+	return length;
+}
+
+static size_t
+deviceState(uint8_t *buf)
+{
+	size_t length = 2;
+	length = derPut(buf, length, "sb", 0);
+	length = derPut(buf, length, "sr", 0);
+	length = derPut(buf, length, "ss", kAKSStateFlags);
+	length = derPut(buf, length, "sas", 0);
+	length = derPut(buf, length, "sfa", 0);
+	length = derPut(buf, length, "sgs", 0);
+	length = derPut(buf, length, "sls", kAKSLockStateDisabled);
+	length = derPut(buf, length, "sgpe", 0);
+	length = derPut(buf, length, "srcd", 0);
+	buf[0] = 0x31;
+	buf[1] = (uint8_t)(length - 2);
+	return length;
+}
+
+static size_t
+configuration(uint8_t *buf)
+{
+	size_t length = 2;
+	length = derPut(buf, length, "bd", 0);
+	length = derPut(buf, length, "gp", 0);
+	length = derPut(buf, length, "mua", 10);
+	buf[0] = 0x31;
+	buf[1] = (uint8_t)(length - 2);
+	return length;
+}
+
+class AppleKeyStore : public IOService
+{
+	OSDeclareDefaultStructors(AppleKeyStore);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleKeyStore, IOService);
+
+bool
+AppleKeyStore::start(IOService *provider)
+{
+	if (!IOService::start(provider)) return false;
+	setProperty(kIOUserClientClassKey, "AppleKeyStoreUserClient");
+	setProperty("PongVolatileSoftwareKeybag", kOSBooleanTrue);
+	setName("AppleKeyStore");
+	registerService();
+	IOLog("MiniAppleKeyStore: no-passcode software keybag published; software wrap/unwrap enabled\n");
+	return true;
+}
+
+class AppleKeyStoreUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(AppleKeyStoreUserClient);
+	static IOReturn answer(IOExternalMethodArguments *, const uint8_t *, size_t);
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn registerNotificationPort(mach_port_t, UInt32, io_user_reference_t) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t, IOExternalMethodArguments *,
+	    IOExternalMethodDispatch *, OSObject *, void *) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleKeyStoreUserClient, IOUserClient);
+
+IOReturn
+AppleKeyStoreUserClient::clientClose(void)
+{
+	if (!isInactive()) terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleKeyStoreUserClient::registerNotificationPort(mach_port_t port,
+    __unused UInt32 type, __unused io_user_reference_t refCon)
+{
+	/* No hardware-backed keys/bags are ever queued for backup. */
+	releaseNotificationPort(port);
+	return kIOReturnSuccess;
+}
+
+/* Match the upstream development format; the fixed pattern is not a secret. */
+static const uint8_t kWrapMark[4] = { 'H', 'K', 'w', 'r' };
+
+static void
+wrapMix(uint8_t *bytes, size_t length)
+{
+	for (size_t i = 0; i < length; i++) {
+		bytes[i] ^= (uint8_t)(0x5a + 37 * i);
+	}
+}
+
+IOReturn
+AppleKeyStoreUserClient::answer(IOExternalMethodArguments *args,
+    const uint8_t *bytes, size_t length)
+{
+	if (args->structureOutputDescriptor) {
+		IOMemoryDescriptor *out = args->structureOutputDescriptor;
+		if (out->getLength() < length) return kIOReturnNoSpace;
+		IOReturn ret = out->prepare();
+		if (ret == kIOReturnSuccess) {
+			out->writeBytes(0, bytes, length);
+			out->complete();
+			args->structureOutputDescriptorSize = (uint32_t)length;
+		}
+		return ret;
+	}
+	if (!args->structureOutput || args->structureOutputSize < length)
+		return kIOReturnNoSpace;
+	memcpy(args->structureOutput, bytes, length);
+	args->structureOutputSize = (uint32_t)length;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleKeyStoreUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *args, __unused IOExternalMethodDispatch *dispatch,
+    __unused OSObject *target, __unused void *reference)
+{
+	static const uint8_t bagUUID[16] = {
+		'P','o','n','g','V','o','l','a','t','i','l','e',0,0,0,1
+	};
+	uint8_t der[128];
+	uint64_t *out = args->scalarOutput;
+	switch (selector) {
+	case kAKSOpenCheck:
+	case kAKSLockDevice:
+	case kAKSLockDeviceNow:
+	case kAKSUnlockDevice:
+	case kAKSUnlockBag:
+	case kAKSAssertHold:
+	case kAKSAssertDrop:
+	case kAKSAssertPromote:
+	case kAKSAssertConsume:
+	case kAKSPrewarm:
+		return kIOReturnSuccess;
+	case kAKSGetLockState:
+		if (args->scalarOutputCount < 1) return kIOReturnBadArgument;
+		out[0] = kAKSStateFlags;
+		args->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+	case kAKSGetSystem:
+	case kAKSGeneration:
+		if (args->scalarOutputCount >= 1) {
+			out[0] = 0;
+			args->scalarOutputCount = 1;
+		}
+		return kIOReturnSuccess;
+	case kAKSGetDeviceState:
+	case kAKSGetExtendedState:
+		return answer(args, der, deviceState(der));
+	case kAKSGetConfiguration:
+		return answer(args, der, configuration(der));
+	case kAKSGetBagUUID:
+		return answer(args, bagUUID, sizeof(bagUUID));
+	case kAKSNotifyStateSet:
+		gAKSNotifyState = true;
+		return kIOReturnSuccess;
+	case kAKSNotifyStateIsSet:
+		if (args->scalarOutputCount < 1) return kIOReturnBadArgument;
+		out[0] = gAKSNotifyState;
+		args->scalarOutputCount = 1;
+		return kIOReturnSuccess;
+	case kAKSWrapKey: {
+		uint8_t wrapped[8 + 64];
+		size_t length = args->structureInputSize;
+		if (!args->structureInput || length == 0 || length > 64 || args->scalarInputCount < 2)
+			return kIOReturnBadArgument;
+		memcpy(wrapped, kWrapMark, sizeof(kWrapMark));
+		wrapped[4] = (uint8_t)args->scalarInput[1];
+		wrapped[5] = wrapped[6] = wrapped[7] = 0;
+		memcpy(wrapped + 8, args->structureInput, length);
+		wrapMix(wrapped + 8, length);
+		if (args->scalarOutputCount >= 1) {
+			out[0] = args->scalarInput[1];
+			args->scalarOutputCount = 1;
+		}
+		return answer(args, wrapped, 8 + length);
+	}
+	case kAKSUnwrapKey: {
+		uint8_t key[64];
+		const uint8_t *wrapped = (const uint8_t *)args->structureInput;
+		size_t length = args->structureInputSize;
+		if (!wrapped || length <= 8 || length > 8 + sizeof(key) ||
+		    memcmp(wrapped, kWrapMark, sizeof(kWrapMark)) != 0)
+			return kIOReturnBadArgument;
+		memcpy(key, wrapped + 8, length - 8);
+		wrapMix(key, length - 8);
+		return answer(args, key, length - 8);
+	}
+	default:
+		break;
+	}
+	if (selector < 256 && !(gAKSLogged[selector / 64] & (1ULL << (selector % 64)))) {
+		char procname[32] = "?";
+		gAKSLogged[selector / 64] |= 1ULL << (selector % 64);
+		proc_selfname(procname, sizeof(procname));
+		IOLog("MiniAppleKeyStore: %s[%d] selector 0x%x unsupported\n",
+		    procname, proc_selfpid(), selector);
+	}
+	return kIOReturnUnsupported;
+}
+
+void
+MiniAppleKeyStoreStart(void)
+{
+	IOService *resources = IOService::getResourceService();
+	AppleKeyStore *store = OSTypeAlloc(AppleKeyStore);
+	if (!resources || !store || !store->init() || !store->attach(resources)) {
+		OSSafeReleaseNULL(store);
+		IOLog("MiniAppleKeyStore: software service creation failed\n");
+		return;
+	}
+	if (!store->start(resources)) store->detach(resources);
+	store->release();
+}
+#endif
