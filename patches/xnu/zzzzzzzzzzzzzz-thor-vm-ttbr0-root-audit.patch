+
+/* This proof is intentionally BEFORE set_mmu_ttb(invalid_ttep).
+ * It consumes NO MMU register write, TLB invalidation, physical aliases
+ * or Boot Services, and only reads one explicitly owned 4 KiB page.
+ * The existing low framebuffer marker remains usable through old TTBR0. */
+static void __attribute__((noinline, noreturn))
+thor_vm_ttbr0_ready_gate(boot_args *args)
+{
+    uint64_t ttbr0, ttbr1, vbar, sp, invalid_va, root_va;
+    __asm__ volatile("mrs %0, ttbr0_el1" : "=r"(ttbr0));
+    __asm__ volatile("mrs %0, ttbr1_el1" : "=r"(ttbr1));
+    __asm__ volatile("mrs %0, vbar_el1" : "=r"(vbar));
+    __asm__ volatile("mov %0, sp" : "=r"(sp));
+
+    /* Validate the ownership contract BEFORE calling phystokv().
+     * The old saved TTBR0 is retained until a separately audited stage. */
+    if (args != thor_entry09_vm_args ||
+        gThorEntry09VmReport.status != 1 || kva_active ||
+        invalid_ttep != first_avail_phys ||
+        cpu_ttep != invalid_ttep + ARM_PGBYTES ||
+        gThorEntry09VmReport.invalid_root != invalid_ttep ||
+        gThorEntry09VmReport.future_root != cpu_ttep ||
+        gPhysSize < 2 * ARM_PGBYTES ||
+        invalid_ttep < gPhysBase ||
+        invalid_ttep - gPhysBase > gPhysSize - 2 * ARM_PGBYTES ||
+        (invalid_ttep & (ARM_PGBYTES - 1)) != 0 ||
+        (cpu_ttep & (ARM_PGBYTES - 1)) != 0 ||
+        ttbr0 != gThorEntry10OldTTBR0 ||
+        ttbr1 != (cpu_ttep & TTBR_BADDR_MASK) ||
+        vbar != (uint64_t)(uintptr_t)&LowExceptionVectorBase ||
+        (vbar >> 48) != 0xffffULL ||
+        (sp >> 48) != 0xffffULL) {
+        thor_entry09_fail();
+    }
+
+    invalid_va = phystokv(invalid_ttep);
+    root_va = phystokv(cpu_ttep);
+    if ((invalid_va >> 48) != 0xffffULL ||
+        root_va != invalid_va + ARM_PGBYTES ||
+        invalid_va != gThorEntry09VmReport.aperture ||
+        !thor_vm_s1e1r_ok(invalid_va) ||
+        !thor_vm_s1e1r_ok(invalid_va + ARM_PGBYTES - sizeof(uint64_t)) ||
+        !thor_vm_s1e1r_ok(root_va) ||
+        !thor_vm_s1e1r_ok(sp) ||
+        !thor_vm_s1e1r_ok(vbar)) {
+        thor_entry09_fail();
+    }
+
+    /* A zeroed first-level root must not translate ANY old low address.
+     * Nonzero entries would mean TTBR0 retirement is unsafe.
+     * Read each word via validated, mapped high kernel VA, not a PA alias. */
+    volatile const uint64_t *invalid_root =
+        (volatile const uint64_t *)(uintptr_t)invalid_va;
+    for (uint32_t i = 0; i < ARM_PGBYTES / sizeof(uint64_t); ++i) {
+        if (invalid_root[i] != 0) {
+            thor_entry09_fail();
+        }
+    }
+
+    /* Only now report the bounded root-readiness milestone.
+     * It is NOT evidence that TTBR0 has actually been retired. */
     thor_entry09_mark(7, 0x00ffffffU);
     thor_entry09_stop();
 }
