+}
+
+static uint32_t
+thor_entry09_read_le32(const void *value)
+{
+	const uint8_t *p = (const uint8_t *)value;
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	       ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static uint64_t
+thor_entry09_counter_frequency(void)
+{
+#if defined(THOR_ENTRY09_HOST_TEST)
+	extern uint64_t thor_entry09_host_counter_hz(void);
+	return thor_entry09_host_counter_hz();
+#elif defined(__arm64__) || defined(__aarch64__)
+	uint64_t value;
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (value));
+	return value;
+#else
+#error ENTRY09 kernel clock shim requires AArch64
+#endif
+}
+
+/*
+ * This branch deliberately has no Apple SoC/MMIO prerequisite or default
+ * CPU/bus frequency. Only the generic counter has evidence. The caller must
+ * check this report after PE(FALSE). ENTRY09 executes real VM preparation
+ * and stops after arm_vm_physmap_init, before installing the new TTBR1.
+ * An error returns with all global clock fields zero, never using panic/serial.
+ */
+static void
+thor_entry09_identify_counter(boot_args *bootArgs)
+{
+	DTEntry root, chosen, cpus, cpu, other;
+	OpaqueDTEntryIterator iter;
+	const void *value = NULL;
+	unsigned int size = 0;
+	uint32_t timebase;
+	uint64_t counter;
+	static const uint8_t diagnostic_version[4] = { 1, 0, 0, 0 };
+	static const char *const unavailable[] = {
+		"bus-frequency", "clock-frequency", "memory-frequency",
+		"peripheral-frequency", "fixed-frequency"
+	};
+	unsigned int i;
+
+	bzero(&gPEClockFrequencyInfo, sizeof(gPEClockFrequencyInfo));
+	if (gThorEntry09ClockReport.status != THOR_ENTRY09_CLOCK_UNSET) {
+		gThorEntry09ClockReport.valid_mask = 0;
+		gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_REENTERED;
+		return;
+	}
+	gThorEntry09ClockReport.version = THOR_ENTRY09_CLOCK_VERSION;
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_BOOTARGS;
+	if (bootArgs == NULL || bootArgs->deviceTreeP == NULL ||
+	    bootArgs->deviceTreeLength < 8 || bootArgs->deviceTreeLength > 16384) {
+		return;
+	}
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_ROOT;
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    !thor_entry09_property_matches(root, "name", "device-tree", sizeof("device-tree")) ||
+	    !thor_entry09_property_matches(root, "compatible", "xnu,thor-entry09", sizeof("xnu,thor-entry09")) ||
+	    !thor_entry09_property_matches(root, "model", "Xiaomi thor ENTRY09 diagnostic", sizeof("Xiaomi thor ENTRY09 diagnostic")) ||
+	    !thor_entry09_property_matches(root, "target-type", "thor", sizeof("thor"))) {
+		return;
+	}
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_CHOSEN;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    !thor_entry09_property_matches(chosen, "entry09-diagnostic", diagnostic_version, sizeof(diagnostic_version)) ||
+	    !thor_entry09_property_absent(chosen, "dram-base") ||
+	    !thor_entry09_property_absent(chosen, "dram-size") ||
+	    !thor_entry09_seed_present(chosen) ||
+	    SecureDTLookupEntry(NULL, "/arm-io", &other) == kSuccess) {
+		return;
+	}
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_CPUS;
+	if (SecureDTLookupEntry(NULL, "/cpus", &cpus) != kSuccess ||
+	    SecureDTInitEntryIterator(cpus, &iter) != kSuccess ||
+	    SecureDTIterateEntries(&iter, &cpu) != kSuccess) {
+		return;
+	}
+	gThorEntry09ClockReport.cpu_count = 1;
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_TOPOLOGY;
+	if (SecureDTIterateEntries(&iter, &other) == kSuccess) {
+		gThorEntry09ClockReport.cpu_count = 2;
+		return;
+	}
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_CPU_STATE;
+	if (!thor_entry09_property_matches(cpu, "name", "cpu0", sizeof("cpu0")) ||
+	    !thor_entry09_property_matches(cpu, "state", "running", sizeof("running")) ||
+	    !thor_entry09_property_matches(cpu, "device_type", "cpu", sizeof("cpu"))) {
+		return;
+	}
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_UNSUPPORTED_FREQUENCY;
+	for (i = 0; i < sizeof(unavailable) / sizeof(unavailable[0]); i++) {
+		if (!thor_entry09_property_absent(cpu, unavailable[i])) {
+			return;
+		}
+	}
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_TIMEBASE;
+	if (SecureDTGetProperty(cpu, "timebase-frequency", &value, &size) != kSuccess || size != 4) {
+		return;
+	}
+	timebase = thor_entry09_read_le32(value);
+	gThorEntry09ClockReport.dt_timebase_hz = timebase;
+	if (timebase != THOR_ENTRY09_COUNTER_HZ) {
+		return;
+	}
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_COUNTER;
+	counter = thor_entry09_counter_frequency();
+	gThorEntry09ClockReport.counter_hz = counter;
+	if (counter != timebase) {
+		return;
+	}
+
+	/* Unknown physical rates and all legacy ratios remain explicitly zero. */
+	gPEClockFrequencyInfo.timebase_frequency_hz = timebase;
+	gPEClockFrequencyInfo.dec_clock_rate_hz = timebase;
+	gThorEntry09ClockReport.valid_mask = THOR_ENTRY09_CLOCK_VALID_TIMEBASE | THOR_ENTRY09_CLOCK_VALID_DEC;
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_OK;
+}
+#endif
