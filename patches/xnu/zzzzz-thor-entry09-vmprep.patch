--- /dev/null
+++ b/osfmk/arm/thor_entry09_early.inc.c
@@ -0,0 +1,376 @@
+/* Included only in the actual arm_init.c under XNU_THOR_EARLY_C=1.
+ * The real VM preparation runs in arm_vm_init; diagnostic code only observes it.
+ */
+#include "../../pexpert/arm/thor_entry09_clock.h"
+
+extern void thor_entry09_mark(uint64_t band, uint32_t rgb);
+extern uint32_t thor_entry09_c_state(const boot_args *args);
+extern void thor_entry09_fail(void) __attribute__((noreturn));
+extern void thor_entry09_stop(void) __attribute__((noreturn));
+extern void thor_entry09_reset(void) __attribute__((noreturn));
+
+static void
+thor_entry09_c_enter(const boot_args *args)
+{
+    if (thor_entry09_c_state(args) != 1) {
+        thor_entry09_reset();
+    }
+    /* A fixed, unslid MH_EXECUTE with no threaded starts takes the real
+     * normal rebase function's minimal branch. Other formats are refused. */
+    if ((uintptr_t)&_mh_execute_header != (uintptr_t)VM_KERNEL_LINK_ADDRESS ||
+        _mh_execute_header.magic != MH_MAGIC_64 ||
+        _mh_execute_header.filetype != MH_EXECUTE ||
+        (_mh_execute_header.flags & MH_DYLIB_IN_CACHE) != 0 ||
+        &__thread_starts_sect_start[0] != &__thread_starts_sect_end[0]) {
+        thor_entry09_fail();
+    }
+    thor_entry09_mark(2, 0x00ffff00U);
+}
+
+static void
+thor_entry09_c_pe_check(boot_args *args)
+{
+    DTEntry chosen = NULL;
+    void const *property = NULL;
+    unsigned int size = 0;
+    const unsigned char *bytes;
+    uint64_t unknown_frequencies;
+
+    if (thor_entry09_c_state(args) != 1) {
+        thor_entry09_reset();
+    }
+    if (BootArgs != args || args != &const_boot_args || vm_kernel_slide != 0 ||
+        static_kernelcache || PE_state.initialized != TRUE ||
+        PE_state.bootArgs != args || PE_state.deviceTreeHead != args->deviceTreeP ||
+        PE_state.deviceTreeSize != 800 || args->deviceTreeLength != 800 ||
+        PE_state.video.v_baseAddr != 0xb8000000ULL ||
+        PE_state.video.v_rowBytes != 5760 || PE_state.video.v_width != 1440 ||
+        PE_state.video.v_height != 3200 || PE_state.video.v_depth != 32 ||
+        PE_state.video.v_display != 1) {
+        thor_entry09_fail();
+    }
+    if (gThorEntry09ClockReport.version != 1 ||
+        gThorEntry09ClockReport.status != 1 ||
+        gThorEntry09ClockReport.valid_mask != 3 ||
+        gThorEntry09ClockReport.cpu_count != 1 ||
+        gThorEntry09ClockReport.counter_hz != 19200000 ||
+        gThorEntry09ClockReport.dt_timebase_hz != 19200000 ||
+        gThorEntry09ClockReport.reserved != 0) {
+        thor_entry09_fail();
+    }
+    unknown_frequencies = gPEClockFrequencyInfo.bus_clock_rate_hz |
+        gPEClockFrequencyInfo.cpu_clock_rate_hz |
+        gPEClockFrequencyInfo.bus_clock_rate_num |
+        gPEClockFrequencyInfo.bus_clock_rate_den |
+        gPEClockFrequencyInfo.bus_to_cpu_rate_num |
+        gPEClockFrequencyInfo.bus_to_cpu_rate_den |
+        gPEClockFrequencyInfo.bus_to_dec_rate_num |
+        gPEClockFrequencyInfo.bus_to_dec_rate_den |
+        gPEClockFrequencyInfo.timebase_frequency_num |
+        gPEClockFrequencyInfo.timebase_frequency_den |
+        gPEClockFrequencyInfo.bus_frequency_hz |
+        gPEClockFrequencyInfo.bus_frequency_min_hz |
+        gPEClockFrequencyInfo.bus_frequency_max_hz |
+        gPEClockFrequencyInfo.cpu_frequency_hz |
+        gPEClockFrequencyInfo.cpu_frequency_min_hz |
+        gPEClockFrequencyInfo.cpu_frequency_max_hz |
+        gPEClockFrequencyInfo.prf_frequency_hz |
+        gPEClockFrequencyInfo.prf_frequency_min_hz |
+        gPEClockFrequencyInfo.prf_frequency_max_hz |
+        gPEClockFrequencyInfo.mem_frequency_hz |
+        gPEClockFrequencyInfo.mem_frequency_min_hz |
+        gPEClockFrequencyInfo.mem_frequency_max_hz |
+        gPEClockFrequencyInfo.fix_frequency_hz;
+    if (unknown_frequencies != 0 ||
+        gPEClockFrequencyInfo.dec_clock_rate_hz != 19200000 ||
+        gPEClockFrequencyInfo.timebase_frequency_hz != 19200000) {
+        thor_entry09_fail();
+    }
+    if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+        SecureDTGetProperty(chosen, "entry09-diagnostic", &property, &size) != kSuccess ||
+        size != 4 || property == NULL) {
+        thor_entry09_fail();
+    }
+    bytes = (const unsigned char *)property;
+    if (bytes[0] != 1 || bytes[1] != 0 || bytes[2] != 0 || bytes[3] != 0) {
+        thor_entry09_fail();
+    }
+    /* Return only after the real initial PE result is checked. */
+}
+
+/* ENTRY09 permits only the one actually executing CPU.  Never infer reg=0. */
+static uint64_t thor_entry09_boot_mpidr;
+
+static uint64_t
+thor_entry09_mpidr(void)
+{
+    uint64_t value;
+    __asm__ volatile ("mrs %0, mpidr_el1" : "=r" (value));
+    return value;
+}
+
+static void
+thor_entry09_before_topology(void)
+{
+    DTEntry cpus = NULL, cpu = NULL, other = NULL;
+    OpaqueDTEntryIterator iter;
+    const void *property = NULL;
+    unsigned int size = 0;
+    uint64_t reg = 0, raw = thor_entry09_mpidr();
+    const uint8_t *bytes;
+    unsigned int i;
+
+    if ((raw & 0xff00ff0000ULL) != 0 ||
+        SecureDTLookupEntry(NULL, "/cpus", &cpus) != kSuccess ||
+        SecureDTInitEntryIterator(cpus, &iter) != kSuccess ||
+        SecureDTIterateEntries(&iter, &cpu) != kSuccess ||
+        SecureDTIterateEntries(&iter, &other) == kSuccess ||
+        SecureDTGetProperty(cpu, "reg", &property, &size) != kSuccess ||
+        property == NULL || size != 8) {
+        thor_entry09_fail();
+    }
+    bytes = (const uint8_t *)property;
+    for (i = 0; i != 8; ++i) {
+        reg |= (uint64_t)bytes[i] << (8 * i);
+    }
+    if (reg != (raw & 0xffffULL)) {
+        thor_entry09_fail();
+    }
+    /* Clock/PE validation already required the sole cpu0 state="running".
+     * Recheck immediately before the real topology consumer as well. */
+    if (SecureDTGetProperty(cpu, "state", &property, &size) != kSuccess ||
+        property == NULL || size != sizeof("running") ||
+        memcmp(property, "running", sizeof("running")) != 0) {
+        thor_entry09_fail();
+    }
+    thor_entry09_boot_mpidr = raw;
+}
+
+static int
+thor_entry09_owned_object(const boot_args *args, const void *object, uint64_t bytes)
+{
+    uint64_t base = args->virtBase, address = (uintptr_t)object;
+    uint64_t used = args->topOfKernelData - args->physBase;
+    return address >= base && address - base <= used &&
+        bytes <= used - (address - base);
+}
+
+static void
+thor_entry09_topology_check(boot_args *args)
+{
+    const ml_topology_info_t *info = ml_get_topology_info();
+    const ml_topology_cpu_t *cpu;
+    const ml_topology_cluster_t *cluster;
+    uint64_t tpidr, tpidrro;
+    __asm__ volatile ("mrs %0, tpidr_el0" : "=r" (tpidr));
+    __asm__ volatile ("mrs %0, tpidrro_el0" : "=r" (tpidrro));
+
+    if (thor_entry09_mpidr() != thor_entry09_boot_mpidr ||
+        !thor_entry09_owned_object(args, info, sizeof(*info)) ||
+        info->version != CPU_TOPOLOGY_VERSION || info->num_cpus != 1 ||
+        info->max_cpu_id != 0 || info->num_clusters != 1 ||
+        info->max_cluster_id != 0 || info->max_die_id != 0 ||
+        !thor_entry09_owned_object(args, info->cpus, sizeof(*info->cpus)) ||
+        !thor_entry09_owned_object(args, info->clusters, sizeof(*info->clusters)) ||
+        info->boot_cpu != info->cpus || info->boot_cluster != info->clusters ||
+        info->cluster_types != (1U << CLUSTER_TYPE_SMP) ||
+        info->cluster_type_num_cpus[CLUSTER_TYPE_SMP] != 1 ||
+        info->cluster_type_num_clusters[CLUSTER_TYPE_SMP] != 1 ||
+        ml_get_boot_cpu_number() != 0 || ml_get_max_cpu_number() != 0 ||
+        tpidr != 0 || tpidrro != 0 || PAGE_SHIFT_CONST != 12 ||
+        page_shift_user32 != 12) {
+        thor_entry09_fail();
+    }
+    cpu = info->boot_cpu;
+    cluster = info->boot_cluster;
+    if (cpu->cpu_id != 0 || cpu->cluster_id != 0 || cpu->die_id != 0 ||
+        cpu->phys_id != (uint32_t)(thor_entry09_boot_mpidr & 0xffffULL) ||
+        cpu->cluster_type != CLUSTER_TYPE_SMP ||
+        (cpu->l2_access_penalty | cpu->l2_cache_size | cpu->l2_cache_id |
+         cpu->l3_cache_size | cpu->l3_cache_id) != 0 ||
+        (cpu->cpu_IMPL_regs | cpu->cpu_IMPL_pa | cpu->cpu_IMPL_len |
+         cpu->cpu_UTTDBG_regs | cpu->cpu_UTTDBG_pa | cpu->cpu_UTTDBG_len |
+         cpu->coresight_regs | cpu->coresight_pa | cpu->coresight_len) != 0 ||
+        cluster->cluster_id != 0 || cluster->cluster_type != CLUSTER_TYPE_SMP ||
+        cluster->num_cpus != 1 || cluster->first_cpu_id != 0 ||
+        cluster->cpu_mask != 1 ||
+        (cluster->acc_IMPL_regs | cluster->acc_IMPL_pa | cluster->acc_IMPL_len |
+         cluster->cpm_IMPL_regs | cluster->cpm_IMPL_pa | cluster->cpm_IMPL_len) != 0) {
+        thor_entry09_fail();
+    }
+}
+
+extern volatile uint64_t gThorEntry09CntkctlBefore;
+extern volatile uint64_t gThorEntry09CntkctlAfter;
+extern volatile uint32_t gThorEntry09CntkctlStatus;
+
+static void
+thor_entry09_thread_check(boot_args *args, thread_t thread)
+{
+    uint64_t tpidr, tpidrro, current, context, cntkctl;
+    __asm__ volatile ("mrs %0, tpidr_el0" : "=r" (tpidr));
+    __asm__ volatile ("mrs %0, tpidrro_el0" : "=r" (tpidrro));
+    __asm__ volatile ("mrs %0, tpidr_el1" : "=r" (current));
+    __asm__ volatile ("mrs %0, contextidr_el1" : "=r" (context));
+    __asm__ volatile ("mrs %0, cntkctl_el1" : "=r" (cntkctl));
+    if (thor_entry09_c_state(args) != 1) {
+        thor_entry09_reset();
+    }
+    if (!thor_entry09_owned_object(args, thread, sizeof(*thread)) ||
+        master_cpu != 0 || BootCpuData.cpu_number != 0 ||
+        BootCpuData.intstack_top != (vm_offset_t)&intstack_top ||
+        BootCpuData.istackptr != &intstack_top ||
+        BootCpuData.excepstack_top != (vm_offset_t)&excepstack_top ||
+        CpuDataEntries[0].cpu_data_vaddr != &BootCpuData ||
+        CpuDataEntries[0].cpu_data_paddr != (void *)(args->physBase +
+            (uintptr_t)&BootCpuData - args->virtBase) ||
+        BootCpuData.cpu_active_thread != thread ||
+        BootCpuData.cpu_tpidr_el0 != 0 || BootCpuData.rtclock_datap != &RTClockData ||
+        thread->machine.CpuDatap != &BootCpuData ||
+        thread->machine.pcpu_data_base != 0 || thread->machine.preemption_count != 0 ||
+        thread->machine.cthread_self != 0 || thread->thread_id != 0 ||
+        thread->ctid != ((1U << 20) - 1) || thread->sched_pri != MAXPRI_KERNEL ||
+        current != (uintptr_t)thread || tpidr != 0 || tpidrro != 0 || context != 0 ||
+        gThorEntry09CntkctlStatus != 1 || cntkctl != gThorEntry09CntkctlAfter ||
+        (cntkctl & 0x200ffULL) != 0x4fULL ||
+        ((cntkctl ^ gThorEntry09CntkctlBefore) & ~0x200ffULL) != 0) {
+        thor_entry09_fail();
+    }
+}
+
+static void
+thor_entry09_rtclock_check(boot_args *args, thread_t thread)
+{
+    thor_entry09_c_pe_check(args);
+    thor_entry09_topology_check(args);
+    thor_entry09_thread_check(args, thread);
+    if (rtclock_timebase_const.numer != 625 || rtclock_timebase_const.denom != 12 ||
+        rtclock_sec_divisor != 19200000 || rtclock_usec_divisor != 19 ||
+        RTClockData.rtc_base.abstime != 0 || RTClockData.rtc_adj.abstime != 0 ||
+        RTClockData.rtc_timebase_addr != 0 || RTClockData.rtc_timebase_val != 0) {
+        thor_entry09_fail();
+    }
+    /* The original ENTRY08 result is preserved as a returning check. */
+}
+
+/* ENTRY09 preserves the ENTRY08 contract and checks the new native consumers. */
+#include <arm/cpuid.h>
+#include <arm/cpuid_internal.h>
+#include "thor_entry09_adt.h"
+
+static thread_t thor_entry09_boot_thread;
+static uint32_t thor_entry09_cpu_prechecked;
+extern uint32_t thor_entry09_timer_ready(void);
+extern vm_offset_t segLOWESTTEXT;
+void thor_entry09_adt_check(const boot_args *args, int consumed);
+void thor_entry09_post_cpu_check(boot_args *args);
+
+void
+thor_entry09_adt_check(const boot_args *args, int consumed)
+{
+    const uint8_t *adt = (const uint8_t *)args->deviceTreeP;
+    uint64_t reg = 0;
+    uint64_t raw = thor_entry09_mpidr();
+    unsigned seed_or = 0;
+    if (args->deviceTreeLength != sizeof(thor_entry09_canonical_adt) ||
+        !thor_entry09_owned_object(args, adt, sizeof(thor_entry09_canonical_adt)) ||
+        (raw & 0xff00ff0000ULL) != 0) {
+        thor_entry09_fail();
+    }
+    for (unsigned i = 0; i < sizeof(thor_entry09_canonical_adt); ++i) {
+        if (i >= 352 && i < 416) {
+            seed_or |= adt[i];
+        } else if (i >= 656 && i < 664) {
+            reg |= (uint64_t)adt[i] << ((i - 656) * 8);
+        } else if (adt[i] != thor_entry09_canonical_adt[i]) {
+            thor_entry09_fail();
+        }
+    }
+    if (reg != (raw & 0xffffULL) || (consumed ? seed_or != 0 : seed_or == 0)) {
+        thor_entry09_fail();
+    }
+}
+
+static void
+thor_entry09_rtclock_done(boot_args *args, thread_t thread)
+{
+    /* The old finish checks now return, after the same real rtclock call. */
+    thor_entry09_rtclock_check(args, thread);
+    thor_entry09_adt_check(args, 0);
+    thor_entry09_boot_thread = thread;
+    thor_entry09_mark(3, 0x000000ffU);
+}
+
+static void
+thor_entry09_before_cpu(boot_args *args)
+{
+    uint64_t raw = thor_entry09_mpidr();
+    if (thor_entry09_c_state(args) != 1) {
+        thor_entry09_reset();
+    }
+    if (thor_entry09_cpu_prechecked != 0 || raw != thor_entry09_boot_mpidr ||
+        (raw & 0xff00ff0000ULL) != 0 || ml_get_cpu_number_local() != 0 ||
+        ml_get_topology_info()->boot_cpu->phys_id != (uint32_t)(raw & 0xffffULL) ||
+        BootCpuData.cpu_type != 0 || cache_info() != NULL ||
+        processor_count != 0 || startup_phase != STARTUP_SUB_LOCKS ||
+        thor_entry09_timer_ready() != 1 || segLOWESTTEXT != 0 ||
+        !disable_serial_output || !disable_kprintf_output) {
+        thor_entry09_fail();
+    }
+    thor_entry09_cpu_prechecked = 1;
+}
+
+void
+thor_entry09_post_cpu_check(boot_args *args)
+{
+    uint64_t selector;
+    uint32_t clidr = machine_read_clidr();
+    uint32_t l1 = clidr & 7, l2 = (clidr >> 3) & 7, l3 = (clidr >> 6) & 7;
+    uint32_t expected_selector = l1 == 3 ? 1 : (l3 == 4 ? 4 : (l2 == 4 || l2 == 2 ? 2 : 0));
+    cache_info_t *cache = cache_info();
+    arm_cpu_info_t *cpuinfo = cpuid_info();
+    __asm__ volatile ("mrs %0, csselr_el1" : "=r" (selector));
+    thor_entry09_rtclock_check(args, thor_entry09_boot_thread);
+    if (thor_entry09_cpu_prechecked != 1 || startup_phase != STARTUP_SUB_LOCKS ||
+        thor_entry09_timer_ready() != 1 || ml_get_cpu_number_local() != 0 ||
+        !thor_entry09_owned_object(args, cache, sizeof(*cache)) ||
+        !thor_entry09_owned_object(args, cpuinfo, sizeof(*cpuinfo)) ||
+        !cache->c_valid || cache->c_dsize == 0 || cache->c_linesz == 0 ||
+        cache->c_assoc == 0 || selector != expected_selector ||
+        BootCpuData.cpu_type != CPU_TYPE_ARM64 ||
+        BootCpuData.cpu_subtype != (cpuinfo->arm_info.arm_arch == CPU_ARCH_ARMv8 ?
+            CPU_SUBTYPE_ARM64_V8 : CPU_SUBTYPE_ARM64E) ||
+        (cpuinfo->arm_info.arm_arch != CPU_ARCH_ARMv8 &&
+            cpuinfo->arm_info.arm_arch != CPU_ARCH_ARMv8E) ||
+        BootCpuData.cpu_threadtype != CPU_THREADTYPE_NONE ||
+        BootCpuData.cpu_running != TRUE || BootCpuData.cpu_sleep_token != 0 ||
+        BootCpuData.cpu_sleep_token_last != ARM_CPU_ON_SLEEP_PATH ||
+        BootCpuData.rtclock_timer.deadline != EndOfAllTime ||
+        !queue_empty(&BootCpuData.rtclock_timer.queue.head) ||
+        BootCpuData.rtclock_timer.queue.count != 0 ||
+        !thor_entry09_owned_object(args, master_processor, sizeof(*master_processor)) ||
+        processor_count != 1 || processor_list != master_processor ||
+        processor_array[0] != master_processor ||
+        master_processor->cpu_id != 0 || master_processor->state != PROCESSOR_OFF_LINE ||
+        master_processor->processor_set != &pset0 ||
+        master_processor->processor_primary != master_processor ||
+        master_processor->processor_secondary != NULL ||
+        master_processor->processor_list != NULL ||
+        master_processor->active_thread != THREAD_NULL ||
+        master_processor->startup_thread != THREAD_NULL ||
+        master_processor->idle_thread != THREAD_NULL ||
+        pset0.cpu_set_count != 1 || pset0.cpu_set_low != 0 || pset0.cpu_set_hi != 0 ||
+        pset0.cpu_bitmask != 1 || pset0.recommended_bitmask != 1 ||
+        pset0.primary_map != 1 || pset0.cpu_state_map[PROCESSOR_OFF_LINE] != 1 ||
+        pset0.cpu_available_map != 0 || pset0.realtime_map != 0) {
+        thor_entry09_fail();
+    }
+}
+
+static void
+thor_entry09_prevm_done(boot_args *args)
+{
+    thor_entry09_post_cpu_check(args);
+    thor_entry09_adt_check(args, 0);
+    thor_entry09_mark(4, 0x00ff8000U);
+}
