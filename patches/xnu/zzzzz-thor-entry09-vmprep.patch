+ * Each band is six rows, beginning at y=64. Eighth band means rejection.
+ * Only x0..x9, flags are clobbered. The original physical and KVA callers
+ * use the same explicitly mapped framebuffer address. */
+.align 2
+.globl EXT(thor_entry09_mark)
+LEXT(thor_entry09_mark)
