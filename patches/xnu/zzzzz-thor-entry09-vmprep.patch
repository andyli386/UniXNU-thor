+        sub     x11, x11, x10
+        add     x11, x11, x1
+        mrs     x9, ttbr0_el1
+        cmp     x9, x11
+        b.ne    L_entry09_state_no
+        add     x11, x11, #1, lsl #12
+        mrs     x9, ttbr1_el1
+        cmp     x9, x11
