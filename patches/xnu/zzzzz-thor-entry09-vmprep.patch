diff --git a/osfmk/arm/ccsidr_decode.h b/osfmk/arm/ccsidr_decode.h
new file mode 100644
--- /dev/null
+++ b/osfmk/arm/ccsidr_decode.h
@@ -0,0 +1,56 @@
+/* Architected AArch64 CCSIDR decoder shared by the kernel and host tests. */
+#ifndef _ARM_CCSIDR_DECODE_H_
+#define _ARM_CCSIDR_DECODE_H_
+#include <stdint.h>
+
+typedef struct {
+	uint32_t line_bytes;
+	uint32_t ways;
+	uint32_t sets;
+	uint32_t size_bytes;
+} arm_ccsidr_geometry_t;
+
+typedef enum {
+	ARM_CCSIDR_OK = 0,
+	ARM_CCSIDR_UNSUPPORTED_FORMAT = 1,
+	ARM_CCSIDR_SIZE_OVERFLOW = 2
+} arm_ccsidr_status_t;
+
+/*
+ * ID_AA64MMFR2_EL1.CCIDX[23:20] is 0 for the legacy encoding and 1
+ * for the extended encoding.  All arithmetic stays 64-bit until the
+ * existing cache_info_t ABI's 32-bit capacity has been checked.
+ * Reserved CCSIDR fields are deliberately ignored, never treated as geometry.
+ */
+static inline arm_ccsidr_status_t
+arm_ccsidr_decode(uint64_t ccsidr, uint64_t mmfr2,
+    arm_ccsidr_geometry_t *result)
+{
+	const uint64_t ccidx = (mmfr2 >> 20) & 15;
+	uint64_t sets, ways;
+	const uint64_t line_bytes = UINT64_C(1) << ((ccsidr & 7) + 4);
+
+	if (ccidx == 0) {
+		sets = ((ccsidr >> 13) & UINT64_C(0x7fff)) + 1;
+		ways = ((ccsidr >> 3) & UINT64_C(0x3ff)) + 1;
+	} else if (ccidx == 1) {
+		sets = ((ccsidr >> 32) & UINT64_C(0xffffff)) + 1;
+		ways = ((ccsidr >> 3) & UINT64_C(0x1fffff)) + 1;
+	} else {
+		return ARM_CCSIDR_UNSUPPORTED_FORMAT;
+	}
+	if (sets > UINT64_MAX / line_bytes ||
+	    ways > UINT64_MAX / (sets * line_bytes)) {
+		return ARM_CCSIDR_SIZE_OVERFLOW;
+	}
+	const uint64_t bytes = sets * line_bytes * ways;
+	if (bytes > UINT32_MAX) {
+		return ARM_CCSIDR_SIZE_OVERFLOW;
+	}
+	result->line_bytes = (uint32_t)line_bytes;
+	result->ways = (uint32_t)ways;
+	result->sets = (uint32_t)sets;
+	result->size_bytes = (uint32_t)bytes;
+	return ARM_CCSIDR_OK;
+}
+#endif /* _ARM_CCSIDR_DECODE_H_ */
