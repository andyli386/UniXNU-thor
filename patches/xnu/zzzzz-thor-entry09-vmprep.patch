+#define THOR_ENTRY09_VM_WINDOW (64ULL << 20)
+#define THOR_ENTRY09_TABLE_PA 0x0000fffffffff000ULL
+
+struct thor_entry09_vm_report {
+    uint32_t version, status, pages, prot_returned;
+    uint64_t first, limit, final_avail, table_pages_seen;
+    uint64_t l2_tables, l3_tables, block_leaves, page_leaves;
+    uint64_t future_root, invalid_root, aperture, slide;
+};
+volatile struct thor_entry09_vm_report gThorEntry09VmReport;
+static const boot_args *thor_entry09_vm_args;
+
+static void
+thor_entry09_vm_enter(uint64_t memory_size, boot_args *args)
+{
+    if (thor_entry09_c_state(args) != 1) {
+        thor_entry09_reset();
+    }
+    if (gThorEntry09VmReport.version != 0 || memory_size != 0 ||
+        args->virtBase != VM_KERNEL_LINK_ADDRESS ||
+        args->memSize != THOR_ENTRY09_VM_WINDOW ||
+        args->memSizeActual != THOR_ENTRY09_VM_WINDOW ||
+        args->topOfKernelData <= args->physBase ||
+        args->topOfKernelData - args->physBase >= THOR_ENTRY09_VM_WINDOW ||
+        (args->topOfKernelData & (ARM_PGBYTES - 1)) != 0 ||
+        THOR_ENTRY09_VM_MAX_PAGES * ARM_PGBYTES >
+            THOR_ENTRY09_VM_WINDOW - (args->topOfKernelData - args->physBase) ||
+        kva_active || ptov_index != 0 || cpu_tte != NULL || invalid_tte != NULL) {
+        thor_entry09_fail();
+    }
+    for (unsigned i = 0; i < PTOV_TABLE_SIZE; ++i) {
+        if (ptov_table[i].pa != 0 || ptov_table[i].va != 0 || ptov_table[i].len != 0) {
+            thor_entry09_fail();
+        }
+    }
+    thor_entry09_post_cpu_check(args);
+    thor_entry09_adt_check(args, 0);
+    thor_entry09_vm_args = args;
+    gThorEntry09VmReport.version = 1;
+    gThorEntry09VmReport.first = args->topOfKernelData;
+    gThorEntry09VmReport.limit = args->physBase + args->memSize;
+}
+
+static void
+thor_entry09_vm_allocate(boolean_t map_static)
+{
+    uint64_t first = gThorEntry09VmReport.first;
+    uint64_t limit = gThorEntry09VmReport.limit;
+    uint32_t pages = gThorEntry09VmReport.pages;
+    /* This precedes the first real page allocation and every bzero/store.
+     * Original avail_end is deliberately not used before its assignment. */
+    if (gThorEntry09VmReport.version != 1 || map_static || kva_active ||
+        pages >= THOR_ENTRY09_VM_MAX_PAGES ||
+        avail_start != first + (uint64_t)pages * ARM_PGBYTES ||
+        (avail_start & (ARM_PGBYTES - 1)) != 0 ||
+        avail_start < first || avail_start > limit ||
+        limit - avail_start < ARM_PGBYTES || (ptov_index != 0 && ptov_index != 1)) {
+        thor_entry09_fail();
+    }
+    gThorEntry09VmReport.pages = pages + 1;
+}
+
+static tt_entry_t *
+thor_entry09_vm_table(uint64_t pa)
+{
+    if ((pa & (ARM_PGBYTES - 1)) != 0 ||
+        pa < gThorEntry09VmReport.first || pa >= avail_start ||
+        avail_start - pa < ARM_PGBYTES ||
+        avail_start > gThorEntry09VmReport.limit) {
+        thor_entry09_fail();
+    }
+    return (tt_entry_t *)(uintptr_t)(gVirtBase + pa - gPhysBase);
+}
+
+static void
+thor_entry09_vm_seen(uint64_t pa)
+{
+    (void)thor_entry09_vm_table(pa);
+    uint64_t index = (pa - gThorEntry09VmReport.first) / ARM_PGBYTES;
+    if (index >= THOR_ENTRY09_VM_MAX_PAGES ||
+        (gThorEntry09VmReport.table_pages_seen & (1ULL << index)) != 0) {
+        thor_entry09_fail();
+    }
+    gThorEntry09VmReport.table_pages_seen |= 1ULL << index;
+}
+
+/* A local read-only walk of future TTBR1. No MMU AT instruction or phystokv. */
+static uint64_t
+thor_entry09_vm_walk(uint64_t va, uint64_t *descriptor, uint64_t *parents)
+{
+    uint64_t e, inherited;
+    tt_entry_t *table;
+    if ((va >> 38) != (VM_KERNEL_LINK_ADDRESS >> 38)) {
+        return 0;
+    }
+    table = thor_entry09_vm_table(cpu_ttep);
+    e = table[(va >> ARM_TT_L1_SHIFT) & 255];
+    if ((e & 3) != 3) {
+        return 0;
+    }
+    inherited = e;
+    table = thor_entry09_vm_table(e & THOR_ENTRY09_TABLE_PA);
+    e = table[(va >> ARM_TT_L2_SHIFT) & 511];
+    if ((e & 3) == 1) {
+        *descriptor = e;
+        *parents = inherited;
+        return (e & ARM_TTE_BLOCK_L2_MASK) | (va & ARM_TT_L2_OFFMASK);
+    }
+    if ((e & 3) != 3) {
+        return 0;
+    }
+    inherited |= e;
+    table = thor_entry09_vm_table(e & THOR_ENTRY09_TABLE_PA);
+    e = table[(va >> ARM_TT_L3_SHIFT) & 511];
+    if ((e & 3) != 3) {
+        return 0;
+    }
+    *descriptor = e;
+    *parents = inherited;
+    return (e & THOR_ENTRY09_TABLE_PA) | (va & (ARM_PGBYTES - 1));
+}
+
+static void
+thor_entry09_vm_leaf(uint64_t e, int block)
+{
+    uint64_t mask = block ? ARM_TTE_BLOCK_L2_MASK : THOR_ENTRY09_TABLE_PA;
+    uint64_t size = block ? ARM_TT_L2_SIZE : ARM_PGBYTES;
+    uint64_t attributes = e & ~mask;
+    uint64_t common = ARM_PTE_AF | ARM_PTE_SH(SH_OUTER_MEMORY) | ARM_PTE_NX;
+    uint64_t optional = ARM_PTE_PNX | ARM_PTE_AP(AP_RONA) |
+        (block ? 0 : ARM_PTE_HINT);
+    uint64_t type = block ? 1 : 3;
+    uint64_t pa = e & mask;
+    if ((attributes & ~optional) != (common | type) ||
+        ((e & ARM_PTE_APMASK) != ARM_PTE_AP(AP_RWNA) &&
+            (e & ARM_PTE_APMASK) != ARM_PTE_AP(AP_RONA)) ||
+        ((e & ARM_PTE_PNX) == 0 && (e & ARM_PTE_APMASK) != ARM_PTE_AP(AP_RONA)) ||
+        pa < gPhysBase || pa > real_avail_end || real_avail_end - pa < size) {
+        thor_entry09_fail();
+    }
+}
+
+static void
+thor_entry09_vm_all_tables(void)
+{
+    uint64_t base_attrs = ARM_TTE_VALID | ARM_TTE_TYPE_TABLE |
+        ARM_TTE_TABLE_AP(ARM_TTE_TABLE_AP_USER_NA);
+    tt_entry_t *root = thor_entry09_vm_table(cpu_ttep);
+    tt_entry_t *invalid = thor_entry09_vm_table(invalid_ttep);
+    thor_entry09_vm_seen(cpu_ttep);
+    thor_entry09_vm_seen(invalid_ttep);
+    for (unsigned i = 0; i < 512; ++i) {
+        uint64_t e = root[i];
+        if (invalid[i] != 0) {
+            thor_entry09_fail();
+        }
+        if (i < 192 || i > 239) {
+            if (e != 0) {
+                thor_entry09_fail();
+            }
+            continue;
+        }
+        uint64_t attrs = e & ~THOR_ENTRY09_TABLE_PA;
+        if (attrs != base_attrs && attrs != (base_attrs | ARM_DYNAMIC_TABLE_XN)) {
+            thor_entry09_fail();
+        }
+        uint64_t l2pa = e & THOR_ENTRY09_TABLE_PA;
+        thor_entry09_vm_seen(l2pa);
+        ++gThorEntry09VmReport.l2_tables;
+        tt_entry_t *l2 = thor_entry09_vm_table(l2pa);
+        for (unsigned j = 0; j < 512; ++j) {
+            uint64_t e2 = l2[j];
+            if (e2 == 0) {
+                continue;
+            }
+            if ((e2 & 3) == 1) {
+                thor_entry09_vm_leaf(e2, 1);
+                ++gThorEntry09VmReport.block_leaves;
+                continue;
+            }
+            uint64_t l3attrs = e2 & ~THOR_ENTRY09_TABLE_PA;
+            int lowglobal = i == ((LOW_GLOBAL_BASE_ADDRESS >> 30) & 255) &&
+                j == ((LOW_GLOBAL_BASE_ADDRESS >> 21) & 511);
+            if (l3attrs != (3ULL | (lowglobal ? ARM_DYNAMIC_TABLE_XN : 0))) {
+                thor_entry09_fail();
+            }
+            uint64_t l3pa = e2 & THOR_ENTRY09_TABLE_PA;
+            thor_entry09_vm_seen(l3pa);
+            ++gThorEntry09VmReport.l3_tables;
+            tt_entry_t *l3 = thor_entry09_vm_table(l3pa);
+            for (unsigned k = 0; k < 512; ++k) {
+                uint64_t e3 = l3[k];
+                if (lowglobal && e3 != 0) {
+                    thor_entry09_fail();
+                }
+                if (e3 != 0) {
+                    thor_entry09_vm_leaf(e3, 0);
+                    ++gThorEntry09VmReport.page_leaves;
+                }
+            }
+        }
+    }
+    uint32_t pages = gThorEntry09VmReport.pages;
+    uint64_t all = pages == 64 ? UINT64_MAX : (1ULL << pages) - 1;
+    if (gThorEntry09VmReport.l2_tables != 48 ||
+        gThorEntry09VmReport.table_pages_seen != all) {
+        thor_entry09_fail();
+    }
+}
+
+static int
+thor_entry09_vm_stack_guard(uint64_t va)
+{
+    return (va >= (uintptr_t)&intstack_low_guard &&
+        va - (uintptr_t)&intstack_low_guard < PAGE_MAX_SIZE) ||
+        (va >= (uintptr_t)&intstack_high_guard &&
+        va - (uintptr_t)&intstack_high_guard < PAGE_MAX_SIZE) ||
+        (va >= (uintptr_t)&excepstack_high_guard &&
+        va - (uintptr_t)&excepstack_high_guard < PAGE_MAX_SIZE);
+}
+
+static void
+thor_entry09_vm_range(uint64_t start, uint64_t size, uint64_t pa,
+    int read_only, int executable, int bootdata)
+{
+    if ((start & (ARM_PGBYTES - 1)) != 0 ||
+        (size & (ARM_PGBYTES - 1)) != 0) {
+        thor_entry09_fail();
+    }
+    for (uint64_t offset = 0; offset < size; offset += ARM_PGBYTES) {
+        uint64_t e = 0, parent = 0;
+        uint64_t expected_ap = (read_only || (bootdata && thor_entry09_vm_stack_guard(start + offset))) ?
+            ARM_PTE_AP(AP_RONA) : ARM_PTE_AP(AP_RWNA);
+        if (thor_entry09_vm_walk(start + offset, &e, &parent) != pa + offset ||
+            (e & ARM_PTE_APMASK) != expected_ap ||
+            !!(e & ARM_PTE_PNX) == !!executable ||
+            (executable && (parent & ARM_TTE_TABLE_PXN) != 0)) {
+            thor_entry09_fail();
+        }
+    }
+}
+
+static void
+thor_entry09_vm_segment(uint64_t va, uint64_t size, int read_only, int executable, int bootdata)
+{
+    if (size != 0) {
+        thor_entry09_vm_range(va, size, va - gVirtBase + gPhysBase,
+            read_only, executable, bootdata);
+    }
+}
+
+static void
+thor_entry09_vm_prot_done(boot_args *args)
+{
+    if (thor_entry09_vm_args != args || gThorEntry09VmReport.version != 1 ||
+        gThorEntry09VmReport.prot_returned != 0 || kva_active ||
+        segLOWEST != gVirtBase || segLOWESTTEXT != gVirtBase ||
+        segSizeEXTRADATA != 0 || segSizeTRUSTCACHE != 0 || auxkc_mh != 0 ||
+        PAGE_SHIFT_CONST != 12 || page_size != ARM_PGBYTES) {
+        thor_entry09_fail();
+    }
+    thor_entry09_adt_check(args, 1);
+    gThorEntry09VmReport.prot_returned = 1;
+    thor_entry09_mark(5, 0x008000ffU);
+}
+
+static void __attribute__((noreturn))
+thor_entry09_vm_finish(boot_args *args, vm_map_address_t dynamic_memory_begin)
+{
+    uint64_t old_tail_va = args->virtBase + args->topOfKernelData - args->physBase;
+    uint64_t shift = physmap_base - old_tail_va;
+    uint64_t aperture = physmap_base;
+    uint64_t pa_offset = args->topOfKernelData & ARM_TT_L2_OFFMASK;
+    uint64_t va_offset = aperture & ARM_TT_L2_OFFMASK;
+    uint64_t ignored_e = 0, ignored_parent = 0;
+    if (va_offset < pa_offset) {
+        aperture += pa_offset - va_offset;
+    } else if (va_offset > pa_offset) {
+        aperture = ((aperture + ARM_TT_L2_OFFMASK) & ~ARM_TT_L2_OFFMASK) + pa_offset;
+    }
+    if (thor_entry09_c_state(args) != 1) {
+        thor_entry09_reset();
+    }
+    if (args != thor_entry09_vm_args || gThorEntry09VmReport.version != 1 ||
+        gThorEntry09VmReport.prot_returned != 1 || gThorEntry09VmReport.status != 0 ||
+        kva_active || gVirtBase != args->virtBase || gPhysBase != args->physBase ||
+        mem_size != args->memSize || gPhysSize != args->memSize ||
+        real_phys_size != args->memSize || mem_actual != args->memSizeActual ||
+        avail_end != gThorEntry09VmReport.limit || real_avail_end != avail_end ||
+        first_avail_phys != gThorEntry09VmReport.first ||
+        avail_start != first_avail_phys + (uint64_t)gThorEntry09VmReport.pages * ARM_PGBYTES ||
+        invalid_ttep != first_avail_phys || cpu_ttep != first_avail_phys + ARM_PGBYTES ||
+        invalid_tte != thor_entry09_vm_table(invalid_ttep) ||
+        cpu_tte != thor_entry09_vm_table(cpu_ttep) ||
+        (shift & (ARM_PGBYTES - 1)) != 0 || shift >= (1ULL << 30) ||
+        physmap_end != physmap_base + args->memSize + PTOV_TABLE_SIZE * ARM_TT_L2_SIZE ||
+        static_memory_end != physmap_end || dynamic_memory_begin != physmap_end ||
+        ptov_index != 2 || ptov_table[0].pa != args->topOfKernelData ||
+        ptov_table[0].va != aperture || ptov_table[0].len != avail_end - args->topOfKernelData ||
+        arm_vm_kernelcache_phys_start != 0 || arm_vm_kernelcache_phys_end != 0) {
+        thor_entry09_fail();
+    }
+    for (unsigned i = 1; i < PTOV_TABLE_SIZE; ++i) {
+        if (ptov_table[i].len != 0) {
+            thor_entry09_fail();
+        }
+    }
+    thor_entry09_adt_check(args, 1);
+    thor_entry09_post_cpu_check(args);
+    thor_entry09_vm_all_tables();
+    thor_entry09_vm_segment(segTEXTB, segSizeTEXT, 1, 0, 0);
+    thor_entry09_vm_segment(segDATACONSTB, segSizeDATACONST, 0, 0, 0);
+    thor_entry09_vm_segment(segTEXTEXECB, segSizeTEXTEXEC, 1, 1, 0);
+    thor_entry09_vm_segment(segDATAB, segSizeDATA, 0, 0, 0);
+    thor_entry09_vm_segment(segBOOTDATAB, segSizeBOOTDATA, 0, 0, 1);
+    thor_entry09_vm_segment(segKLDB, segSizeKLD, 1, 1, 0);
+    thor_entry09_vm_segment(segKLDDATAB, segSizeKLDDATA, 1, 0, 0);
+    thor_entry09_vm_segment(segLASTDATACONSTB, segSizeLASTDATACONST, 0, 0, 0);
+    thor_entry09_vm_segment(segLINKB, segSizeLINK, 0, 0, 0);
+    thor_entry09_vm_segment(end_kern, old_tail_va - end_kern, 0, 0, 0);
+    thor_entry09_vm_range(aperture, avail_end - args->topOfKernelData,
+        args->topOfKernelData, 0, 0, 0);
+    if (thor_entry09_vm_walk(gVirtBase - ARM_PGBYTES, &ignored_e, &ignored_parent) != 0 ||
+        thor_entry09_vm_walk(aperture + avail_end - args->topOfKernelData,
+            &ignored_e, &ignored_parent) != 0 ||
+        thor_entry09_vm_walk(LOW_GLOBAL_BASE_ADDRESS, &ignored_e, &ignored_parent) != 0 ||
+        thor_entry09_vm_walk(0xb805a000ULL, &ignored_e, &ignored_parent) != 0) {
+        thor_entry09_fail();
+    }
+    gThorEntry09VmReport.final_avail = avail_start;
+    gThorEntry09VmReport.future_root = cpu_ttep;
+    gThorEntry09VmReport.invalid_root = invalid_ttep;
+    gThorEntry09VmReport.aperture = aperture;
+    gThorEntry09VmReport.slide = shift;
+    gThorEntry09VmReport.status = 1;
+    thor_entry09_mark(6, 0x0000ff00U);
+    thor_entry09_stop();
+}
