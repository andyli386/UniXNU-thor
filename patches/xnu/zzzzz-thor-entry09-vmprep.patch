+        add     x11, x11, EXT(LowExceptionVectorBase)@pageoff
+        sub     x11, x11, x10
+        add     x11, x11, x1
+        mrs     x9, vbar_el1
+        cmp     x9, x11
+        b.ne    L_entry09_state_no
+        mrs     x9, cntfrq_el0
