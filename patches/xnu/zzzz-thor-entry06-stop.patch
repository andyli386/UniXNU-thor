--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -224,7 +224,12 @@
 	.align	3
 	.globl EXT(_start)
 LEXT(_start)
+#if defined(XNU_THOR_ENTRY_STOP) && XNU_THOR_ENTRY_STOP
+	b	EXT(thor_entry_stop_begin)
+#include "thor_entry_stop.inc.S"
+#else
 	b	EXT(start_first_cpu)
