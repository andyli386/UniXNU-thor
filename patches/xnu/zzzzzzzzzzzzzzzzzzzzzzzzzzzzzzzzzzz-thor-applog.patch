+/*
+ * THOR: pong's applog. launchd sends every service's stdin/stdout to
+ * /dev/null, which hides the one thing that says why a daemon dies. With
+ * applog=1 the selected programs get their fd 1/2 pointed at the console
+ * instead; applog_name is a comma separated list matched against the last
+ * path component. Nothing else about the spawn changes.
+ */
+static const char *
+thor_applog_path(struct image_params *imgp, int fd, const char *path)
+{
+	static char names[128];
+	static int loaded;
+	uint32_t enabled = 0;
+
+	if (fd != 1 && fd != 2) {
+		return path;
+	}
+	if (strcmp(path, "/dev/null") != 0) {
+		return path;
+	}
+	if (!loaded) {
+		if (!PE_parse_boot_argn("applog", &enabled, sizeof(enabled))) {
+			enabled = 0;
+		}
+		if (!PE_parse_boot_argn("applog_name", names, sizeof(names))) {
+			names[0] = 0;
+		}
+		loaded = 1;
+	}
+	if (!enabled || !names[0] || imgp->ip_ndp == NULL) {
+		return path;
+	}
+	const char *name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	if (name == NULL) {
+		return path;
+	}
+	const char *base = strrchr(name, '/');
+	if (base != NULL) {
+		name = base + 1;
+	}
+	const char *p = names;
+	while (*p) {
+		const char *word = p;
+		while (*p && *p != ',') {
+			p++;
+		}
+		size_t len = (size_t)(p - word);
+		if (len && strncmp(name, word, len) == 0 && name[len] == 0) {
+			return "/dev/console";
+		}
+		if (*p) {
+			p++;
+		}
+	}
+	return path;
+}
