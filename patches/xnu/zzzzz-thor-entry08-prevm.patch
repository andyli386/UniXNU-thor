+        cmp     x9, x11
+        b.ne    L_entry08_state_no
+        mrs     x9, mair_el1
+        and     x11, x9, #255
+        cmp     x11, #MAIR_WRITEBACK
+        b.ne    L_entry08_state_no
+        ubfx    x11, x9, #16, #8
+        cmp     x11, #MAIR_WRITETHRU
+        b.ne    L_entry08_state_no
+        ldr     x1, [x0, #0x10]
+        mov     x11, #0xf8000000
+        cmp     x1, x11
+        b.lo    L_entry08_state_no
+        mov     x11, #0xfbc00000
+        cmp     x1, x11
+        b.hi    L_entry08_state_no
+        and     x11, x1, #0x1fffff
+        cmp     x11, #0x4000
+        b.ne    L_entry08_state_no
+        adrp    x11, EXT(bootstrap_pagetables)@page
+        sub     x11, x11, x10
+        add     x11, x11, x1
+        mrs     x9, ttbr0_el1
+        cmp     x9, x11
+        b.ne    L_entry08_state_no
+        add     x11, x11, #1, lsl #12
+        mrs     x9, ttbr1_el1
+        cmp     x9, x11
+        b.ne    L_entry08_state_no
+        adrp    x11, EXT(LowExceptionVectorBase)@page
+        add     x11, x11, EXT(LowExceptionVectorBase)@pageoff
+        sub     x11, x11, x10
+        add     x11, x11, x1
+        mrs     x9, vbar_el1
+        cmp     x9, x11
+        b.ne    L_entry08_state_no
+        mrs     x9, cntfrq_el0
+        movz    x11, #0xf800
+        movk    x11, #0x0124, lsl #16
+        cmp     x9, x11
+        b.ne    L_entry08_state_no
+        mov     w0, #1
+        ret
+L_entry08_state_no:
+        mov     w0, #0
+        ret
+.globl EXT(thor_entry08_c_state_end)
+LEXT(thor_entry08_c_state_end)
+
+/* C-level contract failures retain all completed bands, add red at y106,
+ * then use the same bounded display. Architectural exceptions skip stores. */
+.align 2
+.globl EXT(thor_entry08_fail)
+LEXT(thor_entry08_fail)
+        mov     x0, #7
+        mov     w1, #0x00ff0000
+        bl      EXT(thor_entry08_mark)
+        b       EXT(thor_entry08_stop)
+
+.align 2
+.globl EXT(thor_entry08_stop)
+LEXT(thor_entry08_stop)
+        msr     daifset, #15
+        mrs     x22, CNTFRQ_EL0
+        movz    x9, #0xf800
+        movk    x9, #0x0124, lsl #16
+        cmp     x22, x9
+        b.ne    EXT(thor_entry08_reset)
+        mrs     x9, ctr_el0
+        ubfx    x9, x9, #16, #4
+        cmp     x9, #10
+        b.hi    EXT(thor_entry08_reset)
+        mov     x28, #4
+        lsl     x28, x28, x9
+        movz    x19, #0xd800
+        movk    x19, #0xb809, lsl #16
+        mov     x20, #5760
+        mov     x12, x19
+        mov     w14, #16
+        movz    w16, #0xffff
+        movk    w16, #0x00ff, lsl #16
+L_entry08_gauge_row:
+        mov     x13, x12
+        mov     w15, #1280
+L_entry08_gauge_pixel:
+        str     w16, [x13], #4
+        subs    w15, w15, #1
+        b.ne    L_entry08_gauge_pixel
+        add     x12, x12, x20
+        subs    w14, w14, #1
+        b.ne    L_entry08_gauge_row
+        bl      L_entry08_clean_gauge
+        mov     x10, #20
+        mul     x24, x22, x10
+        isb
+        mrs     x23, CNTVCT_EL0
+        mov     x17, x23
+        mov     w18, #4096
+        mov     x25, #20
+        mov     x26, #0x40000000
+L_entry08_poll:
+        subs    x26, x26, #1
+        b.eq    EXT(thor_entry08_reset)
+        isb
+        mrs     x9, CNTVCT_EL0
+        cmp     x9, x17
+        b.ne    L_entry08_advanced
+        subs    w18, w18, #1
+        b.eq    EXT(thor_entry08_reset)
+        b       L_entry08_elapsed
+L_entry08_advanced:
+        mov     x17, x9
+        mov     w18, #4096
+L_entry08_elapsed:
+        sub     x11, x9, x23
+        cmp     x11, x24
+        b.hs    EXT(thor_entry08_reset)
+        udiv    x10, x11, x22
+        mov     x11, #20
+        sub     x10, x11, x10
+        cmp     x10, x25
+        b.eq    L_entry08_poll
+        b.hi    EXT(thor_entry08_reset)
+        sub     x27, x25, x10
+        lsl     x27, x27, #6
+        mov     x25, x10
+        add     x12, x19, x10, lsl #8
+        mov     w14, #16
+L_entry08_erase_row:
+        mov     x13, x12
+        mov     x15, x27
+L_entry08_erase_pixel:
+        str     wzr, [x13], #4
+        subs    x15, x15, #1
+        b.ne    L_entry08_erase_pixel
+        add     x12, x12, x20
+        subs    w14, w14, #1
+        b.ne    L_entry08_erase_row
