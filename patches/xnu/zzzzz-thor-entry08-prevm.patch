new file mode 100644
--- /dev/null
+++ b/pexpert/arm/thor_entry08_clock.h
@@ -0,0 +1,40 @@
+/* ENTRY08-only generic-counter identification. Not a normal-platform clock policy. */
+#ifndef THOR_ENTRY08_CLOCK_H
+#define THOR_ENTRY08_CLOCK_H
+
+#include <stdint.h>
+
+#define THOR_ENTRY08_CLOCK_VERSION 1u
+#define THOR_ENTRY08_COUNTER_HZ 19200000u
+#define THOR_ENTRY08_CLOCK_VALID_TIMEBASE 1u
+#define THOR_ENTRY08_CLOCK_VALID_DEC 2u
+
+enum thor_entry08_clock_status {
+	THOR_ENTRY08_CLOCK_UNSET = 0,
+	THOR_ENTRY08_CLOCK_OK = 1,
+	THOR_ENTRY08_CLOCK_REENTERED = 2,
+	THOR_ENTRY08_CLOCK_BOOTARGS = 3,
+	THOR_ENTRY08_CLOCK_ROOT = 4,
+	THOR_ENTRY08_CLOCK_CHOSEN = 5,
+	THOR_ENTRY08_CLOCK_CPUS = 6,
+	THOR_ENTRY08_CLOCK_CPU_STATE = 7,
+	THOR_ENTRY08_CLOCK_TIMEBASE = 8,
+	THOR_ENTRY08_CLOCK_COUNTER = 9,
+	THOR_ENTRY08_CLOCK_UNSUPPORTED_FREQUENCY = 10,
+	THOR_ENTRY08_CLOCK_TOPOLOGY = 11
+};
+
+typedef struct thor_entry08_clock_report {
+	uint32_t version;
+	uint32_t status;
+	uint32_t valid_mask;
+	uint32_t cpu_count;
+	uint64_t counter_hz;
+	uint32_t dt_timebase_hz;
+	uint32_t reserved;
+} thor_entry08_clock_report_t;
+
+/* A separate report makes zero-valued unavailable Apple clock fields explicit. */
+extern volatile thor_entry08_clock_report_t gThorEntry08ClockReport;
+
+#endif
