+        b       L_entry08_poll
+L_entry08_clean_gauge:
+        sub     x9, x28, #1
+        bic     x12, x19, x9
+        movz    x13, #0x4000
+        movk    x13, #0xb80b, lsl #16
+L_entry08_gauge_clean_loop:
+        dc      cvac, x12
+        add     x12, x12, x28
+        cmp     x12, x13
+        b.lo    L_entry08_gauge_clean_loop
