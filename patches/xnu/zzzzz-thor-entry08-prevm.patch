+/*
+ * This branch deliberately has no Apple SoC/MMIO prerequisite or default
+ * CPU/bus frequency. Only the generic counter has evidence. The caller must
+ * check this report after PE(FALSE), then stop after rtclock_early_init
+ * and before kernel_startup_bootstrap/VM (the bounded ENTRY08 contract).
+ * An error returns with all global clock fields zero, never using panic/serial.
+ */
+static void
+thor_entry08_identify_counter(boot_args *bootArgs)
+{
+	DTEntry root, chosen, cpus, cpu, other;
+	OpaqueDTEntryIterator iter;
+	const void *value = NULL;
+	unsigned int size = 0;
+	uint32_t timebase;
+	uint64_t counter;
+	static const uint8_t diagnostic_version[4] = { 1, 0, 0, 0 };
+	static const char *const unavailable[] = {
+		"bus-frequency", "clock-frequency", "memory-frequency",
+		"peripheral-frequency", "fixed-frequency"
+	};
+	unsigned int i;
+
+	bzero(&gPEClockFrequencyInfo, sizeof(gPEClockFrequencyInfo));
+	if (gThorEntry08ClockReport.status != THOR_ENTRY08_CLOCK_UNSET) {
+		gThorEntry08ClockReport.valid_mask = 0;
+		gThorEntry08ClockReport.status = THOR_ENTRY08_CLOCK_REENTERED;
+		return;
+	}
+	gThorEntry08ClockReport.version = THOR_ENTRY08_CLOCK_VERSION;
+	gThorEntry08ClockReport.status = THOR_ENTRY08_CLOCK_BOOTARGS;
+	if (bootArgs == NULL || bootArgs->deviceTreeP == NULL ||
+	    bootArgs->deviceTreeLength < 8 || bootArgs->deviceTreeLength > 16384) {
+		return;
+	}
+	gThorEntry08ClockReport.status = THOR_ENTRY08_CLOCK_ROOT;
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    !thor_entry08_property_matches(root, "name", "device-tree", sizeof("device-tree")) ||
+	    !thor_entry08_property_matches(root, "compatible", "xnu,thor-entry08", sizeof("xnu,thor-entry08")) ||
+	    !thor_entry08_property_matches(root, "model", "Xiaomi thor ENTRY08 diagnostic", sizeof("Xiaomi thor ENTRY08 diagnostic")) ||
+	    !thor_entry08_property_matches(root, "target-type", "thor", sizeof("thor"))) {
+		return;
+	}
+	gThorEntry08ClockReport.status = THOR_ENTRY08_CLOCK_CHOSEN;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    !thor_entry08_property_matches(chosen, "entry08-diagnostic", diagnostic_version, sizeof(diagnostic_version)) ||
+	    !thor_entry08_property_absent(chosen, "dram-base") ||
+	    !thor_entry08_property_absent(chosen, "dram-size") ||
+	    !thor_entry08_property_absent(chosen, "random-seed") ||
+	    SecureDTLookupEntry(NULL, "/arm-io", &other) == kSuccess) {
+		return;
+	}
+	gThorEntry08ClockReport.status = THOR_ENTRY08_CLOCK_CPUS;
+	if (SecureDTLookupEntry(NULL, "/cpus", &cpus) != kSuccess ||
+	    SecureDTInitEntryIterator(cpus, &iter) != kSuccess ||
+	    SecureDTIterateEntries(&iter, &cpu) != kSuccess) {
+		return;
+	}
+	gThorEntry08ClockReport.cpu_count = 1;
+	gThorEntry08ClockReport.status = THOR_ENTRY08_CLOCK_TOPOLOGY;
+	if (SecureDTIterateEntries(&iter, &other) == kSuccess) {
+		gThorEntry08ClockReport.cpu_count = 2;
+		return;
+	}
+	gThorEntry08ClockReport.status = THOR_ENTRY08_CLOCK_CPU_STATE;
+	if (!thor_entry08_property_matches(cpu, "name", "cpu0", sizeof("cpu0")) ||
+	    !thor_entry08_property_matches(cpu, "state", "running", sizeof("running")) ||
+	    !thor_entry08_property_matches(cpu, "device_type", "cpu", sizeof("cpu"))) {
+		return;
+	}
+	gThorEntry08ClockReport.status = THOR_ENTRY08_CLOCK_UNSUPPORTED_FREQUENCY;
+	for (i = 0; i < sizeof(unavailable) / sizeof(unavailable[0]); i++) {
+		if (!thor_entry08_property_absent(cpu, unavailable[i])) {
+			return;
+		}
+	}
+	gThorEntry08ClockReport.status = THOR_ENTRY08_CLOCK_TIMEBASE;
+	if (SecureDTGetProperty(cpu, "timebase-frequency", &value, &size) != kSuccess || size != 4) {
+		return;
+	}
+	timebase = thor_entry08_read_le32(value);
+	gThorEntry08ClockReport.dt_timebase_hz = timebase;
+	if (timebase != THOR_ENTRY08_COUNTER_HZ) {
+		return;
+	}
+	gThorEntry08ClockReport.status = THOR_ENTRY08_CLOCK_COUNTER;
+	counter = thor_entry08_counter_frequency();
+	gThorEntry08ClockReport.counter_hz = counter;
+	if (counter != timebase) {
+		return;
+	}
