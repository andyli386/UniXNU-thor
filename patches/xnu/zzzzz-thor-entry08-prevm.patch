+	extern uint64_t thor_entry08_host_counter_hz(void);
+	return thor_entry08_host_counter_hz();
+#elif defined(__arm64__) || defined(__aarch64__)
+	uint64_t value;
+	__asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (value));
