+/* Return 1 only at the linked KVA, with the real native virtual stack and
+ * the exact roots made above. No AT, page-table write, or firmware calls.
+ * x0 is already the KVA boot_args from normal common_start (or its kernel
+ * const copy on the second call). Only x0..x12 and flags are clobbered. */
+.align 2
+.globl EXT(thor_entry08_c_state)
+LEXT(thor_entry08_c_state)
+        mrs     x9, CurrentEL
+        cmp     x9, #4
+        b.ne    L_entry08_state_no
+        MOV64   x10, VM_KERNEL_LINK_ADDRESS
+        cmp     x0, x10
+        b.lo    L_entry08_state_no
+        sub     x9, x0, x10
+        mov     x11, #0x4000000
+        sub     x11, x11, #0x480
+        cmp     x9, x11
+        b.hi    L_entry08_state_no
+        adr     x9, EXT(thor_entry08_c_state)
+        cmp     x9, x10
+        b.lo    L_entry08_state_no
+        sub     x9, x9, x10
+        cmp     x9, x11
+        b.hi    L_entry08_state_no
+        cmp     lr, x10
+        b.lo    L_entry08_state_no
+        sub     x9, lr, x10
+        cmp     x9, x11
+        b.hi    L_entry08_state_no
+        mrs     x9, spsel
+        cbnz    x9, L_entry08_state_no
+        mov     x9, sp
+        tst     x9, #15
+        b.ne    L_entry08_state_no
