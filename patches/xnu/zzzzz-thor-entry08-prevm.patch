+        add     x11, x11, EXT(intstack)@pageoff
+        add     x11, x11, #1, lsl #12
+        cmp     x9, x11
+        b.lo    L_entry08_state_no
+        adrp    x11, EXT(intstack_top)@page
+        add     x11, x11, EXT(intstack_top)@pageoff
+        cmp     x9, x11
+        b.hi    L_entry08_state_no
+        mrs     x9, sctlr_el1
+        mov     x11, #0x1005
+        and     x12, x9, x11
+        cmp     x12, x11
+        b.ne    L_entry08_state_no
+        tbnz    x9, #19, L_entry08_state_no
+        tbnz    x9, #25, L_entry08_state_no
+        mrs     x9, daif
+        and     x9, x9, #0x3c0
+        cmp     x9, #0x3c0
+        b.ne    L_entry08_state_no
+        mrs     x9, cpacr_el1
+        ubfx    x9, x9, #20, #2
+        cmp     x9, #3
+        b.ne    L_entry08_state_no
+        mrs     x9, tcr_el1
