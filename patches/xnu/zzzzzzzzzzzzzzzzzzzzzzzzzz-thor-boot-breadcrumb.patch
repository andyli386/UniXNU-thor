+/* THOR diag: dump processor state so a thread bound to a not-yet-started CPU
+ * (or a CPU wrongly marked RUNNING) is visible instead of inferred. */
+void
+thor_dump_processors(void)
+{
+	/* One compact line so the scheduler state is easy to read off a photo:
+	 * each entry is the processor state (6 = RUNNING) or -1 when the CPU never
+	 * registered a processor object. */
+	{
+		int st[8];
+		for (unsigned i = 0; i < 8; i++) {
+			processor_t p = processor_array[i];
+			st[i] = (p == PROCESSOR_NULL) ? -1 : (int)p->state;
+		}
+		printf("THOR SMP: online=%d states=%d,%d,%d,%d,%d,%d,%d,%d\n",
+		    (st[0] == 6) + (st[1] == 6) + (st[2] == 6) + (st[3] == 6) +
+		    (st[4] == 6) + (st[5] == 6) + (st[6] == 6) + (st[7] == 6),
+		    st[0], st[1], st[2], st[3], st[4], st[5], st[6], st[7]);
+	}
+	for (unsigned i = 0; i < 8; i++) {
+		processor_t p = processor_array[i];
+		if (p == PROCESSOR_NULL) {
+			printf("THOR proc %u: none\n", i);
+		} else {
+			printf("THOR proc %u: state=%d cpu_id=%d\n",
+			    i, (int)p->state, p->cpu_id);
+		}
 	}
 }
 
