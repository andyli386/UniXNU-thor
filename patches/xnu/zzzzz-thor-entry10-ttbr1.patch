+thor_entry09_read_le32(const void *value)
+{
+	const uint8_t *p = (const uint8_t *)value;
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	       ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
