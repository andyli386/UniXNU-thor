+		return;
+	}
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_CPU_STATE;
+	if (!thor_entry09_property_matches(cpu, "name", "cpu0", sizeof("cpu0")) ||
+	    !thor_entry09_property_matches(cpu, "state", "running", sizeof("running")) ||
+	    !thor_entry09_property_matches(cpu, "device_type", "cpu", sizeof("cpu"))) {
+		return;
+	}
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_UNSUPPORTED_FREQUENCY;
+	for (i = 0; i < sizeof(unavailable) / sizeof(unavailable[0]); i++) {
+		if (!thor_entry09_property_absent(cpu, unavailable[i])) {
