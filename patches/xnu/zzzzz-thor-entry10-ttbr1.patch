+	gPEClockFrequencyInfo.timebase_frequency_hz = timebase;
+	gPEClockFrequencyInfo.dec_clock_rate_hz = timebase;
+	gThorEntry09ClockReport.valid_mask = THOR_ENTRY09_CLOCK_VALID_TIMEBASE | THOR_ENTRY09_CLOCK_VALID_DEC;
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_OK;
+}
