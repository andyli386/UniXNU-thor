+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    !thor_entry09_property_matches(chosen, "entry09-diagnostic", diagnostic_version, sizeof(diagnostic_version)) ||
+	    !thor_entry09_property_absent(chosen, "dram-base") ||
+	    !thor_entry09_property_absent(chosen, "dram-size") ||
+	    !thor_entry09_seed_present(chosen) ||
+	    SecureDTLookupEntry(NULL, "/arm-io", &other) == kSuccess) {
+		return;
+	}
+	gThorEntry09ClockReport.status = THOR_ENTRY09_CLOCK_CPUS;
