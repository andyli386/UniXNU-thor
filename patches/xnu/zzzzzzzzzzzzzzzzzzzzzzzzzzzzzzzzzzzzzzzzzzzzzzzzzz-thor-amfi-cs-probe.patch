diff --color -ruN -x *.orig -x *.rej base/bsd/kern/kern_exec.c work/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c	2026-11-10 00:55:49
+++ b/bsd/kern/kern_exec.c	2026-11-10 00:53:56
@@ -5515,6 +5515,16 @@
 				printf("THOR INJECT: %.*s <- %.*s\n",
 				    (int)imgp->ip_ndp->ni_cnd.cn_namelen, name,
 				    (int)liblen, library);
+				/*
+				 * dyld drops every DYLD_* variable for a restricted
+				 * process (CS_RESTRICT) even when AMFI allows them; this
+				 * line says which case the target is in.
+				 */
+				printf("THOR CS: %.*s flags=%#x restricted=%d require_lv=%d\n",
+				    (int)imgp->ip_ndp->ni_cnd.cn_namelen, name,
+				    proc_getcsflags(current_proc()),
+				    (proc_getcsflags(current_proc()) & CS_RESTRICT) ? 1 : 0,
+				    (proc_getcsflags(current_proc()) & CS_REQUIRE_LV) ? 1 : 0);
 			}
 			if (used + (any ? 1 : 0) + liblen >= size) {
 				return false;
diff --color -ruN -x *.orig -x *.rej base/bsd/kern/kern_minimac.c work/bsd/kern/kern_minimac.c
--- a/bsd/kern/kern_minimac.c	2026-11-10 00:55:49
+++ b/bsd/kern/kern_minimac.c	2026-11-10 00:53:48
@@ -100,6 +100,21 @@
 	uint64_t state = AMFI_BOOTARG_STATE_NOT_ENFORCING;
 	int error;
 
+	/*
+	 * THOR: dyld asks request 0x5a to learn whether it may honour the
+	 * DYLD_* environment variables. If the call never arrives, dyld has
+	 * decided AMFI is unavailable and prunes them itself, which would
+	 * explain why the injected library is never loaded even though the
+	 * kernel put DYLD_INSERT_LIBRARIES in the environment.
+	 */
+	{
+		static unsigned thor_amfi_calls;
+		if (thor_amfi_calls < 40) {
+			thor_amfi_calls++;
+			printf("THOR AMFI: pid %d call %#x\n", proc_getpid(p), call);
+		}
+	}
+
 	if (call == AMFI_SYSCALL_QUERY_BOOTARG_STATE) {
 		return copyout(&state, arg, sizeof(state));
 	}
