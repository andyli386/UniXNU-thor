 }
 
+/* THOR: the last SpringBoard exit, repeated by the driver's heartbeat. */
+int thor_sb_exit_pid;
+int thor_sb_exit_rv;
+unsigned thor_sb_exit_ns;
+unsigned long long thor_sb_exit_code;
+unsigned thor_sb_exit_count;
+
 void
 proc_prepareexit(proc_t p, int rv, boolean_t perf_notify)
 {
@@ -1975,6 +1982,18 @@
 				    sb_reason->osr_namespace, sb_reason->osr_code,
 				    sb_reason->osr_flags);
 			}
+			/*
+			 * The line above is lost in the launchd flood within seconds.
+			 * Keep the last exit in globals so the driver's once-a-minute
+			 * heartbeat can repeat it next to SpringBoard's live state.
+			 */
+			thor_sb_exit_pid = proc_getpid(p);
+			thor_sb_exit_rv = rv;
+			thor_sb_exit_ns = (sb_reason != OS_REASON_NULL) ?
+			    (unsigned)sb_reason->osr_namespace : 0;
+			thor_sb_exit_code = (sb_reason != OS_REASON_NULL) ?
+			    (unsigned long long)sb_reason->osr_code : 0;
+			thor_sb_exit_count++;
 		}
 	}
 
