 /* ENTRY09 diagnostic only: observe original VM preparation, never install it.
  * After arm_vm_physmap_init, phystokv already selects the future aperture.
  * Every table access below deliberately uses the still-active old alias.
  */
 extern uint32_t thor_entry09_c_state(const boot_args *args);
+extern unsigned int LowExceptionVectorBase; /* early vector symbol in start.s */
 extern void thor_entry09_mark(uint64_t band, uint32_t rgb);
 extern void thor_entry09_fail(void) __attribute__((noreturn));
 extern void thor_entry09_reset(void) __attribute__((noreturn));
