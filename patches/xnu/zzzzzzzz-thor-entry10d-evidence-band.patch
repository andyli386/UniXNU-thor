+        b.eq    L_entry10d_post
+        movz    w9, #0xffff
+        movk    w9, #0x00ff, lsl #16 /* white: register+stack PASS */
+        cmp     w1, w9
+        b.eq    L_entry10d_pass
+        movz    w9, #0x00ff, lsl #16  /* red: explicit C reject */
+        cmp     w1, w9
+        b.eq    L_entry10d_fail
