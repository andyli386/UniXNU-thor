-L_entry10c_small_band:
+        b       L_entry10d_band_ready
+L_entry10d_post:
+        mov     x0, #1
+        b       L_entry10d_band_ready
+L_entry10d_pass:
+        mov     x0, #2
+        b       L_entry10d_band_ready
+L_entry10d_fail:
+        mov     x0, #3
+        b       L_entry10d_band_ready
+L_entry10d_small_band:
         mov     x2, #34560
         mov     x7, #8640
-L_entry10c_band_ready:
+L_entry10d_band_ready:
