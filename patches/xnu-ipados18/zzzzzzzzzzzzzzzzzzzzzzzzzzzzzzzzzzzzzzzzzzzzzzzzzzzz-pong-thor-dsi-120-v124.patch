+/*
+ * CAPE Android display binds APPS SMMU SID 0x2800, mask 0x402.
+ * Use the same fixed SMR3/CB3 read-only layout qualified on MIX Fold 2.
+ * No scan of other stream slots, SMMU writes or DMA memory allocations.
+ */
+static bool
+thorDsiDomainAudit(const ThorDpuMappings &map, const ThorDsiInstance &dsi)
+{
+	uint32_t enabled = 1;
+	(void) PE_parse_boot_argn("thor_dsi_domain_audit", &enabled, sizeof(enabled));
+	if (!enabled || !thorDsiClocksReady(map, dsi, 0)) return false;
+
+	constexpr vm_offset_t appsSmmu = 0x15000000;
+	constexpr unsigned idr0Offset = 0x20, idr1Offset = 0x24;
+	constexpr unsigned smr3Offset = 0x80c, s2cr3Offset = 0xc0c, cba2r3Offset = 0x180c;
+	constexpr uint32_t expectedSmr = 0x84022800;
+	const vm_offset_t regs = io_map(appsSmmu, 0x2000, VM_WIMG_IO, VM_PROT_READ, true);
+	if (!regs) {
+		thorDpuMarker("THOR DSI DOMAIN: skip APPS SMMU global page map unavailable\n");
+		return false;
+	}
+	thorDpuMarker("THOR DSI DOMAIN: before fixed APPS SMMU identification read\n");
+	const uint32_t idr0 = thorDpuRead(regs + idr0Offset);
+	const uint32_t idr1 = thorDpuRead(regs + idr1Offset);
+	if (!(idr0 & (1u << 27)) || (idr0 & (1u << 8)) || (idr0 & 0xffu) <= 3 ||
+	    (idr1 & 0xf0000000u) != 0x60000000u || (idr1 & 0xffu) <= 3) {
+		IOLog("THOR DSI DOMAIN: skip unsupported layout idr0=%#x idr1=%#x\n", idr0, idr1);
+		ml_io_unmap(regs, 0x2000);
+		return false;
+	}
+	const uint32_t smr = thorDpuRead(regs + smr3Offset);
+	const uint32_t s2cr = thorDpuRead(regs + s2cr3Offset);
+	IOLog("THOR DSI DOMAIN: idr0=%#x idr1=%#x smr3=%#x s2cr3=%#x\n", idr0, idr1, smr, s2cr);
+	if (smr != expectedSmr || (s2cr & 0x300ffu) != 3) {
+		thorDpuMarker("THOR DSI DOMAIN: skip fixed stream or context differs\n");
+		ml_io_unmap(regs, 0x2000);
+		return false;
+	}
+	const uint32_t cba2r = thorDpuRead(regs + cba2r3Offset);
+	if (cba2r != 1) {
+		IOLog("THOR DSI DOMAIN: skip CB3 cba2r=%#x\n", cba2r);
+		ml_io_unmap(regs, 0x2000);
+		return false;
+	}
+
+	const vm_offset_t cb = io_map(appsSmmu + 0x83000, 0x1000, VM_WIMG_IO, VM_PROT_READ, true);
+	if (!cb) {
+		thorDpuMarker("THOR DSI DOMAIN: skip CB3 page map unavailable\n");
+		ml_io_unmap(regs, 0x2000);
+		return false;
+	}
+	bool identity = false;
+	if (thorDsiClocksReady(map, dsi, 0)) {
+		thorDpuMarker("THOR DSI DOMAIN: before fixed CB3 read\n");
+		const uint32_t sctlr = thorDpuRead(cb);
+		const uint32_t fsr = thorDpuRead(cb + 0x58);
+		const bool stable = thorDpuRead(regs + smr3Offset) == smr &&
+		    thorDpuRead(regs + s2cr3Offset) == s2cr &&
+		    thorDpuRead(regs + cba2r3Offset) == cba2r && thorDpuRead(cb) == sctlr;
+		identity = stable && !(fsr & 0xc00001feu) && !(sctlr & 1u);
+		const char *observed = !stable ? "changed" :
+		    (fsr & 0xc00001feu) ? "faulted" : (sctlr & 1u) ? "translation-active" : "identity-observed";
+		IOLog("THOR DSI DOMAIN: cb3 cba2r=%#x sctlr=%#x fsr=%#x state=%s "
+		    "snapshot_only=1 dma_unqualified=1\n", cba2r, sctlr, fsr, observed);
+	}
+	ml_io_unmap(cb, 0x1000);
+	ml_io_unmap(regs, 0x2000);
+	return identity;
+}
