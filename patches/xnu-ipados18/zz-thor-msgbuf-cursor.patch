+/* Root-only proc_info extension. Copy raw bytes in sequence order so
+ * the reader can detect an overrun without comparing log contents. */
+int
+pong_log_dmesg_since(uint64_t cursor, user_addr_t buffer, uint32_t buffersize,
+    int32_t *retval)
+{
+	struct pong_msgbuf_range range;
+	if (buffersize < sizeof(range) || buffersize > MAX_MSG_BSIZE + sizeof(range)) {
+		return EINVAL;
+	}
+	size_t capacity = buffersize - sizeof(range);
+	char *data = kalloc_data(buffersize, Z_WAITOK);
+	if (data == NULL) {
+		return ENOMEM;
+	}
+
+	bsd_log_lock_safe();
+	range.oldest = pong_msgbuf_sequence - pong_msgbuf_valid_bytes;
+	range.end = pong_msgbuf_sequence;
+	range.start = cursor < range.oldest || cursor > range.end ? range.oldest : cursor;
+	size_t count = MIN(range.end - range.start, capacity);
+	size_t size = msgbufp->msg_size;
+	size_t at = (msgbufp->msg_bufx + size - (range.end - range.start)) % size;
+	size_t first = MIN(count, size - at);
+	memcpy(data + sizeof(range), msgbufp->msg_bufc + at, first);
+	memcpy(data + sizeof(range) + first, msgbufp->msg_bufc, count - first);
+	bsd_log_unlock();
+
+	memcpy(data, &range, sizeof(range));
+	int error = copyout(data, buffer, sizeof(range) + count);
+	if (!error) {
+		*retval = (int32_t)(sizeof(range) + count);
+	}
+	kfree_data(data, buffersize);
+	return error;
+}
