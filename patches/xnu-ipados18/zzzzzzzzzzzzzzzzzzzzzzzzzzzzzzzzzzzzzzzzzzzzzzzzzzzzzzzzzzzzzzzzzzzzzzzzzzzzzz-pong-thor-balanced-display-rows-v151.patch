+/* Enter and return with fHelperLock held. Each range is reserved once;
+ * render outside the lock using this thread's own optional blend row. */
+void
+IOMobileFramebuffer::drawClaimedRows(const RowJob * job, uint32_t * blendRow)
+{
+	while (fHelperNextRow < fHelperEndRow) {
+		const int32_t first = fHelperNextRow;
+		const int32_t remaining = fHelperEndRow - first;
+		const int32_t last = first + (remaining < kHelperRowGrain ? remaining : kHelperRowGrain);
+		fHelperNextRow = last;
+		IOLockUnlock(fHelperLock);
+		drawRows(job, first, last, blendRow);
+		IOLockLock(fHelperLock);
+	}
+}
