+static bool
+touch_evict_move(struct input_queue *q)
+{
+    for (uint32_t index = q->head; index != q->tail; ++index) {
+        if (q->samples[index % QUEUE_SIZE].type != PONG_TOUCH_MOVE) {
+            continue;
+        }
+        /* Shift the prefix forward so every retained sample keeps its order. */
+        while (index != q->head) {
+            q->samples[index % QUEUE_SIZE] = q->samples[(index - 1) % QUEUE_SIZE];
+            --index;
+        }
+        ++q->head;
+        return true;
+    }
+    return false;
+}
