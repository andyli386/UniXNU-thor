 	    native_owner_data_device_path, !native_owner_data_readonly,
 	    (unsigned long long)native_owner_data_seed_size);
+#if CONFIG_PERSONAS && defined(PONG) && (DEVELOPMENT || DEBUG) && !SECURE_KERNEL
+	if (!data_error) {
+		int persona_error = thor_restore_personal_persona(p);
+		printf("THOR persona: native personal replay id=1000 result=%d\n", persona_error);
+	}
+#endif
 #endif
