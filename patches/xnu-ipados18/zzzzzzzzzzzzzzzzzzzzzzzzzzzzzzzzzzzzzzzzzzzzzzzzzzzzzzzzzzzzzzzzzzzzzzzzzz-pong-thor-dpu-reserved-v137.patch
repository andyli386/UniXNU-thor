+static uint64_t
+thorDpuReservedScratch()
+{
+	IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	if (!chosen) return 0;
+	auto *data = OSDynamicCast(OSData, chosen->getProperty("thor-native-scanout"));
+	uint64_t range[2] = {};
+	if (data && data->getLength() == sizeof(range)) memcpy(range, data->getBytesNoCopy(), sizeof(range));
+	chosen->release();
+
+	constexpr uint64_t leaseBytes = 18ull << 20;
+	const uint64_t physical = range[0];
+	if (range[1] != leaseBytes || physical < 0xf8000000 || physical > 0xffc00000 - leaseBytes ||
+	    (physical & 4095) || !pmap_pong_pa_valid(physical + leaseBytes)) return 0;
+	for (uint64_t page = physical; page < physical + leaseBytes; page += 4096) {
+		if (pmap_pong_pa_valid(page)) return 0;
+	}
+	return physical;
+}
