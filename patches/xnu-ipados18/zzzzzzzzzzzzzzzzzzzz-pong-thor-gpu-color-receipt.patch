+#if XNU_PONG_ADRENO_PLATFORM
+/* Only the presenter calls this, with the display-reader reference held.
+ * Report color counts, not pixel data, from the source before CPU scaling. */
+static void
+reportGpuSourceColor(MiniIOSurface *surface, uint32_t swapID)
+{
+	static unsigned initial, notable, invalid;
+	if (!canDrawLinearBGRA(surface)) {
+		if (invalid < 8) {
+			invalid++;
+			IOLog("PONG GPU COLOR: swap=%u sid=%u linear=0 format=%#x row=%u\n",
+			    swapID, surface->sid, surface->info.pixelFormat, surface->info.bytesPerRow);
+		}
+		return;
+	}
+
+	const uint8_t *pixels = surface->pixels();
+	const size_t stride = surface->info.bytesPerRow;
+	unsigned purple = 0, white = 0, translucent = 0, freshPattern = 0;
+	for (unsigned y = 1; y < 5; y++) {
+		const uint8_t *row = pixels + (size_t)surface->info.height * y / 5 * stride;
+		for (unsigned x = 1; x < 5; x++) {
+			const uint8_t *pixel = row + (size_t)surface->info.width * x / 5 * 4;
+			const unsigned b = pixel[0], g = pixel[1], r = pixel[2];
+			purple += r > 96 && b > 96 && r > g + 40 && b > g + 40;
+			white += r > 230 && g > 230 && b > 230;
+			translucent += pixel[3] != 255;
+			freshPattern += b == 255 && g == 0 && r == 255 && pixel[3] == 255;
+		}
+	}
+	if (initial < 8) {
+		initial++;
+	} else if (purple != 0 && notable < 12) {
+		notable++;
+	} else {
+		return;
+	}
+	IOLog("PONG GPU COLOR: swap=%u sid=%u linear=1 purple=%u white=%u translucent=%u fresh_pattern=%u samples=16\n",
+	    swapID, surface->sid, purple, white, translucent, freshPattern);
+}
+#endif
