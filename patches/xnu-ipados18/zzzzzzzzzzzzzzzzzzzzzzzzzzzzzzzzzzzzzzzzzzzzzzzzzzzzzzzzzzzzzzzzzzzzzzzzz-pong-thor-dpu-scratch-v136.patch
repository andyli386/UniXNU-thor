+static constexpr IOByteCount kThorScratchBytes = 5760ull * 3200;
+static constexpr uint32_t kThorFlipMask = (1u << 17) | 3u;
+static constexpr unsigned kThorCtlFlush = 0x18;
+static constexpr unsigned kThorSsppSource = 0x14;
+extern "C" bool pmap_pong_pa_valid(uint64_t);
+
+struct ThorDpuScratch {
+	IOBufferMemoryDescriptor *memory = nullptr;
+	bool prepared = false;
+
+	~ThorDpuScratch()
+	{
+		if (memory) {
+			if (prepared) (void) memory->complete();
+			memory->release();
+		}
+	}
+};
+
+struct ThorDpuFlipMaps {
+	vm_offset_t ctl = 0;
+	vm_offset_t pipes[2] = {};
+
+	~ThorDpuFlipMaps()
+	{
+		if (ctl) ml_io_unmap(ctl, 0x1000);
+		for (auto pipe : pipes) {
+			if (pipe) ml_io_unmap(pipe, 0x1000);
+		}
+	}
+};
+
+static bool
+thorDpuScratchRoute(const ThorDpuMappings &map, uint32_t address, uint32_t &pending)
+{
+	if (!thorDpuClocksReady(map)) return false;
+	const vm_offset_t ctl = map.mdss + 0x16000;
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	pending = thorDpuRead(ctl + kThorCtlFlush);
+	if ((pending & ~kThorFlipMask) ||
+	    thorDpuRead(ctl) != 0x100002d || thorDpuRead(ctl + 4) != 0x100002d ||
+	    thorDpuRead(ctl + 0x14) != 0xf0020000 ||
+	    thorDpuRead(ctl + kThorCtlIntfActive) != 0x2 ||
+	    thorDpuRead(ctl + kThorCtlFetchActive) != 0x30000 ||
+	    thorDpuRead(intf + kThorIntfTearCheck) != 1 ||
+	    thorDpuRead(intf + kThorIntfAutorefresh) != kThorRefreshEachTe) return false;
+	for (unsigned i = 0; i < 2; ++i) {
+		const vm_offset_t pipe = map.mdss + kThorSsppOffset[i];
+		const uint32_t x = i * 720;
+		if (thorDpuRead(pipe) != 0x0c8002d0 || thorDpuRead(pipe + 0x0c) != 0x0c8002d0 ||
+		    thorDpuRead(pipe + 0x08) != x || thorDpuRead(pipe + 0x10) != x ||
+		    thorDpuRead(pipe + kThorSsppSource) != address ||
+		    thorDpuRead(pipe + 0x24) != 0x1680 || thorDpuRead(pipe + 0x30) != 0x237ff ||
+		    thorDpuRead(pipe + 0x34) != 0x3020001 || thorDpuRead(pipe + 0x38) != 0x80000000) return false;
+	}
+	return true;
+}
+
+enum ThorDpuScratchFlip { ThorDpuScratchSkipped, ThorDpuScratchPending, ThorDpuScratchLatched };
+
+static ThorDpuScratchFlip
+thorDpuScratchSubmit(const ThorDpuMappings &map, const ThorDpuFlipMaps &write,
+    uint32_t original, uint32_t address, const char *stage)
+{
+	uint32_t pending = 0;
+	if (!thorDpuScratchRoute(map, original, pending) || pending != 0) {
+		IOLog("THOR DPU SCRATCH: %s skipped before MMIO, route or flush changed\n", stage);
+		return ThorDpuScratchSkipped;
+	}
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	const uint32_t before = thorDpuRead(intf + kThorIntfFrameCount);
+	for (auto pipe : write.pipes) {
+		*reinterpret_cast<volatile uint32_t *>(pipe + kThorSsppSource) = address;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	*reinterpret_cast<volatile uint32_t *>(write.ctl + kThorCtlFlush) = kThorFlipMask;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	bool sawPending = false, latched = false;
+	uint32_t scans = 0;
+	for (unsigned attempt = 0; attempt < 160; ++attempt) {
+		if (!thorDpuScratchRoute(map, address, pending)) break;
+		sawPending |= pending != 0;
+		scans = thorDpuRead(intf + kThorIntfFrameCount) - before;
+		if (sawPending && !pending && scans >= 2 && scans <= 8) {
+			latched = true;
+			break;
+		}
+		IODelay(250);
+	}
+	IOLog("THOR DPU SCRATCH: %s addr=%#x pending_seen=%u flush=%#x scans=%u result=%s\n",
+	    stage, address, sawPending ? 1u : 0u, pending, scans, latched ? "latched" : "unconfirmed");
+	return latched ? ThorDpuScratchLatched : ThorDpuScratchPending;
+}
