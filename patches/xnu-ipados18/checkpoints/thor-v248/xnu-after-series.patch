+static bool
+exec_inject_env(struct image_params *imgp, char *env, size_t size)
+{
+	char conf[sizeof(exec_inject_conf)];
+	const char *name, *p;
+	size_t used;
+	bool any = false;
+	if (imgp->ip_ndp == NULL) return false;
+	lck_mtx_lock(&exec_inject_lock);
+	strlcpy(conf, exec_inject_conf, sizeof(conf));
+	lck_mtx_unlock(&exec_inject_lock);
+	p = conf;
+	name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	used = strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+	while (*p != 0) {
+		while (*p == ' ' || *p == ';') p++;
+		const char *library = p;
+		while (*p && *p != ' ' && *p != ';') p++;
+		size_t liblen = p - library;
+		bool matched = false;
+		while (*p == ' ') {
+			const char *word = ++p;
+			while (*p && *p != ' ' && *p != ';') p++;
+			if ((size_t)(p - word) == imgp->ip_ndp->ni_cnd.cn_namelen &&
+			    p != word && strncmp(word, name, p - word) == 0) matched = true;
+		}
+		if (matched && liblen && *library == '/') {
+			if (used + (any ? 1 : 0) + liblen >= size) return false;
+			if (any) env[used++] = ':';
+			memcpy(env + used, library, liblen);
+			used += liblen;
+			env[used] = 0;
+			any = true;
+		}
+	}
+#ifdef THOR_CONSOLE_V172_STAGE_PATH
+	/* Each process already has the signed UI adapter. Append the matching
+	 * diagnostic once, after its signed payload has been staged on Data. */
+	static const struct {
+		const char *name;
+		size_t length;
+		const char *path;
+	} targets[] = {
+		{ "runningboardd", sizeof("runningboardd") - 1, "/usr/libexec/runningboardd" },
+		{ "backboardd", sizeof("backboardd") - 1, "/usr/libexec/backboardd" },
+		{ "SpringBoard", sizeof("SpringBoard") - 1, "/System/Library/CoreServices/SpringBoard.app/SpringBoard" },
+	};
+	static const char library[] = THOR_CONSOLE_V172_STAGE_PATH;
+	const size_t console_size = used + 1 + sizeof(library);
+	if (any && console_size <= size && imgp->ip_vp &&
+	    imgp->ip_argspace >= console_size + 2 * sizeof(uint64_t) &&
+	    imgp->ip_strspace >= console_size + 2 * sizeof(uint64_t) &&
+	    __atomic_load_n(&thor_console_v172_ready, __ATOMIC_ACQUIRE)) {
+		for (unsigned i = 0; i < sizeof(targets) / sizeof(targets[0]); ++i) {
