+/* Read begins after the virtual HID service is ready. Do not replay fully
+ * released contacts older than that start window. Keep complete pairs
+ * together and leave any live or ambiguous prefix untouched. */
+static unsigned
+touch_discard_stale_start(struct input_queue *q)
+{
+    uint64_t stale;
+    clock_interval_to_absolutetime_interval(1, NSEC_PER_SEC, &stale);
+    const uint64_t now = mach_absolute_time();
+    uint32_t active = 0;
+    uint32_t discard_to = q->head;
+
+    for (uint32_t index = q->head; index != q->tail; ++index) {
+        const struct pong_touch *sample = &q->samples[index % QUEUE_SIZE];
+        if (sample->time > now || now - sample->time < stale || sample->finger >= 10) {
+            break;
+        }
+        const uint32_t bit = 1u << sample->finger;
+        if (sample->type == PONG_TOUCH_DOWN) {
+            if (active & bit) {
+                break;
+            }
+            active |= bit;
+        } else {
+            if (!(active & bit)) {
+                break;
+            }
+            if (sample->type == PONG_TOUCH_UP) {
+                active &= ~bit;
+            } else if (sample->type != PONG_TOUCH_MOVE) {
+                break;
+            }
+        }
+        if (!active) {
+            discard_to = index + 1;
+        }
+    }
+
+    const unsigned discarded = discard_to - q->head;
+    q->head = discard_to;
+    return discarded;
+}
