+/*
+ * SM8475 Cape display layout from the Thor LineageOS display DT.
+ * The clock check follows the MIX Fold 2 probe: a retained splash can
+ * scan while the MDSS register clock is off. Do not enable gates here.
+ */
+extern "C" vm_offset_t io_map(vm_map_offset_t, vm_size_t, unsigned int, vm_prot_t, bool);
+extern "C" void ml_io_unmap(vm_offset_t, vm_size_t);
+extern "C" void pong_ramoops_diagnostic_write(const char *, int);
+
+static constexpr vm_offset_t kThorGccDispAhb = 0x00137004;
+static constexpr vm_offset_t kThorDispCc = 0x0af00000;
+static constexpr vm_offset_t kThorMdss = 0x0ae00000;
+static constexpr unsigned kThorDispCcMdp = 0x800c;
+static constexpr unsigned kThorDispCcAhb = 0x80a4;
+static constexpr unsigned kThorDispCcGdsc = 0x9000;
+static constexpr unsigned kThorCtlIntfActive = 0xf4;
+static constexpr unsigned kThorCtlFetchActive = 0xfc;
+static constexpr unsigned kThorDsiInterfaces = (1u << 1) | (1u << 2);
+static constexpr unsigned kThorIntfFrameCount = 0xac;
+static constexpr unsigned kThorIntfTearCheck = 0x284;
+static constexpr unsigned kThorIntfAutorefresh = 0x2b4;
+static constexpr unsigned kThorIntfOffset[] = { 0x36000, 0x37000 };
+static constexpr unsigned kThorSsppOffset[] = { 0x5000, 0x7000, 0x9000, 0xb000, 0x25000, 0x27000, 0x29000, 0x2b000 };
+static constexpr unsigned kThorSsppFetchBit[] = { 16, 17, 18, 19, 0, 1, 2, 3 };
+
+struct ThorDpuMappings {
+	vm_offset_t gcc;
+	vm_offset_t clocks;
+	vm_offset_t mdss;
+
+	~ThorDpuMappings()
+	{
+		if (mdss) ml_io_unmap(mdss, 0x84000);
+		if (clocks) ml_io_unmap(clocks, 0x2000);
+		if (gcc) ml_io_unmap(gcc, 0x1000);
+	}
+};
+
+static uint32_t
+thorDpuRead(vm_offset_t address)
+{
+	return *reinterpret_cast<const volatile uint32_t *>(address);
+}
+
+static void
+thorDpuMarker(const char *text)
+{
+	IOLog("%s", text);
+	pong_ramoops_diagnostic_write(text, static_cast<int>(strlen(text)));
+}
+
+static bool
+thorDpuClockRunning(uint32_t cbcr)
+{
+	/* Require both an enable indication and a deasserted CLK_OFF bit. */
+	return (cbcr & 0x80000001u) == 1u;
+}
+
+static bool
+thorDpuClocksReady(const ThorDpuMappings &map, bool report = true)
+{
+	const uint32_t gcc = thorDpuRead(map.gcc + (kThorGccDispAhb & 0xfff));
+	if (!thorDpuClockRunning(gcc)) {
+		if (report) IOLog("THOR DPU PROBE: skip GCC DISP AHB cbcr=%#x\n", gcc);
+		return false;
+	}
+	/* The exposed DISPCC range begins at its MDP/AHB/GDSC register page. */
+	const uint32_t gdsc = thorDpuRead(map.clocks + kThorDispCcGdsc - 0x8000);
+	const uint32_t ahb = thorDpuRead(map.clocks + kThorDispCcAhb - 0x8000);
+	const uint32_t mdp = thorDpuRead(map.clocks + kThorDispCcMdp - 0x8000);
+	if ((gdsc & 0x80000001u) != 0x80000000u || !thorDpuClockRunning(ahb) || !thorDpuClockRunning(mdp)) {
+		if (report) IOLog("THOR DPU PROBE: skip DISPCC gdsc=%#x ahb=%#x mdp=%#x\n", gdsc, ahb, mdp);
+		return false;
+	}
+	return true;
+}
+
+/* The Cape Android SDE driver writes BIT(31) | frame_count at 0x2b4.
+ * v119 measured firmware 0x8000003c and only one transfer in 753 ms.
+ * Do not change the panel mode, TE timing, route, or scanout addresses. */
+static constexpr uint32_t kThorFirmwareRefresh = 0x8000003c;
+static constexpr uint32_t kThorRefreshEachTe = 0x80000001;
+
+static bool
+thorDpuRefreshRouteMatches(const ThorDpuMappings &map, uint64_t framebuffer, bool report = true)
+{
+	if (framebuffer != 0xb8000000 || !thorDpuClocksReady(map, report)) return false;
+
+	const vm_offset_t ctl = map.mdss + 0x16000;
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	if (thorDpuRead(ctl + kThorCtlIntfActive) != 0x2 ||
+	    thorDpuRead(ctl + kThorCtlFetchActive) != 0x30000 ||
+	    thorDpuRead(ctl + 0x14) != 0xf0020000 ||
+	    thorDpuRead(ctl + 0x18) != 0 ||
+	    thorDpuRead(intf + kThorIntfTearCheck) != 1) {
+		if (report) thorDpuMarker("THOR DPU REFRESH: skip unexpected CTL0 or INTF1 route\n");
+		return false;
+	}
+	for (unsigned i = 0; i < 2; ++i) {
+		const vm_offset_t pipe = map.mdss + kThorSsppOffset[i];
+		if (thorDpuRead(pipe + 0x14) != framebuffer ||
+		    thorDpuRead(pipe) != 0x0c8002d0 ||
+		    thorDpuRead(pipe + 0x0c) != 0x0c8002d0 ||
+		    thorDpuRead(pipe + 0x24) != 0x1680 ||
+		    thorDpuRead(pipe + 0x30) != 0x237ff) {
+			if (report) thorDpuMarker("THOR DPU REFRESH: skip unexpected VIG0/VIG1 framebuffer\n");
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool
+thorDpuWriteRefresh(const ThorDpuMappings &map, uint64_t framebuffer, uint32_t expected, uint32_t desired)
+{
+	if (!thorDpuRefreshRouteMatches(map, framebuffer)) return false;
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	if (thorDpuRead(intf + kThorIntfAutorefresh) != expected) {
+		thorDpuMarker("THOR DPU REFRESH: skip unexpected auto-refresh config\n");
+		return false;
+	}
+	const vm_offset_t writePage = io_map(kThorMdss + kThorIntfOffset[0], 0x1000,
+	    VM_WIMG_IO, VM_PROT_READ | VM_PROT_WRITE, true);
+	if (!writePage) {
+		thorDpuMarker("THOR DPU REFRESH: skip INTF1 write map unavailable\n");
+		return false;
+	}
+
+	bool applied = false;
+	if (thorDpuRefreshRouteMatches(map, framebuffer) &&
+	    thorDpuRead(writePage + kThorIntfAutorefresh) == expected) {
+		thorDpuMarker(desired == kThorRefreshEachTe ?
+		    "THOR DPU REFRESH: write INTF1 auto-refresh 0x8000003c -> 0x80000001\n" :
+		    "THOR DPU REFRESH: restore INTF1 auto-refresh 0x80000001 -> 0x8000003c\n");
+		*reinterpret_cast<volatile uint32_t *>(writePage + kThorIntfAutorefresh) = desired;
+		__asm__ volatile("dsb sy" ::: "memory");
+		if (thorDpuClocksReady(map)) {
+			const uint32_t actual = thorDpuRead(intf + kThorIntfAutorefresh);
+			IOLog("THOR DPU REFRESH: readback=%#x expected=%#x\n", actual, desired);
+			applied = actual == desired;
+			if (!applied) thorDpuMarker("THOR DPU REFRESH: readback mismatch\n");
+		}
+	}
+	ml_io_unmap(writePage, 0x1000);
+	return applied;
+}
+
+/*
+ * The Cape Android DT associates DSI0 (0x0ae94000) with INTF1 and
+ * DSI1 (0x0ae96000) with INTF2. The matching waipio DISPCC table
+ * provides the byte, byte-interface, pixel and escape-clock CBCRs.
+ * Only inspect a routed controller whose branch clocks are all running.
+ */
+struct ThorDsiInstance {
+	vm_offset_t address;
+	unsigned byteClock, byteInterfaceClock, pixelClock, escapeClock;
+	uint32_t route;
+};
+
+static constexpr ThorDsiInstance kThorDsi[] = {
+	{ 0x0ae94000, 0x8028, 0x802c, 0x8004, 0x8038, 1u << 1 },
+	{ 0x0ae96000, 0x8030, 0x8034, 0x8008, 0x803c, 1u << 2 },
+};
+
+static bool
+thorDsiClocksReady(const ThorDpuMappings &map, const ThorDsiInstance &dsi, unsigned index)
+{
+	if (!thorDpuClocksReady(map)) return false;
+	const uint32_t byte = thorDpuRead(map.clocks + dsi.byteClock - 0x8000);
+	const uint32_t byteInterface = thorDpuRead(map.clocks + dsi.byteInterfaceClock - 0x8000);
+	const uint32_t pixel = thorDpuRead(map.clocks + dsi.pixelClock - 0x8000);
+	const uint32_t escape = thorDpuRead(map.clocks + dsi.escapeClock - 0x8000);
+	if (thorDpuClockRunning(byte) && thorDpuClockRunning(byteInterface) &&
+	    thorDpuClockRunning(pixel) && thorDpuClockRunning(escape)) return true;
+
+	IOLog("THOR DSI AUDIT: id=%u skip branch clock byte=%#x byte_intf=%#x pixel=%#x esc=%#x\n",
+	    index, byte, byteInterface, pixel, escape);
+	return false;
+}
