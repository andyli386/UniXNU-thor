+
+static void
+thorPresentStage(ThorPresentPhase phase)
+{
+	if (phase == ThorPresentPhase::Idle) {
+		__atomic_store_n(&gThorPresentIdleAt, mach_absolute_time(), __ATOMIC_RELAXED);
+	}
+	const uint64_t stamp = (static_cast<uint64_t>(gThorPresentSwap) << 32) |
+	    ((++gThorPresentSequence & 0xffffffu) << 8) | static_cast<uint8_t>(phase);
+	__atomic_store_n(&gThorPresentStamp, stamp, __ATOMIC_RELEASE);
+}
+
+static void
+thorPresentWatch(thread_call_param_t, thread_call_param_t)
+{
+	static uint64_t observed, observedAt, reported;
+	static unsigned activeReceipts, idleReceipts;
+	const uint64_t now = mach_absolute_time();
+	const uint64_t stamp = __atomic_load_n(&gThorPresentStamp, __ATOMIC_ACQUIRE);
+	if (stamp != observed) {
+		observed = stamp;
+		observedAt = now;
+	}
+
+	static constexpr const char *phases[] = {
+		"unknown", "queue-lock", "queue-idle", "deferred-clear", "surface-reader",
+		"pace", "panel-lock", "compose", "helper-lock", "parallel-rows",
+		"join-helpers", "finish", "release-readers", "retire", "drop-surfaces",
+	};
+	static_assert(sizeof(phases) / sizeof(phases[0]) ==
+	    static_cast<unsigned>(ThorPresentPhase::DropSurfaces) + 1, "presenter phases");
+	const unsigned phase = stamp & 0xffu;
+	const bool idle = phase == static_cast<unsigned>(ThorPresentPhase::Idle);
+	const uint64_t touch = pong_touch_last_event_time();
+	const uint64_t observedUs = thorSwitcherMicros(now - observedAt);
+	const bool worthReporting = idle ?
+	    (idleReceipts < 8 && touch > __atomic_load_n(&gThorPresentIdleAt, __ATOMIC_RELAXED)) :
+	    activeReceipts < 16;
+	if (stamp && stamp != reported && observedUs >= 400000 && worthReporting &&
+	    stamp == __atomic_load_n(&gThorPresentStamp, __ATOMIC_ACQUIRE)) {
+		reported = stamp;
+		if (idle) {
+			++idleReceipts;
+		} else {
+			++activeReceipts;
+		}
+		IOLog("PONG FB V181 WATCH: phase=%s swap=%u observed_us=%llu sample_us=%llu "
+		    "touch_us=%llu ingress_us=%llu enqueues=%llu writebacks=%llu helpers=%#x\n",
+		    phases[phase], static_cast<uint32_t>(stamp >> 32),
+		    static_cast<unsigned long long>(observedUs), thorSwitcherMicros(now),
+		    thorSwitcherMicros(touch),
+		    thorSwitcherMicros(__atomic_load_n(&gThorPresentIngress, __ATOMIC_RELAXED)),
+		    static_cast<unsigned long long>(__atomic_load_n(&gThorFrameEnqueues, __ATOMIC_RELAXED)),
+		    static_cast<unsigned long long>(__atomic_load_n(&gThorFrameWritebacks, __ATOMIC_RELAXED)),
+		    __atomic_load_n(&gThorPresentHelperMask, __ATOMIC_RELAXED));
+	}
+
+	// Keep a sample from *before* a lockup, even when the whole scheduler
+	// later stops and no unchanged-stage receipt can fire. The touch time
+	// and framebuffer stamp are sampled here without taking their locks.
+	static uint64_t previousSnapshot;
+	if (&pong_gpu_swipe_snapshot && touch && touch <= now &&
+	    thorSwitcherMicros(now - touch) <= 2000000 &&
+	    thorSwitcherMicros(now - previousSnapshot) >= 1000000) {
+		previousSnapshot = now;
+		pong_gpu_swipe_snapshot(now, touch, static_cast<uint32_t>(stamp >> 32), phase);
+	}
+	uint64_t deadline;
+	clock_interval_to_deadline(500, kMillisecondScale, &deadline);
+	thread_call_enter_delayed(gThorPresentWatchCall, deadline);
+}
