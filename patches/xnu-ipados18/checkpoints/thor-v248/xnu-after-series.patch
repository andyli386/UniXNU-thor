+            last.last = id;
+            return;
+        }
+        fNewestRun = (fNewestRun + 1) % kRetiredRuns;
+    }
+    if (fRunCount < kRetiredRuns) ++fRunCount;
+    fRetiredRuns[fNewestRun] = {id, id, result};
+}
+
+bool IOMobileFramebuffer::lookupRetired(uint64_t ticket, IOReturn &result, bool &history) const
+{
+    if (!ticket) return false;
+    const uint32_t id = uint32_t(ticket);
+    const auto &slot = fRetired[id % 64];
+    if (slot.ticket == ticket) {
+        result = slot.result;
+        return true;
+    }
+    if (fSwapSequence > UINT32_MAX || ticket > fSwapSequence) return false;
+    for (unsigned i = 0; i < fRunCount; ++i) {
+        const RetiredRun &run = fRetiredRuns[(fNewestRun + kRetiredRuns - i) % kRetiredRuns];
+        if (run.first <= id && id <= run.last) {
+            result = run.result;
+            history = true;
+            return true;
+        }
+    }
