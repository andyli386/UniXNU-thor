+		if (!error && residual) {
+			error = EIO;
+		}
+		if (!error) {
+			error = vnode_setsize(file, length, 0, context);
+		}
+		if (!error) {
+			error = VNOP_FSYNC(file, MNT_WAIT, context);
+		}
+		if (!error && verify) {
+			error = thor_stage_verify_payload(p, file, payload, length, context);
+		}
+	}
+	if (file) {
+		int close_error = vnode_close(file, access, context);
+		if (!error) {
+			error = close_error;
+		}
+	}
+	if (directory) {
+		vnode_put(directory);
+	}
+	if (data) {
+		vnode_put(data);
+	}
+	return error;
+}
