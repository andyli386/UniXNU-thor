+		{ "IOSurfacePlaneComponentTypes", plane->componentType },
+		{ "IOSurfacePlaneComponentRanges", plane->componentRange },
+		{ "IOSurfacePlaneComponentBitDepths", plane->componentBitDepth },
+		{ "IOSurfacePlaneComponentBitOffsets", plane->componentBitOffset },
