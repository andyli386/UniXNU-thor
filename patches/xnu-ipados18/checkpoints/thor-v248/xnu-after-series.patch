+static void
+thor_stage_console_v172(proc_t p)
+{
+	int error = ENOTSUP;
+	/* THOR WITNESS V233: the monitor (osfmk) and the console mirror (above), once. */
+	{
+		extern void thor_witness_start(void) __attribute__((weak_import));
+		thread_t thread = THREAD_NULL;
+		if (&thor_witness_start) {
+			thor_witness_start();
+		}
+		if (!__atomic_exchange_n(&thor_witness_mirror_started, 1u, __ATOMIC_ACQ_REL) &&
+		    kernel_thread_start(thor_witness_mirror, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+			printf("THOR WITNESS V233: console mirror thread started\n");
+		}
+	}
+#ifdef THOR_APP_INSTALLER_PAYLOAD
+	vfs_context_t context = vfs_context_current();
+	vnode_t data = NULLVP, directory = NULLVP;
+	error = vnode_lookup("/private/var", VNODE_LOOKUP_NOFOLLOW_ANY, &data, context);
+	if (!error) error = thor_stage_check_directory(data, 0, 0, 0);
+	if (!error) {
+		error = thor_stage_ensure_directory(data, "thor-console-v232", 0, 0, 0755, &directory);
+	}
+	if (directory) vnode_put(directory);
+	if (data) vnode_put(data);
+	if (!error) {
+		error = thor_stage_data_payload(p, "/private/var/thor-console-v232", THOR_CONSOLE_V172_STAGE_PATH,
+		    thor_console_v172_payload, sizeof(thor_console_v172_payload), true);
+	}
+#endif
+	if (error) {
+		printf("THOR CONSOLE V205: stage failed error=%d\n", error);
+		return;
+	}
+	__atomic_store_n(&thor_console_v172_ready, 1, __ATOMIC_RELEASE);
+	printf("THOR CONSOLE V205: staged %s bytes=%zu\n", THOR_CONSOLE_V172_STAGE_PATH,
+	    sizeof(thor_console_v172_payload));
+}
+#endif
