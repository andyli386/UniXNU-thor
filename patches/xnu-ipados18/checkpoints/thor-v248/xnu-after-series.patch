+static uint64_t
+thor_wifi_us(void)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / 1000;
+}
+
+static uint64_t
+thor_wifi_since_launch(void)
+{
+	/* The SoC counter is not reset by a warm boot, so the clock is taken from the first use:
+	 * the first time wifid's library asks for the switch. */
+	uint64_t base = __atomic_load_n(&thor_wifi_boot_abs, __ATOMIC_ACQUIRE);
+	if (!base) {
+		base = thor_wifi_us();
+		__atomic_store_n(&thor_wifi_boot_abs, base, __ATOMIC_RELEASE);
+	}
+	return thor_wifi_us() - base;
+}
+
+static void
+thor_wifid_watchdog(thread_call_param_t a, thread_call_param_t b);
+
+static void
+thor_wifid_arm_watchdog(void)
+{
+	if (!thor_wifid_watch) {
+		thor_wifid_watch = thread_call_allocate_with_options(thor_wifid_watchdog, NULL,
+		    THREAD_CALL_PRIORITY_KERNEL, 0);
+	}
+	if (thor_wifid_watch) {
+		uint64_t deadline = 0;
+		(void)thread_call_cancel(thor_wifid_watch);
+		clock_interval_to_deadline(60, NSEC_PER_SEC, &deadline);
+		(void)thread_call_enter_delayed(thor_wifid_watch, deadline);
+	}
+}
