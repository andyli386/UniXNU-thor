+struct ThorDpuPhaseAudit {
+	/* The probe owns the mappings. It publishes them to the presenter only
+	 * while the existing interaction window is armed, under fLock. */
+	static constexpr unsigned Limit = 12;
+	struct Phase {
+		uint32_t frame, read, writeLine;
+		uint32_t revision, mux, doneBank, doneMask, doneLevel, doneEnable;
+	};
+	struct Sample {
+		uint64_t start, finish;
+		uint32_t swap;
+		Phase before, after;
+	};
+	const ThorDpuMappings *map;
+	uint64_t framebuffer, next;
+	unsigned count, missed;
+	Sample samples[Limit];
+
+	static void readPpDone(const ThorDpuMappings &map, vm_offset_t intf, Phase &phase) {
+		// The vendor revision register is relative to MDSS; its SDE
+		// TOP interrupt bank starts at MDP (+0x1000), not MDSS +0.
+		const vm_offset_t mdp = map.mdss + 0x1000;
+		constexpr unsigned IntfMux = 0x25c;
+		phase.revision = thorDpuRead(map.mdss);
+		phase.mux = thorDpuRead(intf + IntfMux);
+		phase.doneBank = phase.doneMask = phase.doneLevel = phase.doneEnable = 0;
+		// Thor's Cape revision has PP0 on INTF1 and its secondary disconnected.
+		// Keep other Cape revisions and routes outside the read-only observation.
+		const bool capePp0 = phase.revision == 0x80050000u &&
+		    intf == map.mdss + kThorIntfOffset[0] && phase.mux == 0x000f0000u;
+		if (!capePp0 && (phase.revision & 0xffff0000u) != 0x80010000u) return;
+
+		// Cape's vendor INTF_MUX selects a primary PP in bits 3:0
+		// and uses 0x10000 for split-link PP0/PP1. The two PP_DONE
+		// bits for that route share the same interrupt/status bank.
+		constexpr uint32_t Selectors = 0x000f000fu;
+		const unsigned primary = phase.mux & 0xf;
+		const unsigned secondary = (phase.mux >> 16) & 0xf;
+		const bool split01 = phase.mux == 0x10000;
+		if ((phase.mux & ~Selectors) || primary >= 6 ||
+		    (!split01 && secondary != primary && secondary != 0xf)) return;
+
+		// PP0..3 are in INTR bits 8..11; PP4..5 are in INTR2 bits
+		// 30..31. A latched level is only a snapshot. Neither register
+		// is acknowledged, and no level authorizes buffer retirement.
+		const bool highBank = primary >= 4;
+		const uint32_t mask = split01 ? (3u << 8) : 1u << (highBank ? 26 + primary : 8 + primary);
+		const uint32_t pending = thorDpuRead(mdp + (highBank ? 0x0c : 0x14));
+		const uint32_t enabled = thorDpuRead(mdp + (highBank ? 0x08 : 0x10));
+		if (thorDpuRead(intf + IntfMux) != phase.mux) return;
+		phase.doneBank = highBank ? 2 : 1;
+		phase.doneMask = mask;
+		phase.doneLevel = pending & mask;
+		phase.doneEnable = enabled & mask;
+	}
+
+	bool readPhase(Phase &phase) const {
+		if (!thorDpuRefreshRouteMatches(*map, framebuffer, false)) return false;
+		const vm_offset_t intf = map->mdss + kThorIntfOffset[0];
+		if (thorDpuRead(intf + kThorIntfAutorefresh) != kThorRefreshEachTe) return false;
+		/* The TE read pointer packs frame and line into one word. The
+		 * write pointer is separate. Keep both when the outer frame agrees. */
+		phase.frame = thorDpuRead(intf + kThorIntfFrameCount);
+		phase.read = thorDpuRead(intf + 0x298);
+		phase.writeLine = thorDpuRead(intf + 0x2b0) & 0xffff;
+		readPpDone(*map, intf, phase);
+		return phase.frame == thorDpuRead(intf + kThorIntfFrameCount);
+	}
+
+	bool begin(uint32_t swap) {
+		if (!map || count + missed >= Limit || mach_absolute_time() < next) return false;
+		clock_interval_to_deadline(40, kMillisecondScale, &next);
+		Sample &sample = samples[count];
+		if (!readPhase(sample.before)) {
+			++missed;
+			return false;
+		}
+		sample.swap = swap;
+		sample.start = mach_absolute_time();
+		return true;
+	}
+
+	void end(bool samePower) {
