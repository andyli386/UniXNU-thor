+/* The presenter owns the sequence and swap ID. Publish both with the phase
+ * in one atomic word so the observer never needs a framebuffer or surface lock. */
+enum class ThorPresentPhase : uint8_t {
+	QueueLock = 1, Idle, DeferredClear, SurfaceReader, Pace, PanelLock, Compose,
+	HelperLock, ParallelRows, JoinHelpers, Finish, ReleaseReaders, Retire, DropSurfaces,
+};
+
+static uint32_t gThorPresentSwap, gThorPresentSequence;
+static uint64_t gThorPresentStamp, gThorPresentIdleAt, gThorPresentIngress;
+static uint32_t gThorPresentHelperMask;
+static thread_call_t gThorPresentWatchCall;
+extern "C" void pong_gpu_swipe_snapshot(uint64_t, uint64_t, uint32_t, unsigned) __attribute__((weak_import));
