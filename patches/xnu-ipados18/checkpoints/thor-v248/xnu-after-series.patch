+/* ======================= monitor ======================= */
+
+/* The report on the panel: `page` 0..pages-1. */
+static void
+thor_witness_show(unsigned number, unsigned page)
+{
+	uint32_t *base;
+	unsigned columns, rows, rowpixels, body, pages;
+	char title[96];
+	if (!thor_witness_panel(&base, &columns, &rows, &rowpixels)) {
+		return;
+	}
+	body = rows - 4;
+	pages = (thor_witness_rows(thor_witness_report, thor_witness_report_length, columns - 2) + body - 1) / body;
+	if (!pages) {
+		pages = 1;
+	}
+	if (page >= pages) {
+		page = pages - 1;
+	}
+	snprintf(title, sizeof title, "HANG %u: %s", number, thor_witness_reason);
+	thor_witness_page(title, thor_witness_report, thor_witness_report_length, page * body, body, page, pages);
+}
+
+static unsigned
+thor_witness_pages(void)
+{
+	uint32_t *base;
+	unsigned columns, rows, rowpixels, pages;
+	if (!thor_witness_panel(&base, &columns, &rows, &rowpixels)) {
+		return 1;
+	}
+	pages = (thor_witness_rows(thor_witness_report, thor_witness_report_length, columns - 2) + rows - 5) / (rows - 4);
+	return pages ? pages : 1;
+}
+
+static void __attribute__((noreturn))
+thor_witness_monitor(void *parameter __unused, wait_result_t result __unused)
+{
+	uint64_t next_report = 0, next_draw = 0;
+	unsigned number = 0;
+	for (;;) {
+		const uint64_t now = mach_absolute_time();
+		const uint64_t uptime = thor_witness_micros(now);
+		const uint64_t reader_raw = __atomic_load_n(&thor_witness_reader_abs, __ATOMIC_RELAXED);
+		if (__atomic_load_n(&thor_witness_panic_noted, __ATOMIC_RELAXED)) {
+			/* v248: a panic page is on the panel; no hang report is drawn over it */
+			delay_for_interval(THOR_WITNESS_PERIOD_MS, NSEC_PER_MSEC);
+			continue;
+		}
+		const uint64_t frame_raw = __atomic_load_n(&thor_witness_frame_abs, __ATOMIC_RELAXED);
+		const uint64_t reader = reader_raw ? thor_witness_micros(reader_raw) : 0;
+		const uint64_t frame = frame_raw ? thor_witness_micros(frame_raw) : 0;
+		const uint64_t touch = pong_touch_last_event_time();
+		const bool reader_stalled = reader && uptime > reader && uptime - reader > THOR_WITNESS_STALL_US;
+		const bool input_stalled = frame && touch > frame && uptime > frame &&
+		    uptime - frame > THOR_WITNESS_STALL_US && uptime > touch && uptime - touch < THOR_WITNESS_INPUT_US;
+		__atomic_store_n(&thor_witness_monitor_abs, now, __ATOMIC_RELAXED);
+		if (uptime >= THOR_WITNESS_GRACE_US) {
+			if (reader_stalled || input_stalled) {
+				if (uptime >= next_report) {
+					number++;
+					snprintf(thor_witness_reason, sizeof thor_witness_reason, "%s",
+					    reader_stalled && input_stalled ? "CONSOLE READER AND FRAMES STOPPED" :
+					    reader_stalled ? "CONSOLE READER STOPPED" : "TOUCHES WITHOUT FRAMES");
+					thor_witness_build(thor_witness_reason, uptime);
+					thor_witness_show(number, 0);
+					/* The kernel panics when a cross-call is not taken over: this comes last. */
+					thor_witness_ping();
+					__atomic_store_n(&thor_witness_report_number, number, __ATOMIC_RELAXED);
+					next_report = uptime + THOR_WITNESS_REPORT_GAP_US;
+					next_draw = uptime + THOR_WITNESS_PAGE_US;
+				} else if (uptime >= next_draw) {
+					const unsigned pages = thor_witness_pages();
+					thor_witness_show(number, (unsigned)((uptime / THOR_WITNESS_PAGE_US) % pages));
+					next_draw = uptime + THOR_WITNESS_PAGE_US;
+				}
+			} else {
+				next_report = 0;
+			}
+		}
+		delay_for_interval(THOR_WITNESS_PERIOD_MS, NSEC_PER_MSEC);
+	}
+}
