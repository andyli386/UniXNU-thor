+static const ThorSwitcherProducer *
+thorSwitcherMatchProducer(const ThorSwitcherFrame &frame, bool &ambiguous)
+{
+	const auto &timing = frame.timing;
+	if (timing.baseWriterState != MiniIOSurfaceWriterState::Released ||
+	    timing.baseWritersAtLock != 1 || !timing.baseWriterRelease) {
+		return nullptr;
+	}
+	const ThorSwitcherProducer *match = nullptr;
+	for (unsigned i = 0; i < gSwitcherProducerCount; ++i) {
+		const ThorSwitcherProducer &producer = gSwitcherProducers[i];
+		if (producer.surface == frame.surface && producer.releaseTicks == timing.baseWriterRelease) {
+			if (match) {
+				ambiguous = true;
+				return nullptr;
+			}
+			match = &producer;
+		}
+	}
+	return match;
+}
+
+struct ThorSwitcherMetric {
+	uint64_t total;
+	uint32_t count, max, overTwoPeriods;
+	uint16_t buckets[kSwitcherMsBins];
+
+	void add(uint32_t us)
+	{
+		++count;
+		total += us;
+		if (us > max) {
+			max = us;
+		}
+		overTwoPeriods += us > kSwitcherTwoPeriodsUs;
+		const unsigned ms = us / 1000;
+		++buckets[ms < kSwitcherMsBins ? ms : kSwitcherMsBins - 1];
+	}
+
+	uint32_t p95Upper() const
+	{
+		if (!count) {
+			return 0;
+		}
+		const unsigned rank = (count * 95 + 99) / 100;
+		unsigned seen = 0;
+		for (unsigned i = 0; i + 1 < kSwitcherMsBins; ++i) {
+			seen += buckets[i];
+			if (seen >= rank) {
+				const unsigned upper = (i + 1) * 1000 - 1;
+				return upper < max ? upper : max;
+			}
+		}
+		return max;
+	}
+
+	void report(const char *name) const
+	{
+		IOLog("PONG SWITCHER V157 METRIC: %s n=%u mean_us=%u p95_le_us=%u max_us=%u gt16667=%u\n",
+		    name, count, count ? static_cast<unsigned>(total / count) : 0u,
+		    p95Upper(), max, overTwoPeriods);
+	}
+};
+
+struct ThorSwitcherWindow {
+	unsigned completed, gaps, overTwoPeriods;
+	uint32_t maxGap, maxWriter;
+};
+
+struct ThorSwitcherWorst {
+	unsigned index;
+	uint32_t us;
+};
+
+static void
+thorSwitcherKeepWorst(ThorSwitcherWorst (&worst)[kSwitcherWorstLimit], unsigned index, uint32_t us)
+{
+	for (unsigned i = 0; i < kSwitcherWorstLimit; ++i) {
+		if (us > worst[i].us) {
+			for (unsigned j = kSwitcherWorstLimit - 1; j > i; --j) {
+				worst[j] = worst[j - 1];
+			}
+			worst[i] = { index, us };
+			return;
+		}
+	}
+}
+
+static void
+thorSwitcherReportCues()
+{
+	if (!gSwitcherCueCount) {
+		return;
+	}
+	uint64_t anchor = gSwitcherCues[0].user;
+	for (unsigned i = 1; i < gSwitcherCueCount; ++i) {
+		if (gSwitcherCues[i].user < anchor) {
+			anchor = gSwitcherCues[i].user;
+		}
+	}
+	IOLog("PONG SWITCHER V157 CUEBASE: anchor_us=%llu format=phase,user_delta_us,kernel_delta_us\n",
+	    thorSwitcherMicros(anchor));
+	for (unsigned i = 0; i < gSwitcherCueCount; i += kSwitcherCuesPerLine) {
+		// 8 times one phase digit, two 10-digit deltas and three separators.
+		char line[kSwitcherCuesPerLine * 24 + 1] = {};
+		size_t used = 0;
+		for (unsigned j = i; j < gSwitcherCueCount && j - i < kSwitcherCuesPerLine; ++j) {
+			const ThorSwitcherCue &cue = gSwitcherCues[j];
+			const int length = snprintf(line + used, sizeof(line) - used, "%u,%u,%u;", cue.phase,
+			    thorSwitcherDuration(cue.user - anchor), thorSwitcherDuration(cue.kernel - anchor));
+			if (length < 0 || static_cast<size_t>(length) >= sizeof(line) - used) {
+				break;
+			}
+			used += static_cast<size_t>(length);
+		}
+		IOLog("PONG SWITCHER V157 CUES: i=%u %s\n", i, line);
+	}
+}
