+static void
+thor_wifi_maybe_open(void)
+{
+	if (__atomic_load_n(&thor_wifi_gate, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	const uint32_t ready = __atomic_load_n(&thor_wifi_ready, __ATOMIC_ACQUIRE);
+	const char *why = NULL;
+	if ((ready & 3) == 3) {
+		why = "configd has prepared en0 and a power source is on the registry";
+	} else if (thor_wifi_since_launch() >= 150000000ull) {
+		why = "150 seconds since wifid first asked, before both preparations";
+	}
+	if (!why) {
+		return;
+	}
+	if (__atomic_exchange_n(&thor_wifi_gate, 1, __ATOMIC_ACQ_REL)) {
+		return;
+	}
+	printf("THOR WIFI V241: wifid may run: %s (ready=%#x)\n", why, ready);
+	if (__atomic_load_n(&thor_wifid_pid, __ATOMIC_ACQUIRE) > 0) {
+		thor_wifid_arm_watchdog();
+	}
