+	thor_witness_role_name[i] = 0;
+	__atomic_store_n(&thor_witness_role_pid, (uint64_t)pid, __ATOMIC_RELAXED);
+	__atomic_store_n(&thor_witness_role_fg, foreground ? 1ull : 0ull, __ATOMIC_RELAXED);
+	__atomic_store_n(&thor_witness_role_abs, mach_absolute_time(), __ATOMIC_RELAXED);
