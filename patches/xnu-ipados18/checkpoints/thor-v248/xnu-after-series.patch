+		return;
+	}
+
+	lck_mtx_lock(&exec_inject_lock);
+	snprintf(exec_inject_conf, sizeof(exec_inject_conf), "%s%s",
+	    new_path, injection + sizeof(old_path) - 1);
+	const char service[] = " installd";
+	bool install_adapter = installer_ready &&
+	    strlen(exec_inject_conf) + sizeof(service) <= sizeof(exec_inject_conf);
+	if (install_adapter) {
+		strlcat(exec_inject_conf, service, sizeof(exec_inject_conf));
