+
+static bool
+thorSwitcherClaimGpuOwner(uint32_t pid, uint64_t owner)
+{
+	/* Call under the trace lock; a process restart during capture makes the
+	 * user-space pointer graph unattributable, even if its PID is reused. */
+	if (!pid || !owner) {
+		return false;
+	}
+	if (!gSwitcherGpuOwner) {
+		gSwitcherGpuOwner = owner;
+		gSwitcherGpuPid = pid;
+	}
+	if (gSwitcherGpuOwner != owner || gSwitcherGpuPid != pid) {
+		gSwitcherGpuOwnerChanged = true;
+		return false;
+	}
+	return true;
+}
+
+extern "C" void
+thor_switcher_gpu_event(uint32_t event, uint32_t pid, const uint64_t *words)
+{
+	const uint64_t now = mach_absolute_time();
+	if (!thor_switcher_producer_active(now)) {
+		return;
+	}
+	const uint64_t owner = proc_uniqueid(current_proc());
+	if (!owner) {
+		return;
+	}
+	ThorSwitcherGpuStages stages{};
+	ThorSwitcherGpuLink link{thorSwitcherMicros(now), words[0], words[1], words[2], words[3], words[4], event};
+	switch (event) {
+	case kSwitcherGpuFrontend:
+		if (!link.a || !link.b || link.c != 1) {
+			return;
+		}
+		break;
+	case kSwitcherGpuRuntimeBuffer:
+		if (!link.a || !link.b) {
+			return;
+		}
+		break;
+	case kSwitcherGpuSubmitBuffer:
+		if (!link.a || !link.b || link.c >= link.d || link.d > kSwitcherGpuLinkLimit) {
+			return;
+		}
+		break;
+	case kSwitcherGpuChunk:
+		// e is the total flattened IB count, a v159 extension. Old events
+		// stay in the generic trace and never imply a complete fence set.
+		if (!link.a || !link.b || link.b > UINT32_MAX || !link.e ||
+		    link.c >= link.e || !link.d || link.d > link.e - link.c) {
+			return;
+		}
+		break;
+	case kSwitcherGpuStages:
+		memcpy(&stages, words, sizeof(stages));
+		if (!stages.surface || stages.surface > UINT32_MAX || !stages.command ||
+		    !stages.releaseTicks || stages.releaseTicks > now || stages.heldMask > UINT32_MAX) {
+			return;
+		}
+		for (uint64_t duration : stages.intervals) {
+			if (duration != UINT64_MAX && duration > 8000000) {
+				return;
+			}
+		}
+		break;
+	default:
+		return;
+	}
+
+	lck_mtx_lock(&thor_switcher_trace_lock);
+	if (!gSwitcherTraceSealed && now >= gSwitcherTraceStart && thorSwitcherClaimGpuOwner(pid, owner)) {
+		if (event == kSwitcherGpuStages) {
+			if (gSwitcherGpuStageCount < kSwitcherProducerLimit) {
+				gSwitcherGpuStageRecords[gSwitcherGpuStageCount++] = stages;
+			} else {
+				++gSwitcherGpuStagesLost;
+			}
+		} else if (gSwitcherGpuLinkCount < kSwitcherGpuLinkLimit) {
+			gSwitcherGpuLinks[gSwitcherGpuLinkCount++] = link;
+		} else {
+			++gSwitcherGpuLinksLost;
+		}
+	}
+	lck_mtx_unlock(&thor_switcher_trace_lock);
+}
+
+extern "C" void
+thor_switcher_gpu_fence_record(uint32_t pid, uint32_t fence, const uint64_t *words)
+{
+	const uint64_t now = mach_absolute_time();
+	if (!thor_switcher_producer_active(now) || !pid || !fence) {
+		return;
+	}
+	const ThorSwitcherGpuFence sample{words[0], words[1], words[2], words[3],
+		words[4], words[5], words[6], words[7], words[8], pid, fence};
+	const uint64_t nowUs = thorSwitcherMicros(now);
+	if (!sample.submit || sample.observed < sample.submit || sample.retired < sample.observed ||
+	    sample.retired > nowUs || sample.acquire > sample.retired - sample.observed ||
+	    (sample.cpEnd && (sample.cpStart < sample.submit || sample.cpEnd < sample.cpStart ||
+	    sample.cpEnd > sample.observed)) ||
+	    (sample.irqCandidate && (!sample.cpEnd || sample.irqCandidate < sample.cpEnd ||
+	    sample.irqCandidate > sample.observed))) {
+		return;
+	}
+	lck_mtx_lock(&thor_switcher_trace_lock);
+	if (!gSwitcherTraceSealed && sample.submit >= thorSwitcherMicros(gSwitcherTraceStart)) {
+		if (gSwitcherGpuFenceCount < kSwitcherGpuFenceLimit) {
+			gSwitcherGpuFences[gSwitcherGpuFenceCount++] = sample;
+		} else {
+			++gSwitcherGpuFencesLost;
+		}
+	}
+	lck_mtx_unlock(&thor_switcher_trace_lock);
+}
+
+/* The driver accepts these records from backboardd. Only the quiet-window cue
+ * arms capture, and the IOSurface release never waits for telemetry. */
+extern "C" void
+thor_switcher_producer_record(const uint64_t *words)
+{
+	const uint64_t now = mach_absolute_time();
+	if (!thor_switcher_producer_active(now)) {
+		return;
+	}
+	ThorSwitcherProducer producer;
+	memcpy(&producer, words, sizeof(producer));
+	if (!producer.surface || producer.surface > UINT32_MAX || !producer.command || producer.flags ||
+	    !producer.commit || producer.commit > producer.writerBegin || producer.writerBegin > producer.submit ||
+	    producer.submit > producer.callback || producer.callback > producer.syncDone ||
+	    producer.syncDone > producer.flushDone || producer.flushDone > producer.releaseBegin ||
+	    producer.releaseBegin > producer.releaseEnd || producer.releaseEnd > thorSwitcherMicros(now) ||
+	    !producer.releaseTicks || producer.releaseTicks > now) {
+		return;
+	}
+	const uint64_t releaseUs = thorSwitcherMicros(producer.releaseTicks);
+	if (releaseUs < producer.releaseBegin || releaseUs > producer.releaseEnd) {
+		return;
+	}
+	lck_mtx_lock(&thor_switcher_trace_lock);
+	if (!gSwitcherTraceSealed && producer.releaseTicks >= gSwitcherTraceStart &&
+	    thorSwitcherClaimGpuOwner(static_cast<uint32_t>(proc_selfpid()), proc_uniqueid(current_proc()))) {
+		gSwitcherProducers[gSwitcherProducerNext] = producer;
+		gSwitcherProducerNext = (gSwitcherProducerNext + 1) % kSwitcherProducerLimit;
+		if (gSwitcherProducerCount < kSwitcherProducerLimit) {
+			++gSwitcherProducerCount;
+		} else {
+			++gSwitcherLostProducers;
+		}
+	}
+	lck_mtx_unlock(&thor_switcher_trace_lock);
+}
