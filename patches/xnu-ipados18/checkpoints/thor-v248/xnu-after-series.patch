+static void
+exec_inject_seed_from_boot_args(void)
+{
+	char conf[sizeof(exec_inject_conf)];
+	if (exec_inject_seeded) return;
+	exec_inject_seeded = true;
+	if (PE_parse_boot_argn("pong_exec_inject", conf, sizeof(conf)) == false) return;
+	for (size_t i = 0; conf[i] != 0; i++) {
+		if (conf[i] == ',') conf[i] = ' ';
+	}
+	lck_mtx_lock(&exec_inject_lock);
+	strlcpy(exec_inject_conf, conf, sizeof(exec_inject_conf));
+	lck_mtx_unlock(&exec_inject_lock);
+	printf("THOR INJECT: armed from boot args (%u chars) %.96s\n",
+	    (unsigned)strnlen(conf, sizeof(conf)), conf);
+	printf("THOR WIFI V241: wifid runs once configd has prepared en0 and a power source is on the registry\n");
+}
