+static void
+thorSwitcherReportFrame(const ThorSwitcherFrame &frame, unsigned reason, uint32_t previousSwap,
+    uint32_t gapUs)
+{
+	const auto &timing = frame.timing;
+	/* The serial console retains at most 255 bytes per log call. */
+	IOLog("PONG SWITCHER V157 FRAME: swap=%u sid=%u why=%u prev=%u gap=%u gpu=%u "
+	    "t=%llu/%llu/%llu/%llu/%llu\n", frame.id, frame.surface, reason, previousSwap, gapUs,
+	    frame.gpuFrame ? 1u : 0u, thorSwitcherMicros(frame.enqueued),
+	    thorSwitcherMicros(frame.dequeued), thorSwitcherMicros(frame.ready),
+	    thorSwitcherMicros(frame.shown), thorSwitcherMicros(frame.drawn));
+	IOLog("PONG SWITCHER V157 WRITER: swap=%u sid=%u w=%u/%u/%u base=%u/%u t=%llu/%llu/%llu\n",
+	    frame.id, frame.surface, thorSwitcherDuration(timing.lockTicks),
+	    thorSwitcherDuration(timing.writerTicks), thorSwitcherDuration(timing.resumeTicks),
+	    static_cast<unsigned>(timing.baseWriterState), timing.baseWritersAtLock,
+	    thorSwitcherMicros(timing.baseWriterLocked), thorSwitcherMicros(timing.baseWriterRelease),
+	    thorSwitcherMicros(timing.baseWriterResumed));
+}
+
+
+struct ThorSwitcherFenceSet {
+	uint32_t fences[kSwitcherGpuMaxCommandFences] = {};
+	unsigned count = 0;
+	bool shared = false;
+
+	bool add(uint32_t fence)
+	{
+		for (unsigned i = 0; i < count; ++i) {
+			if (fences[i] == fence) {
+				return true;
+			}
+		}
+		if (count == kSwitcherGpuMaxCommandFences) {
+			return false;
+		}
+		fences[count++] = fence;
+		return true;
+	}
+};
+
+static bool
+thorSwitcherAppendSubmit(unsigned buffer, uint64_t through, ThorSwitcherFenceSet &result)
+{
+	const auto &target = gSwitcherGpuLinks[buffer];
+	unsigned first = buffer;
+	for (; first > 0; --first) {
+		const auto &item = gSwitcherGpuLinks[first];
+		if (item.event == kSwitcherGpuSubmitBuffer && item.a == target.a && item.c == 0) {
+			break;
+		}
+	}
+	const auto &opening = gSwitcherGpuLinks[first];
+	if (opening.event != kSwitcherGpuSubmitBuffer || opening.a != target.a ||
+	    opening.c != 0 || opening.d != target.d) {
+		return false;
+	}
+	unsigned buffers = 0;
+	uint64_t ibOffset = 0, ibTotal = 0;
+	for (unsigned i = first; i < gSwitcherGpuLinkCount; ++i) {
+		const auto &item = gSwitcherGpuLinks[i];
+		if (item.us > through || ((item.event != kSwitcherGpuSubmitBuffer &&
+		    item.event != kSwitcherGpuChunk) || item.a != target.a)) {
+			continue;
+		}
+		if (item.event == kSwitcherGpuSubmitBuffer) {
+			if (i != first && item.c == 0) {
+				break;
+			}
+			if (ibOffset || buffers >= target.d || item.d != target.d || item.c != buffers++) {
+				return false;
+			}
+			continue;
+		}
+		if (buffers != target.d || item.c != ibOffset || (ibTotal && item.e != ibTotal) ||
+		    !result.add(static_cast<uint32_t>(item.b))) {
+			return false;
+		}
+		ibOffset += item.d;
+		ibTotal = item.e;
+	}
+	if (!ibTotal || ibOffset != ibTotal) {
+		return false;
+	}
+	result.shared |= target.d > 1;
+	return true;
+}
+
+static bool
+thorSwitcherMatchFences(const ThorSwitcherProducer &producer, ThorSwitcherFenceSet &result)
+{
+	if (!gSwitcherGpuPid || gSwitcherGpuOwnerChanged || gSwitcherGpuLinksLost) {
+		return false;
+	}
+	unsigned first = gSwitcherGpuLinkCount;
+	for (unsigned i = 0; i < gSwitcherGpuLinkCount; ++i) {
+		const auto &item = gSwitcherGpuLinks[i];
+		if (item.event == kSwitcherGpuFrontend && item.a == producer.command &&
+		    item.us >= producer.commit && item.us <= producer.callback) {
+			if (first != gSwitcherGpuLinkCount) {
+				return false;
+			}
+			first = i;
+		}
+	}
+	if (first == gSwitcherGpuLinkCount) {
+		return false;
+	}
+	const auto &frontend = gSwitcherGpuLinks[first];
+	unsigned runtimeBuffers = 0;
+	for (unsigned i = first + 1; i < gSwitcherGpuLinkCount; ++i) {
+		const auto &runtime = gSwitcherGpuLinks[i];
+		if (runtime.us > producer.callback) {
+			continue;
+		}
+		if (runtime.event == kSwitcherGpuFrontend && runtime.b == frontend.b) {
+			// Arc addresses can be recycled. Refuse a conflicting lifetime.
+			return false;
+		}
+		if (runtime.event != kSwitcherGpuRuntimeBuffer || runtime.a != frontend.b) {
+			continue;
+		}
+		if (++runtimeBuffers > kSwitcherGpuMaxCommandFences) {
+			return false;
+		}
+		unsigned submit = gSwitcherGpuLinkCount;
+		for (unsigned j = i + 1; j < gSwitcherGpuLinkCount; ++j) {
+			const auto &item = gSwitcherGpuLinks[j];
+			if (item.us > producer.callback) {
+				continue;
+			}
+			if (item.event == kSwitcherGpuRuntimeBuffer && item.b == runtime.b) {
+				break;
+			}
+			if (item.event == kSwitcherGpuSubmitBuffer && item.b == runtime.b) {
+				if (submit != gSwitcherGpuLinkCount) {
+					return false;
+				}
+				submit = j;
+			}
+		}
+		if (submit == gSwitcherGpuLinkCount ||
+		    !thorSwitcherAppendSubmit(submit, producer.callback, result)) {
+			return false;
+		}
+	}
+	return result.count > 0;
+}
+
+static bool
+thorSwitcherReportGpu(const ThorSwitcherFrame &frame, const ThorSwitcherProducer &producer)
+{
+	const ThorSwitcherGpuStages *stage = nullptr;
+	for (unsigned i = 0; !gSwitcherGpuOwnerChanged && i < gSwitcherGpuStageCount; ++i) {
+		const auto &sample = gSwitcherGpuStageRecords[i];
+		if (sample.surface == producer.surface && sample.command == producer.command &&
+		    sample.releaseTicks == producer.releaseTicks) {
+			if (stage) {
+				stage = nullptr;
+				break;
+			}
+			stage = &sample;
+		}
+	}
+	if (stage) {
+		const auto duration = [stage](unsigned i) -> long long {
+			const auto value = stage->intervals[i];
+			return value == UINT64_MAX ? -1 : static_cast<long long>(value);
+		};
+		IOLog("PONG SWITCHER V159 STAGES: swap=%u cmd=%llu us=%lld/%lld/%lld/%lld/%lld/%lld/%lld/%lld held_mask=%llx\n",
+		    frame.id, (unsigned long long)producer.command, duration(0), duration(1), duration(2),
+		    duration(3), duration(4), duration(5), duration(6), duration(7),
+		    (unsigned long long)stage->heldMask);
+	}
+
+	ThorSwitcherFenceSet set{};
+	if (!thorSwitcherMatchFences(producer, set)) {
+		return false;
+	}
+	char ids[kSwitcherGpuMaxCommandFences * 11 + 1] = {};
+	size_t used = 0;
+	unsigned recorded = 0;
+	const ThorSwitcherGpuFence *slow = nullptr;
+	for (unsigned i = 0; i < set.count; ++i) {
+		used += snprintf(ids + used, sizeof(ids) - used, "%s%u", i ? "," : "", set.fences[i]);
+		for (unsigned j = 0; j < gSwitcherGpuFenceCount; ++j) {
+			const auto &sample = gSwitcherGpuFences[j];
+			if (sample.pid != gSwitcherGpuPid || sample.fence != set.fences[i] ||
+			    sample.retired > producer.callback) {
+				continue;
+			}
+			++recorded;
+			if (!slow || sample.retired - sample.submit > slow->retired - slow->submit) {
+				slow = &sample;
+			}
+			break;
+		}
+	}
+	IOLog("PONG SWITCHER V159 JOIN: swap=%u cmd=%llu shared=%u fences=%s receipts=%u\n",
+	    frame.id, (unsigned long long)producer.command, set.shared, ids, recorded);
+	if (slow) {
+		IOLog("PONG SWITCHER V159 LINKED: swap=%u fence=%u queue_us=%llu gpu_us=%llu cp_end_est_us=%llu irq_candidate_us=%llu observed_us=%llu retired_us=%llu acquire_us=%llu\n",
+		    frame.id, slow->fence, (unsigned long long)slow->queue, (unsigned long long)slow->execute,
+		    (unsigned long long)slow->cpEnd, (unsigned long long)slow->irqCandidate,
+		    (unsigned long long)slow->observed, (unsigned long long)slow->retired,
+		    (unsigned long long)slow->acquire);
+	}
+	return true;
+}
+
+static void
+thorSwitcherReportGpuFences(unsigned joined)
+{
+	// This independent native-fence sample must not be attributed to a
+	// particular displayed frame if its user-space links were unavailable.
+	const ThorSwitcherGpuFence *worst[4] = {};
+	unsigned marked = 0, timed = 0;
+	uint64_t maxPostCp = 0, maxGpu = 0;
+	for (unsigned i = 0; i < gSwitcherGpuFenceCount; ++i) {
+		const auto &sample = gSwitcherGpuFences[i];
+		if (gSwitcherGpuOwnerChanged || !gSwitcherGpuPid || sample.pid != gSwitcherGpuPid) {
+			continue;
+		}
+		++marked;
+		if (sample.cpEnd) {
+			++timed;
+			const uint64_t gap = sample.observed - sample.cpEnd;
+			if (gap > maxPostCp) {
+				maxPostCp = gap;
+			}
+			if (sample.execute > maxGpu) {
+				maxGpu = sample.execute;
+			}
+			for (unsigned j = 0; j < sizeof(worst) / sizeof(worst[0]); ++j) {
+				if (!worst[j] || gap > worst[j]->observed - worst[j]->cpEnd) {
+					for (unsigned k = sizeof(worst) / sizeof(worst[0]) - 1; k > j; --k) {
+						worst[k] = worst[k - 1];
+					}
+					worst[j] = &sample;
+					break;
+				}
+			}
+		}
+	}
+	for (const auto *sample : worst) {
+		if (sample) {
+			IOLog("PONG SWITCHER V159 NATIVE: fence=%u submit_us=%llu queue_us=%llu gpu_us=%llu cp_end_est_us=%llu irq_candidate_us=%llu observed_us=%llu retired_us=%llu acquire_us=%llu\n",
+			    sample->fence, (unsigned long long)sample->submit, (unsigned long long)sample->queue,
+			    (unsigned long long)sample->execute, (unsigned long long)sample->cpEnd,
+			    (unsigned long long)sample->irqCandidate, (unsigned long long)sample->observed,
+			    (unsigned long long)sample->retired, (unsigned long long)sample->acquire);
+		}
+	}
+	IOLog("PONG SWITCHER V159 FENCE SUMMARY: native=%u stored=%u cp_tagged=%u fence_lost=%u links=%u link_lost=%u stages=%u stage_lost=%u joined=%u owner_change=%u max_gpu_us=%llu max_cp_to_observed_est_us=%llu\n",
+	    marked, gSwitcherGpuFenceCount, timed, gSwitcherGpuFencesLost, gSwitcherGpuLinkCount,
+	    gSwitcherGpuLinksLost, gSwitcherGpuStageCount, gSwitcherGpuStagesLost, joined, gSwitcherGpuOwnerChanged,
+	    (unsigned long long)maxGpu, (unsigned long long)maxPostCp);
+	if (gSwitcherGpuStageCount) {
+		IOLog("PONG SWITCHER V159 STAGE SCHEMA: run/prepare/hand/inbox/held/submit/poll/seen, -1=missing\n");
+	}
+}
+
+static void
+thorSwitcherReport(thread_call_param_t, thread_call_param_t)
+{
+	lck_mtx_lock(&thor_switcher_trace_lock);
+	if (gSwitcherTraceSealed) {
+		lck_mtx_unlock(&thor_switcher_trace_lock);
+		return;
+	}
+	const uint64_t deadline = __atomic_load_n(&gSwitcherTraceEnd, __ATOMIC_RELAXED);
+	if (deadline > mach_absolute_time()) {
+		thread_call_enter_delayed(gSwitcherTraceCall, deadline);
+		lck_mtx_unlock(&thor_switcher_trace_lock);
+		return;
+	}
+	gSwitcherTraceSealed = true;
+	__atomic_store_n(&gSwitcherTraceEnd, 0, __ATOMIC_RELAXED);
+	lck_mtx_unlock(&thor_switcher_trace_lock);
+
+	ThorSwitcherMetric queue{}, ready{}, lock{}, writer{}, resume{}, cpu{}, gpu{}, gap{};
+	ThorSwitcherWindow windows[kSwitcherWindows] = {};
+	ThorSwitcherWorst worstGap[kSwitcherWorstLimit] = {}, worstWriter[kSwitcherWorstLimit] = {};
+	unsigned notReady = 0, idHoles = 0, gpuFrames = 0, firstFailure = kSwitcherFrameLimit;
+	unsigned lastFailure = kSwitcherFrameLimit;
+	const ThorSwitcherFrame *previous = nullptr;
+	for (unsigned i = 0; i < gSwitcherFrameCount; ++i) {
+		const ThorSwitcherFrame &frame = gSwitcherFrames[i];
+		if (frame.enqueued && frame.dequeued >= frame.enqueued) {
+			queue.add(thorSwitcherDuration(frame.dequeued - frame.enqueued));
+		}
+		if (!frame.drawn) {
+			if (firstFailure == kSwitcherFrameLimit) {
+				firstFailure = i;
+			}
+			lastFailure = i;
+			++notReady;
+			continue;
+		}
+		const unsigned seconds = frame.drawn >= gSwitcherTraceStart ?
+		    thorSwitcherDuration(frame.drawn - gSwitcherTraceStart) / 1000000 : 0;
+		ThorSwitcherWindow &window = windows[seconds < kSwitcherWindows ? seconds : kSwitcherWindows - 1];
+		++window.completed;
+		gpuFrames += frame.gpuFrame;
+		if (frame.ready && frame.ready >= frame.dequeued) {
+			ready.add(thorSwitcherDuration(frame.ready - frame.dequeued));
+		}
+		if (frame.shown && frame.drawn >= frame.shown) {
+			(frame.gpuFrame ? gpu : cpu).add(thorSwitcherDuration(frame.drawn - frame.shown));
+		}
+		const uint32_t writerUs = thorSwitcherDuration(frame.timing.writerTicks);
+		lock.add(thorSwitcherDuration(frame.timing.lockTicks));
+		writer.add(writerUs);
+		resume.add(thorSwitcherDuration(frame.timing.resumeTicks));
+		thorSwitcherKeepWorst(worstWriter, i, writerUs);
+		if (writerUs > window.maxWriter) {
+			window.maxWriter = writerUs;
+		}
+		if (previous && frame.drawn >= previous->drawn) {
+			const uint32_t us = thorSwitcherDuration(frame.drawn - previous->drawn);
+			gap.add(us);
+			++window.gaps;
+			window.overTwoPeriods += us > kSwitcherTwoPeriodsUs;
+			idHoles += frame.id != previous->id + 1;
+			thorSwitcherKeepWorst(worstGap, i, us);
+			if (us > window.maxGap) {
+				window.maxGap = us;
+			}
+		}
+		previous = &frame;
+	}
+
+	IOLog("PONG SWITCHER V157 SUMMARY: start_us=%llu attempts=%u capture_lost=%u not_ready=%u "
+	    "gpu=%u cues=%u cue_lost=%u nonadjacent_ids=%u software_writeback\n",
+	    thorSwitcherMicros(gSwitcherTraceStart), gSwitcherFrameCount, gSwitcherLostFrames,
+	    notReady, gpuFrames, gSwitcherCueCount, gSwitcherLostCues, idHoles);
+	IOLog("PONG SWITCHER V157 SCHEMA: FRAME t=enqueue/dequeue/ready/start/done "
+	    "WRITER w=lock/wait/resume base=state/count t=lock/release/resume unit=us\n");
+	queue.report("enqueue_to_dequeue");
+	ready.report("dequeue_to_ready");
+	lock.report("surface_lock");
+	writer.report("writer_wait");
+	resume.report("reader_resume");
+	cpu.report("cpu_writeback");
+	gpu.report("gpu_present_span");
+	gap.report("completion_gap");
+	thorSwitcherReportCues();
+	for (unsigned i = 0; i < kSwitcherWindows; ++i) {
+		const ThorSwitcherWindow &window = windows[i];
+		if (window.completed) {
+			IOLog("PONG SWITCHER V157 WINDOW: s=%u done=%u gaps=%u gt16667=%u max_gap_us=%u max_writer_us=%u\n",
+			    i, window.completed, window.gaps, window.overTwoPeriods, window.maxGap, window.maxWriter);
+		}
+	}
+	previous = nullptr;
+	unsigned printed = 0;
+	unsigned selectedWriters = 0, matchedProducers = 0, ambiguousProducers = 0, joinedFences = 0;
+	for (unsigned i = 0; i < gSwitcherFrameCount; ++i) {
+		const ThorSwitcherFrame &frame = gSwitcherFrames[i];
+		unsigned reason = (i == 0 || i + 1 == gSwitcherFrameCount) ? 1u : 0u;
+		for (unsigned j = 0; j < kSwitcherWorstLimit; ++j) {
+			if (worstGap[j].us && worstGap[j].index == i) {
+				reason |= 2;
+			}
+			if (worstWriter[j].us && worstWriter[j].index == i) {
+				reason |= 4;
+			}
+		}
+		if (i == firstFailure || i == lastFailure) {
+			reason |= 8;
+		}
+		if (reason) {
+			const uint32_t us = previous && frame.drawn >= previous->drawn ?
+			    thorSwitcherDuration(frame.drawn - previous->drawn) : 0;
+			thorSwitcherReportFrame(frame, reason, previous ? previous->id : 0, us);
+			if (frame.timing.baseWriterState == MiniIOSurfaceWriterState::Released &&
+			    frame.timing.baseWritersAtLock == 1) {
+				++selectedWriters;
+				bool ambiguous = false;
+				const auto *producer = thorSwitcherMatchProducer(frame, ambiguous);
+				ambiguousProducers += ambiguous;
+				if (producer) {
+					++matchedProducers;
+					IOLog("PONG SWITCHER V158 PRODUCER: swap=%u sid=%u cmd=%llu t=%llu/%llu/%llu/%llu/%llu/%llu/%llu/%llu\n",
+					    frame.id, frame.surface, static_cast<unsigned long long>(producer->command),
+					    (unsigned long long)producer->commit, (unsigned long long)producer->writerBegin,
+					    (unsigned long long)producer->submit, (unsigned long long)producer->callback,
+					    (unsigned long long)producer->syncDone, (unsigned long long)producer->flushDone,
+					    (unsigned long long)producer->releaseBegin, (unsigned long long)producer->releaseEnd);
+					joinedFences += thorSwitcherReportGpu(frame, *producer);
+				}
+			}
+			++printed;
+		}
+		if (frame.drawn) {
+			previous = &frame;
+		}
+	}
+	IOLog("PONG SWITCHER V158 PRODUCER SUMMARY: receipts=%u overwritten=%u selected=%u matched=%u ambiguous=%u "
+	    "t=commit/writer_begin/submit/callback/sync_done/flush_done/release_begin/release_end unit=us\n",
+	    gSwitcherProducerCount, gSwitcherLostProducers, selectedWriters, matchedProducers, ambiguousProducers);
+	thorSwitcherReportGpuFences(joinedFences);
+	IOLog("PONG SWITCHER V157 END: attempts=%u details=%u cues=%u\n",
+	    gSwitcherFrameCount, printed, gSwitcherCueCount);
+}
+
+/* Durable receipt for the cue, independent of the delayed frame report.
+ * Only the diagnostic endpoint's SpringBoard caller can arm this window.
+ * Keep malformed or failed requests out of the normal receipt budget. */
+static void
+thorSwitcherCueReceipt(unsigned phase, uint64_t user, uint64_t now, const char *state, bool valid)
+{
+	static unsigned validReceipts, faultReceipts;
+	unsigned *counter = valid ? &validReceipts : &faultReceipts;
+	const unsigned limit = valid ? kSwitcherCueLimit : 8;
+	unsigned count = __atomic_load_n(counter, __ATOMIC_RELAXED);
+	while (count < limit) {
+		if (__atomic_compare_exchange_n(counter, &count, count + 1, false,
+		    __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+			const uint64_t userUs = user && user <= now ? thorSwitcherMicros(user) : 0;
+			IOLog("PONG SWITCHER V176 CUE: phase=%u state=%s user_us=%llu kernel_us=%llu\n",
+			    phase, state, userUs, thorSwitcherMicros(now));
+			return;
+		}
+	}
+}
+
+extern "C" int
+thor_switcher_trace_arm(unsigned phase, uint64_t user)
+{
+	const uint64_t now = mach_absolute_time();
+	uint64_t quiet, window;
+	nanoseconds_to_absolutetime(950ull * NSEC_PER_MSEC, &quiet);
+	nanoseconds_to_absolutetime(8ull * NSEC_PER_SEC, &window);
+	if ((phase != 1 && phase != 2) || !user || user > now || now - user > quiet) {
+		thorSwitcherCueReceipt(phase, user, now, "invalid", false);
+		return EINVAL;
+	}
+	lck_mtx_lock(&thor_switcher_trace_lock);
+	if (gSwitcherTraceSealed || (gSwitcherHardEnd && now >= gSwitcherHardEnd)) {
+		const char *state = gSwitcherTraceSealed ? "sealed" : "expired";
+		lck_mtx_unlock(&thor_switcher_trace_lock);
+		thorSwitcherCueReceipt(phase, user, now, state, true);
+		return 0;
+	}
+	const bool first = !gSwitcherTraceCall;
+	if (first) {
+		gSwitcherTraceCall = thread_call_allocate_with_priority(thorSwitcherReport,
+		    nullptr, THREAD_CALL_PRIORITY_LOW);
+		if (!gSwitcherTraceCall) {
+			lck_mtx_unlock(&thor_switcher_trace_lock);
+			thorSwitcherCueReceipt(phase, user, now, "allocation-failed", false);
+			return ENOMEM;
+		}
+		gSwitcherTraceStart = now;
+		gSwitcherHardEnd = now + window;
+	}
+	const bool recorded = gSwitcherCueCount < kSwitcherCueLimit;
+	if (recorded) {
+		gSwitcherCues[gSwitcherCueCount++] = { user, now, phase };
+	} else {
+		++gSwitcherLostCues;
+	}
+	const uint64_t deadline = now + quiet < gSwitcherHardEnd ? now + quiet : gSwitcherHardEnd;
+	if (deadline > __atomic_load_n(&gSwitcherTraceEnd, __ATOMIC_RELAXED)) {
+		__atomic_store_n(&gSwitcherTraceEnd, deadline, __ATOMIC_RELAXED);
+		thread_call_enter_delayed(gSwitcherTraceCall, deadline);
+	}
+	lck_mtx_unlock(&thor_switcher_trace_lock);
+	thorSwitcherCueReceipt(phase, user, now, first ? "first" : recorded ? "recorded" : "full", true);
+	return 0;
+}
+
+static void
+thorSwitcherCapture(uint32_t swap, uint32_t surface, uint64_t enqueued, uint64_t dequeued,
+    uint64_t ready, uint64_t shown, uint64_t drawn, const MiniIOSurfaceReadTiming &timing,
+    bool gpuFrame)
+{
+	const uint64_t now = drawn ? drawn : mach_absolute_time();
+	const uint64_t deadline = __atomic_load_n(&gSwitcherTraceEnd, __ATOMIC_RELAXED);
+	if (!deadline || now > deadline) {
+		return;
+	}
+	lck_mtx_lock(&thor_switcher_trace_lock);
+	if (!gSwitcherTraceSealed) {
+		if (gSwitcherFrameCount < kSwitcherFrameLimit) {
+			gSwitcherFrames[gSwitcherFrameCount++] = {
+				enqueued, dequeued, ready, shown, drawn, timing, swap, surface, gpuFrame
+			};
+		} else {
+			++gSwitcherLostFrames;
+		}
+	}
+	lck_mtx_unlock(&thor_switcher_trace_lock);
+}
