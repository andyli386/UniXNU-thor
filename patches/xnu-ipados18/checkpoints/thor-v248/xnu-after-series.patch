+ * holds launchd's spawn call, and a refused start leaves the service's ports reserved with
+ * nobody to serve them.  launchd starts wifid as before; the small library the kernel puts into
+ * it (libpong-wifid-v241.dylib) waits in its constructor until kern.pong_wifi_gate is 1: configd
+ * has listed en0 and given it a network service, a power source is on the registry, or 150
+ * seconds have gone by since wifid first asked.  Then wifid runs untouched.  A wifid that has
+ * not asked the Wi-Fi driver for anything 60 seconds after it may run is killed; launchd starts
+ * it again, and every client that was waiting on it gets its connection interrupted instead of
+ * waiting for ever.  The command line is not involved. */
+volatile int             thor_wifid_pid = -1;
+static unsigned         thor_wifid_requests;
+static uint32_t         thor_wifi_ready;       /* 1: configd prepared en0; 2: a power source is on the registry */
+static int               thor_wifi_gate;       /* 1: wifid may run; the library reads it through kern.pong_wifi_gate */
+static thread_call_t    thor_wifid_watch;     /* a persistent call: re-armed for every new wifid */
+static uint64_t         thor_wifi_boot_abs;
