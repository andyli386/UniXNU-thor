+/* THOR WITNESS V233: the kernel's own console mirror.  The user-space reader stopped at every
+ * freeze so far (it waits on notifyd, on its journal and on the storage sync), so the kernel
+ * copies the console itself every 250 ms (from the oldest byte still buffered when this thread
+ * starts) and appends each report of the monitor thread
+ * (osfmk/kern/thor_witness_v233.h).  Storage is the one thing this thread may wait for. */
+#define THOR_WITNESS_MIRROR_PATH    "/private/var/logs/PongConsole-kernel-v235.txt"
+#define THOR_WITNESS_MIRROR_CHUNK   32768u
+#define THOR_WITNESS_MIRROR_REPORT  65536u
+#define THOR_WITNESS_MIRROR_LIMIT   (24u * 1024u * 1024u)
+uint64_t thor_witness_writer_abs, thor_witness_writer_file;
+static unsigned thor_witness_mirror_started;
+
+extern size_t thor_witness_console_copy(char *data, size_t capacity, uint64_t *cursor);
+extern size_t thor_witness_report_fetch(char *out, size_t capacity, unsigned *seen, unsigned *lines)
+    __attribute__((weak_import));
+
+/* THOR WITNESS V235: the panic record slot.  A panicking kernel cannot write a file, so the
+ * record goes to blocks that APFS has already given to one.  /private/var/logs/PongPanic-v235-N.bin
+ * is pre-allocated to 256 KiB, the device offset of every 4 KiB block of it is read with
+ * VNOP_BLOCKMAP, and the mapping is proven by reading blocks back through the UFS driver and
+ * comparing them with the file.  Only a proven slot is written at panic time.  A slot that
+ * holds a record is never reused, so records accumulate over boots.
+ *
+ * THOR WITNESS V235: where those block numbers count from.  The only v234 boot proved nothing:
+ * "panic record slot 0 block 0 does not match its file (error 5)", so no record was stored.  A
+ * read-only check from TWRP the same evening showed the Data window holding a GPT whose single
+ * APFS partition begins 1 MiB into the window, and all 64 blocks of the slot file exactly at
+ * partition start + block * 4096, while window start + block * 4096 is zeros.  VNOP_BLOCKMAP
+ * counts from the container device, which is that partition, not from the window.  The origin
+ * now comes from the device stack (window plus the partitions below the file system's device);
+ * the bare window and the volume's own base are tried as well; each candidate has to prove
+ * every block; and when none does, the window itself is searched for the blocks (every block
+ * carries the slot number, its own number and a nonce drawn at this start). */
+#define THOR_WITNESS_SLOT_BYTES    (256u * 1024u)
+#define THOR_WITNESS_SLOT_BLOCKS   (THOR_WITNESS_SLOT_BYTES / 4096u)
+#define THOR_WITNESS_SLOTS         12
+#define THOR_WITNESS_RECORD_MAGIC  "THORPAN1"
+#define THOR_WITNESS_SLOT_MARK     256u                   /* each block's own mark starts here */
+#define THOR_WITNESS_SCAN_BYTES    (128u * 1024u)         /* one raw read: the transport's payload size */
+#define THOR_WITNESS_SCAN_SECONDS  30ull
+struct thor_ufs_device_place {
+	uint64_t window_base;   /* first byte of the storage window inside the UFS LUN */
+	uint64_t window_bytes;  /* its size */
+	uint64_t stack_offset;  /* bytes between the window start and the outermost IOMedia below the device */
+	uint64_t own_base;      /* the file system device's own IOMedia base, 0 for a whole disk */
+};
+static uint64_t thor_witness_slot_block[THOR_WITNESS_SLOT_BLOCKS];   /* the numbers VNOP_BLOCKMAP reports */
+static uint64_t thor_witness_slot_where[THOR_WITNESS_SLOT_BLOCKS];   /* proven: each block's first byte in the UFS LUN */
+static unsigned thor_witness_slot_state;          /* 0 not prepared, 1 proven, 2 unavailable */
+static char thor_witness_slot_path[72];
+static uint8_t thor_witness_slot_image[THOR_WITNESS_SLOT_BYTES];
+extern int thor_ufs_container_of_bsd(int major, int minor, struct thor_ufs_device_place *place);
+extern int thor_ufs_raw_read(uint64_t byte, void *data, uint32_t blocks);
+extern int thor_ufs_raw_write(uint64_t byte, const void *data, uint32_t blocks, int panic);
+
+static int
+thor_witness_slot_io(enum uio_rw direction, vnode_t file, void *data, size_t bytes, off_t offset,
+    vfs_context_t context)
+{
+	int residual = 0;
+	const int error = vn_rdwr(direction, file, (caddr_t)data, (int)bytes, offset, UIO_SYSSPACE, IO_UNIT,
+	    vfs_context_ucred(context), &residual, PROC_NULL);
+	return error ? error : residual ? EIO : 0;
+}
+
+static void
+thor_witness_slot_put(void *at, uint32_t value)
+{
+	memcpy(at, &value, sizeof value);
+}
+
+static uint64_t
+thor_witness_slot_word(const void *at)
+{
+	uint64_t value;
+	memcpy(&value, at, sizeof value);
+	return value;
+}
+
+/* The first byte in the UFS LUN of every block, for one origin of the block numbers and one
+ * bytes-per-block scale: false when a block would not start on a 4 KiB boundary. */
+static bool
+thor_witness_slot_locate(uint64_t origin, uint64_t scale)
+{
+	unsigned n;
+	for (n = 0; n < THOR_WITNESS_SLOT_BLOCKS; n++) {
+		const uint64_t byte = origin + thor_witness_slot_block[n] * scale;
+		if ((byte & 4095) || byte < origin) {
+			return false;
+		}
+		thor_witness_slot_where[n] = byte;
+	}
+	return true;
+}
+
+/* Every block read through the raw channel: 0 when each equals what the file holds, otherwise
+ * the error.  `which` and `saw` tell where it stopped and the first eight bytes of the medium there. */
+static int
+thor_witness_slot_proof(const uint8_t *content, uint8_t *block, unsigned *which, uint64_t *saw)
+{
+	unsigned n;
+	int error = 0;
+	for (n = 0; n < THOR_WITNESS_SLOT_BLOCKS; n++) {
+		memset(block, 0, 4096);
+		error = thor_ufs_raw_read(thor_witness_slot_where[n], block, 1);
+		if (!error && memcmp(block, content + (size_t)n * 4096, 4096)) {
+			error = EIO;
+		}
+		if (error) {
+			*which = n;
+			*saw = thor_witness_slot_word(block);
+			return error;
+		}
+	}
+	return 0;
+}
+
+/* Last resort: find the blocks themselves in the window.  256 bytes into block n of the file
+ * stand "THORSLOT", the slot number, n and a nonce drawn at this start.  A 4 KiB block of the
+ * window with that mark whose whole content equals the file's block n is that block.  Bounded
+ * by the size of the window and by THOR_WITNESS_SCAN_SECONDS; nothing is written. */
+static int
+thor_witness_slot_scan(const struct thor_ufs_device_place *place, const uint8_t *content, unsigned index,
+    unsigned *found_count)
+{
+	const uint8_t *mark = content + THOR_WITNESS_SLOT_MARK;
+	uint8_t *buffer;
+	uint64_t at, left, now, limit;
+	unsigned blocks, i, n, found = 0;
+	int error = 0;
+
+	buffer = kalloc_data(THOR_WITNESS_SCAN_BYTES, Z_WAITOK | Z_ZERO);
+	if (!buffer) {
+		return ENOMEM;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time(), &limit);
+	limit += THOR_WITNESS_SCAN_SECONDS * 1000000000ull;
+	for (at = 0; at < place->window_bytes && found < THOR_WITNESS_SLOT_BLOCKS; at += left) {
+		left = place->window_bytes - at;
+		if (left > THOR_WITNESS_SCAN_BYTES) {
+			left = THOR_WITNESS_SCAN_BYTES;
+		}
+		blocks = (unsigned)(left / 4096);
+		if (!blocks) {
+			break;
+		}
+		error = thor_ufs_raw_read(place->window_base + at, buffer, blocks);
+		if (error) {
+			break;
+		}
+		for (i = 0; i < blocks; i++) {
+			const uint8_t *candidate = buffer + (size_t)i * 4096 + THOR_WITNESS_SLOT_MARK;
+			if (memcmp(candidate, "THORSLOT", 8) ||
+			    (uint32_t)thor_witness_slot_word(candidate + 8) != index ||
+			    (uint32_t)(thor_witness_slot_word(candidate + 8) >> 32) >= THOR_WITNESS_SLOT_BLOCKS ||
+			    memcmp(candidate + 16, mark + 16, 8)) {
+				continue;
+			}
+			n = (unsigned)(thor_witness_slot_word(candidate + 8) >> 32);
+			if (thor_witness_slot_where[n] ||
+			    memcmp(buffer + (size_t)i * 4096, content + (size_t)n * 4096, 4096)) {
+				continue;
+			}
+			thor_witness_slot_where[n] = place->window_base + at + (uint64_t)i * 4096;
+			found++;
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time(), &now);
+		if (now > limit) {
+			error = ETIMEDOUT;
+			break;
+		}
+	}
+	if (!error && found < THOR_WITNESS_SLOT_BLOCKS) {
+		error = ENOENT;
+	}
+	kfree_data(buffer, THOR_WITNESS_SCAN_BYTES);
+	*found_count = found;
+	return error;
+}
+
+static void
+thor_witness_slot_prepare(vfs_context_t context)
+{
+	uint8_t *content = NULL, *block = NULL;
+	vnode_t file = NULLVP;
+	char path[sizeof thor_witness_slot_path];
+	struct vnode_attr attributes;
+	struct thor_ufs_device_place place;
+	daddr64_t bn = 0;
+	size_t run = 0;
+	uint64_t nonce = 0, saw = 0, origins[3], scales[3];
+	unsigned index, b, n, last, which = 0, found = 0, norigins, nscales;
+	dev_t device = 0;
+	int error, unit;
+
+	thor_witness_slot_state = 2;
+	content = kalloc_data(THOR_WITNESS_SLOT_BYTES, Z_WAITOK | Z_ZERO);
+	block = kalloc_data(4096, Z_WAITOK | Z_ZERO);
+	if (!content || !block) {
+		error = ENOMEM;
+		goto out;
+	}
+	/* 1. the first slot that does not hold a record of an earlier boot */
+	for (index = 0; index < THOR_WITNESS_SLOTS; index++) {
+		snprintf(path, sizeof path, "/private/var/logs/PongPanic-v235-%u.bin", index);
+		error = vnode_open(path, O_CREAT | O_RDWR, 0600, VNODE_LOOKUP_NOFOLLOW_ANY, &file, context);
+		if (error) {
+			goto out;
+		}
+		{
+			int residual = 0;
+			/* v238: clear the first 16 bytes before every slot.  Up to v237 they kept the magic of
+			 * the slot before, so once slot 0 held a record every empty slot after it read as
+			 * "holds a record" too: the v236 boot created eleven empty files and ended with
+			 * "no panic record slot (error 28)", and a panic could only have been shown on the panel.
+			 * A new slot is empty: a short read is not an error, the block stays zero. */
+			memset(block, 0, 16);
+			error = vn_rdwr(UIO_READ, file, (caddr_t)block, 16, 0, UIO_SYSSPACE, IO_UNIT,
+			    vfs_context_ucred(context), &residual, PROC_NULL);
+		}
+		(void)vnode_close(file, FREAD | FWRITE, context);
+		file = NULLVP;
+		if (error) {
+			goto out;
+		}
+		if (!memcmp(block, THOR_WITNESS_RECORD_MAGIC, 8)) {
+			continue;
+		}
+		break;
+	}
+	if (index == THOR_WITNESS_SLOTS) {
+		error = ENOSPC;
+		goto out;
+	}
+	error = vnode_open(path, O_RDWR | O_TRUNC, 0600, VNODE_LOOKUP_NOFOLLOW_ANY, &file, context);
+	if (error) {
+		goto out;
+	}
+	snprintf((char *)content, 256, "THOR WITNESS V235 panic record slot %u; a record starts with %s\n",
+	    index, THOR_WITNESS_RECORD_MAGIC);
+	/* Every 4 KiB block carries its own mark (slot, block, a per-boot nonce), so that a block
+	 * map that points anywhere else is caught by the comparison below. */
+	read_frandom(&nonce, sizeof nonce);
+	for (n = 0; n < THOR_WITNESS_SLOT_BLOCKS; n++) {
+		uint8_t *mark = content + (size_t)n * 4096 + THOR_WITNESS_SLOT_MARK;
+		memcpy(mark, "THORSLOT", 8);
+		thor_witness_slot_put(mark + 8, index);
+		thor_witness_slot_put(mark + 12, n);
+		memcpy(mark + 16, &nonce, sizeof nonce);
+	}
+	error = thor_witness_slot_io(UIO_WRITE, file, content, THOR_WITNESS_SLOT_BYTES, 0, context);
+	/* The size and the allocation must be on disk before any panic can trust the block map. */
+	for (n = 0; !error && n < 2; n++) {
+		error = VNOP_FSYNC(file, MNT_WAIT, context);
+	}
+	if (error) {
+		goto out;
+	}
+	/* 2. the block numbers of every block, as the file system reports them */
+	unit = vfs_devblocksize(vnode_mount(file));
+	for (b = 0; b < THOR_WITNESS_SLOT_BLOCKS && !error; b += n) {
+		n = 0;
+		error = VNOP_BLOCKMAP(file, (off_t)(b * 4096), THOR_WITNESS_SLOT_BYTES - b * 4096, &bn, &run, NULL, 0, context);
+		for (n = 0; !error && n * 4096 < run && b + n < THOR_WITNESS_SLOT_BLOCKS; n++) {
+			thor_witness_slot_block[b + n] = (uint64_t)bn + (uint64_t)n;
+		}
+		if (!error && (n == 0 || bn == -1)) {
+			error = bn == -1 ? ENXIO : EIO;
+		}
+	}
+	if (error || b < THOR_WITNESS_SLOT_BLOCKS) {
+		error = error ? error : EIO;
+		goto out;
+	}
+	/* 3. candidates for the first byte, in the UFS LUN, that the block numbers count from */
+	VATTR_INIT(&attributes);
+	VATTR_WANTED(&attributes, va_rdev);
+	error = vnode_getattr(vfs_devvp(vnode_mount(file)), &attributes, context);
+	if (error || !VATTR_IS_SUPPORTED(&attributes, va_rdev)) {
+		error = error ? error : ENODEV;
+		goto out;
+	}
+	device = attributes.va_rdev;
+	memset(&place, 0, sizeof place);
+	if (!thor_ufs_container_of_bsd(major(device), minor(device), &place) || !place.window_base ||
+	    place.window_bytes < THOR_WITNESS_SLOT_BYTES) {
+		error = ENODEV;
+		printf("THOR WITNESS V235: panic record slot %u: device %d,%d is not backed by a storage window\n",
+		    index, major(device), minor(device));
+		goto out;
+	}
+	printf("THOR WITNESS V235: panic record slot %u: block numbers %llx..%llx, unit %d, device %d,%d, "
+	    "window %#llx + %#llx, media below the device start %#llx into it, own base %#llx\n",
+	    index, (unsigned long long)(thor_witness_slot_block[0]), (unsigned long long)(thor_witness_slot_block[THOR_WITNESS_SLOT_BLOCKS - 1]), unit,
+	    major(device), minor(device), (unsigned long long)(place.window_base), (unsigned long long)(place.window_bytes), (unsigned long long)(place.stack_offset), (unsigned long long)(place.own_base));
+	norigins = 0;
+	origins[norigins++] = place.window_base + place.stack_offset;              /* the device stack */
+	if (place.own_base) {
+		origins[norigins++] = place.window_base + place.stack_offset + place.own_base;
+	}
+	if (place.stack_offset) {
+		origins[norigins++] = place.window_base;                               /* what v234 used */
+	}
+	nscales = 0;
+	scales[nscales++] = (uint64_t)unit;
+	if (unit != 4096) {
+		scales[nscales++] = 4096;
+	}
+	if (unit != 512) {
+		scales[nscales++] = 512;
+	}
+	/* 4. prove the mapping: the first origin and scale under which every block read through the
+	 * raw channel equals what the file holds */
+	error = ENOENT;
+	for (n = 0; n < norigins && error; n++) {
+		unsigned s;
+		for (s = 0; s < nscales && error; s++) {
+			if (!thor_witness_slot_locate(origins[n], scales[s])) {
+				continue;
+			}
+			error = thor_witness_slot_proof(content, block, &which, &saw);
+			if (error) {
+				printf("THOR WITNESS V235: panic record slot %u: origin %#llx, %llu bytes per block: "
+				    "block %u (number %llx, LUN byte %#llx) differs: %s, the medium holds %016llx "
+				    "where the file holds %016llx\n",
+				    index, (unsigned long long)(origins[n]), (unsigned long long)(scales[s]), which, (unsigned long long)(thor_witness_slot_block[which]),
+				    (unsigned long long)(thor_witness_slot_where[which]), error == EIO ? "other data" : "read error", (unsigned long long)(saw),
+				    (unsigned long long)(thor_witness_slot_word(content + (size_t)which * 4096)));
+			} else {
+				printf("THOR WITNESS V235: panic record slot %u: origin %#llx, %llu bytes per block: "
+				    "every block matches\n", index, (unsigned long long)(origins[n]), (unsigned long long)(scales[s]));
+			}
+		}
+	}
+	if (error) {
+		/* 4b. nothing computed matched: look for the blocks themselves */
+		memset(thor_witness_slot_where, 0, sizeof thor_witness_slot_where);
+		error = thor_witness_slot_scan(&place, content, index, &found);
+		printf("THOR WITNESS V235: panic record slot %u: the window was searched for the blocks: "
+		    "%u of %u found (error %d)\n", index, found, THOR_WITNESS_SLOT_BLOCKS, error);
+	}
+	if (error) {
+		goto out;
+	}
+	/* 5. the write path: one byte of the last block is changed on the medium, read back through
+	 * the raw channel and restored.  The file's cached pages never see this. */
+	last = THOR_WITNESS_SLOT_BLOCKS - 1;
+	memcpy(block, content + (size_t)last * 4096, 4096);
+	block[4095] ^= 0xa5;
+	error = thor_ufs_raw_write(thor_witness_slot_where[last], block, 1, 0);
+	if (!error) {
+		memset(block, 0, 4096);
+		error = thor_ufs_raw_read(thor_witness_slot_where[last], block, 1);
+		if (!error && memcmp(block, content + (size_t)last * 4096, 4095)) {
+			error = EIO;
+		}
+		if (!error && block[4095] != (content[(size_t)last * 4096 + 4095] ^ 0xa5)) {
+			error = EIO;
+		}
+		/* Whatever the outcome, the medium gets the file's content back. */
+		memcpy(block, content + (size_t)last * 4096, 4096);
+		if (thor_ufs_raw_write(thor_witness_slot_where[last], block, 1, 0) && !error) {
+			error = EIO;
+		}
+	}
+	if (error) {
+		printf("THOR WITNESS V235: panic record slot %u: the raw write did not read back (error %d)\n",
+		    index, error);
+		goto out;
+	}
+	strlcpy(thor_witness_slot_path, path, sizeof thor_witness_slot_path);
+	thor_witness_slot_state = 1;
+	error = 0;
+	printf("THOR WITNESS V235: panic record slot %s proven: %u blocks, LUN bytes %#llx..%#llx, "
+	    "write-read-restore done\n", path, THOR_WITNESS_SLOT_BLOCKS, (unsigned long long)(thor_witness_slot_where[0]),
+	    (unsigned long long)(thor_witness_slot_where[THOR_WITNESS_SLOT_BLOCKS - 1]));
+
+out:
+	if (thor_witness_slot_state != 1) {
+		printf("THOR WITNESS V235: no panic record slot (error %d): a panic will only be shown on the panel\n",
+		    error);
+	}
+	if (file != NULLVP) {
+		(void)vnode_close(file, FREAD | FWRITE, context);
+	}
+	if (content) {
+		kfree_data(content, THOR_WITNESS_SLOT_BYTES);
+	}
+	if (block) {
+		kfree_data(block, 4096);
+	}
+}
+
+int thor_witness_slot_store(const void *stock, unsigned stock_bytes, const void *extra, unsigned extra_bytes);
+
+/* Called from the panic path: interrupts are masked and every other CPU is halted, so nothing
+ * is allocated or locked here; the image is built in static memory and written block by block. */
+int
+thor_witness_slot_store(const void *stock, unsigned stock_bytes, const void *extra, unsigned extra_bytes)
+{
+	unsigned b, written = 0;
+	uint64_t now;
+	int error = 0;
+	if (thor_witness_slot_state != 1) {
+		return -1;
+	}
+	if (stock_bytes > THOR_WITNESS_SLOT_BYTES / 2 - 64) {
+		stock_bytes = THOR_WITNESS_SLOT_BYTES / 2 - 64;
+	}
+	if (extra_bytes > THOR_WITNESS_SLOT_BYTES - 64 - stock_bytes) {
+		extra_bytes = THOR_WITNESS_SLOT_BYTES - 64 - stock_bytes;
+	}
+	memset(thor_witness_slot_image, 0, THOR_WITNESS_SLOT_BYTES);
+	memcpy(thor_witness_slot_image, THOR_WITNESS_RECORD_MAGIC, 8);
+	thor_witness_slot_put(thor_witness_slot_image + 8, 64 + stock_bytes + extra_bytes);   /* record bytes */
+	thor_witness_slot_put(thor_witness_slot_image + 12, stock_bytes);
+	now = mach_absolute_time();
+	memcpy(thor_witness_slot_image + 16, &now, sizeof now);
+	thor_witness_slot_put(thor_witness_slot_image + 24, extra_bytes);
+	thor_witness_slot_put(thor_witness_slot_image + 28, 1);                               /* layout version */
+	memcpy(thor_witness_slot_image + 64, stock, stock_bytes);
+	memcpy(thor_witness_slot_image + 64 + stock_bytes, extra, extra_bytes);
+	for (b = 0; b < THOR_WITNESS_SLOT_BLOCKS; b++) {
+		error = thor_ufs_raw_write(thor_witness_slot_where[b],
+		    thor_witness_slot_image + (size_t)b * 4096, 1, 1);
+		if (error) {
+			break;
+		}
+		written++;
+	}
+	return written ? (int)written : -((error ? error : EIO) & 0x7fff);
+}
+
+static int
+thor_witness_write(vnode_t file, vfs_context_t context, const void *data, size_t length, uint64_t *offset)
+{
+	int residual = 0;
+	const int error = vn_rdwr(UIO_WRITE, file, (caddr_t)data, (int)length, (off_t)*offset, UIO_SYSSPACE,
+	    IO_UNIT, vfs_context_ucred(context), &residual, PROC_NULL);
+	if (!error) {
+		if (residual) {
+			return EIO;
+		}
+		*offset += length;
+		thor_witness_writer_file = *offset;
+	}
+	return error;
+}
+
+static void __attribute__((noreturn))
+thor_witness_mirror(void *parameter __unused, wait_result_t result __unused)
+{
+	static char chunk[THOR_WITNESS_MIRROR_CHUNK];
+	static char report[THOR_WITNESS_MIRROR_REPORT];
+	const vfs_context_t context = vfs_context_kernel();
+	vnode_t file = NULLVP;
+	uint64_t cursor = 0, offset = 0, retry = 0, deadline, quiet = 0;
+	unsigned seen = 0, failures = 0, lines = 0;
+	bool written, slot_prepared = false;
+	for (;;) {
+		const uint64_t now = mach_absolute_time();
+		uint64_t nanos = 0;
+		int error = 0;
+		written = false;
+		absolutetime_to_nanoseconds(now, &nanos);
+		thor_witness_writer_abs = now;
+		/* One file per boot: a new boot starts it again. */
+		if (file == NULLVP && nanos >= retry) {
+			error = vnode_open(THOR_WITNESS_MIRROR_PATH, O_CREAT | O_WRONLY | O_TRUNC, 0600,
+			    VNODE_LOOKUP_NOFOLLOW_ANY, &file, context);
+			if (error) {
+				file = NULLVP;
+				retry = nanos + 2000000000ull;
+				failures++;
+				if (failures == 20 || failures == 600) {
+					printf("THOR WITNESS V235: cannot open %s (error %d)\n", THOR_WITNESS_MIRROR_PATH, error);
+				}
+			}
+		}
+		if (file != NULLVP) {
+			if (offset < THOR_WITNESS_MIRROR_LIMIT) {
+				const size_t count = thor_witness_console_copy(chunk, sizeof chunk, &cursor);
+				if (count == (size_t)-1) {
+					error = EBUSY;          /* the console lock is taken right now: try again next pass */
+				} else if (count) {
+					error = thor_witness_write(file, context, chunk, count, &offset);
+					written = !error;
+				}
+			}
+			if (!error && &thor_witness_report_fetch) {
+				const size_t length = thor_witness_report_fetch(report, sizeof report, &seen, &lines);
+				if (length) {
+					char header[160];
+					const int n = snprintf(header, sizeof header,
+					    "\n===== THOR WITNESS V233 REPORT %u (%u lines) =====\n", seen, lines);
+					error = thor_witness_write(file, context, header, (size_t)n, &offset);
+					if (!error) {
+						error = thor_witness_write(file, context, report, length, &offset);
+						written = !error;
+					}
+				}
+			}
+			if (error == EBUSY) {
+				error = 0;
+			} else if (error) {
+				/* Leave the file alone for a while; a later pass starts it again from the oldest
+				 * console byte that is still buffered. */
+				(void)vnode_close(file, FWRITE, context);
+				file = NULLVP;
+				cursor = offset = thor_witness_writer_file = 0;
+				retry = nanos + 2000000000ull;
+				failures++;
+				if (failures == 20 || failures == 600) {
+					printf("THOR WITNESS V235: writing %s failed (error %d)\n", THOR_WITNESS_MIRROR_PATH, error);
+				}
+			} else if (written) {
+				/* What was written reaches the storage now; a forced reboot keeps it. */
+				error = VNOP_FSYNC(file, MNT_WAIT, context);
+				if (!quiet) {
+					quiet = 1;
+					printf("THOR WITNESS V235: console mirror %s open\n", THOR_WITNESS_MIRROR_PATH);
+				}
+			}
+			if (!slot_prepared) {
+				/* Once the storage answers: reserve and prove the panic record slot. */
+				slot_prepared = true;
+				thor_witness_slot_prepare(context);
+			}
+		}
+		clock_interval_to_deadline(250, NSEC_PER_MSEC, &deadline);
+		assert_wait_deadline((event_t)thor_witness_mirror, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
