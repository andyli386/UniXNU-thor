+	    "skipped (installer or service directories unavailable)"));
+#endif
+	__atomic_store_n(&thor_ui_runtime_ready, 1, __ATOMIC_RELEASE);
+	printf("THOR UI runtime: PASS path=%s bytes=%zu\n",
+	    new_path, sizeof(thor_ui_runtime_payload));
+}
+#endif
