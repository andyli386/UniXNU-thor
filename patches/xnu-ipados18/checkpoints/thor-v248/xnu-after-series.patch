+void
+thor_witness_start(void)
+{
+	thread_t thread = THREAD_NULL;
+	if (__atomic_fetch_or(&thor_witness_start_state, 1u, __ATOMIC_ACQ_REL) & 1u) {
+		return;
+	}
+	if (kernel_thread_start_priority(thor_witness_monitor, NULL, MAXPRI_KERNEL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	thor_witness_symbols_load();
+	if (&native_gpu_trace_arm) {
+		native_gpu_trace_arm();          /* the GPU driver's ring, read into the panic record */
+	}
+	printf("THOR WITNESS V235: monitor started, %u functions, %u symbols%s\n",
+	    thor_witness_function_count, thor_witness_symbol_count,
+	    thor_witness_symbol_count ? "" : " (no kernel symbol index)");
+	/* One line names what this image changes, so the console shows which one runs. */
+	printf("THOR WITNESS V243: the primary partition table of the firmware LUN decides (the bootloader "
+	    "rewrites it on every normal boot of a slot that is not marked successful and the backup lags behind; "
+	    "v239 to v242 lost Wi-Fi, the modem and the battery to that in every boot from flash while the same "
+	    "v242 image passed when temporary-booted); the wallpaper library gives WallpaperKit the iPad catalog "
+	    "names through its own lower-casing call (the MobileGestalt interception could not reach a call that "
+	    "the shared cache fixed, and chronod and PosterBoard no longer get the library); carried: the retries "
+	    "and the record of a failed check (v242), the interface-namer marker, the en0 listing, the panic "
+	    "record slot (v238), data volume classes A and B open for every process, the modem server's "
+	    "shared-memory host id (v237)\n");
+	printf("THOR WITNESS V248: the first page of a panic names the fault (pc, lr, sp, fp with their symbols, esr, far), the "
+	    "thread and the callers of panic, drawn in the panic hook before the kernel's own panic path (v247: only the unformatted "
+	    "panic string was shown, and the panic of 2026-11-28 stopped before the panic log); the camera inventory is off, /chosen has "
+	    "no thor-camera (v247 panicked 43.6 s after boot, when its inventory was due); carried: every death by a signal prints one "
+	    "line (PONG DEATH), the log capture library v247, the display library that answers the panel's size also for a display with "
+	    "no size of its own, the UI adapter in PosterBoard, the Wi-Fi station's retries, everything of v247 to v239, the v236 GPU "
+	    "timing hook, the v235 witness\n");
+}
+
+/* ======================= symbols ======================= */
+
+static int
+thor_witness_symbol_order(const void *a, const void *b)
+{
+	const uint64_t x = ((const struct thor_witness_symbol *)a)->address, y = ((const struct thor_witness_symbol *)b)->address;
+	return x < y ? -1 : x > y;
+}
+
+/* The stripped image that boots keeps LC_SYMTAB in __LINKEDIT.  Index every named symbol by address. */
+static void
+thor_witness_symbols_load(void)
+{
+	const struct mach_header_64 *header = (const struct mach_header_64 *)&_mh_execute_header;
+	const struct load_command *command = (const struct load_command *)(const void *)(header + 1);
+	const struct segment_command_64 *linkedit = NULL;
+	const struct symtab_command *symtab = NULL;
+	const struct nlist_64 *entries;
+	const char *strings;
+	struct thor_witness_symbol *table;
+	uint64_t delta;
+	uint32_t i;
+	if (header->magic != MH_MAGIC_64) {
+		return;
+	}
+	for (i = 0; i < header->ncmds; i++, command = (const struct load_command *)(const void *)((const char *)command + command->cmdsize)) {
+		if (command->cmd == LC_SEGMENT_64 && !strncmp(((const struct segment_command_64 *)(const void *)command)->segname, SEG_LINKEDIT, 16)) {
+			linkedit = (const struct segment_command_64 *)(const void *)command;
+		} else if (command->cmd == LC_SYMTAB) {
+			symtab = (const struct symtab_command *)(const void *)command;
+		}
+	}
+	if (!linkedit) {
+		return;
+	}
+	delta = linkedit->vmaddr - linkedit->fileoff;
+	/* Function starts: ULEB128 distances from the first byte of __TEXT. */
+	command = (const struct load_command *)(const void *)(header + 1);
+	for (i = 0; i < header->ncmds && !thor_witness_function_count; i++, command = (const struct load_command *)(const void *)((const char *)command + command->cmdsize)) {
+		if (command->cmd != LC_FUNCTION_STARTS) {
+			continue;
+		}
+		{
+			const struct linkedit_data_command *starts = (const struct linkedit_data_command *)(const void *)command;
+			const uint8_t *at = (const uint8_t *)(uintptr_t)(starts->dataoff + delta), *end = at + starts->datasize;
+			uint64_t address = (uint64_t)(const void *)header;   /* the distances count from the first byte of __TEXT */
+			while (at < end && *at && thor_witness_function_count < THOR_WITNESS_FUNCTIONS_MAX) {
+				uint64_t value = 0;
+				unsigned shift = 0, done;
+				do {
+					const uint8_t byte = *at++;
+					value |= (uint64_t)(byte & 0x7f) << shift;
+					shift += 7;
+					done = !(byte & 0x80);
+				} while (!done);
+				address += value;
+				thor_witness_function_start[thor_witness_function_count++] = address;
+			}
+		}
+	}
+	if (!symtab || !symtab->nsyms) {
+		return;
+	}
+	entries = (const struct nlist_64 *)(uintptr_t)(symtab->symoff + delta);
+	strings = (const char *)(uintptr_t)(symtab->stroff + delta);
+	if (!kvtophys((vm_offset_t)entries) || !kvtophys((vm_offset_t)strings)) {
+		printf("THOR WITNESS V235: the kernel symbol table is not mapped\n");
+		return;
+	}
+	table = kalloc_data(THOR_WITNESS_SYMBOLS_MAX * sizeof *table, Z_WAITOK | Z_ZERO);
+	if (!table) {
+		return;
+	}
+	for (i = 0; i < symtab->nsyms && thor_witness_symbol_count < THOR_WITNESS_SYMBOLS_MAX; i++) {
+		const struct nlist_64 *entry = &entries[i];
+		const uint8_t kind = entry->n_type & N_TYPE;
+		if ((kind != N_SECT && kind != N_ABS) || !entry->n_value || !entry->n_un.n_strx ||
+		    entry->n_un.n_strx >= symtab->strsize) {
+			continue;
+		}
+		table[thor_witness_symbol_count].address = entry->n_value;
+		table[thor_witness_symbol_count].name = strings + entry->n_un.n_strx;
+		thor_witness_symbol_count++;
+	}
+	qsort(table, thor_witness_symbol_count, sizeof *table, thor_witness_symbol_order);
+	thor_witness_symbols = table;
+}
+
+/* The first byte of the function that contains `address` (0 when unknown), and the distance. */
+static uint64_t
+thor_witness_function(uint64_t address, uint64_t *offset)
+{
+	size_t low = 0, high = thor_witness_function_count;
+	while (low < high) {                    /* after the loop `low` is the first start above `address` */
+		const size_t middle = low + (high - low) / 2;
+		if (thor_witness_function_start[middle] <= address) {
+			low = middle + 1;
+		} else {
+			high = middle;
+		}
+	}
+	if (!low) {
+		return 0;
+	}
+	*offset = address - thor_witness_function_start[low - 1];
+	return thor_witness_function_start[low - 1];
+}
+
+/* The name of the symbol that sits exactly at `start`; NULL when it has none. */
+static const char *
+thor_witness_symbol_at(uint64_t start)
+{
+	size_t low = 0, high = thor_witness_symbol_count;
+	while (low < high) {
+		const size_t middle = low + (high - low) / 2;
+		if (thor_witness_symbols[middle].address < start) {
+			low = middle + 1;
+		} else {
+			high = middle;
+		}
+	}
+	if (low < thor_witness_symbol_count && thor_witness_symbols[low].address == start) {
+		return thor_witness_symbols[low].name;
+	}
+	return NULL;
+}
+
+/* "name+0x278" for an address inside a function whose first byte has a symbol, otherwise
+ * "sub_<function start>+0x278".  Without the function table it falls back to the nearest symbol. */
+static void
+thor_witness_describe(uint64_t address, char *out, size_t capacity)
+{
+	uint64_t offset = 0;
+	const char *name = NULL;
+	if (address < vm_kernel_stext || address >= vm_kernel_etext) {
+		snprintf(out, capacity, "%llx (outside the kernel text %llx..%llx)", (unsigned long long)address,
+		    (unsigned long long)vm_kernel_stext, (unsigned long long)vm_kernel_etext);
+		return;
+	}
+	if (thor_witness_function_count) {
+		const uint64_t start = thor_witness_function(address, &offset);
+		if (!start) {
+			snprintf(out, capacity, "%llx (before the first function)", (unsigned long long)address);
+			return;
+		}
+		name = thor_witness_symbol_at(start);
+		if (name) {
+			snprintf(out, capacity, "%s+%llx", name, (unsigned long long)offset);
+		} else {
+			snprintf(out, capacity, "sub_%llx+%llx", (unsigned long long)start, (unsigned long long)offset);
+		}
+	} else if (thor_witness_symbols) {
+		size_t low = 0, high = thor_witness_symbol_count;
+		while (low < high) {
+			const size_t middle = low + (high - low) / 2;
+			if (thor_witness_symbols[middle].address <= address) {
+				low = middle + 1;
+			} else {
+				high = middle;
+			}
+		}
+		if (low) {
+			snprintf(out, capacity, "%s?+%llx", thor_witness_symbols[low - 1].name,
+			    (unsigned long long)(address - thor_witness_symbols[low - 1].address));
+			return;
+		}
+		snprintf(out, capacity, "%llx (no symbol)", (unsigned long long)address);
+		return;
+	} else {
+		snprintf(out, capacity, "%llx (no symbol index)", (unsigned long long)address);
+	}
+}
+
+/* ======================= panic extras ======================= */
+
+static void
+thor_witness_extra_line(const char *format, ...) __printflike(1, 2);
+
+static void
+thor_witness_extra_line(const char *format, ...)
+{
+	va_list args;
+	size_t room = sizeof(thor_witness_extra) - thor_witness_extra_length;
+	int n;
+	if (room < THOR_WITNESS_LINE) {
+		return;
+	}
+	va_start(args, format);
+	n = vsnprintf(thor_witness_extra + thor_witness_extra_length, room, format, args);
+	va_end(args);
+	if (n > 0) {
+		thor_witness_extra_length += (size_t)n < room ? (size_t)n : room - 1;
+	}
+}
+
+/* Copy from any kernel address without taking a fault: returns false when it is not translated. */
+static bool
+thor_witness_fetch(void *out, uint64_t address, size_t bytes)
+{
+	return ml_nofault_copy((vm_offset_t)address, (vm_offset_t)out, bytes) == bytes;
+}
+
+static void
+thor_witness_extra_symbol(const char *label, uint64_t address)
+{
+	char text[160];
+	thor_witness_describe(address, text, sizeof text);
+	thor_witness_extra_line(" %s=%llx %s\n", label, address, text);
+}
+
+/* Sixteen bytes per line around an address that is translated; nothing when it is not. */
+static void
+thor_witness_extra_bytes(const char *label, uint64_t address)
+{
+	uint8_t bytes[128];
+	unsigned i;
+	if ((address & 3) || !thor_witness_fetch(bytes, address, sizeof bytes)) {
+		thor_witness_extra_line(" %s: %#llx is not readable\n", label, address);
+		return;
+	}
+	for (i = 0; i < sizeof bytes; i += 16) {
+		unsigned j;
+		thor_witness_extra_line(" %s %#llx:", i ? "" : label, address + i);
+		for (j = 0; j < 16; j++) {
+			thor_witness_extra_line(" %02x", bytes[i + j]);
+		}
+		thor_witness_extra_line("\n");
+	}
+}
+
+/* Return addresses on the frame-pointer chain that starts at frame record `fp`: each record holds
+ * the caller's frame pointer and the return address into that caller.  The chain has to stay
+ * inside [low, top) and to climb; the walk stops at the first record that does not.  No fault is
+ * taken, so this runs both while the system is up and in the panic path. */
+static unsigned
+thor_witness_chain(uint64_t low, uint64_t top, uint64_t fp, uint64_t *frames, unsigned capacity)
+{
+	uint64_t record[2];
+	unsigned count = 0;
+	while (count < capacity && !(fp & 15) && fp >= low && fp + sizeof record <= top &&
+	    thor_witness_fetch(record, fp, sizeof record)) {
+		frames[count++] = record[1];
+		if (record[0] < fp + sizeof record || record[0] + sizeof record > top) {
+			break;
+		}
+		fp = record[0];
+	}
+	return count;
+}
+
+/* Called by sleh.c with the kernel state of the first exception that ends in a panic. */
+void
+thor_witness_fault_state(const void *state)
+{
+	const arm_saved_state_t *saved = state;
+	if (saved && !thor_witness_fault_pc) {
+		thor_witness_fault_pc = saved->ss_64.pc;
+		thor_witness_fault_lr = saved->ss_64.lr;
+		thor_witness_fault_sp = saved->ss_64.sp;
+		thor_witness_fault_fp = saved->ss_64.fp;
+		thor_witness_fault_esr = saved->ss_64.esr;
+		thor_witness_fault_far = saved->ss_64.far;
+		thor_witness_fault_cpsr = saved->ss_64.cpsr;
+	}
+}
+
+/* Text only the panicking kernel can give.  Interrupts are masked and the other CPUs are
+ * halted: no lock, no allocation, no fault is taken here. */
+static void
+thor_witness_panic_extras(void)
+{
+	const thread_t thread = current_thread();
+	const task_t task = get_threadtask(thread);
+	const arm_saved_state_t *user = thread->machine.upcb;
+	const uint64_t low = (uint64_t)thread->kernel_stack;
+	const uint64_t top = low ? low + kernel_stack_size : 0;
+	char name[THOR_WITNESS_NAMELEN] = { 0 };
+	const uint64_t pc = thor_witness_fault_pc, lr = thor_witness_fault_lr;
+	uint64_t word;
+	unsigned i, c, lines = 0;
+	thor_witness_extra_length = 0;
+	thor_witness_extra_line("THOR WITNESS V235 PANIC EXTRAS (kernel time %llu us)\n",
+	    (unsigned long long)thor_witness_micros(mach_absolute_time()));
+	if (task) {
+		task_procname(task, name, (int)sizeof name);
+		name[sizeof name - 1] = 0;
+	}
+	thor_witness_extra_line(" thread %p tid %llu of pid %d %s; kernel stack %llx..%llx\n", thread,
+	    (unsigned long long)thread_tid(thread), task ? task_pid(task) : -1, name, low, top);
+	if (pc) {
+		thor_witness_extra_line(" fault: pc=%llx lr=%llx sp=%llx fp=%llx\n", pc, lr,
+		    thor_witness_fault_sp, thor_witness_fault_fp);
+		thor_witness_extra_line(" fault: pc translated=%d (pa %llx), lr translated=%d (pa %llx)\n",
+		    kvtophys((vm_offset_t)pc) != 0, (unsigned long long)kvtophys((vm_offset_t)pc),
+		    kvtophys((vm_offset_t)lr) != 0, (unsigned long long)kvtophys((vm_offset_t)lr));
+		thor_witness_extra_symbol("pc symbol", pc);
+		thor_witness_extra_symbol("lr symbol", lr);
+		/* What ran just before the fault: the words around the return address and at the fault. */
+		thor_witness_extra_bytes("bytes at lr-0x40", (lr - 0x40) & ~0xfULL);
+		thor_witness_extra_bytes("bytes at pc-0x40", (pc - 0x40) & ~0xfULL);
+		/* v235: who leads to the fault.  The frame record of the faulting code (or, for a leaf
+		 * without one, of its caller) starts the chain. */
+		thor_witness_fault_chain_count = top && thor_witness_fault_fp >= low &&
+		    thor_witness_fault_fp < top ? thor_witness_chain(low, top, thor_witness_fault_fp,
+		    thor_witness_fault_chain, THOR_WITNESS_CHAIN_MAX) : 0;
+		thor_witness_extra_line(" frame records from the fault, newest first (%u):\n",
+		    thor_witness_fault_chain_count);
+		for (c = 0; c < thor_witness_fault_chain_count; c++) {
+			char text[160];
+			thor_witness_describe(thor_witness_fault_chain[c], text, sizeof text);
+			thor_witness_extra_line("  fault caller %u: %llx %s\n", c, thor_witness_fault_chain[c], text);
+		}
+	}
+	/* v235: who called panic().  The chain was read while the panic was announced (PE_panic_hook). */
+	thor_witness_extra_line(" frame records at the panic call, newest first (%u):\n",
+	    thor_witness_panic_chain_count);
+	for (c = 0; c < thor_witness_panic_chain_count; c++) {
+		char text[160];
+		thor_witness_describe(thor_witness_panic_chain[c], text, sizeof text);
+		thor_witness_extra_line("  panic caller %u: %llx %s\n", c, thor_witness_panic_chain[c], text);
+	}
+	if (user) {
+		thor_witness_extra_line(" user: pc=%llx lr=%llx sp=%llx fp=%llx x0=%llx x1=%llx x2=%llx x3=%llx x16=%llx\n",
+		    user->ss_64.pc, user->ss_64.lr, user->ss_64.sp, user->ss_64.fp, user->ss_64.x[0],
+		    user->ss_64.x[1], user->ss_64.x[2], user->ss_64.x[3], user->ss_64.x[16]);
+	}
+	/* Every kernel-text word left on this thread's kernel stack, newest first; one that is on one
+	 * of the two chains above is marked.  The frame-pointer chain of the panic log is not reliable
+	 * once the thread ran off into foreign memory. */
+	thor_witness_extra_line(" kernel-text words on the stack (offset: address symbol; * on a chain)\n");
+	if (low) {
+		for (i = (unsigned)kernel_stack_size; i >= 8 && lines < THOR_WITNESS_STACK_LINES; i -= 8) {
+			char text[160];
+			int on_chain = 0;
+			if (!thor_witness_fetch(&word, low + i - 8, sizeof word)) {
+				continue;
+			}
+			if (word < vm_kernel_stext || word >= vm_kernel_etext) {
+				continue;
+			}
+			for (c = 0; c < thor_witness_fault_chain_count && !on_chain; c++) {
+				on_chain = thor_witness_fault_chain[c] == word;
+			}
+			for (c = 0; c < thor_witness_panic_chain_count && !on_chain; c++) {
+				on_chain = thor_witness_panic_chain[c] == word;
+			}
+			thor_witness_describe(word, text, sizeof text);
+			thor_witness_extra_line(" %s+%#06x: %llx %s\n", on_chain ? "*" : " ", i - 8, word, text);
+			lines++;
+		}
+	}
+	/* The GPU driver's trace ring: submits, retires, imports and surface events before the fault. */
+	if (&native_gpu_trace_snapshot) {
+		/* One buffer: the driver writes the records straight after the header.  (Two separate
+		 * static objects made it run past the header and the records read back as zeros.) */
+		static struct {
+			uint32_t magic, version, record_bytes, count;
+			uint64_t issued, dropped;
+			struct {
+				uint64_t sequence, us;
+				uint32_t event, pid;
+				uint64_t value[12];
+			} records[THOR_WITNESS_TRACE_RECORDS];
+		} trace;
+		const uint32_t bytes = native_gpu_trace_snapshot(&trace, sizeof trace);
+		unsigned first;
+		if (bytes < sizeof(trace) - sizeof trace.records || trace.record_bytes != sizeof trace.records[0]) {
+			thor_witness_extra_line(" gpu trace: unavailable (error %x)\n", bytes);
+		} else {
+			thor_witness_extra_line(" gpu trace: issued %llu, dropped %llu, last %u records\n",
+			    (unsigned long long)trace.issued, (unsigned long long)trace.dropped, trace.count);
+			/* The snapshot lists the oldest kept record first; show the newest, within the line budget. */
+			first = trace.count > 72 ? trace.count - 72 : 0;
+			for (i = first; i < trace.count && thor_witness_extra_length + 400 < sizeof thor_witness_extra; i++) {
+				thor_witness_extra_line("  gpu %llu us=%llu event=%u pid=%u %llx %llx %llx %llx %llx %llx\n",
+				    (unsigned long long)trace.records[i].sequence, (unsigned long long)trace.records[i].us,
+				    trace.records[i].event, trace.records[i].pid, (unsigned long long)trace.records[i].value[0],
+				    (unsigned long long)trace.records[i].value[1], (unsigned long long)trace.records[i].value[2],
+				    (unsigned long long)trace.records[i].value[3], (unsigned long long)trace.records[i].value[4],
+				    (unsigned long long)trace.records[i].value[5]);
+			}
+		}
+	}
+	thor_witness_extra[thor_witness_extra_length] = 0;
+}
+
+/* For the console mirror (kern_exec.c): the newest report when `*seen` is older; 0 otherwise. */
+size_t
+thor_witness_report_fetch(char *out, size_t capacity, unsigned *seen, unsigned *lines)
+{
+	const unsigned number = thor_witness_report_number;
+	size_t length;
+	if (number == *seen || !capacity) {
+		return 0;
+	}
+	length = thor_witness_report_length < capacity ? thor_witness_report_length : capacity - 1;
+	memcpy(out, thor_witness_report, length);
+	out[length] = 0;
+	*seen = number;
+	*lines = thor_witness_report_lines;
+	return length;
+}
+
+#define THOR_WITNESS_NOTE_BYTES   4096u
+
+/* One line into the panic note, within its room. */
+static size_t thor_witness_note_line(char *note, size_t length, const char *format, ...) __printflike(3, 4);
+
+static size_t
+thor_witness_note_line(char *note, size_t length, const char *format, ...)
+{
+	va_list args;
+	int n;
+	if (length + THOR_WITNESS_LINE > THOR_WITNESS_NOTE_BYTES) {
+		return length;
+	}
+	va_start(args, format);
+	n = vsnprintf(note + length, THOR_WITNESS_NOTE_BYTES - length, format, args);
+	va_end(args);
+	if (n > 0) {
+		const size_t room = THOR_WITNESS_NOTE_BYTES - length;
+		length += (size_t)n < room ? (size_t)n : room - 1;
+	}
+	return length;
+}
+
+/* Called from PE_panic_hook: the panic string is known, the log is not written yet.  This is the
+ * first code of ours that runs on the panicking thread's stack inside the panic, so the frame
+ * records from here lead straight to whoever called panic(); they are read now.
+ *
+ * v248: this page is the only one that is certain to be shown.  On 2026-11-28 (v247) the panic of
+ * 43.6 s stopped in the kernel's own panic path: the panic log never came, no record was stored,
+ * and the page held nothing but the unformatted panic string.  So the page now says what is known
+ * here: the faulting pc, lr, sp and fp with their symbols (sleh.c handed them over), esr and far,
+ * the thread, and the callers of panic.  No lock, no allocation, no I/O; the record is still left
+ * to panic_spin_forever, where the other CPUs are halted and the storage is not in use. */
+void
+thor_witness_panic_note(const char *str)
+{
+	static char note[THOR_WITNESS_NOTE_BYTES];
+	static char name[THOR_WITNESS_NAMELEN];
+	const thread_t thread = current_thread();
+	const task_t task = get_threadtask(thread);
+	const uint64_t low = (uint64_t)thread->kernel_stack;
+	size_t length = 0;
+	unsigned c, rows = 2;
+	if (!str) {
+		return;
+	}
+	if (low && !thor_witness_panic_chain_count) {
+		thor_witness_panic_chain_count = thor_witness_chain(low, low + kernel_stack_size,
+		    (uint64_t)__builtin_frame_address(0), thor_witness_panic_chain, THOR_WITNESS_CHAIN_MAX);
+	}
+	length = thor_witness_note_line(note, length, "THOR PANIC V248: at the panic hook (kernel time %llu us)\n",
+	    (unsigned long long)thor_witness_micros(mach_absolute_time()));
+	if (task) {
+		name[0] = 0;
+		task_procname(task, name, (int)sizeof name);
+		name[sizeof name - 1] = 0;
+	}
+	length = thor_witness_note_line(note, length, " thread %p of pid %d %s\n", thread,
+	    task ? task_pid(task) : -1, task ? name : "-");
+	if (thor_witness_fault_pc) {
+		char text[160], text2[160];
+		thor_witness_describe(thor_witness_fault_pc, text, sizeof text);
+		thor_witness_describe(thor_witness_fault_lr, text2, sizeof text2);
+		length = thor_witness_note_line(note, length, " fault pc=%llx %s\n",
+		    (unsigned long long)thor_witness_fault_pc, text);
+		length = thor_witness_note_line(note, length, "       lr=%llx %s\n",
+		    (unsigned long long)thor_witness_fault_lr, text2);
+		length = thor_witness_note_line(note, length, "       sp=%llx fp=%llx esr=%llx far=%llx\n",
+		    (unsigned long long)thor_witness_fault_sp, (unsigned long long)thor_witness_fault_fp,
+		    (unsigned long long)thor_witness_fault_esr, (unsigned long long)thor_witness_fault_far);
+	}
+	length = thor_witness_note_line(note, length, " callers of panic, newest first (%u):\n",
+	    thor_witness_panic_chain_count);
+	for (c = 0; c < thor_witness_panic_chain_count; c++) {
+		char text[160];
+		thor_witness_describe(thor_witness_panic_chain[c], text, sizeof text);
+		length = thor_witness_note_line(note, length, "  %u: %llx %s\n", c,
+		    (unsigned long long)thor_witness_panic_chain[c], text);
+	}
+	{
+		char line[THOR_WITNESS_LINE];
+		size_t i;
+		for (i = 0; i < sizeof line - 1 && str[i] && str[i] != '\n'; i++) {
+			line[i] = str[i] >= 32 && str[i] < 127 ? str[i] : '?';
+		}
+		line[i] = 0;
+		length = thor_witness_note_line(note, length, " panic string: %s\n", line);
+	}
+	note[length < THOR_WITNESS_NOTE_BYTES ? length : THOR_WITNESS_NOTE_BYTES - 1] = 0;
+	__atomic_store_n(&thor_witness_panic_noted, 1u, __ATOMIC_RELAXED);
+	{
+		uint32_t *base;
+		unsigned columns, panel_rows, rowpixels;
+		if (!thor_witness_panel(&base, &columns, &panel_rows, &rowpixels)) {
+			return;
+		}
+		rows = thor_witness_rows(note, length, columns - 2);
+	}
+	thor_witness_page("KERNEL PANIC", note, length, 0, rows, 0, 1);
+}
+
+/* Called from panic_spin_forever(): the panic log is complete.  Store it with the extras, then
+ * show it on the panel, page by page, until the phone is reset. */
+void
+thor_witness_panic_screen(void)
+{
+	const size_t length = debug_buf_base && debug_buf_ptr && debug_buf_ptr > debug_buf_base ?
+	    THOR_WITNESS_MIN((size_t)(debug_buf_ptr - debug_buf_base), (size_t)debug_buf_size) : 0;
+	const char text[] = "The panic log buffer is empty.";
+	const char *const stock = length ? debug_buf_base : text;
+	const size_t stock_length = length ? length : sizeof text - 1;
+	const uint64_t start = mach_absolute_time();
+	uint32_t *base;
+	unsigned columns, rows, rowpixels, pages, page;
+	thor_witness_panic_extras();
+	/* One document: the panic log, the outcome of the store, the extras. */
+	thor_witness_panic_doc_length = 0;
+	if (stock_length + thor_witness_extra_length + 96 < sizeof thor_witness_panic_doc) {
+		const int stored = thor_witness_slot_store(stock, (unsigned)stock_length, thor_witness_extra,
+		    (unsigned)thor_witness_extra_length);
+		memcpy(thor_witness_panic_doc, stock, stock_length);
+		thor_witness_panic_doc_length = stock_length;
+		thor_witness_panic_doc_length += (size_t)snprintf(thor_witness_panic_doc + thor_witness_panic_doc_length,
+		    sizeof thor_witness_panic_doc - thor_witness_panic_doc_length,
+		    "\n===== THOR WITNESS V235: panic record %s (blocks written: %d) =====\n",
+		    stored > 0 ? "STORED" : "NOT stored (no proven slot or the storage was busy)", stored);
+		memcpy(thor_witness_panic_doc + thor_witness_panic_doc_length, thor_witness_extra, thor_witness_extra_length);
+		thor_witness_panic_doc_length += thor_witness_extra_length;
+		thor_witness_panic_doc[thor_witness_panic_doc_length] = 0;
+	}
+	while (!thor_witness_panel(&base, &columns, &rows, &rowpixels)) {
+		__asm__ volatile("" ::: "memory");        /* no panel geometry: nothing can be shown, stay here */
+	}
+	pages = (thor_witness_rows(thor_witness_panic_doc, thor_witness_panic_doc_length, columns - 2) + rows - 5) / (rows - 4);
+	if (!pages) {
+		pages = 1;
+	}
+	for (page = 0;; page = (page + 1) % pages) {
+		thor_witness_page("KERNEL PANIC LOG", thor_witness_panic_doc, thor_witness_panic_doc_length,
+		    page * (rows - 4), rows - 4, page, pages);
+		for (;;) {
+			const uint64_t elapsed = thor_witness_micros(mach_absolute_time()) - thor_witness_micros(start);
+			if (elapsed >= (uint64_t)(page + 1) * THOR_WITNESS_PANIC_PAGE_US) {
+				break;
+			}
+			__asm__ volatile("" ::: "memory");
+		}
+	}
+}
