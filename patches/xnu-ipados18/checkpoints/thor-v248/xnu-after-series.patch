+/* Caller holds fSwapLock. Preserve the direct lookup for all retirements, including
+ * errors. Only extend history for IDs actually issued before the first wire wrap;
+ * across reuse the caller cannot express a generation in a new explicit query. */
+void IOMobileFramebuffer::recordRetired(uint64_t ticket, IOReturn result, bool archive)
+{
+    if (!ticket) return;
+    const uint32_t id = uint32_t(ticket);
+    fRetired[id % 64] = {ticket, result};
+    if (!archive || fSwapSequence > UINT32_MAX) return;
