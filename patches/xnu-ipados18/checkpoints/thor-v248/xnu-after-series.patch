+			    "intf=%u/%u te_frame=%u/%u te_line=%u/%u write_line=%u/%u\n",
+			    window, sample.swap, startNs / 1000, copyNs / 1000,
+			    sample.before.frame, sample.after.frame,
+			    sample.before.read >> 16, sample.after.read >> 16,
+			    sample.before.read & 0xffff, sample.after.read & 0xffff,
+			    sample.before.writeLine, sample.after.writeLine);
