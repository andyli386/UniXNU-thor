+/* ======================= panel text ======================= */
+
+#define THOR_WITNESS_CW (8u * THOR_WITNESS_SCALE)
+#define THOR_WITNESS_CH (16u * THOR_WITNESS_SCALE)
+#define THOR_WITNESS_WHITE 0xffffffffu
+#define THOR_WITNESS_BLACK 0xff000000u
+
+static bool
+thor_witness_panel(uint32_t **base, unsigned *columns, unsigned *rows, unsigned *rowpixels)
+{
+	const unsigned long address = vinfo.v_baseaddr;
+	if (!address || vinfo.v_depth != 32 || vinfo.v_width < 640 || vinfo.v_height < 640 ||
+	    vinfo.v_rowbytes < vinfo.v_width * 4 || (vinfo.v_rowbytes & 3)) {
+		return false;
+	}
+	*base = (uint32_t *)(uintptr_t)address;
+	*columns = (unsigned)vinfo.v_width / THOR_WITNESS_CW;
+	*rows = (unsigned)vinfo.v_height / THOR_WITNESS_CH;
+	*rowpixels = (unsigned)vinfo.v_rowbytes / 4;
+	return *columns >= 40 && *rows >= 10;
+}
+
+static void
+thor_witness_glyph(uint32_t *base, unsigned rowpixels, unsigned x, unsigned y, unsigned char ch,
+    uint32_t fore, uint32_t back)
+{
+	const unsigned char *bits = iso_font + (ch & 0xffu) * 16u;
+	unsigned r, s, c, t;
+	if (x + THOR_WITNESS_CW > vinfo.v_width || y + THOR_WITNESS_CH > vinfo.v_height) {
+		return;
+	}
+	for (r = 0; r < 16u; r++) {
+		const unsigned char row = bits[r];
+		uint32_t *line = base + (size_t)(y + r * THOR_WITNESS_SCALE) * rowpixels + x;
+		for (s = 0; s < THOR_WITNESS_SCALE; s++, line += rowpixels) {
+			for (c = 0; c < 8u; c++) {
+				const uint32_t value = (row >> c) & 1u ? fore : back;
+				for (t = 0; t < THOR_WITNESS_SCALE; t++) {
+					line[c * THOR_WITNESS_SCALE + t] = value;
+				}
+			}
+		}
+	}
+}
+
+/* One screen row starting at `column`: `length` characters, then padding up to `columns`. */
+static void
+thor_witness_row(uint32_t *base, unsigned rowpixels, unsigned column, unsigned row, unsigned columns,
+    const char *text, size_t length, uint32_t fore, uint32_t back)
+{
+	size_t i = 0;
+	while (column < columns) {
+		unsigned char ch = ' ';
+		if (i < length) {
+			ch = (unsigned char)text[i++];
+			if (ch < 0x20 || ch > 0x7e) {
+				ch = '?';
+			}
+		}
+		thor_witness_glyph(base, rowpixels, column * THOR_WITNESS_CW, row * THOR_WITNESS_CH, ch, fore, back);
+		column++;
+	}
+}
+
+/* Rows of `width` cells that `text` needs when wrapped. */
+static unsigned
+thor_witness_rows(const char *text, size_t length, unsigned width)
+{
+	unsigned rows = 0;
+	size_t i, start = 0;
+	for (i = 0; i <= length; i++) {
+		if (i == length || text[i] == '\n') {
+			const size_t n = i - start;
+			rows += n ? (unsigned)((n + width - 1) / width) : 1;
+			start = i + 1;
+		}
+	}
+	return rows;
+}
+
+/* Draw rows [first, first + count) of `text` wrapped to `width` cells, beginning at screen row `top`. */
+static void
+thor_witness_text(uint32_t *base, unsigned rowpixels, unsigned columns, unsigned top, unsigned first,
+    unsigned count, const char *text, size_t length, unsigned width)
+{
+	unsigned row = 0, drawn = 0;
+	size_t i, start = 0;
+	for (i = 0; i <= length && drawn < count; i++) {
+		size_t at;
+		if (i < length && text[i] != '\n') {
+			continue;
+		}
+		at = start;
+		do {
+			const size_t n = THOR_WITNESS_MIN((size_t)width, i - at);
+			if (row >= first) {
+				thor_witness_row(base, rowpixels, 1, top + drawn, columns, text + at, n, THOR_WITNESS_WHITE,
+				    THOR_WITNESS_BLACK);
+				drawn++;
+			}
+			row++;
+			at += n;
+		} while (at < i && drawn < count);
+		start = i + 1;
+	}
+}
+
+/* A titled page of `text` over the top of the panel: title row (inverted), body, white rule. */
+static void
+thor_witness_page(const char *title, const char *text, size_t length, unsigned first, unsigned count,
+    unsigned number, unsigned pages)
+{
+	uint32_t *base;
+	unsigned columns, rows, rowpixels;
+	char line[160];
+	if (!thor_witness_panel(&base, &columns, &rows, &rowpixels)) {
+		return;
+	}
+	if (count > rows - 4) {
+		count = rows - 4;
+	}
+	snprintf(line, sizeof line, " %s  PAGE %u/%u  KERNEL ALIVE ", title, number + 1, pages);
+	thor_witness_row(base, rowpixels, 0, 0, columns, line, strlen(line), THOR_WITNESS_BLACK, THOR_WITNESS_WHITE);
+	thor_witness_row(base, rowpixels, 0, 1, columns, "", 0, THOR_WITNESS_BLACK, THOR_WITNESS_BLACK);
+	thor_witness_text(base, rowpixels, columns, 2, first, count, text, length, columns - 2);
+	thor_witness_row(base, rowpixels, 0, 2 + count, columns, "", 0, THOR_WITNESS_WHITE, THOR_WITNESS_WHITE);
+}
+
+/* ======================= report text ======================= */
+
+static size_t thor_witness_line(const char *format, ...) __printflike(1, 2);
+
+static size_t
+thor_witness_line(const char *format, ...)
+{
+	va_list args;
+	size_t used = 0;
+	int n;
+	if (thor_witness_report_length + THOR_WITNESS_LINE > sizeof(thor_witness_report)) {
+		return 0;
+	}
+	va_start(args, format);
+	n = vsnprintf(thor_witness_report + thor_witness_report_length, THOR_WITNESS_LINE, format, args);
+	va_end(args);
+	if (n > 0) {
+		used = (size_t)n < THOR_WITNESS_LINE ? (size_t)n : THOR_WITNESS_LINE - 1;
+		thor_witness_report_length += used;
+		thor_witness_report_lines++;
+	}
+	return used;
+}
+
+static void
+thor_witness_hex(char *out, size_t capacity, const uint64_t *values, unsigned count)
+{
+	size_t used = 0;
+	unsigned i;
+	out[0] = 0;
+	for (i = 0; i < count && used + 20 < capacity; i++) {
+		const int n = snprintf(out + used, capacity - used, "%s%llx", i ? "," : "",
+		    (unsigned long long)values[i]);
+		if (n <= 0) {
+			break;
+		}
+		used += (size_t)n;
+	}
+}
+
+static bool
+thor_witness_named_task(const char *name)
+{
+	unsigned i;
+	for (i = 0; i < sizeof thor_witness_named / sizeof thor_witness_named[0]; i++) {
+		if (!strncmp(name, thor_witness_named[i], THOR_WITNESS_NAMELEN)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Kernel frames of a thread that is blocked (not on a CPU): its context was saved at its last
+ * switch into the state at the top of its kernel stack.  Every address read is checked against
+ * that stack first; a thread without a stack (finishing) has no frames. */
+static unsigned
+thor_witness_kernel_frames(thread_t thread, uint64_t *frames, unsigned capacity)
+{
+	const thread_kernel_state_t state = (thread_kernel_state_t)thread->machine.kstackptr;
+	const uint64_t low = (uint64_t)thread->kernel_stack;
+	const uint64_t top = (uint64_t)state;
+	uint64_t fp, lr;
+	unsigned count = 0;
+	if (!state || !low || top < low || top - low > kernel_stack_size) {
+		return 0;
+	}
+	fp = state->machine.ss.fp;
+	lr = state->machine.ss.lr;
+	while (count < capacity && lr >= vm_kernel_stext && lr < vm_kernel_etext) {
+		const uint64_t *record;
+		uint64_t next, caller;
+		frames[count++] = lr;
+		if (fp < low || fp + 32 > top || (fp & 15)) {
+			break;
+		}
+		record = (const uint64_t *)(uintptr_t)fp;
+		next = record[0];
+		caller = record[1];
+		if (next <= fp || next + 32 > top) {
+			break;
+		}
+		fp = next;
+		lr = caller;
+	}
+	return count;
+}
+
+/* Snapshot of every task and thread.  Locks are only tried, never waited for: a thread that
+ * stopped inside a task lock is itself a finding, and the monitor must survive it. */
+static void
+thor_witness_scan(void)
+{
+	task_t task;
+	unsigned t;
+	thor_witness_task_count = thor_witness_thread_count = 0;
+	/* Lock order is task lock before tasks_threads_lock, so the list is only snapshotted here. */
+	if (!lck_mtx_try_lock(&tasks_threads_lock)) {
+		thor_witness_list_busy = 1;
+		return;
+	}
+	queue_iterate(&tasks, task, task_t, tasks) {
+		if (thor_witness_task_count == THOR_WITNESS_TASKS_MAX) {
+			break;
+		}
+		task_reference(task);
+		thor_witness_tasks[thor_witness_task_count++].task = task;
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+
+	for (t = 0; t < thor_witness_task_count; t++) {
+		struct thor_witness_task *row = &thor_witness_tasks[t];
+		thread_t thread;
+		row->pid = task_pid(row->task);
+		row->name[0] = 0;
+		task_procname(row->task, row->name, (int)sizeof row->name);
+		row->name[sizeof row->name - 1] = 0;
+		row->threads = row->running = row->waiting = row->uninterruptible = row->shown = 0;
+		row->lock_busy = false;
+		row->key = thor_witness_named_task(row->name) ||
+		    (*thor_witness_role_name && !strncmp(row->name, thor_witness_role_name, THOR_WITNESS_NAMELEN));
+		{
+			unsigned attempt;
+			for (attempt = 0; attempt < 50 && !task_lock_try(row->task); attempt++) {
+				delay_for_interval(200, NSEC_PER_USEC);
+			}
+			if (attempt == 50) {
+				row->lock_busy = true;      /* still taken after 10 ms: a thread stopped inside it */
+				continue;
+			}
+		}
+		queue_iterate(&row->task->threads, thread, thread_t, task_threads) {
+			struct thor_witness_thread *tr;
+			if (thor_witness_thread_count == THOR_WITNESS_THREADS_MAX) {
+				break;
+			}
+			tr = &thor_witness_threads[thor_witness_thread_count++];
+			tr->tid = thread_tid(thread);
+			tr->wait_event = thread->wait_event;
+			tr->state = thread->state;
+			tr->base_pri = thread->base_pri;
+			tr->sched_pri = thread->sched_pri;
+			tr->task_index = t;
+			tr->frame_count = 0;
+			tr->user_pc = tr->user_lr = 0;
+			if (thread->machine.upcb) {          /* the trap frame of a user thread; NULL for kernel threads */
+				tr->user_pc = thread->machine.upcb->ss_64.pc;
+				tr->user_lr = thread->machine.upcb->ss_64.lr;
+			}
+			row->threads++;
+			if (thread->state & TH_RUN) {
+				row->running++;
+			} else if (thread->state & TH_WAIT) {
+				row->waiting++;
+				if (thread->state & TH_UNINT) {
+					row->uninterruptible++;
+				}
+			}
+			if (row->key && (thread->state & TH_WAIT) && !(thread->state & TH_RUN)) {
+				tr->frame_count = (uint8_t)thor_witness_kernel_frames(thread, tr->frames, THOR_WITNESS_FRAMES);
+			}
+		}
+		task_unlock(row->task);
+	}
+}
+
+static void
+thor_witness_release(void)
+{
+	unsigned t;
+	for (t = 0; t < thor_witness_task_count; t++) {
+		task_deallocate(thor_witness_tasks[t].task);
+		thor_witness_tasks[t].task = TASK_NULL;
+	}
+	thor_witness_task_count = thor_witness_thread_count = 0;
+}
+
+static const char *
+thor_witness_state(int state)
+{
+	static char text[8];
+	unsigned n = 0;
+	if (state & TH_RUN) {
+		text[n++] = 'R';
+	}
+	if (state & TH_WAIT) {
+		text[n++] = 'W';
+	}
+	if (state & TH_UNINT) {
+		text[n++] = 'U';
+	}
+	if (state & TH_SUSP) {
+		text[n++] = 'S';
+	}
+	if (state & TH_TERMINATE) {
+		text[n++] = 'T';
+	}
+	if (state & TH_IDLE) {
+		text[n++] = 'I';
+	}
+	text[n] = 0;
+	return text;
+}
+
+static void
+thor_witness_xcall(void *parameter)
+{
+	__atomic_store_n((uint64_t *)parameter, mach_absolute_time(), __ATOMIC_RELAXED);
+}
+
+/* Cross-call every CPU last: a CPU that does not answer is stuck with interrupts masked. */
+static void
+thor_witness_ping(void)
+{
+	processor_t processor;
+	uint64_t answer[MAX_CPUS];
+	char value[256];
+	unsigned cpu;
+	for (cpu = 0; cpu < MAX_CPUS; cpu++) {
+		__atomic_store_n(&thor_witness_xcall_time[cpu], 0, __ATOMIC_RELAXED);
+		answer[cpu] = 0;
+	}
+	for (processor = processor_list; processor; processor = processor->processor_list) {
+		cpu_data_t *data;
+		if (processor->cpu_id < 0 || (unsigned)processor->cpu_id >= MAX_CPUS) {
+			continue;
+		}
+		data = cpu_datap(processor->cpu_id);
+		if (data) {
+			(void)cpu_signal(data, SIGPxcall, (void *)thor_witness_xcall,
+			    &thor_witness_xcall_time[processor->cpu_id]);
+		}
+	}
+	delay_for_interval(40, NSEC_PER_MSEC);
+	for (cpu = 0; cpu < MAX_CPUS; cpu++) {
+		answer[cpu] = __atomic_load_n(&thor_witness_xcall_time[cpu], __ATOMIC_RELAXED) ? 1 : 0;
+	}
+	thor_witness_hex(value, sizeof value, answer, 8);
+	thor_witness_line("cpu answered cross-call (1 yes, 0 no): %s", value);
+}
+
+static void
+thor_witness_cpu_lines(void)
+{
+	processor_t processor;
+	for (processor = processor_list; processor; processor = processor->processor_list) {
+		const thread_t thread = processor->active_thread;
+		task_t task = thread ? get_threadtask(thread) : TASK_NULL;
+		char name[THOR_WITNESS_NAMELEN] = { 0 };
+		int pid = -1;
+		if (task) {
+			pid = task_pid(task);
+			task_procname(task, name, (int)sizeof name);
+			name[sizeof name - 1] = 0;
+		}
+		thor_witness_line("cpu%u st=%u %s pid=%d %s pri=%d/%d", processor->cpu_id, processor->state,
+		    thread == processor->idle_thread ? "idle" : "on-cpu", pid, pid > 0 ? name : "kernel",
+		    thread ? thread->base_pri : -1, thread ? thread->sched_pri : -1);
+	}
+}
+
+/* The ten wait events most threads are blocked on (space-saving count: a new event replaces
+ * an entry that was seen once, so rare events can be undercounted, common ones are exact). */
+static void
+thor_witness_wait_events(void)
+{
+	uint64_t table[10];
+	unsigned total[10];
+	unsigned entries = 0, i, k;
+	for (i = 0; i < thor_witness_thread_count; i++) {
+		const struct thor_witness_thread *tr = &thor_witness_threads[i];
+		unsigned j;
+		if (!(tr->state & TH_WAIT)) {
+			continue;
+		}
+		for (j = 0; j < entries && table[j] != tr->wait_event; j++) {
+		}
+		if (j < entries) {
+			total[j]++;
+		} else if (entries < 10) {
+			table[entries] = tr->wait_event;
+			total[entries++] = 1;
+		} else {
+			unsigned smallest = 0;
+			for (j = 1; j < entries; j++) {
+				if (total[j] < total[smallest]) {
+					smallest = j;
+				}
+			}
+			if (total[smallest] == 1) {
+				table[smallest] = tr->wait_event;
+			}
+		}
+	}
+	for (k = 0; k < entries; k++) {
+		unsigned biggest = k, m;
+		for (m = k + 1; m < entries; m++) {
+			if (total[m] > total[biggest]) {
+				biggest = m;
+			}
+		}
+		if (biggest != k) {
+			const uint64_t value = table[k];
+			const unsigned c = total[k];
+			table[k] = table[biggest];
+			total[k] = total[biggest];
+			table[biggest] = value;
+			total[biggest] = c;
+		}
+	}
+	for (k = 0; k < entries; k++) {
+		thor_witness_line("wait event %llx: %u threads", (unsigned long long)table[k], total[k]);
+	}
+}
+
+/* The UI processes first, then the app of the last role change, each with its threads. */
+static void
+thor_witness_task_lines(void)
+{
+	unsigned o, t, i;
+	for (o = 0; o <= sizeof thor_witness_named / sizeof thor_witness_named[0]; o++) {
+		for (t = 0; t < thor_witness_task_count; t++) {
+			struct thor_witness_task *row = &thor_witness_tasks[t];
+			const bool wanted = o < sizeof thor_witness_named / sizeof thor_witness_named[0] ?
+			    !strncmp(row->name, thor_witness_named[o], THOR_WITNESS_NAMELEN) : row->key;
+			unsigned shown = 0;
+			if (!wanted || row->shown) {
+				continue;
+			}
+			row->shown = 1;
+			if (row->lock_busy) {
+				thor_witness_line("pid=%d %s: TASK LOCK STAYED TAKEN FOR 10 MS (a thread stopped inside it)", row->pid, row->name);
+				continue;
+			}
+			thor_witness_line("pid=%d %s threads=%u run=%u wait=%u unint=%u", row->pid, row->name, row->threads,
+			    row->running, row->waiting, row->uninterruptible);
+			for (i = 0; i < thor_witness_thread_count && shown < THOR_WITNESS_TASK_THREADS; i++) {
+				const struct thor_witness_thread *tr = &thor_witness_threads[i];
+				char value[256];
+				if (tr->task_index != t) {
+					continue;
+				}
+				char text[THOR_WITNESS_LINE];
+				size_t used;
+				shown++;
+				thor_witness_hex(value, sizeof value, tr->frames, tr->frame_count);
+				thor_witness_line(" t%llu %s pri=%d/%d u=%llx,%llx we=%llx k=%s", (unsigned long long)tr->tid,
+				    thor_witness_state(tr->state), tr->base_pri, tr->sched_pri,
+				    (unsigned long long)tr->user_pc, (unsigned long long)tr->user_lr,
+				    (unsigned long long)tr->wait_event, tr->frame_count ? value : "-");
+				if (tr->frame_count) {          /* the same frames by name, innermost first */
+					used = thor_witness_line("   k:");
+					for (unsigned f = 0; f < tr->frame_count && used + 60 < sizeof text; f++) {
+						thor_witness_describe(tr->frames[f], text, sizeof text);
+						used += thor_witness_line("%s%s", f ? " <- " : " ", text);
+					}
+					thor_witness_line("\n");
+				}
+			}
+		}
+	}
+}
+
+static void
+thor_witness_build(const char *reason, uint64_t uptime)
+{
+	unsigned total = 0, running = 0, waiting = 0, uninterruptible = 0, i;
+	const uint64_t writer = __atomic_load_n(&thor_witness_writer_abs, __ATOMIC_RELAXED);
+	const uint64_t storage = __atomic_load_n(&thor_witness_storage_abs, __ATOMIC_RELAXED);
+	const uint64_t reader = __atomic_load_n(&thor_witness_reader_abs, __ATOMIC_RELAXED);
+	const uint64_t frame = __atomic_load_n(&thor_witness_frame_abs, __ATOMIC_RELAXED);
+	const uint64_t touch = pong_touch_last_event_time();
+	char a[24], b[24];
+	thor_witness_report_length = 0;
+	thor_witness_report_lines = 0;
+	thor_witness_line("THOR WITNESS V233: %s at T=%s s", reason,
+	    thor_witness_age(a, sizeof a, true, (int64_t)uptime));
+	thor_witness_line(" last console read by pid %llu: %s s ago", (unsigned long long)thor_witness_reader_pid,
+	    thor_witness_age(a, sizeof a, reader != 0, (int64_t)uptime - (int64_t)thor_witness_micros(reader)));
+	thor_witness_line(" last frame to the panel: %s s ago; last touch: %s s ago",
+	    thor_witness_age(a, sizeof a, frame != 0, (int64_t)uptime - (int64_t)thor_witness_micros(frame)),
+	    thor_witness_age(b, sizeof b, touch != 0, (int64_t)uptime - (int64_t)touch));
+	thor_witness_line(" kernel text %#llx..%#llx, panic_spin_forever at %#llx (slide reference)",
+	    (unsigned long long)vm_kernel_stext, (unsigned long long)vm_kernel_etext,
+	    (unsigned long long)(uintptr_t)&panic_spin_forever);
+	thor_witness_line(" kernel console mirror thread: %s; %s holds %llu bytes", writer ? "alive" : "not running",
+	    THOR_WITNESS_FILE,
+	    (unsigned long long)__atomic_load_n(&thor_witness_writer_file, __ATOMIC_RELAXED));
+	thor_witness_line(" storage: last command %s s ago, %llu commands, last status %llu",
+	    thor_witness_age(a, sizeof a, storage != 0, (int64_t)uptime - (int64_t)thor_witness_micros(storage)),
+	    (unsigned long long)__atomic_load_n(&thor_witness_storage_ops, __ATOMIC_RELAXED),
+	    (unsigned long long)__atomic_load_n(&thor_witness_storage_status, __ATOMIC_RELAXED));
+	if (thor_witness_role_name[0]) {
+		thor_witness_line(" last role change %s s ago: pid %llu %s %s",
+		    thor_witness_age(a, sizeof a, true,
+		    (int64_t)uptime - (int64_t)thor_witness_micros(__atomic_load_n(&thor_witness_role_abs, __ATOMIC_RELAXED))),
+		    (unsigned long long)__atomic_load_n(&thor_witness_role_pid, __ATOMIC_RELAXED), thor_witness_role_name,
+		    __atomic_load_n(&thor_witness_role_fg, __ATOMIC_RELAXED) ? "foreground" : "background");
+	}
+	thor_witness_list_busy = 0;
+	thor_witness_scan();
+	for (i = 0; i < thor_witness_thread_count; i++) {
+		const int state = thor_witness_threads[i].state;
+		total++;
+		if (state & TH_IDLE) {
+			continue;
+		}
+		if (state & TH_RUN) {
+			running++;
+		} else if (state & TH_WAIT) {
+			waiting++;
+			if (state & TH_UNINT) {
+				uninterruptible++;
+			}
+		}
+	}
+	thor_witness_line(" threads: %u scanned, %u runnable, %u waiting (%u uninterruptible)%s", total, running,
+	    waiting, uninterruptible, thor_witness_list_busy ? "; TASK LIST LOCK IS HELD" : "");
+	thor_witness_cpu_lines();
+	thor_witness_wait_events();
+	thor_witness_task_lines();
+	thor_witness_release();
+}
