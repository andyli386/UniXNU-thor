+static int
+thor_backboard_display_exec(struct image_params *imgp, size_t pointer_size)
+{
+	static const char target[] = "backboardd";
+	static const char metal_key[] = "DYLD_LIBRARY_PATH=";
+	static const char metal_env[] = "DYLD_LIBRARY_PATH=" THOR_METAL_POOL_DIR;
+	static const char software_key[] = "CA_DISABLE_ASYNCHRONOUS=";
+	static const char software_env[] = "CA_DISABLE_ASYNCHRONOUS=1";
+
+	if (!imgp->ip_ndp || imgp->ip_ndp->ni_cnd.cn_namelen != sizeof(target) - 1 ||
+	    memcmp(imgp->ip_ndp->ni_cnd.cn_nameptr, target, sizeof(target) - 1)) {
+		return 0;
+	}
+	const bool software = pongThorSoftwareDisplay();
+	if (!software && !__atomic_load_n(&thor_metal_pool_ready, __ATOMIC_ACQUIRE)) {
+		return 0;
+	}
+	const char *key = software ? software_key : metal_key;
+	const size_t key_length = software ? sizeof(software_key) - 1 : sizeof(metal_key) - 1;
+	const char *environment = software ? software_env : metal_env;
+	const size_t environment_size = software ? sizeof(software_env) : sizeof(metal_env);
+	if (imgp->ip_argspace < environment_size + 2 * pointer_size ||
+	    imgp->ip_strspace < environment_size) {
+		return 0;
+	}
+	char path[MAXPATHLEN];
+	int path_length = sizeof(path);
+	if (!imgp->ip_vp || vn_getpath(imgp->ip_vp, path, &path_length) ||
+	    strcmp(path, "/usr/libexec/backboardd")) {
+		return 0;
+	}
+	bool existing_async_policy = false;
+	const char *end = imgp->ip_strendp;
+	for (const char *entry = imgp->ip_endargv; entry < end; ) {
+		size_t limit = (size_t)(end - entry);
+		size_t length = strnlen(entry, limit);
+		if (length == limit) {
+			return 0;
+		}
+		if (length >= sizeof(software_key) - 1 &&
+		    !memcmp(entry, software_key, sizeof(software_key) - 1)) {
+			existing_async_policy = true;
+		}
+		if (length >= key_length && !memcmp(entry, key, key_length)) {
+			if (software) {
+				printf("THOR SW V208: backboardd existing CA async policy retained\n");
+			} else {
+				printf("THOR METAL POOL: existing backboardd library path; stock lookup preserved\n");
+			}
+			return 0;
+		}
+		entry += length + 1;
+	}
+	/* Only the Metal library trial is one-shot. The software policy must
+	 * accompany every new render-server process before QuartzCore starts. */
+	if (!software && __atomic_exchange_n(&thor_metal_pool_tried, 1, __ATOMIC_ACQ_REL)) {
+		printf("THOR METAL POOL: backboardd retry uses stock bridge path\n");
+		return 0;
+	}
+	int error = exec_add_user_string(imgp, CAST_USER_ADDR_T(environment), UIO_SYSSPACE, TRUE);
+	if (!error) {
+		imgp->ip_argspace -= pointer_size;
+		imgp->ip_envc++;
+		if (software) {
+			printf("THOR SW V208: backboardd CA_DISABLE_ASYNCHRONOUS=1 at exec\n");
+		} else {
+			printf("THOR METAL POOL: first backboardd exec given trial lookup path\n");
+			/* Let QuartzCore select the hardware LayerHost policy at launch. */
+			printf("THOR LAYERHOST V224: hardware backboardd async_policy=%s\n",
+			    existing_async_policy ? "provided" : "framework-default");
+		}
+	}
+	return error;
+}
