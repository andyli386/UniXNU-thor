+}
+
+void
+thor_wifi_power_source(void)
+{
+	__atomic_fetch_or(&thor_wifi_ready, 2U, __ATOMIC_ACQ_REL);
+	thor_wifi_maybe_open();
+}
+
+void
+thor_wifi_note_request(int pid)
+{
+	if (pid <= 0 || pid != __atomic_load_n(&thor_wifid_pid, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	if (__atomic_add_fetch(&thor_wifid_requests, 1U, __ATOMIC_RELAXED) == 1) {
+		printf("THOR WIFI V241: wifid asked the driver for something (pid %d)\n", pid);
+	}
+}
+
+static void
+thor_wifid_watchdog(thread_call_param_t a, thread_call_param_t b)
+{
+#pragma unused(a, b)
+	const int pid = __atomic_load_n(&thor_wifid_pid, __ATOMIC_ACQUIRE);
+	if (pid <= 0 || !__atomic_load_n(&thor_wifi_gate, __ATOMIC_ACQUIRE) ||
+	    __atomic_load_n(&thor_wifid_requests, __ATOMIC_RELAXED)) {
+		return;                             /* not running, still held, or it talks to the driver */
+	}
+	proc_t p = proc_find(pid);
+	if (p == PROC_NULL) {
+		return;                             /* it left on its own; the next start arms the call again */
+	}
+	/* p_comm is not padded beyond its terminator: compare the name and its terminator only. */
+	const bool same = strncmp(p->p_comm, "wifid", sizeof("wifid")) == 0;
+	proc_rele(p);
+	if (!same) {
+		return;
+	}
+	static unsigned kills;
+	proc_signal(pid, SIGKILL);
+	printf("THOR WIFI V241: wifid (pid %d) has not asked the driver for anything in the 60 seconds "
+	    "since it may run: stopped (stop number %u); launchd starts it again\n", pid,
+	    __atomic_add_fetch(&kills, 1U, __ATOMIC_RELAXED) + 1);
+}
+
+static int
+thor_wifi_gate_admit(struct image_params *imgp)
+{
+	if (imgp->ip_ndp == NULL) {
+		return 0;
+	}
+	const char *name = imgp->ip_ndp->ni_cnd.cn_nameptr;
+	const size_t length = imgp->ip_ndp->ni_cnd.cn_namelen;
+	if (length != sizeof("wifid") - 1 || memcmp(name, "wifid", length)) {
+		return 0;
+	}
+	const int pid = proc_pid(vfs_context_proc(imgp->ip_vfs_context));
+	if (pid == __atomic_load_n(&thor_wifid_pid, __ATOMIC_ACQUIRE)) {
+		return 0;
+	}
+	static unsigned starts;
+	printf("THOR WIFI V241: wifid starts (pid %d, start number %u)\n", pid,
+	    __atomic_add_fetch(&starts, 1U, __ATOMIC_RELAXED) + 1);
+	__atomic_store_n(&thor_wifid_requests, 0U, __ATOMIC_RELAXED);
+	__atomic_store_n(&thor_wifid_pid, pid, __ATOMIC_RELEASE);
+	if (__atomic_load_n(&thor_wifi_gate, __ATOMIC_ACQUIRE)) {
+		thor_wifid_arm_watchdog();
+	}
+	return 0;
+}
