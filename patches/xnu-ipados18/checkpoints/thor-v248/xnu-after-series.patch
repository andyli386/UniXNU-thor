+	s.flush = thorDpuRead(ctl + 0x18);
+	s.source[0] = thorDpuRead(map.mdss + kThorSsppOffset[0] + 0x14);
+	s.source[1] = thorDpuRead(map.mdss + kThorSsppOffset[1] + 0x14);
+	s.config = thorDpuRead(intf + kThorIntfAutorefresh);
+	s.frame = thorDpuRead(intf + kThorIntfFrameCount);
+	s.tear = thorDpuRead(intf + 0x298);
+	if (inspectPp && s.config == kThorRefreshEachTe && thorDpuClocksReady(map, false)) {
+		ThorDpuPhaseAudit::readPpDone(map, intf, s.pp);
+		s.ppSample = true;
+	}
+	return "sampled";
+}
+
+struct ThorScanoutRuntime {
+	IOService &display;
+	const uint64_t &powerEpoch;
+};
+
+static void
+thorObserveScanout(const ThorDpuMappings &map, const ThorScanoutRuntime &runtime)
+{
+	unsigned ppSamples = 0;
+	uint64_t last = 0;
+	uint64_t previousWritten = __atomic_load_n(&gThorFrameWritebacks, __ATOMIC_RELAXED);
+	uint64_t previousPower = __atomic_load_n(&runtime.powerEpoch, __ATOMIC_ACQUIRE);
+	while (!runtime.display.isInactive()) {
+		const uint64_t now = mach_absolute_time();
+		const uint64_t touch = pong_touch_last_event_time();
+		const bool recent = touch && touch <= now && thorSwitcherMicros(now - touch) < 3000000;
+		const uint64_t power = __atomic_load_n(&runtime.powerEpoch, __ATOMIC_ACQUIRE);
+		const uint64_t written = __atomic_load_n(&gThorFrameWritebacks, __ATOMIC_RELAXED);
+		if (!last || recent || thorSwitcherMicros(now - last) >= 10000000) {
+			last = now;
+			ThorScanoutSnapshot sample = {};
+			const char *state = "idle-software";
+			// Continuous scanout has no runtime PM lease. Only touch the
+			// qualified hardware after recent input and new software writeback
+			// in the same power epoch. Idle or stopped writers need no MMIO.
+			if (recent) {
+				if (power != previousPower) {
+					state = "power-change";
+				} else if (written == previousWritten) {
+					state = "no-new-write";
+				} else {
+					state = thorScanoutSnapshot(map, sample, ppSamples < 12);
+					if (power != __atomic_load_n(&runtime.powerEpoch, __ATOMIC_ACQUIRE)) {
+						sample = {};
+						state = "power-raced";
+					}
+				}
+			}
+			const uint64_t presenter = __atomic_load_n(&gThorPresentStamp, __ATOMIC_ACQUIRE);
+			const uint64_t enqueued = __atomic_load_n(&gThorFrameEnqueues, __ATOMIC_RELAXED);
+			if (sample.ppSample) {
+				++ppSamples;
+				IOLog("THOR DPU V226 PP_DONE: at_us=%llu frame=%u revision=%#x mux=%#x "
+				    "bank=%u mask=%#x pending=%#x enabled=%#x mode=level-only qualified=0\n",
+				    thorSwitcherMicros(now), sample.frame, sample.pp.revision, sample.pp.mux,
+				    sample.pp.doneBank, sample.pp.doneMask, sample.pp.doneLevel, sample.pp.doneEnable);
+			}
+			// Neither the INTF counter nor VIG addresses acknowledge a swap.
+			IOLog("THOR SCANOUT V187: at_us=%llu touch_us=%llu state=%s "
+			    "active=%#x fetch=%#x flush=%#x src=%#x/%#x auto=%#x frame=%u te=%#x "
+			    "swap=%u phase=%u enqueued=%llu written=%llu raster=%llu skipped=%llu\n",
+			    thorSwitcherMicros(now), thorSwitcherMicros(touch), state,
+			    sample.active, sample.fetch, sample.flush, sample.source[0], sample.source[1],
+			    sample.config, sample.frame, sample.tear, static_cast<uint32_t>(presenter >> 32),
+			    static_cast<unsigned>(presenter & 0xffu), static_cast<unsigned long long>(enqueued),
+			    static_cast<unsigned long long>(written),
+			    static_cast<unsigned long long>(__atomic_load_n(&gThorBaseRasterized, __ATOMIC_RELAXED)),
+			    static_cast<unsigned long long>(__atomic_load_n(&gThorBaseSkipped, __ATOMIC_RELAXED)));
+		}
+		previousWritten = written;
+		previousPower = power;
+		IOSleep(500);
+	}
+}
+
+/* Opt-in interaction diagnostics publish the mapped registers to the frame
+ * writer while it holds the presenter lock. Ordinary presentation uses no
+ * interaction MMIO. */
+static void
+thorDpuInteractionAudit(const ThorDpuMappings &map, uint64_t framebuffer,
+    IOLock *lock, ThorDpuPhaseAudit *phase, const ThorScanoutRuntime &runtime)
+{
+	uint32_t enabled = 2;
+	(void) PE_parse_boot_argn("thor_dpu_interaction", &enabled, sizeof(enabled));
+	if (enabled == 2) {
+		if (phase) thorObserveScanout(map, runtime);
+		else thorDpuMarker("THOR SCANOUT V187: skipped unqualified panel or copy path\n");
+		return;
+	}
+	if (!enabled) {
+		thorDpuMarker("THOR DPU INTERACTION disabled (opt in: thor_dpu_interaction=1)\n");
+		return;
+	}
+
+	uint64_t deadline, cooldown = 0;
+	clock_interval_to_deadline(20 * 60, NSEC_PER_SEC, &deadline);
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	for (unsigned samples = 0; samples < 8 && mach_absolute_time() < deadline;) {
+		IOSleep(200);
+		const uint64_t touch = pong_touch_last_event_time();
+		const uint64_t now = mach_absolute_time();
+		if (!touch || touch > now || now < cooldown) continue;
+		uint64_t touchAge;
+		absolutetime_to_nanoseconds(now - touch, &touchAge);
+		if (touchAge > 300 * NSEC_PER_MSEC) continue;
+		clock_interval_to_deadline(10, NSEC_PER_SEC, &cooldown);
+		++samples;
+		if (!thorDpuRefreshRouteMatches(map, framebuffer)) {
+			IOLog("THOR DPU INTERACTION: sample=%u skip guard\n", samples);
+			continue;
+		}
+		const uint32_t configStart = thorDpuRead(intf + kThorIntfAutorefresh);
+		const uint32_t countStart = thorDpuRead(intf + kThorIntfFrameCount);
+		const uint64_t enqueues = __atomic_load_n(&gThorFrameEnqueues, __ATOMIC_RELAXED);
+		const uint64_t writebacks = __atomic_load_n(&gThorFrameWritebacks, __ATOMIC_RELAXED);
+		const uint64_t start = mach_absolute_time();
+		const bool measurePhase = phase && configStart == kThorRefreshEachTe;
+		if (measurePhase) {
+			IOLockLock(lock);
+			phase->framebuffer = framebuffer;
+			phase->count = phase->missed = 0;
+			phase->next = 0;
+			phase->map = &map;
+			IOLockUnlock(lock);
+		}
+		IOSleep(750);
+		if (measurePhase) {
+			IOLockLock(lock);
+			phase->map = nullptr;
+			IOLockUnlock(lock);
+		}
+		if (!thorDpuRefreshRouteMatches(map, framebuffer)) {
+			IOLog("THOR DPU INTERACTION: sample=%u skip route or clocks changed\n", samples);
+			continue;
+		}
+		const uint32_t configEnd = thorDpuRead(intf + kThorIntfAutorefresh);
+		const uint32_t countEnd = thorDpuRead(intf + kThorIntfFrameCount);
+		const uint64_t enqueueDelta = __atomic_load_n(&gThorFrameEnqueues, __ATOMIC_RELAXED) - enqueues;
+		const uint64_t writebackDelta = __atomic_load_n(&gThorFrameWritebacks, __ATOMIC_RELAXED) - writebacks;
+		const uint64_t end = mach_absolute_time();
+		uint64_t touchNs, startNs, elapsedNs;
+		absolutetime_to_nanoseconds(touch, &touchNs);
+		absolutetime_to_nanoseconds(start, &startNs);
+		absolutetime_to_nanoseconds(end - start, &elapsedNs);
+		IOLog("THOR DPU INTERACTION: sample=%u touch_us=%llu start_us=%llu elapsed_us=%llu "
+		    "frames=%u delta=%u enqueued=%llu written=%llu auto_before=%#x auto_after=%#x\n",
+		    samples, touchNs / 1000, startNs / 1000, elapsedNs / 1000,
+		    countEnd, countEnd - countStart, enqueueDelta, writebackDelta, configStart, configEnd);
+		if (measurePhase) phase->report(samples);
+	}
+}
+
+static bool
+thorDsiAudit(const ThorDpuMappings &map, uint64_t framebuffer, uint32_t active)
+{
+	uint32_t enabled = 1;
+	(void) PE_parse_boot_argn("thor_dsi_audit", &enabled, sizeof(enabled));
+	if (!enabled || !thorDpuRefreshRouteMatches(map, framebuffer)) return false;
+	bool panel120 = false;
+
+	for (unsigned i = 0; i < sizeof(kThorDsi) / sizeof(kThorDsi[0]); ++i) {
+		const auto &dsi = kThorDsi[i];
+		if (!(active & dsi.route)) {
+			IOLog("THOR DSI AUDIT: id=%u skip no active INTF route (mask=%#x)\n", i, active);
+			continue;
+		}
+		if (!thorDsiClocksReady(map, dsi, i)) continue;
+		const vm_offset_t regs = io_map(dsi.address, 0x1000, VM_WIMG_IO, VM_PROT_READ, true);
+		if (!regs) {
+			IOLog("THOR DSI AUDIT: id=%u skip controller map unavailable\n", i);
+			continue;
+		}
+		if (thorDsiClocksReady(map, dsi, i) &&
+		    (thorDpuRead(map.mdss + 0x16000 + kThorCtlIntfActive) & dsi.route)) {
+			thorDpuMarker(i == 0 ? "THOR DSI AUDIT: DSI0 guards passed, before first controller read\n" :
+			    "THOR DSI AUDIT: DSI1 guards passed, before first controller read\n");
+			const uint32_t version = thorDpuRead(regs);
+			if (version == 0x20060000) {
+				const uint32_t control = thorDpuRead(regs + 0x04);
+				const uint32_t status = thorDpuRead(regs + 0x08);
+				IOLog("THOR DSI AUDIT: id=%u ver=%#x ctrl=%#x status=%#x cmd_enabled=%u "
+				    "video_enabled=%u dma_busy=%u mdp_busy=%u panel_identity=unmeasured\n",
+				    i, version, control, status, (control & 5u) == 5u, (control >> 1) & 1,
+				    (status >> 1) & 1, (status >> 2) & 1);
+				if ((control & 7u) == 5u) {
+					const vm_offset_t intf = map.mdss + kThorIntfOffset[i];
+					IOLog("THOR DSI AUDIT: id=%u intf=%u tear=%#x sync=%#x int_count=%#x line=%#x auto=%#x\n",
+					    i, i + 1, thorDpuRead(intf + kThorIntfTearCheck), thorDpuRead(intf + 0x288),
+					    thorDpuRead(intf + 0x298), thorDpuRead(intf + 0x2b0),
+					    thorDpuRead(intf + kThorIntfAutorefresh));
+					thorDsiTimingPreflight(map, regs, dsi, i, control);
+					if (i == 0 && control == 0x1f5) panel120 = thorDsiTry120(map, dsi, framebuffer);
+				}
+			} else {
+				IOLog("THOR DSI AUDIT: id=%u skip unexpected version=%#x\n", i, version);
+			}
+		}
+		ml_io_unmap(regs, 0x1000);
+	}
+	thorDpuMarker("THOR DSI AUDIT: complete\n");
+	return panel120;
+}
+
+/* The live Cape DT advertises QSEED3 at VIG + 0xa00. Qualcomm's
+ * QSEED3_HW_VERSION register is the first word of that sub-block.
+ * Read only the qualified CTL0, VIG0/1 and INTF1 register blocks. */
+static void
+thorDpuFlipAudit(const ThorDpuMappings &map, uint64_t framebuffer)
+{
+	if (!thorDpuRefreshRouteMatches(map, framebuffer)) return;
+	const vm_offset_t ctl = map.mdss + 0x16000;
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	if (thorDpuRead(intf + kThorIntfAutorefresh) != kThorRefreshEachTe) return;
+
+	thorDpuMarker("THOR DPU FLIP AUDIT: CTL0 VIG0/1 INTF1 read-only snapshot\n");
+	const uint32_t layer0 = thorDpuRead(ctl + 0x00);
+	const uint32_t layer1 = thorDpuRead(ctl + 0x04);
+	const uint32_t top = thorDpuRead(ctl + 0x14);
+	const uint32_t flush = thorDpuRead(ctl + 0x18);
+	const uint32_t interfaces = thorDpuRead(ctl + kThorCtlIntfActive);
+	const uint32_t pipes = thorDpuRead(ctl + kThorCtlFetchActive);
+	struct PipeState {
+		uint32_t srcXY, outXY, unpack, opMode, qseedVersion;
+	} state[2];
+	for (unsigned i = 0; i < 2; ++i) {
+		if (!thorDpuClocksReady(map)) return;
+		const vm_offset_t pipe = map.mdss + kThorSsppOffset[i];
+		state[i] = {thorDpuRead(pipe + 0x08), thorDpuRead(pipe + 0x10),
+		    thorDpuRead(pipe + 0x34), thorDpuRead(pipe + 0x38),
+		    thorDpuRead(pipe + 0xa00)};
+	}
+	if (!thorDpuClocksReady(map)) return;
+	const uint32_t te = thorDpuRead(intf + kThorIntfTearCheck);
+	const uint32_t sync = thorDpuRead(intf + 0x288);
+	const uint32_t intCount = thorDpuRead(intf + 0x298);
+	const uint32_t line = thorDpuRead(intf + 0x2b0);
+	const uint32_t autorefresh = thorDpuRead(intf + kThorIntfAutorefresh);
+	const uint32_t frames = thorDpuRead(intf + kThorIntfFrameCount);
+	if (!thorDpuRefreshRouteMatches(map, framebuffer) || autorefresh != kThorRefreshEachTe ||
+	    layer0 != thorDpuRead(ctl + 0x00) || layer1 != thorDpuRead(ctl + 0x04)) return;
+
+	IOLog("THOR DPU FLIP AUDIT: ctl0 lm0=%#x lm1=%#x top=%#x flush=%#x intf=%#x fetch=%#x\n",
+	    layer0, layer1, top, flush, interfaces, pipes);
+	for (unsigned i = 0; i < 2; ++i) {
+		IOLog("THOR DPU FLIP AUDIT: vig%u src_xy=%#x out_xy=%#x unpack=%#x op=%#x qseed_ver=%#x\n",
+		    i, state[i].srcXY, state[i].outXY, state[i].unpack,
+		    state[i].opMode, state[i].qseedVersion);
+	}
+	IOLog("THOR DPU FLIP AUDIT: intf1 te=%#x sync=%#x int_count=%#x line=%#x auto=%#x frames=%u\n",
+	    te, sync, intCount, line, autorefresh, frames);
+}
+
+static constexpr uint32_t kThorFlipMask = (1u << 17) | 3u;
+static constexpr unsigned kThorCtlFlush = 0x18;
+static constexpr unsigned kThorSsppSource = 0x14;
+
+struct ThorDpuScratch {
+	IOMemoryDescriptor *memory = nullptr;
+	IOMemoryMap *mapping = nullptr;
+
+	~ThorDpuScratch()
+	{
+		if (mapping) mapping->release();
+		if (memory) memory->release();
+	}
+};
+
+struct ThorDpuFlipMaps {
+	vm_offset_t ctl = 0;
+	vm_offset_t pipes[2] = {};
+
+	~ThorDpuFlipMaps()
+	{
+		if (ctl) ml_io_unmap(ctl, 0x1000);
+		for (auto pipe : pipes) {
+			if (pipe) ml_io_unmap(pipe, 0x1000);
+		}
+	}
+};
+
+static bool
+thorDpuScratchRoute(const ThorDpuMappings &map, uint32_t address, uint32_t &pending, uint32_t alternate = 0)
+{
+	if (!thorDpuClocksReady(map)) return false;
+	const vm_offset_t ctl = map.mdss + 0x16000;
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	pending = thorDpuRead(ctl + kThorCtlFlush);
+	if ((pending & ~kThorFlipMask) ||
+	    thorDpuRead(ctl) != 0x100002d || thorDpuRead(ctl + 4) != 0x100002d ||
+	    thorDpuRead(ctl + 0x14) != 0xf0020000 ||
+	    thorDpuRead(ctl + kThorCtlIntfActive) != 0x2 ||
+	    thorDpuRead(ctl + kThorCtlFetchActive) != 0x30000 ||
+	    thorDpuRead(intf + kThorIntfTearCheck) != 1 ||
+	    thorDpuRead(intf + kThorIntfAutorefresh) != kThorRefreshEachTe) return false;
+	for (unsigned i = 0; i < 2; ++i) {
+		const vm_offset_t pipe = map.mdss + kThorSsppOffset[i];
+		const uint32_t x = i * 720;
+		const uint32_t source = thorDpuRead(pipe + kThorSsppSource);
+		if (thorDpuRead(pipe) != 0x0c8002d0 || thorDpuRead(pipe + 0x0c) != 0x0c8002d0 ||
+		    thorDpuRead(pipe + 0x08) != x || thorDpuRead(pipe + 0x10) != x ||
+		    (source != address && (!alternate || source != alternate)) ||
+		    thorDpuRead(pipe + 0x24) != 0x1680 || thorDpuRead(pipe + 0x30) != 0x237ff ||
+		    thorDpuRead(pipe + 0x34) != 0x3020001 || thorDpuRead(pipe + 0x38) != 0x80000000) return false;
+	}
+	return true;
+}
+
+enum ThorDpuScratchFlip { ThorDpuScratchSkipped, ThorDpuScratchPending, ThorDpuScratchLatched };
+
+static ThorDpuScratchFlip
+thorDpuScratchSubmit(const ThorDpuMappings &map, const ThorDpuFlipMaps &write,
+    uint32_t original, uint32_t address, const char *stage)
+{
+	uint32_t pending = 0;
+	if (!thorDpuScratchRoute(map, original, pending) || pending != 0) {
+		IOLog("THOR DPU SCRATCH: %s skipped before MMIO, route or flush changed\n", stage);
+		return ThorDpuScratchSkipped;
+	}
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	const uint32_t before = thorDpuRead(intf + kThorIntfFrameCount);
+	for (auto pipe : write.pipes) {
+		*reinterpret_cast<volatile uint32_t *>(pipe + kThorSsppSource) = address;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	*reinterpret_cast<volatile uint32_t *>(write.ctl + kThorCtlFlush) = kThorFlipMask;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	bool sawPending = false, latched = false;
+	uint32_t scans = 0;
+	for (unsigned attempt = 0; attempt < 160; ++attempt) {
+		if (!thorDpuScratchRoute(map, address, pending, original)) break;
+		sawPending |= pending != 0;
+		scans = thorDpuRead(intf + kThorIntfFrameCount) - before;
+		if (sawPending && !pending && scans >= 2 && scans <= 8 &&
+		    thorDpuScratchRoute(map, address, pending) && !pending) {
+			latched = true;
+			break;
+		}
+		IODelay(250);
+	}
+	IOLog("THOR DPU SCRATCH: %s addr=%#x pending_seen=%u flush=%#x scans=%u result=%s\n",
+	    stage, address, sawPending ? 1u : 0u, pending, scans, latched ? "latched" : "unconfirmed");
+	return latched ? ThorDpuScratchLatched : ThorDpuScratchPending;
+}
+
+static void
+thorDpuScratchTrial(const ThorDpuMappings &map, uint64_t framebuffer, const uint8_t *source, IOLock *lock)
+{
+	if (page_size != 4096 || !source || !lock || !thorDpuRefreshRouteMatches(map, framebuffer) ||
+	    !thorDsiDomainAudit(map, kThorDsi[0])) return;
+
+	ThorDpuFlipMaps write;
+	write.ctl = io_map(kThorMdss + 0x16000, 0x1000, VM_WIMG_IO, VM_PROT_READ | VM_PROT_WRITE, true);
+	for (unsigned i = 0; i < 2; ++i) {
+		write.pipes[i] = io_map(kThorMdss + kThorSsppOffset[i], 0x1000,
+		    VM_WIMG_IO, VM_PROT_READ | VM_PROT_WRITE, true);
+	}
+	if (!write.ctl || !write.pipes[0] || !write.pipes[1]) {
+		thorDpuMarker("THOR DPU SCRATCH: SKIP write aliases unavailable\n");
+		return;
+	}
+
+	const uint32_t original = static_cast<uint32_t>(framebuffer);
+	if (thorDpuScratchSubmit(map, write, original, original, "same-address") != ThorDpuScratchLatched) return;
+
+	const uint64_t physical = thorDpuReservedScratch();
+	if (!physical) {
+		thorDpuMarker("THOR DPU SCRATCH: SKIP no separate firmware lease\n");
+		return;
+	}
+	ThorDpuScratch scratch;
+	scratch.memory = IOMemoryDescriptor::withPhysicalAddress(physical, kThorScratchBytes, kIODirectionInOut);
+	if (scratch.memory) {
+		scratch.mapping = scratch.memory->createMappingInTask(kernel_task, 0,
+		    kIOMapAnywhere | kIOMapCopybackCache);
+	}
+	if (!scratch.mapping || scratch.mapping->getLength() != kThorScratchBytes ||
+	    !scratch.mapping->getAddress()) {
+		thorDpuMarker("THOR DPU SCRATCH: SKIP dedicated buffer mapping failed\n");
+		return;
+	}
+	const vm_offset_t pixels = scratch.mapping->getAddress();
+	IOLog("THOR DPU SCRATCH: dedicated firmware buffer pa=%#llx bytes=%llu pitch=5760\n",
+	    physical, static_cast<uint64_t>(kThorScratchBytes));
+	if (!IOLockTryLock(lock)) {
+		thorDpuMarker("THOR DPU SCRATCH: SKIP presenter busy at snapshot\n");
+		return;
+	}
+	memcpy(reinterpret_cast<void *>(pixels), source, kThorScratchBytes);
+	IOLockUnlock(lock);
+
+	constexpr unsigned chunk = 64 * 1024;
+	for (IOByteCount offset = 0; offset < kThorScratchBytes; offset += chunk) {
+		const IOByteCount left = kThorScratchBytes - offset;
+		flush_dcache64(pixels + offset, static_cast<unsigned>(left < chunk ? left : chunk), 0);
+	}
+	if (!IOLockTryLock(lock)) {
+		thorDpuMarker("THOR DPU SCRATCH: SKIP presenter busy at switch\n");
+		return;
+	}
+
+	const uint32_t address = static_cast<uint32_t>(physical);
+	thorDpuMarker("THOR DPU SCRATCH: before fresh source submission\n");
+	const auto submitted = thorDpuScratchSubmit(map, write, original, address, "fresh-buffer");
+	if (submitted == ThorDpuScratchSkipped) {
+		IOLockUnlock(lock);
+		return;
+	}
+
+	/* Restore only from an idle, precisely recognized controller route.
+	 * Keep the mapping and backing pinned if restore cannot be confirmed. */
+	auto restored = thorDpuScratchSubmit(map, write, address, original, "restore");
+	if (restored == ThorDpuScratchSkipped) {
+		restored = thorDpuScratchSubmit(map, write, original, original, "restore-original-route");
+	}
+	IOLockUnlock(lock);
+	if (restored != ThorDpuScratchLatched) {
+		scratch.mapping = nullptr;
+		scratch.memory = nullptr;
+		thorDpuMarker("THOR DPU SCRATCH: UNCERTAIN restore, keep fresh backing pinned\n");
+		return;
+	}
+	if (submitted == ThorDpuScratchLatched && thorDsiDomainAudit(map, kThorDsi[0])) {
+		thorDpuMarker("THOR DPU SCRATCH: PASS new-address latch and original-address restore\n");
+	} else {
+		thorDpuMarker("THOR DPU SCRATCH: restore confirmed, new scanout unqualified\n");
+	}
+}
+
+static void
+thorDpuProbe(uint64_t framebuffer, const uint8_t *source, IOLock *lock, ThorDpuPhaseAudit *phase, const ThorScanoutRuntime &runtime)
+{
+	ThorDpuMappings map = {};
+	map.gcc = io_map(kThorGccDispAhb & ~0xffful, 0x1000, VM_WIMG_IO, VM_PROT_READ, true);
