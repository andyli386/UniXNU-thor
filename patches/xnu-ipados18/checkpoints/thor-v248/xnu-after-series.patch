+			    "rev=%#x/%#x mux=%#x/%#x bank=%u/%u mask=%#x/%#x pending=%#x/%#x enabled=%#x/%#x\n",
+			    window, sample.swap, sample.before.revision, sample.after.revision,
+			    sample.before.mux, sample.after.mux, sample.before.doneBank,
+			    sample.after.doneBank, sample.before.doneMask, sample.after.doneMask,
+			    sample.before.doneLevel, sample.after.doneLevel, sample.before.doneEnable,
+			    sample.after.doneEnable);
