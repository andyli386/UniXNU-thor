+#if XNU_PONG_ADRENO_PLATFORM
+struct ThorFrameReceipt {
+	uint32_t swap;
+	uint64_t touch, enqueued, ready, shown, drawn, fingerprint;
+	unsigned white, black, samples;
+	uint64_t sampleUs;
+	int cpuStart, cpuEnd;
+};
+
+static void
+thorPrintFrameReceipt(const ThorFrameReceipt &r)
+{
+	IOLog("PONG TOUCH FRAME: swap=%u touch_us=%llu enqueue_us=%llu ready_us=%llu "
+	    "start_us=%llu done_us=%llu fp=%016llx white=%u dark=%u samples=%u sample_us=%llu cpu=%d/%d\n",
+	    r.swap, micros(r.touch), micros(r.enqueued), micros(r.ready), micros(r.shown), micros(r.drawn),
+	    r.fingerprint, r.white, r.black, r.samples, r.sampleUs, r.cpuStart, r.cpuEnd);
+}
+
+// The boot-lifetime presenter is the sole producer. ONCE serializes drain callbacks.
+// Only copied timestamps and counts cross the thread boundary.
+struct ThorFrameReceiptQueue {
+	static constexpr unsigned capacity = 64;
+	ThorFrameReceipt records[capacity];
+	uint32_t head, tail, dropped;
+	thread_call_t call;
+
+	void push(const ThorFrameReceipt &r)
+	{
+		const uint32_t h = __atomic_load_n(&head, __ATOMIC_RELAXED);
+		if (h - __atomic_load_n(&tail, __ATOMIC_ACQUIRE) < capacity) {
+			records[h % capacity] = r;
+			__atomic_store_n(&head, h + 1, __ATOMIC_RELEASE);
+		} else {
+			__atomic_fetch_add(&dropped, 1u, __ATOMIC_RELAXED);
+		}
+		thread_call_enter(call);
+	}
+
+	static void drain(thread_call_param_t param, thread_call_param_t)
+	{
+		auto *q = static_cast<ThorFrameReceiptQueue *>(param);
+		uint32_t t = __atomic_load_n(&q->tail, __ATOMIC_RELAXED);
+		for (unsigned i = 0; i < 16; ++i) {
+			if (t == __atomic_load_n(&q->head, __ATOMIC_ACQUIRE)) {
+				break;
+			}
+			const ThorFrameReceipt r = q->records[t % capacity];
+			__atomic_store_n(&q->tail, ++t, __ATOMIC_RELEASE);
+			thorPrintFrameReceipt(r);
+		}
+		const uint32_t lost = __atomic_exchange_n(&q->dropped, 0u, __ATOMIC_RELAXED);
+		if (lost) {
+			IOLog("THOR FRAME TRACE V185: dropped=%u\n", lost);
+		}
+		if (t != __atomic_load_n(&q->head, __ATOMIC_ACQUIRE)) {
+			thread_call_enter(q->call);
+		}
+	}
+};
+#endif
 
