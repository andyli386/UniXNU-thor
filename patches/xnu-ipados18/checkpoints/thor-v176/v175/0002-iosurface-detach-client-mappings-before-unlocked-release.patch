+/* With gSurfaceLock held, retire the logical holder immediately. Retain a
+ * surviving surface so its wrapped-client backing cannot complete before
+ * the detached client's own maps have been released. */
+static void
+detachRefHolder(const struct minisurf_client_ref &ref)
+{
+	if (!surfaceDropHolder(ref.surface)) {
+		ref.surface->retain();
+	}
