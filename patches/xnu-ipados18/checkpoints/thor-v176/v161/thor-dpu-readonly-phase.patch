+struct ThorDpuPhaseAudit {
+	/* The probe owns the mappings. It publishes them to the presenter only
+	 * while the existing interaction window is armed, under fLock. */
+	static constexpr unsigned Limit = 12;
+	struct Phase {
+		uint32_t frame, read, writeLine;
+	};
+	struct Sample {
+		uint64_t start, finish;
+		uint32_t swap;
+		Phase before, after;
+	};
+	const ThorDpuMappings *map;
+	uint64_t framebuffer, next;
+	unsigned count, missed;
+	Sample samples[Limit];
+
+	bool readPhase(Phase &phase) const {
+		if (!thorDpuRefreshRouteMatches(*map, framebuffer, false)) return false;
+		const vm_offset_t intf = map->mdss + kThorIntfOffset[0];
+		if (thorDpuRead(intf + kThorIntfAutorefresh) != kThorRefreshEachTe) return false;
+		/* The TE read pointer packs frame and line into one word. The
+		 * write pointer is separate. Keep both when the outer frame agrees. */
+		phase.frame = thorDpuRead(intf + kThorIntfFrameCount);
+		phase.read = thorDpuRead(intf + 0x298);
+		phase.writeLine = thorDpuRead(intf + 0x2b0) & 0xffff;
+		return phase.frame == thorDpuRead(intf + kThorIntfFrameCount);
+	}
+
+	bool begin(uint32_t swap) {
+		if (!map || count + missed >= Limit || mach_absolute_time() < next) return false;
+		clock_interval_to_deadline(40, kMillisecondScale, &next);
+		Sample &sample = samples[count];
+		if (!readPhase(sample.before)) {
+			++missed;
+			return false;
+		}
+		sample.swap = swap;
+		sample.start = mach_absolute_time();
+		return true;
+	}
+
+	void end(bool samePower) {
+		Sample &sample = samples[count];
+		sample.finish = mach_absolute_time();
+		if (samePower && readPhase(sample.after)) ++count;
+		else ++missed;
+	}
+
+	void report(unsigned window) const {
+		for (unsigned i = 0; i < count; ++i) {
+			const Sample &sample = samples[i];
+			uint64_t startNs, copyNs;
+			absolutetime_to_nanoseconds(sample.start, &startNs);
+			absolutetime_to_nanoseconds(sample.finish - sample.start, &copyNs);
+			IOLog("THOR DPU PHASE: window=%u swap=%u start_us=%llu copy_us=%llu "
+			    "intf=%u/%u te_frame=%u/%u te_line=%u/%u write_line=%u/%u\n",
+			    window, sample.swap, startNs / 1000, copyNs / 1000,
+			    sample.before.frame, sample.after.frame,
+			    sample.before.read >> 16, sample.after.read >> 16,
+			    sample.before.read & 0xffff, sample.after.read & 0xffff,
+			    sample.before.writeLine, sample.after.writeLine);
+		}
+		IOLog("THOR DPU PHASE: window=%u samples=%u rejected=%u\n", window, count, missed);
+	}
+};
