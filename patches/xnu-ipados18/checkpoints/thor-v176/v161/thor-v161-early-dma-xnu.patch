+/* Reserve from a loader-owned non-bootstrap bank before the aperture and
+ * VM free lists are built. Both firmware slots must be absent/zero, since
+ * partially populated or malformed firmware reservations need diagnosis.
+ * The tail is excluded from VM and mapped later by the DMA consumer. */
+void
+thor_modem_reserve_boot_dma(boot_args *args)
+{
+    DTEntry chosen;
+    uint32_t cell[28];
+    uint32_t modem[26];
+    unsigned invalid = 0, overlap = 0;
+    uint64_t metadata[2] = { 0 };
+    uint64_t rmtfs[2] = { 0 };
+    uint64_t display[2] = { 0 };
+    uint64_t audio[2] = { 0 };
+    uint64_t usb[2] = { 0 };
+    if (thor_modem_dma_tail || PAGE_SHIFT != 12 || pong_ram_range_count < 2 ||
+        SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+        !thor_modem_read_adt(chosen, "thor-cellular-profile", cell, sizeof(cell), false) ||
+        !thor_modem_read_adt(chosen, "thor-modem-prereqs", modem, sizeof(modem), false) ||
+        cell[0] != 0x4c434854 || cell[1] != 1 || cell[2] != 0xc141accf || cell[3] != 4 ||
+        cell[4] != 0x80900000 || cell[5] != 0x200000 || cell[22] != 1 ||
+        cell[23] != 435 || cell[24] != 428 || cell[25] != THOR_MODEM_RMTFS_SIZE ||
+        !thor_modem_prereqs_match(cell, modem)) {
+        return;
+    }
+
+    thor_modem_check_carveouts(cell, &invalid, &overlap);
+    if (invalid || overlap ||
+        !thor_modem_read_adt(chosen, "pong-modem-metadata", metadata, sizeof(metadata), true) ||
+        !thor_modem_read_adt(chosen, "pong-rmtfs-dma", rmtfs, sizeof(rmtfs), true) ||
+        metadata[0] || metadata[1] || rmtfs[0] || rmtfs[1] ||
+        !thor_modem_read_adt(chosen, "thor-native-scanout", display, sizeof(display), false) ||
+        !thor_modem_range_at_low32(display, 18ULL << 20) ||
+        !thor_modem_read_adt(chosen, "pong-audio-dma", audio, sizeof(audio), true) ||
+        !thor_modem_read_adt(chosen, "pong-usb-dma", usb, sizeof(usb), true) ||
+        ((audio[0] || audio[1]) && !thor_modem_range_at_low32(audio, 0x10000)) ||
+        ((usb[0] || usb[1]) && !thor_modem_range_at_low32(usb, 0x8000))) {
+        return;
+    }
+
+    const uint64_t fb = args->Video.v_baseAddr;
+    const uint64_t pitch = args->Video.v_rowBytes;
+    const uint64_t height = args->Video.v_height;
+    if (!fb || fb >= 0x100000000ULL || !pitch || !height ||
+        height > (0x100000000ULL - fb) / pitch) {
+        return;
+    }
+
+    unsigned selected = 0;
+    uint64_t best = 0;
+    for (unsigned i = 1; i < pong_ram_range_count; i++) {
+        const struct pong_ram_range *bank = &pong_ram_ranges[i];
+        if (bank->end > 0x100000000ULL || bank->end - bank->start <= THOR_MODEM_DMA_SIZE ||
+            bank->end - bank->start <= best) {
+            continue;
+        }
+        const uint64_t begin = bank->end - THOR_MODEM_DMA_SIZE;
+        if (thor_modem_dma_overlap(begin, THOR_MODEM_DMA_SIZE, display[0], display[1]) ||
+            /* The retained scanout validator checks that the next page is VM-owned. */
+            (begin <= display[0] + display[1] && display[0] + display[1] < bank->end) ||
+            thor_modem_dma_overlap(begin, THOR_MODEM_DMA_SIZE, fb, pitch * height) ||
+            (audio[0] && thor_modem_dma_overlap(begin, THOR_MODEM_DMA_SIZE, audio[0], audio[1])) ||
+            (usb[0] && thor_modem_dma_overlap(begin, THOR_MODEM_DMA_SIZE, usb[0], usb[1]))) {
+            continue;
+        }
+        best = bank->end - bank->start;
+        selected = i;
+    }
+    if (!selected) {
+        return;
+    }
+
+    pong_ram_ranges[selected].end -= THOR_MODEM_DMA_SIZE;
+    for (unsigned i = selected + 1; i < pong_ram_range_count; i++) {
+        pong_ram_ranges[i].first_page -= THOR_MODEM_DMA_SIZE >> PAGE_SHIFT;
+    }
+    pong_ram_bytes -= THOR_MODEM_DMA_SIZE;
+    thor_modem_dma_tail = pong_ram_ranges[selected].end;
+}
+
+bool
+thor_modem_get_boot_dma_ranges(uint64_t ranges[4])
+{
+    if (!ranges || !thor_modem_dma_tail) {
+        return false;
+    }
+    ranges[0] = thor_modem_dma_tail;
+    ranges[1] = THOR_MODEM_METADATA_SIZE;
+    ranges[2] = ranges[0] + THOR_MODEM_METADATA_SIZE;
+    ranges[3] = THOR_MODEM_RMTFS_SIZE;
+    return true;
+}
