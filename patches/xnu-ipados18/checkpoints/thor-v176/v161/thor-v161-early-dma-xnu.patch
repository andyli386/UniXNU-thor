--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -98,6 +98,181 @@
 #if defined(PONG)
 bool thor_modem_smem_admitted;
 
+#define THOR_MODEM_METADATA_SIZE 0x10000u
+#define THOR_MODEM_RMTFS_SIZE 0x280000u
+#define THOR_MODEM_DMA_SIZE (THOR_MODEM_METADATA_SIZE + THOR_MODEM_RMTFS_SIZE)
+
+SECURITY_READ_ONLY_LATE(static uint64_t) thor_modem_dma_tail;
+void thor_modem_reserve_boot_dma(boot_args *);
+bool thor_modem_get_boot_dma_ranges(uint64_t ranges[4]);
+
+static bool
+thor_modem_read_adt(DTEntry chosen, const char *name, void *result, size_t bytes, bool optional)
+{
+    const void *property = NULL;
+    unsigned size = 0;
+    if (SecureDTGetProperty(chosen, name, &property, &size) != kSuccess) {
+        return optional;
+    }
+    if (property == NULL || size != bytes) {
+        return false;
+    }
+    const volatile uint8_t *source = property;
+    for (size_t i = 0; i < bytes; i++) {
+        ((uint8_t *)result)[i] = source[i];
+    }
+    return true;
+}
+
+static bool
+thor_modem_range_at_low32(const uint64_t range[2], uint64_t bytes)
+{
+    return range[0] && !(range[0] & PAGE_MASK) && range[1] == bytes &&
+        range[0] <= 0x100000000ULL - bytes;
+}
+
+static bool
+thor_modem_dma_overlap(uint64_t a, uint64_t a_size, uint64_t b, uint64_t b_size)
+{
+    return a < b + b_size && b < a + a_size;
+}
+
+static bool
+thor_modem_prereqs_match(const uint32_t cell[28], const uint32_t modem[26])
+{
+    return modem[0] == 0x384d4854 && modem[1] == 1 && modem[2] == 26 &&
+        modem[3] == cell[2] && modem[4] == cell[12] && modem[5] == cell[13] &&
+        modem[6] == cell[10] && modem[7] == cell[11] &&
+        modem[8] == cell[4] && modem[9] == cell[5] &&
+        modem[10] == 0x2000000 && modem[11] == 0x400000 &&
+        modem[12] == cell[25] && modem[13] == cell[22] &&
+        modem[14] == 0 && modem[15] == 2 && modem[16] == 1 &&
+        modem[17] == 3 && modem[18] == 7 && modem[19] == 0 &&
+        modem[20] == 2 && modem[21] == 0 && modem[22] == 2 &&
+        modem[23] == 4 && modem[24] == 264 && modem[25] == cell[14];
+}
+
+static void
+thor_modem_check_carveouts(const uint32_t cell[28], unsigned *invalid, unsigned *overlap)
+{
+    for (unsigned row = 0; row < 4; row++) {
+        const uint64_t start = cell[4 + 2 * row];
+        const uint64_t length = cell[5 + 2 * row];
+        const uint64_t end = start + length;
+        if (!start || !length || ((start | length) & 0xfff) || end > 0x100000000ULL) {
+            *invalid |= 1u << row;
+            continue;
+        }
+        for (unsigned bank = 0; bank < pong_ram_range_count; bank++) {
+            const struct pong_ram_range *range = &pong_ram_ranges[bank];
+            if (start < range->end && end > range->start) {
+                *overlap |= 1u << row;
+                break;
+            }
+        }
+        for (unsigned other = 0; other < row; other++) {
+            if (thor_modem_dma_overlap(start, length,
+                cell[4 + 2 * other], cell[5 + 2 * other])) {
+                *invalid |= (1u << row) | (1u << other);
+            }
+        }
+    }
+}
