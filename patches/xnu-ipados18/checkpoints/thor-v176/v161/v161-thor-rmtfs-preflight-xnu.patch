+extern bool thor_modem_smem_admitted;
+extern int pong_ufs_factory_nv(unsigned, uint64_t, void *, uint32_t, uint64_t *)
+    __attribute__((weak_import));
+
+static void
+thor_rmtfs_nv_preflight(thread_call_param_t unused, thread_call_param_t handle)
+{
+	(void)unused;
+	uint64_t bytes = 0;
+	const int error = pong_ufs_factory_nv(0, 0, NULL, 0, &bytes);
+	printf("THOR RMTFS V161: live GPT metadata query status=%d slot0_bytes=%llu\n",
+	    error, (unsigned long long)bytes);
+	(void)thread_call_free((thread_call_t)handle);
+}
+
+static void
+thor_rmtfs_nv_schedule(void)
+{
+	if (!thor_modem_smem_admitted) {
+		return;
+	}
+	if (pong_ufs_factory_nv == NULL) {
+		printf("THOR RMTFS V161: live GPT metadata query unavailable\n");
+		return;
+	}
+
+	/* This size query transfers GPT metadata only. Keep the UFS
+	 * transaction off the init task after the native Data mount. */
+	static bool scheduled;
+	if (__atomic_exchange_n(&scheduled, true, __ATOMIC_ACQ_REL)) {
+		return;
+	}
+	thread_call_t call = thread_call_allocate_with_priority(thor_rmtfs_nv_preflight,
+	    NULL, THREAD_CALL_PRIORITY_LOW);
+	if (call == NULL) {
+		printf("THOR RMTFS V161: live GPT metadata query allocation failed\n");
+		return;
+	}
+	uint64_t deadline = 0;
+	clock_interval_to_deadline(2, NSEC_PER_SEC, &deadline);
+	(void)thread_call_enter1_delayed(call, (thread_call_param_t)call, deadline);
+}
