+/* Publish only the exact leases accepted by the complete Thor boot validator.
+ * Kind 0 is PAS metadata, kind 1 is the RMTFS shared buffer. */
+bool
+thor_modem_dma_lease(unsigned kind, uint64_t bytes, uint64_t *address)
+{
+    if (address == NULL) {
+        return false;
+    }
+    *address = 0;
+    if (kind == 0 && bytes == THOR_MODEM_METADATA_SIZE) {
+        *address = thor_modem_metadata_dma;
+    } else if (kind == 1 && bytes == THOR_MODEM_RMTFS_SIZE) {
+        *address = thor_modem_rmtfs_dma;
+    }
+    return *address != 0;
+}
 
