 	if (error) {
 		printf("THOR METAL POOL: stage failed error=%d; stock bridge retained\n", error);
 		return;
 	}
+#endif
 	__atomic_store_n(&thor_metal_pool_ready, 1, __ATOMIC_RELEASE);
