+/* Separate failure budgets from ordinary transient display waits.
+ * Call with gSurfaceLock held. The retry flag is local to this surface. */
+enum GpuPoisonReport : uint8_t {
+    kGpuPoisonWriterRetry = 1,
+    kGpuPoisonDisplayRetry = 2,
+};
+
+static bool
+logGpuPoisonReceipt(unsigned &count)
+{
+    if (count >= 24) {
+        return false;
+    }
+    ++count;
+    return true;
+}
+
+static bool
+logGpuPoisonRetry(MiniIOSurface *surface, GpuPoisonReport flag, unsigned &count)
+{
+    if (surface->gpuPoisonReports & flag) {
+        return false;
+    }
+    surface->gpuPoisonReports |= flag;
+    return logGpuPoisonReceipt(count);
+}
