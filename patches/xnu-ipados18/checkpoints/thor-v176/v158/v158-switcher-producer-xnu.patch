 		unsigned reason = (i == 0 || i + 1 == gSwitcherFrameCount) ? 1u : 0u;
@@ -348,12 +416,31 @@ thorSwitcherReport(thread_call_param_t, thread_call_param_t)
 			const uint32_t us = previous && frame.drawn >= previous->drawn ?
 			    thorSwitcherDuration(frame.drawn - previous->drawn) : 0;
 			thorSwitcherReportFrame(frame, reason, previous ? previous->id : 0, us);
+			if (frame.timing.baseWriterState == MiniIOSurfaceWriterState::Released &&
+			    frame.timing.baseWritersAtLock == 1) {
+				++selectedWriters;
+				bool ambiguous = false;
+				const auto *producer = thorSwitcherMatchProducer(frame, ambiguous);
+				ambiguousProducers += ambiguous;
+				if (producer) {
+					++matchedProducers;
+					IOLog("PONG SWITCHER V158 PRODUCER: swap=%u sid=%u cmd=%llu t=%llu/%llu/%llu/%llu/%llu/%llu/%llu/%llu\n",
+					    frame.id, frame.surface, static_cast<unsigned long long>(producer->command),
+					    (unsigned long long)producer->commit, (unsigned long long)producer->writerBegin,
+					    (unsigned long long)producer->submit, (unsigned long long)producer->callback,
+					    (unsigned long long)producer->syncDone, (unsigned long long)producer->flushDone,
+					    (unsigned long long)producer->releaseBegin, (unsigned long long)producer->releaseEnd);
+				}
+			}
 			++printed;
 		}
 		if (frame.drawn) {
 			previous = &frame;
 		}
 	}
+	IOLog("PONG SWITCHER V158 PRODUCER SUMMARY: receipts=%u overwritten=%u selected=%u matched=%u ambiguous=%u "
+	    "t=commit/writer_begin/submit/callback/sync_done/flush_done/release_begin/release_end unit=us\n",
+	    gSwitcherProducerCount, gSwitcherLostProducers, selectedWriters, matchedProducers, ambiguousProducers);
 	IOLog("PONG SWITCHER V157 END: attempts=%u details=%u cues=%u\n",
 	    gSwitcherFrameCount, printed, gSwitcherCueCount);
 }
