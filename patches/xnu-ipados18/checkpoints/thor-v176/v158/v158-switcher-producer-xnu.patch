+
 LCK_GRP_DECLARE(thor_switcher_trace_group, "thor-switcher-trace");
 LCK_MTX_DECLARE(thor_switcher_trace_lock, &thor_switcher_trace_group);
 static ThorSwitcherFrame gSwitcherFrames[kSwitcherFrameLimit];
 static ThorSwitcherCue gSwitcherCues[kSwitcherCueLimit];
+static ThorSwitcherProducer gSwitcherProducers[kSwitcherProducerLimit];
 static unsigned gSwitcherFrameCount, gSwitcherCueCount, gSwitcherLostFrames, gSwitcherLostCues;
+static unsigned gSwitcherProducerCount, gSwitcherProducerNext, gSwitcherLostProducers;
 static uint64_t gSwitcherTraceStart, gSwitcherTraceEnd, gSwitcherHardEnd;
 static bool gSwitcherTraceSealed;
 static thread_call_t gSwitcherTraceCall;
@@ -120,6 +129,64 @@ thorSwitcherDuration(uint64_t ticks)
 	return us <= UINT32_MAX ? static_cast<uint32_t>(us) : UINT32_MAX;
 }
 
+/* The driver authenticates the submitting process. Only the quiet-window cue
+ * arms this bounded capture. Nothing logs or waits on the IOSurface path. */
+extern "C" void
+thor_switcher_producer_record(const uint64_t *words)
+{
+	const uint64_t now = mach_absolute_time();
+	if (now >= __atomic_load_n(&gSwitcherTraceEnd, __ATOMIC_RELAXED)) {
+		return;
+	}
+	ThorSwitcherProducer producer;
+	memcpy(&producer, words, sizeof(producer));
+	if (!producer.surface || producer.surface > UINT32_MAX || !producer.command || producer.flags ||
+	    !producer.commit || producer.commit > producer.writerBegin || producer.writerBegin > producer.submit ||
+	    producer.submit > producer.callback || producer.callback > producer.syncDone ||
+	    producer.syncDone > producer.flushDone || producer.flushDone > producer.releaseBegin ||
+	    producer.releaseBegin > producer.releaseEnd || producer.releaseEnd > thorSwitcherMicros(now) ||
+	    !producer.releaseTicks || producer.releaseTicks > now) {
+		return;
+	}
+	const uint64_t releaseUs = thorSwitcherMicros(producer.releaseTicks);
+	if (releaseUs < producer.releaseBegin || releaseUs > producer.releaseEnd) {
+		return;
+	}
+	lck_mtx_lock(&thor_switcher_trace_lock);
+	if (!gSwitcherTraceSealed && producer.releaseTicks >= gSwitcherTraceStart) {
+		gSwitcherProducers[gSwitcherProducerNext] = producer;
+		gSwitcherProducerNext = (gSwitcherProducerNext + 1) % kSwitcherProducerLimit;
+		if (gSwitcherProducerCount < kSwitcherProducerLimit) {
+			++gSwitcherProducerCount;
+		} else {
+			++gSwitcherLostProducers;
+		}
+	}
+	lck_mtx_unlock(&thor_switcher_trace_lock);
+}
+
+static const ThorSwitcherProducer *
+thorSwitcherMatchProducer(const ThorSwitcherFrame &frame, bool &ambiguous)
+{
+	const auto &timing = frame.timing;
+	if (timing.baseWriterState != MiniIOSurfaceWriterState::Released ||
+	    timing.baseWritersAtLock != 1 || !timing.baseWriterRelease) {
+		return nullptr;
+	}
+	const ThorSwitcherProducer *match = nullptr;
+	for (unsigned i = 0; i < gSwitcherProducerCount; ++i) {
+		const ThorSwitcherProducer &producer = gSwitcherProducers[i];
+		if (producer.surface == frame.surface && producer.releaseTicks == timing.baseWriterRelease) {
+			if (match) {
+				ambiguous = true;
+				return nullptr;
+			}
+			match = &producer;
+		}
+	}
+	return match;
+}
