+extern "C" void
+thor_switcher_gpu_event(uint32_t event, uint32_t pid, const uint64_t *words)
+{
+	const uint64_t now = mach_absolute_time();
+	if (!thor_switcher_producer_active(now)) {
+		return;
+	}
+	const uint64_t owner = proc_uniqueid(current_proc());
+	if (!owner) {
+		return;
+	}
+	ThorSwitcherGpuStages stages{};
+	ThorSwitcherGpuLink link{thorSwitcherMicros(now), words[0], words[1], words[2], words[3], words[4], event};
+	switch (event) {
+	case kSwitcherGpuFrontend:
+		if (!link.a || !link.b || link.c != 1) {
+			return;
+		}
+		break;
+	case kSwitcherGpuRuntimeBuffer:
+		if (!link.a || !link.b) {
+			return;
+		}
+		break;
+	case kSwitcherGpuSubmitBuffer:
+		if (!link.a || !link.b || link.c >= link.d || link.d > kSwitcherGpuLinkLimit) {
+			return;
+		}
