+static bool
+thorSwitcherMatchFences(const ThorSwitcherProducer &producer, ThorSwitcherFenceSet &result)
+{
+	if (!gSwitcherGpuPid || gSwitcherGpuOwnerChanged || gSwitcherGpuLinksLost) {
+		return false;
+	}
+	unsigned first = gSwitcherGpuLinkCount;
+	for (unsigned i = 0; i < gSwitcherGpuLinkCount; ++i) {
+		const auto &item = gSwitcherGpuLinks[i];
+		if (item.event == kSwitcherGpuFrontend && item.a == producer.command &&
+		    item.us >= producer.commit && item.us <= producer.callback) {
+			if (first != gSwitcherGpuLinkCount) {
+				return false;
+			}
+			first = i;
+		}
+	}
+	if (first == gSwitcherGpuLinkCount) {
+		return false;
+	}
+	const auto &frontend = gSwitcherGpuLinks[first];
+	unsigned runtimeBuffers = 0;
+	for (unsigned i = first + 1; i < gSwitcherGpuLinkCount; ++i) {
+		const auto &runtime = gSwitcherGpuLinks[i];
+		if (runtime.us > producer.callback) {
+			continue;
+		}
+		if (runtime.event == kSwitcherGpuFrontend && runtime.b == frontend.b) {
+			// Arc addresses can be recycled. Refuse a conflicting lifetime.
+			return false;
+		}
+		if (runtime.event != kSwitcherGpuRuntimeBuffer || runtime.a != frontend.b) {
+			continue;
+		}
+		if (++runtimeBuffers > kSwitcherGpuMaxCommandFences) {
+			return false;
+		}
+		unsigned submit = gSwitcherGpuLinkCount;
+		for (unsigned j = i + 1; j < gSwitcherGpuLinkCount; ++j) {
+			const auto &item = gSwitcherGpuLinks[j];
+			if (item.us > producer.callback) {
+				continue;
+			}
+			if (item.event == kSwitcherGpuRuntimeBuffer && item.b == runtime.b) {
+				break;
+			}
+			if (item.event == kSwitcherGpuSubmitBuffer && item.b == runtime.b) {
+				if (submit != gSwitcherGpuLinkCount) {
+					return false;
+				}
+				submit = j;
+			}
+		}
+		if (submit == gSwitcherGpuLinkCount ||
+		    !thorSwitcherAppendSubmit(submit, producer.callback, result)) {
+			return false;
+		}
+	}
+	return result.count > 0;
+}
