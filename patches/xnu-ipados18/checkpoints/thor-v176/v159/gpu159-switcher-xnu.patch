+static bool
+thorSwitcherReportGpu(const ThorSwitcherFrame &frame, const ThorSwitcherProducer &producer)
+{
+	const ThorSwitcherGpuStages *stage = nullptr;
+	for (unsigned i = 0; !gSwitcherGpuOwnerChanged && i < gSwitcherGpuStageCount; ++i) {
+		const auto &sample = gSwitcherGpuStageRecords[i];
+		if (sample.surface == producer.surface && sample.command == producer.command &&
+		    sample.releaseTicks == producer.releaseTicks) {
+			if (stage) {
+				stage = nullptr;
+				break;
+			}
+			stage = &sample;
+		}
+	}
+	if (stage) {
+		const auto duration = [stage](unsigned i) -> long long {
+			const auto value = stage->intervals[i];
+			return value == UINT64_MAX ? -1 : static_cast<long long>(value);
+		};
+		IOLog("PONG SWITCHER V159 STAGES: swap=%u cmd=%llu us=%lld/%lld/%lld/%lld/%lld/%lld/%lld/%lld held_mask=%llx\n",
+		    frame.id, (unsigned long long)producer.command, duration(0), duration(1), duration(2),
+		    duration(3), duration(4), duration(5), duration(6), duration(7),
+		    (unsigned long long)stage->heldMask);
+	}
+
+	ThorSwitcherFenceSet set{};
+	if (!thorSwitcherMatchFences(producer, set)) {
+		return false;
+	}
+	char ids[kSwitcherGpuMaxCommandFences * 11 + 1] = {};
+	size_t used = 0;
+	unsigned recorded = 0;
+	const ThorSwitcherGpuFence *slow = nullptr;
+	for (unsigned i = 0; i < set.count; ++i) {
+		used += snprintf(ids + used, sizeof(ids) - used, "%s%u", i ? "," : "", set.fences[i]);
+		for (unsigned j = 0; j < gSwitcherGpuFenceCount; ++j) {
+			const auto &sample = gSwitcherGpuFences[j];
+			if (sample.pid != gSwitcherGpuPid || sample.fence != set.fences[i] ||
+			    sample.retired > producer.callback) {
+				continue;
+			}
+			++recorded;
+			if (!slow || sample.retired - sample.submit > slow->retired - slow->submit) {
+				slow = &sample;
+			}
+			break;
+		}
+	}
+	IOLog("PONG SWITCHER V159 JOIN: swap=%u cmd=%llu shared=%u fences=%s receipts=%u\n",
+	    frame.id, (unsigned long long)producer.command, set.shared, ids, recorded);
+	if (slow) {
+		IOLog("PONG SWITCHER V159 LINKED: swap=%u fence=%u queue_us=%llu gpu_us=%llu cp_end_est_us=%llu irq_candidate_us=%llu observed_us=%llu retired_us=%llu acquire_us=%llu\n",
+		    frame.id, slow->fence, (unsigned long long)slow->queue, (unsigned long long)slow->execute,
+		    (unsigned long long)slow->cpEnd, (unsigned long long)slow->irqCandidate,
+		    (unsigned long long)slow->observed, (unsigned long long)slow->retired,
+		    (unsigned long long)slow->acquire);
+	}
+	return true;
+}
