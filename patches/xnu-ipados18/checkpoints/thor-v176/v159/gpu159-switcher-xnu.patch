+struct ThorSwitcherFenceSet {
+	uint32_t fences[kSwitcherGpuMaxCommandFences] = {};
+	unsigned count = 0;
+	bool shared = false;
+
+	bool add(uint32_t fence)
+	{
+		for (unsigned i = 0; i < count; ++i) {
+			if (fences[i] == fence) {
+				return true;
+			}
+		}
+		if (count == kSwitcherGpuMaxCommandFences) {
+			return false;
+		}
+		fences[count++] = fence;
+		return true;
+	}
+};
