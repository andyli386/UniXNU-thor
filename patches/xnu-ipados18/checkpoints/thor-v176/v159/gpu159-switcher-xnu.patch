+		// stay in the generic trace and never imply a complete fence set.
+		if (!link.a || !link.b || link.b > UINT32_MAX || !link.e ||
+		    link.c >= link.e || !link.d || link.d > link.e - link.c) {
+			return;
+		}
+		break;
+	case kSwitcherGpuStages:
