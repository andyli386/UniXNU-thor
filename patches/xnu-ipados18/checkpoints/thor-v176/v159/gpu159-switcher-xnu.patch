+static void
+thorSwitcherReportGpuFences(unsigned joined)
+{
+	// This independent native-fence sample must not be attributed to a
+	// particular displayed frame if its user-space links were unavailable.
+	const ThorSwitcherGpuFence *worst[4] = {};
+	unsigned marked = 0, timed = 0;
+	uint64_t maxPostCp = 0, maxGpu = 0;
+	for (unsigned i = 0; i < gSwitcherGpuFenceCount; ++i) {
+		const auto &sample = gSwitcherGpuFences[i];
+		if (gSwitcherGpuOwnerChanged || !gSwitcherGpuPid || sample.pid != gSwitcherGpuPid) {
+			continue;
+		}
+		++marked;
+		if (sample.cpEnd) {
+			++timed;
+			const uint64_t gap = sample.observed - sample.cpEnd;
+			if (gap > maxPostCp) {
+				maxPostCp = gap;
+			}
+			if (sample.execute > maxGpu) {
+				maxGpu = sample.execute;
+			}
+			for (unsigned j = 0; j < sizeof(worst) / sizeof(worst[0]); ++j) {
+				if (!worst[j] || gap > worst[j]->observed - worst[j]->cpEnd) {
+					for (unsigned k = sizeof(worst) / sizeof(worst[0]) - 1; k > j; --k) {
+						worst[k] = worst[k - 1];
+					}
+					worst[j] = &sample;
+					break;
+				}
+			}
+		}
+	}
+	for (const auto *sample : worst) {
+		if (sample) {
+			IOLog("PONG SWITCHER V159 NATIVE: fence=%u submit_us=%llu queue_us=%llu gpu_us=%llu cp_end_est_us=%llu irq_candidate_us=%llu observed_us=%llu retired_us=%llu acquire_us=%llu\n",
+			    sample->fence, (unsigned long long)sample->submit, (unsigned long long)sample->queue,
+			    (unsigned long long)sample->execute, (unsigned long long)sample->cpEnd,
+			    (unsigned long long)sample->irqCandidate, (unsigned long long)sample->observed,
+			    (unsigned long long)sample->retired, (unsigned long long)sample->acquire);
+		}
+	}
+	IOLog("PONG SWITCHER V159 FENCE SUMMARY: native=%u stored=%u cp_tagged=%u fence_lost=%u links=%u link_lost=%u stages=%u stage_lost=%u joined=%u owner_change=%u max_gpu_us=%llu max_cp_to_observed_est_us=%llu\n",
+	    marked, gSwitcherGpuFenceCount, timed, gSwitcherGpuFencesLost, gSwitcherGpuLinkCount,
+	    gSwitcherGpuLinksLost, gSwitcherGpuStageCount, gSwitcherGpuStagesLost, joined, gSwitcherGpuOwnerChanged,
+	    (unsigned long long)maxGpu, (unsigned long long)maxPostCp);
+	if (gSwitcherGpuStageCount) {
+		IOLog("PONG SWITCHER V159 STAGE SCHEMA: run/prepare/hand/inbox/held/submit/poll/seen, -1=missing\n");
+	}
 }
 
