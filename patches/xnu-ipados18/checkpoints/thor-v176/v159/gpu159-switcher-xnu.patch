+static bool
+thorSwitcherClaimGpuOwner(uint32_t pid, uint64_t owner)
+{
+	/* Call under the trace lock; a process restart during capture makes the
+	 * user-space pointer graph unattributable, even if its PID is reused. */
+	if (!pid || !owner) {
+		return false;
+	}
+	if (!gSwitcherGpuOwner) {
+		gSwitcherGpuOwner = owner;
+		gSwitcherGpuPid = pid;
+	}
+	if (gSwitcherGpuOwner != owner || gSwitcherGpuPid != pid) {
+		gSwitcherGpuOwnerChanged = true;
+		return false;
+	}
+	return true;
+}
