+		constexpr uint64_t alpha = 0xff000000ff000000ull;
+		for (; x < pairedWidth; x += 4) {
+			const uint64_t ab = from[0] | alpha;
+			const uint64_t cd = from[1] | alpha;
+			to[0] = (ab & 0xffffffffull) | (ab << 32);
+			to[1] = (ab >> 32) | (cd << 32);
+			to[2] = cd;
+			from += 2;
+			to += 3;
+		}
+		panel = reinterpret_cast<uint32_t *>(to);
+	}
+#endif
+	for (; x < sourceWidth; x += 2) {
+		const uint32_t a = source[x] | 0xff000000u;
+		const uint32_t b = source[x + 1] | 0xff000000u;
+		panel[0] = a;
+		panel[1] = a;
+		panel[2] = b;
+		panel += 3;
+	}
+}
