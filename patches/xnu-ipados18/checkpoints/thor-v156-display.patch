+/*
+ * Thor L1 timing programs contain one exact 260-byte embedded DMA batch
+ * per mode. Landings with an unproven APPS SMMU context must not allocate
+ * or start a command. A successful standard DCS NOP precedes the timing
+ * commands, using the same fresh physical page and DMA settings.
+ */
+extern "C" void flush_dcache64(addr64_t address, unsigned length, int physical);
+
+constexpr uint32_t kThorDsiControl = 0x04;
+constexpr uint32_t kThorDsiStatus = 0x08;
+constexpr uint32_t kThorDsiDmaControl = 0x3c;
+constexpr uint32_t kThorDsiDmaOffset = 0x48;
+constexpr uint32_t kThorDsiDmaLength = 0x4c;
+constexpr uint32_t kThorDsiFifo = 0x50;
+constexpr uint32_t kThorDsiTriggerControl = 0x84;
+constexpr uint32_t kThorDsiDmaTrigger = 0x90;
+constexpr uint32_t kThorDsiIrq = 0x110;
+constexpr uint32_t kThorDsiPattern = 0x15c;
+constexpr uint32_t kThorDsiBusy = 6;
+constexpr uint32_t kThorDsiDmaDone = 1;
+constexpr uint32_t kThorDsiError = 1u << 24;
+constexpr uint32_t kThorDsiIrqEnables = (1u << 1) | (1u << 9) | (1u << 11) | (1u << 13) |
+    (1u << 15) | (1u << 17) | (1u << 21) | (1u << 25) | (1u << 29) | (1u << 31);
+static constexpr uint8_t kThorDsiNop[] = { 0x00, 0x00, 0x05, 0x80 };
+
+static constexpr uint64_t kThorScratchLeaseBytes = 18ull << 20;
+static constexpr IOByteCount kThorScratchBytes = 5760ull * 3200;
+constexpr IOByteCount kThorDsiCommandPageBytes = 4096;
+static_assert(kThorScratchBytes <= kThorScratchLeaseBytes - kThorDsiCommandPageBytes);
+static_assert(sizeof(kThorDsiWqhd120) == sizeof(kThorDsiWqhd60));
+static_assert(sizeof(kThorDsiWqhd120) <= kThorDsiCommandPageBytes);
+
+extern "C" bool pmap_pong_pa_valid(uint64_t);
+
+static uint64_t
+thorDpuReservedScratch()
+{
+	IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	if (!chosen) return 0;
+	auto *data = OSDynamicCast(OSData, chosen->getProperty("thor-native-scanout"));
+	uint64_t range[2] = {};
+	if (data && data->getLength() == sizeof(range)) memcpy(range, data->getBytesNoCopy(), sizeof(range));
+	chosen->release();
+
+	const uint64_t physical = range[0];
+	if (range[1] != kThorScratchLeaseBytes || physical < 0xf8000000 || physical > 0xffc00000 - kThorScratchLeaseBytes ||
+	    (physical & 4095) || !pmap_pong_pa_valid(physical + kThorScratchLeaseBytes)) return 0;
+	for (uint64_t page = physical; page < physical + kThorScratchLeaseBytes; page += 4096) {
+		if (pmap_pong_pa_valid(page)) return 0;
+	}
+	return physical;
+}
+
+struct ThorDsiCommandBuffer {
+	IOBufferMemoryDescriptor *allocated = nullptr;
+	IOMemoryDescriptor *reserved = nullptr;
+	IOMemoryMap *mapping = nullptr;
+	void *cpu = nullptr;
+	uint32_t physical = 0;
+	bool retainForDma = false;
+
+	~ThorDsiCommandBuffer()
+	{
+		if (retainForDma) return;
+		if (mapping) mapping->release();
+		if (reserved) reserved->release();
+		if (allocated) {
+			(void) allocated->complete();
+			allocated->release();
+		}
+	}
+};
+
+enum ThorDsiTransfer { ThorDsiNotStarted, ThorDsiComplete, ThorDsiFailedIdle, ThorDsiRetain };
+
+static void
+thorDsiWrite(vm_offset_t regs, uint32_t offset, uint32_t value)
+{
+	*reinterpret_cast<volatile uint32_t *>(regs + offset) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static ThorDsiTransfer
+thorDsiTransferBatch(const ThorDpuMappings &map, const ThorDsiInstance &dsi, uint64_t framebuffer,
+    vm_offset_t regs, const ThorDsiCommandBuffer &memory,
+    const uint8_t *program, size_t bytes, const char *tag)
+{
+	if (!thorDsiDomainAudit(map, dsi) || !thorDpuRefreshRouteMatches(map, framebuffer) ||
+	    !thorDsiClocksReady(map, dsi, 0) || thorDpuRead(regs) != 0x20060000 ||
+	    thorDpuRead(regs + kThorDsiControl) != 0x1f5 ||
+	    (thorDpuRead(regs + kThorDsiPattern) & 7u) || (thorDpuRead(regs + kThorDsiIrq) & kThorDsiError)) {
+		IOLog("THOR DSI 120: %s skipped; controller or context changed\n", tag);
+		return ThorDsiNotStarted;
+	}
+	const uint32_t physical = memory.physical;
+	memcpy(memory.cpu, program, bytes);
+	/* Firmware-reserved memory has a cacheable CPU alias outside the direct map. */
+	if (memory.mapping) {
+		flush_dcache64(reinterpret_cast<addr64_t>(memory.cpu), static_cast<unsigned>(bytes), 0);
+	} else {
+		flush_dcache64(physical, static_cast<unsigned>(bytes), 1);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	char receipt[140];
+	snprintf(receipt, sizeof(receipt), "THOR DSI 120: %s awaiting command window pa=%#x bytes=%zu\n", tag, physical, bytes);
+	thorDpuMarker(receipt);
+	for (unsigned i = 0; i < 1250 && (thorDpuRead(regs + kThorDsiStatus) & kThorDsiBusy); ++i) {
+		IODelay(20);
+	}
+	if (!thorDsiClocksReady(map, dsi, 0) || (thorDpuRead(regs + kThorDsiStatus) & kThorDsiBusy) ||
+	    (thorDpuRead(regs + kThorDsiIrq) & kThorDsiError)) return ThorDsiNotStarted;
+	const uint32_t ctrl = thorDpuRead(regs + kThorDsiDmaControl);
+	const uint32_t offset = thorDpuRead(regs + kThorDsiDmaOffset);
+	const uint32_t length = thorDpuRead(regs + kThorDsiDmaLength);
+	const uint32_t fifo = thorDpuRead(regs + kThorDsiFifo);
+	const uint32_t trigger = thorDpuRead(regs + kThorDsiTriggerControl);
+	if (ctrl != 0x14000000 || trigger != 0x80000004) {
+		IOLog("THOR DSI 120: %s unexpected retained DMA ctrl=%#x trigger=%#x\n", tag, ctrl, trigger);
+		return ThorDsiNotStarted;
+	}
+
+	/* Vendor embedded HS mode. Leave unrelated interrupt state intact. */
+	thorDsiWrite(regs, kThorDsiIrq, (thorDpuRead(regs + kThorDsiIrq) & kThorDsiIrqEnables) | kThorDsiDmaDone);
+	if (thorDpuRead(regs + kThorDsiIrq) & (kThorDsiDmaDone | kThorDsiError)) return ThorDsiNotStarted;
+	thorDsiWrite(regs, kThorDsiDmaControl, ctrl & ~(1u << 26));
+	thorDsiWrite(regs, kThorDsiFifo, fifo | (1u << 20) | (1u << 16));
+	thorDsiWrite(regs, kThorDsiDmaOffset, physical);
+	thorDsiWrite(regs, kThorDsiDmaLength, static_cast<uint32_t>(bytes));
+	thorDsiWrite(regs, kThorDsiDmaTrigger, 1);
+
+	uint32_t irq = 0, status = 0;
+	bool complete = false;
+	for (unsigned i = 0; i < 1250; ++i) {
+		irq = thorDpuRead(regs + kThorDsiIrq);
+		status = thorDpuRead(regs + kThorDsiStatus);
+		complete = (irq & kThorDsiDmaDone) && !(status & (1u << 1));
+		if (complete || (irq & kThorDsiError)) break;
+		IODelay(20);
+	}
+	if (!thorDsiClocksReady(map, dsi, 0)) return ThorDsiRetain;
+	if (thorDpuRead(regs + kThorDsiStatus) & (1u << 1)) {
+		thorDpuMarker("THOR DSI 120: DMA still busy; retain fresh command page and do not touch controller\n");
+		return ThorDsiRetain;
+	}
+	thorDsiWrite(regs, kThorDsiIrq, (thorDpuRead(regs + kThorDsiIrq) & kThorDsiIrqEnables) | kThorDsiDmaDone);
+	thorDsiWrite(regs, kThorDsiDmaOffset, offset);
+	thorDsiWrite(regs, kThorDsiDmaLength, length);
+	thorDsiWrite(regs, kThorDsiFifo, fifo);
+	thorDsiWrite(regs, kThorDsiDmaControl, ctrl);
+	const bool pass = complete && !(irq & kThorDsiError);
+	IOLog("THOR DSI 120: %s result=%s status=%#x irq=%#x\n", tag, pass ? "done" : "failed", status, irq);
+	return pass ? ThorDsiComplete : ThorDsiFailedIdle;
+}
+
+static uint32_t
+thorDsiMeasurePanel(const ThorDpuMappings &map, const ThorDsiInstance &dsi)
+{
+	if (!thorDsiClocksReady(map, dsi, 0)) return 0;
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	const uint32_t frames = thorDpuRead(intf + kThorIntfFrameCount);
+	const uint64_t began = mach_absolute_time();
+	IOSleep(300);
+	if (!thorDsiClocksReady(map, dsi, 0) ||
+	    thorDpuRead(intf + kThorIntfAutorefresh) != kThorRefreshEachTe) return 0;
+	const uint32_t delta = thorDpuRead(intf + kThorIntfFrameCount) - frames;
+	uint64_t elapsed = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - began, &elapsed);
+	if (!elapsed || delta > 100) return 0;
+	const uint32_t tenths = static_cast<uint32_t>(delta * 10000000000ull / elapsed);
+	IOLog("THOR DSI 120: hardware frames=%u elapsed_us=%llu refresh_tenths=%u\n",
+	    delta, elapsed / 1000, tenths);
+	return tenths;
+}
+
+static bool
+thorDsiPrepareCommandBuffer(ThorDsiCommandBuffer &buffer)
+{
+	const uint64_t lease = thorDpuReservedScratch();
+	if (lease) {
+		/* This last page is outside the DPU scratch pixels and OS-managed RAM. */
+		const uint64_t address = lease + kThorScratchLeaseBytes - kThorDsiCommandPageBytes;
+		auto *memory = IOMemoryDescriptor::withPhysicalAddress(address, kThorDsiCommandPageBytes, kIODirectionInOut);
+		auto *mapping = memory ? memory->createMappingInTask(kernel_task, 0,
+		    kIOMapAnywhere | kIOMapCopybackCache) : nullptr;
+		if (mapping && mapping->getLength() == kThorDsiCommandPageBytes && mapping->getAddress()) {
+			buffer.reserved = memory;
+			buffer.mapping = mapping;
+			buffer.cpu = reinterpret_cast<void *>(mapping->getAddress());
+			buffer.physical = static_cast<uint32_t>(address);
+			IOLog("THOR DSI 120: dedicated firmware command page pa=%#llx\n", address);
+			return true;
+		}
+		if (mapping) mapping->release();
+		if (memory) memory->release();
+		thorDpuMarker("THOR DSI 120: firmware command page map failed; try low contiguous pages\n");
+	}
+
+	constexpr IOByteCount allocationBytes = 2 * kThorDsiCommandPageBytes;
+	constexpr uint64_t dmaLimit = 1ull << 32;
+	/* IOMallocContiguous will bypass the physical ceiling for a single
+	 * page on ARM64. Two pages take the bounded contiguous VM path. */
+	IOBufferMemoryDescriptor *memory = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+	    static_cast<IOOptionBits>(kIODirectionInOut) | static_cast<IOOptionBits>(kIOMemoryMapperNone) |
+	    kIOMemoryPhysicallyContiguous, allocationBytes, dmaLimit - page_size);
+	if (!memory) {
+		thorDpuMarker("THOR DSI 120: skipped; no fresh low contiguous command pages\n");
+		return false;
+	}
+	const IOReturn prepared = memory->prepare();
+	if (prepared != kIOReturnSuccess) {
+		IOLog("THOR DSI 120: low contiguous pages prepare failed=%#x\n", static_cast<unsigned>(prepared));
+		memory->release();
+		return false;
+	}
+	IOByteCount segment = 0, tail = 0;
+	const uint64_t address = memory->getPhysicalSegment(0, &segment, kIOMemoryMapperNone);
+	const uint64_t last = memory->getPhysicalSegment(allocationBytes - 1, &tail, kIOMemoryMapperNone);
+	const uint64_t descriptorBytes = memory->getLength();
+	void *const cpu = memory->getBytesNoCopy();
+	const bool hasBuffer = cpu != nullptr;
+	IOLog("THOR DSI 120: low contiguous pages pa=%#llx seg=%llu last=%#llx tail=%llu descriptor=%llu kva=%u\n",
+	    address, static_cast<uint64_t>(segment), last, static_cast<uint64_t>(tail), descriptorBytes, hasBuffer ? 1u : 0u);
+	if (!address || (address & (page_size - 1)) || address > dmaLimit - allocationBytes ||
+	    segment < allocationBytes || !tail || last != address + allocationBytes - 1 ||
+	    descriptorBytes != allocationBytes || !hasBuffer) {
+		thorDpuMarker("THOR DSI 120: skipped; fresh DMA pages failed physical range validation\n");
+		(void) memory->complete();
+		memory->release();
+		return false;
+	}
+	buffer.allocated = memory;
+	buffer.cpu = cpu;
+	buffer.physical = static_cast<uint32_t>(address);
+	return true;
+}
+
+static bool
+thorDsiTry120(const ThorDpuMappings &map, const ThorDsiInstance &dsi, uint64_t framebuffer)
+{
+	bool qualified = false;
+	uint32_t enabled = 1;
+	(void) PE_parse_boot_argn("thor_dsi_120", &enabled, sizeof(enabled));
+	if (!enabled || !thorDsiDomainAudit(map, dsi)) {
+		thorDpuMarker("THOR DSI 120: skipped; fixed display identity context was not qualified\n");
+		return false;
+	}
+	const uint32_t initial = thorDsiMeasurePanel(map, dsi);
+	if (initial < 550 || initial > 650) {
+		IOLog("THOR DSI 120: skipped; initial hardware frequency out of range (%u)\n", initial);
+		return false;
+	}
+
+	if (page_size != kThorDsiCommandPageBytes) {
+		thorDpuMarker("THOR DSI 120: skipped; unexpected ARM64 VM page size\n");
+		return false;
+	}
+	ThorDsiCommandBuffer memory;
+	if (!thorDsiPrepareCommandBuffer(memory)) return false;
+
+	const vm_offset_t regs = io_map(dsi.address, 0x1000, VM_WIMG_IO, VM_PROT_READ | VM_PROT_WRITE, true);
+	if (!regs) {
+		thorDpuMarker("THOR DSI 120: skipped; no command controller write mapping\n");
+		return false;
+	}
+	ThorDsiTransfer result = thorDsiTransferBatch(map, dsi, framebuffer, regs, memory,
+	    kThorDsiNop, sizeof(kThorDsiNop), "NOP");
+	if (result == ThorDsiComplete) {
+		result = thorDsiTransferBatch(map, dsi, framebuffer, regs, memory,
+		    kThorDsiWqhd120, sizeof(kThorDsiWqhd120), "switch120");
+		if (result == ThorDsiComplete) {
+			/* The first rate window can straddle the 60/120 timing
+			 * transition even after command DMA has completed. */
+			IOSleep(150);
+			uint32_t after = thorDsiMeasurePanel(map, dsi);
+			if (after < 1130 || after > 1270) {
+				thorDpuMarker("THOR DSI 120: first settled sample out of range, remeasure before rollback\n");
+				after = thorDsiMeasurePanel(map, dsi);
+			}
+			if (after >= 1130 && after <= 1270) {
+				qualified = true;
+				thorDpuMarker("THOR DSI 120: PASS actual ~120 Hz hardware scanout measured\n");
+			} else {
+				thorDpuMarker("THOR DSI 120: hardware rate not qualified, try stock 60 Hz rollback\n");
+				result = thorDsiTransferBatch(map, dsi, framebuffer, regs, memory,
+				    kThorDsiWqhd60, sizeof(kThorDsiWqhd60), "restore60");
+				if (result == ThorDsiComplete) (void) thorDsiMeasurePanel(map, dsi);
+			}
+		} else if (result == ThorDsiFailedIdle) {
+			thorDpuMarker("THOR DSI 120: incomplete switch while idle, try stock 60 Hz rollback\n");
+			result = thorDsiTransferBatch(map, dsi, framebuffer, regs, memory,
+			    kThorDsiWqhd60, sizeof(kThorDsiWqhd60), "restore60");
+			if (result == ThorDsiComplete) (void) thorDsiMeasurePanel(map, dsi);
+		}
+	}
+	ml_io_unmap(regs, 0x1000);
+	memory.retainForDma = result == ThorDsiRetain;
+	return qualified;
+}
+
+static void
+thorDsiTimingPreflight(const ThorDpuMappings &map, vm_offset_t regs, const ThorDsiInstance &dsi,
+    unsigned index, uint32_t control)
+{
+	if (index != 0 || control != 0x1f5 || !thorDsiClocksReady(map, dsi, index)) return;
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[index];
+	if (thorDpuRead(intf + kThorIntfAutorefresh) != kThorRefreshEachTe) return;
+
+	constexpr uint32_t BusyMask = (1u << 1) | (1u << 2);
+	constexpr uint32_t ErrorPending = 1u << 24;
+	const uint32_t dmaControl = thorDpuRead(regs + 0x03c);
+	const uint32_t dmaOffset = thorDpuRead(regs + 0x048);
+	const uint32_t dmaLength = thorDpuRead(regs + 0x04c);
+	const uint32_t trigger = thorDpuRead(regs + 0x084);
+	const uint32_t pattern = thorDpuRead(regs + 0x15c);
+	const uint32_t irq = thorDpuRead(regs + 0x110);
+	const uint32_t stream = thorDpuRead(regs + 0x058);
+	const uint32_t extent = thorDpuRead(regs + 0x05c);
+	IOLog("THOR DSI TIMING: id=0 dma_ctrl=%#x dma_offset=%#x dma_len=%#x "
+	    "trigger=%#x pattern=%#x irq=%#x stream0=%#x extent0=%#x\n",
+	    dmaControl, dmaOffset, dmaLength, trigger, pattern, irq, stream, extent);
+
+	unsigned samples = 0, idle = 0, error = 0, consecutiveIdle = 0, maxConsecutiveIdle = 0;
+	const uint32_t frameAtStart = thorDpuRead(intf + kThorIntfFrameCount);
+	const uint64_t start = mach_absolute_time();
+	for (; samples < 48; ++samples) {
+		if (!thorDsiClocksReady(map, dsi, index)) return;
+		if (!(thorDpuRead(map.mdss + 0x16000 + kThorCtlIntfActive) & dsi.route) ||
+		    thorDpuRead(regs + 0x004) != control) return;
+
+		const bool irqError = (thorDpuRead(regs + 0x110) & ErrorPending) != 0;
+		if (irqError) ++error;
+		if (!(thorDpuRead(regs + 0x008) & BusyMask) && !irqError) {
+			++idle;
+			++consecutiveIdle;
+			if (consecutiveIdle > maxConsecutiveIdle) maxConsecutiveIdle = consecutiveIdle;
+		} else {
+			consecutiveIdle = 0;
+		}
+		IOSleep(1);
+	}
+	if (!thorDsiClocksReady(map, dsi, index)) return;
+	const uint32_t frameAtEnd = thorDpuRead(intf + kThorIntfFrameCount);
+	uint64_t elapsed = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - start, &elapsed);
+	IOLog("THOR DSI TIMING: samples=%u idle=%u irq_error=%u max_consecutive_idle=%u "
+	    "elapsed_us=%llu intf_frames=%u\n",
+	    samples, idle, error, maxConsecutiveIdle, elapsed / 1000, frameAtEnd - frameAtStart);
+	thorDpuMarker("THOR DSI TIMING: L1 WQHD 60/120 each 29 packets, 260-byte batch, "
+	    "FIFO 64 bytes, command DMA not qualified; no commands sent\n");
+}
+
+/* Sample hardware during real interaction as well as at startup. The worker
+ * sleeps outside the presenter and reads only the already-qualified route. */
+static void
+thorDpuInteractionAudit(const ThorDpuMappings &map, uint64_t framebuffer)
+{
+	uint32_t enabled = 1;
+	(void) PE_parse_boot_argn("thor_dpu_interaction", &enabled, sizeof(enabled));
+	if (!enabled) return;
+
+	uint64_t deadline, cooldown = 0;
+	clock_interval_to_deadline(20 * 60, NSEC_PER_SEC, &deadline);
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	for (unsigned samples = 0; samples < 8 && mach_absolute_time() < deadline;) {
+		IOSleep(200);
+		const uint64_t touch = pong_touch_last_event_time();
+		const uint64_t now = mach_absolute_time();
+		if (!touch || touch > now || now < cooldown) continue;
+		uint64_t touchAge;
+		absolutetime_to_nanoseconds(now - touch, &touchAge);
+		if (touchAge > 300 * NSEC_PER_MSEC) continue;
+		clock_interval_to_deadline(10, NSEC_PER_SEC, &cooldown);
+		++samples;
+		if (!thorDpuRefreshRouteMatches(map, framebuffer)) {
+			IOLog("THOR DPU INTERACTION: sample=%u skip guard\n", samples);
+			continue;
+		}
+		const uint32_t configStart = thorDpuRead(intf + kThorIntfAutorefresh);
+		const uint32_t countStart = thorDpuRead(intf + kThorIntfFrameCount);
+		const uint64_t enqueues = __atomic_load_n(&gThorFrameEnqueues, __ATOMIC_RELAXED);
+		const uint64_t writebacks = __atomic_load_n(&gThorFrameWritebacks, __ATOMIC_RELAXED);
+		const uint64_t start = mach_absolute_time();
+		IOSleep(750);
+		if (!thorDpuRefreshRouteMatches(map, framebuffer)) {
+			IOLog("THOR DPU INTERACTION: sample=%u skip route or clocks changed\n", samples);
+			continue;
+		}
+		const uint32_t configEnd = thorDpuRead(intf + kThorIntfAutorefresh);
+		const uint32_t countEnd = thorDpuRead(intf + kThorIntfFrameCount);
+		const uint64_t enqueueDelta = __atomic_load_n(&gThorFrameEnqueues, __ATOMIC_RELAXED) - enqueues;
+		const uint64_t writebackDelta = __atomic_load_n(&gThorFrameWritebacks, __ATOMIC_RELAXED) - writebacks;
+		const uint64_t end = mach_absolute_time();
+		uint64_t touchNs, startNs, elapsedNs;
+		absolutetime_to_nanoseconds(touch, &touchNs);
+		absolutetime_to_nanoseconds(start, &startNs);
+		absolutetime_to_nanoseconds(end - start, &elapsedNs);
+		IOLog("THOR DPU INTERACTION: sample=%u touch_us=%llu start_us=%llu elapsed_us=%llu "
+		    "frames=%u delta=%u enqueued=%llu written=%llu auto_before=%#x auto_after=%#x\n",
+		    samples, touchNs / 1000, startNs / 1000, elapsedNs / 1000,
+		    countEnd, countEnd - countStart, enqueueDelta, writebackDelta, configStart, configEnd);
+	}
+}
+
+static bool
+thorDsiAudit(const ThorDpuMappings &map, uint64_t framebuffer, uint32_t active)
+{
+	uint32_t enabled = 1;
+	(void) PE_parse_boot_argn("thor_dsi_audit", &enabled, sizeof(enabled));
+	if (!enabled || !thorDpuRefreshRouteMatches(map, framebuffer)) return false;
+	bool panel120 = false;
+
+	for (unsigned i = 0; i < sizeof(kThorDsi) / sizeof(kThorDsi[0]); ++i) {
+		const auto &dsi = kThorDsi[i];
+		if (!(active & dsi.route)) {
+			IOLog("THOR DSI AUDIT: id=%u skip no active INTF route (mask=%#x)\n", i, active);
+			continue;
+		}
+		if (!thorDsiClocksReady(map, dsi, i)) continue;
+		const vm_offset_t regs = io_map(dsi.address, 0x1000, VM_WIMG_IO, VM_PROT_READ, true);
+		if (!regs) {
+			IOLog("THOR DSI AUDIT: id=%u skip controller map unavailable\n", i);
+			continue;
+		}
+		if (thorDsiClocksReady(map, dsi, i) &&
+		    (thorDpuRead(map.mdss + 0x16000 + kThorCtlIntfActive) & dsi.route)) {
+			thorDpuMarker(i == 0 ? "THOR DSI AUDIT: DSI0 guards passed, before first controller read\n" :
+			    "THOR DSI AUDIT: DSI1 guards passed, before first controller read\n");
+			const uint32_t version = thorDpuRead(regs);
+			if (version == 0x20060000) {
+				const uint32_t control = thorDpuRead(regs + 0x04);
+				const uint32_t status = thorDpuRead(regs + 0x08);
+				IOLog("THOR DSI AUDIT: id=%u ver=%#x ctrl=%#x status=%#x cmd_enabled=%u "
+				    "video_enabled=%u dma_busy=%u mdp_busy=%u panel_identity=unmeasured\n",
+				    i, version, control, status, (control & 5u) == 5u, (control >> 1) & 1,
+				    (status >> 1) & 1, (status >> 2) & 1);
+				if ((control & 7u) == 5u) {
+					const vm_offset_t intf = map.mdss + kThorIntfOffset[i];
+					IOLog("THOR DSI AUDIT: id=%u intf=%u tear=%#x sync=%#x int_count=%#x line=%#x auto=%#x\n",
+					    i, i + 1, thorDpuRead(intf + kThorIntfTearCheck), thorDpuRead(intf + 0x288),
+					    thorDpuRead(intf + 0x298), thorDpuRead(intf + 0x2b0),
+					    thorDpuRead(intf + kThorIntfAutorefresh));
+					thorDsiTimingPreflight(map, regs, dsi, i, control);
+					if (i == 0 && control == 0x1f5) panel120 = thorDsiTry120(map, dsi, framebuffer);
+				}
+			} else {
+				IOLog("THOR DSI AUDIT: id=%u skip unexpected version=%#x\n", i, version);
+			}
+		}
+		ml_io_unmap(regs, 0x1000);
+	}
+	thorDpuMarker("THOR DSI AUDIT: complete\n");
+	return panel120;
+}
+
+/* The live Cape DT advertises QSEED3 at VIG + 0xa00. Qualcomm's
+ * QSEED3_HW_VERSION register is the first word of that sub-block.
+ * Read only the qualified CTL0, VIG0/1 and INTF1 register blocks. */
+static void
+thorDpuFlipAudit(const ThorDpuMappings &map, uint64_t framebuffer)
+{
+	if (!thorDpuRefreshRouteMatches(map, framebuffer)) return;
+	const vm_offset_t ctl = map.mdss + 0x16000;
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	if (thorDpuRead(intf + kThorIntfAutorefresh) != kThorRefreshEachTe) return;
+
+	thorDpuMarker("THOR DPU FLIP AUDIT: CTL0 VIG0/1 INTF1 read-only snapshot\n");
+	const uint32_t layer0 = thorDpuRead(ctl + 0x00);
+	const uint32_t layer1 = thorDpuRead(ctl + 0x04);
+	const uint32_t top = thorDpuRead(ctl + 0x14);
+	const uint32_t flush = thorDpuRead(ctl + 0x18);
+	const uint32_t interfaces = thorDpuRead(ctl + kThorCtlIntfActive);
+	const uint32_t pipes = thorDpuRead(ctl + kThorCtlFetchActive);
+	struct PipeState {
+		uint32_t srcXY, outXY, unpack, opMode, qseedVersion;
+	} state[2];
+	for (unsigned i = 0; i < 2; ++i) {
+		if (!thorDpuClocksReady(map)) return;
+		const vm_offset_t pipe = map.mdss + kThorSsppOffset[i];
+		state[i] = {thorDpuRead(pipe + 0x08), thorDpuRead(pipe + 0x10),
+		    thorDpuRead(pipe + 0x34), thorDpuRead(pipe + 0x38),
+		    thorDpuRead(pipe + 0xa00)};
+	}
+	if (!thorDpuClocksReady(map)) return;
+	const uint32_t te = thorDpuRead(intf + kThorIntfTearCheck);
+	const uint32_t sync = thorDpuRead(intf + 0x288);
+	const uint32_t intCount = thorDpuRead(intf + 0x298);
+	const uint32_t line = thorDpuRead(intf + 0x2b0);
+	const uint32_t autorefresh = thorDpuRead(intf + kThorIntfAutorefresh);
+	const uint32_t frames = thorDpuRead(intf + kThorIntfFrameCount);
+	if (!thorDpuRefreshRouteMatches(map, framebuffer) || autorefresh != kThorRefreshEachTe ||
+	    layer0 != thorDpuRead(ctl + 0x00) || layer1 != thorDpuRead(ctl + 0x04)) return;
+
+	IOLog("THOR DPU FLIP AUDIT: ctl0 lm0=%#x lm1=%#x top=%#x flush=%#x intf=%#x fetch=%#x\n",
+	    layer0, layer1, top, flush, interfaces, pipes);
+	for (unsigned i = 0; i < 2; ++i) {
+		IOLog("THOR DPU FLIP AUDIT: vig%u src_xy=%#x out_xy=%#x unpack=%#x op=%#x qseed_ver=%#x\n",
+		    i, state[i].srcXY, state[i].outXY, state[i].unpack,
+		    state[i].opMode, state[i].qseedVersion);
+	}
+	IOLog("THOR DPU FLIP AUDIT: intf1 te=%#x sync=%#x int_count=%#x line=%#x auto=%#x frames=%u\n",
+	    te, sync, intCount, line, autorefresh, frames);
+}
+
+static constexpr uint32_t kThorFlipMask = (1u << 17) | 3u;
+static constexpr unsigned kThorCtlFlush = 0x18;
+static constexpr unsigned kThorSsppSource = 0x14;
+
+struct ThorDpuScratch {
+	IOMemoryDescriptor *memory = nullptr;
+	IOMemoryMap *mapping = nullptr;
+
+	~ThorDpuScratch()
+	{
+		if (mapping) mapping->release();
+		if (memory) memory->release();
+	}
+};
+
+struct ThorDpuFlipMaps {
+	vm_offset_t ctl = 0;
+	vm_offset_t pipes[2] = {};
+
+	~ThorDpuFlipMaps()
+	{
+		if (ctl) ml_io_unmap(ctl, 0x1000);
+		for (auto pipe : pipes) {
+			if (pipe) ml_io_unmap(pipe, 0x1000);
+		}
+	}
+};
+
+static bool
+thorDpuScratchRoute(const ThorDpuMappings &map, uint32_t address, uint32_t &pending, uint32_t alternate = 0)
+{
+	if (!thorDpuClocksReady(map)) return false;
+	const vm_offset_t ctl = map.mdss + 0x16000;
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	pending = thorDpuRead(ctl + kThorCtlFlush);
+	if ((pending & ~kThorFlipMask) ||
+	    thorDpuRead(ctl) != 0x100002d || thorDpuRead(ctl + 4) != 0x100002d ||
+	    thorDpuRead(ctl + 0x14) != 0xf0020000 ||
+	    thorDpuRead(ctl + kThorCtlIntfActive) != 0x2 ||
+	    thorDpuRead(ctl + kThorCtlFetchActive) != 0x30000 ||
+	    thorDpuRead(intf + kThorIntfTearCheck) != 1 ||
+	    thorDpuRead(intf + kThorIntfAutorefresh) != kThorRefreshEachTe) return false;
+	for (unsigned i = 0; i < 2; ++i) {
+		const vm_offset_t pipe = map.mdss + kThorSsppOffset[i];
+		const uint32_t x = i * 720;
+		const uint32_t source = thorDpuRead(pipe + kThorSsppSource);
+		if (thorDpuRead(pipe) != 0x0c8002d0 || thorDpuRead(pipe + 0x0c) != 0x0c8002d0 ||
+		    thorDpuRead(pipe + 0x08) != x || thorDpuRead(pipe + 0x10) != x ||
+		    (source != address && (!alternate || source != alternate)) ||
+		    thorDpuRead(pipe + 0x24) != 0x1680 || thorDpuRead(pipe + 0x30) != 0x237ff ||
+		    thorDpuRead(pipe + 0x34) != 0x3020001 || thorDpuRead(pipe + 0x38) != 0x80000000) return false;
+	}
+	return true;
+}
+
+enum ThorDpuScratchFlip { ThorDpuScratchSkipped, ThorDpuScratchPending, ThorDpuScratchLatched };
+
+static ThorDpuScratchFlip
+thorDpuScratchSubmit(const ThorDpuMappings &map, const ThorDpuFlipMaps &write,
+    uint32_t original, uint32_t address, const char *stage)
+{
+	uint32_t pending = 0;
+	if (!thorDpuScratchRoute(map, original, pending) || pending != 0) {
+		IOLog("THOR DPU SCRATCH: %s skipped before MMIO, route or flush changed\n", stage);
+		return ThorDpuScratchSkipped;
+	}
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	const uint32_t before = thorDpuRead(intf + kThorIntfFrameCount);
+	for (auto pipe : write.pipes) {
+		*reinterpret_cast<volatile uint32_t *>(pipe + kThorSsppSource) = address;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	*reinterpret_cast<volatile uint32_t *>(write.ctl + kThorCtlFlush) = kThorFlipMask;
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	bool sawPending = false, latched = false;
+	uint32_t scans = 0;
+	for (unsigned attempt = 0; attempt < 160; ++attempt) {
+		if (!thorDpuScratchRoute(map, address, pending, original)) break;
+		sawPending |= pending != 0;
+		scans = thorDpuRead(intf + kThorIntfFrameCount) - before;
+		if (sawPending && !pending && scans >= 2 && scans <= 8 &&
+		    thorDpuScratchRoute(map, address, pending) && !pending) {
+			latched = true;
+			break;
+		}
+		IODelay(250);
+	}
+	IOLog("THOR DPU SCRATCH: %s addr=%#x pending_seen=%u flush=%#x scans=%u result=%s\n",
+	    stage, address, sawPending ? 1u : 0u, pending, scans, latched ? "latched" : "unconfirmed");
+	return latched ? ThorDpuScratchLatched : ThorDpuScratchPending;
+}
+
+static void
+thorDpuScratchTrial(const ThorDpuMappings &map, uint64_t framebuffer, const uint8_t *source, IOLock *lock)
+{
+	if (page_size != 4096 || !source || !lock || !thorDpuRefreshRouteMatches(map, framebuffer) ||
+	    !thorDsiDomainAudit(map, kThorDsi[0])) return;
+
+	ThorDpuFlipMaps write;
+	write.ctl = io_map(kThorMdss + 0x16000, 0x1000, VM_WIMG_IO, VM_PROT_READ | VM_PROT_WRITE, true);
+	for (unsigned i = 0; i < 2; ++i) {
+		write.pipes[i] = io_map(kThorMdss + kThorSsppOffset[i], 0x1000,
+		    VM_WIMG_IO, VM_PROT_READ | VM_PROT_WRITE, true);
+	}
+	if (!write.ctl || !write.pipes[0] || !write.pipes[1]) {
+		thorDpuMarker("THOR DPU SCRATCH: SKIP write aliases unavailable\n");
+		return;
+	}
+
+	const uint32_t original = static_cast<uint32_t>(framebuffer);
+	if (thorDpuScratchSubmit(map, write, original, original, "same-address") != ThorDpuScratchLatched) return;
+
+	const uint64_t physical = thorDpuReservedScratch();
+	if (!physical) {
+		thorDpuMarker("THOR DPU SCRATCH: SKIP no separate firmware lease\n");
+		return;
+	}
+	ThorDpuScratch scratch;
+	scratch.memory = IOMemoryDescriptor::withPhysicalAddress(physical, kThorScratchBytes, kIODirectionInOut);
+	if (scratch.memory) {
+		scratch.mapping = scratch.memory->createMappingInTask(kernel_task, 0,
+		    kIOMapAnywhere | kIOMapCopybackCache);
+	}
+	if (!scratch.mapping || scratch.mapping->getLength() != kThorScratchBytes ||
+	    !scratch.mapping->getAddress()) {
+		thorDpuMarker("THOR DPU SCRATCH: SKIP dedicated buffer mapping failed\n");
+		return;
+	}
+	const vm_offset_t pixels = scratch.mapping->getAddress();
+	IOLog("THOR DPU SCRATCH: dedicated firmware buffer pa=%#llx bytes=%llu pitch=5760\n",
+	    physical, static_cast<uint64_t>(kThorScratchBytes));
+	if (!IOLockTryLock(lock)) {
+		thorDpuMarker("THOR DPU SCRATCH: SKIP presenter busy at snapshot\n");
+		return;
+	}
+	memcpy(reinterpret_cast<void *>(pixels), source, kThorScratchBytes);
+	IOLockUnlock(lock);
+
+	constexpr unsigned chunk = 64 * 1024;
+	for (IOByteCount offset = 0; offset < kThorScratchBytes; offset += chunk) {
+		const IOByteCount left = kThorScratchBytes - offset;
+		flush_dcache64(pixels + offset, static_cast<unsigned>(left < chunk ? left : chunk), 0);
+	}
+	if (!IOLockTryLock(lock)) {
+		thorDpuMarker("THOR DPU SCRATCH: SKIP presenter busy at switch\n");
+		return;
+	}
+
+	const uint32_t address = static_cast<uint32_t>(physical);
+	thorDpuMarker("THOR DPU SCRATCH: before fresh source submission\n");
+	const auto submitted = thorDpuScratchSubmit(map, write, original, address, "fresh-buffer");
+	if (submitted == ThorDpuScratchSkipped) {
+		IOLockUnlock(lock);
+		return;
+	}
+
+	/* Restore only from an idle, precisely recognized controller route.
+	 * Keep the mapping and backing pinned if restore cannot be confirmed. */
+	auto restored = thorDpuScratchSubmit(map, write, address, original, "restore");
+	if (restored == ThorDpuScratchSkipped) {
+		restored = thorDpuScratchSubmit(map, write, original, original, "restore-original-route");
+	}
+	IOLockUnlock(lock);
+	if (restored != ThorDpuScratchLatched) {
+		scratch.mapping = nullptr;
+		scratch.memory = nullptr;
+		thorDpuMarker("THOR DPU SCRATCH: UNCERTAIN restore, keep fresh backing pinned\n");
+		return;
+	}
+	if (submitted == ThorDpuScratchLatched && thorDsiDomainAudit(map, kThorDsi[0])) {
+		thorDpuMarker("THOR DPU SCRATCH: PASS new-address latch and original-address restore\n");
+	} else {
+		thorDpuMarker("THOR DPU SCRATCH: restore confirmed, new scanout unqualified\n");
+	}
+}
+
+static void
+thorDpuProbe(uint64_t framebuffer, const uint8_t *source, IOLock *lock)
+{
+	ThorDpuMappings map = {};
+	map.gcc = io_map(kThorGccDispAhb & ~0xffful, 0x1000, VM_WIMG_IO, VM_PROT_READ, true);
+	if (!map.gcc || !thorDpuClockRunning(thorDpuRead(map.gcc + (kThorGccDispAhb & 0xfff)))) {
+		thorDpuMarker("THOR DPU PROBE: skip GCC DISP AHB unavailable\n");
+		return;
+	}
+	map.clocks = io_map(kThorDispCc + 0x8000, 0x2000, VM_WIMG_IO, VM_PROT_READ, true);
+	if (!map.clocks || !thorDpuClocksReady(map)) {
+		thorDpuMarker("THOR DPU PROBE: skip MDSS register clocks or power unavailable\n");
+		return;
+	}
+	map.mdss = io_map(kThorMdss, 0x84000, VM_WIMG_IO, VM_PROT_READ, true);
+	if (!map.mdss) {
+		thorDpuMarker("THOR DPU PROBE: skip MDSS map unavailable\n");
+		return;
+	}
+
+	thorDpuMarker("THOR DPU PROBE: clock guards passed, before first MDSS read\n");
+	uint32_t active = 0, fetch = 0;
+	for (unsigned i = 0; i < 6; ++i) {
+		if (!thorDpuClocksReady(map)) return;
+		const vm_offset_t ctl = map.mdss + 0x16000 + i * 0x1000;
+		const uint32_t interfaces = thorDpuRead(ctl + kThorCtlIntfActive);
+		if (!(interfaces & kThorDsiInterfaces)) continue;
+		const uint32_t pipes = thorDpuRead(ctl + kThorCtlFetchActive);
+		active |= interfaces;
+		fetch |= pipes;
+		IOLog("THOR DPU CTL: id=%u intf=%#x fetch=%#x top=%#x flush=%#x\n", i, interfaces,
+		    pipes, thorDpuRead(ctl + 0x14), thorDpuRead(ctl + 0x18));
+	}
+	if (!(active & kThorDsiInterfaces)) {
+		thorDpuMarker("THOR DPU PROBE: skip CTL reported no active DSI route\n");
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(kThorSsppOffset) / sizeof(kThorSsppOffset[0]); ++i) {
+		if (!(fetch & (1u << kThorSsppFetchBit[i]))) continue;
+		if (!thorDpuClocksReady(map)) return;
+		const vm_offset_t pipe = map.mdss + kThorSsppOffset[i];
+		const uint32_t source = thorDpuRead(pipe + 0x14);
+		const bool inFramebuffer = source >= framebuffer && source - framebuffer < 1440ull * 3200 * 4;
+		IOLog("THOR DPU SSPP: id=%u src=%#x size=%#x out=%#x stride=%#x fmt=%#x fb=%#llx inside=%u\n", i,
+		    source, thorDpuRead(pipe), thorDpuRead(pipe + 0x0c), thorDpuRead(pipe + 0x24),
+		    thorDpuRead(pipe + 0x30), framebuffer, inFramebuffer ? 1 : 0);
+	}
+
+	uint32_t previous[2] = {};
+	uint32_t baselineFrames = 0;
+	uint64_t previousAt = 0;
+	for (unsigned sample = 0; sample < 4; ++sample) {
+		if (sample) IOSleep(250);
+		if (!thorDpuClocksReady(map)) return;
+		const uint64_t now = mach_absolute_time();
+		uint64_t elapsed = 0;
+		if (sample) absolutetime_to_nanoseconds(now - previousAt, &elapsed);
+		for (unsigned i = 0; i < 2; ++i) {
+			if (!(active & (1u << (i + 1)))) continue;
+			const vm_offset_t intf = map.mdss + kThorIntfOffset[i];
+			const uint32_t counter = thorDpuRead(intf + kThorIntfFrameCount);
+			IOLog("THOR DPU INTF: id=%u sample=%u frames=%u delta=%u elapsed_us=%llu tear=%#x auto=%#x\n",
+			    i + 1, sample, counter, sample ? counter - previous[i] : 0, elapsed / 1000,
+			    thorDpuRead(intf + kThorIntfTearCheck), thorDpuRead(intf + kThorIntfAutorefresh));
+			if (i == 0 && sample == 0) baselineFrames = counter;
+			previous[i] = counter;
+		}
+		previousAt = now;
+	}
+	thorDpuMarker("THOR DPU PROBE: read-only phase complete\n");
+	if (active != 0x2 || fetch != 0x30000 || previous[0] - baselineFrames > 3) {
+		thorDpuMarker("THOR DPU REFRESH: skip route or frame counter differs from v119\n");
+		return;
+	}
+	uint32_t enable = 1;
+	(void) PE_parse_boot_argn("thor_dpu_refresh", &enable, sizeof(enable));
+	if (enable != 1) {
+		thorDpuMarker("THOR DPU REFRESH: disabled by boot argument\n");
+		return;
+	}
+	if (!thorDpuWriteRefresh(map, framebuffer, kThorFirmwareRefresh, kThorRefreshEachTe)) return;
+	const vm_offset_t intf = map.mdss + kThorIntfOffset[0];
+	if (!thorDpuClocksReady(map)) return;
+	uint32_t counter = thorDpuRead(intf + kThorIntfFrameCount);
+	const uint32_t firstCounter = counter;
+	uint64_t at = mach_absolute_time();
+	for (unsigned i = 0; i < 8; ++i) {
+		IOSleep(250);
+		if (!thorDpuClocksReady(map)) return;
+		const uint32_t next = thorDpuRead(intf + kThorIntfFrameCount);
+		const uint32_t refresh = thorDpuRead(intf + kThorIntfAutorefresh);
+		const uint64_t now = mach_absolute_time();
+		uint64_t elapsed = 0;
+		absolutetime_to_nanoseconds(now - at, &elapsed);
+		IOLog("THOR DPU REFRESH: sample=%u frames=%u delta=%u elapsed_us=%llu auto=%#x\n",
+		    i + 1, next, next - counter, elapsed / 1000, refresh);
+		if (refresh != kThorRefreshEachTe) {
+			thorDpuMarker("THOR DPU REFRESH: stopped after config changed\n");
+			return;
+		}
+		if (i == 2 && next - firstCounter <= 3) {
+			thorDpuMarker("THOR DPU REFRESH: frame count did not accelerate; restoring firmware\n");
+			(void) thorDpuWriteRefresh(map, framebuffer, kThorRefreshEachTe, kThorFirmwareRefresh);
+			return;
+		}
+		counter = next;
+		at = now;
+	}
+	const bool panel120 = thorDsiAudit(map, framebuffer, active);
+	thorDpuFlipAudit(map, framebuffer);
+	uint32_t trial = 1;
+	(void)PE_parse_boot_argn("thor_flip_trial", &trial, sizeof(trial));
+	if (trial && panel120 && source) thorDpuScratchTrial(map, framebuffer, source, lock);
+	thorDpuInteractionAudit(map, framebuffer);
+}
