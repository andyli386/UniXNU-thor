+static inline bool
+pongNearestThreeToTwo(bool filter, bool diff, int32_t sourceWidth,
+    int32_t left, int32_t right, uint32_t panelWidth)
+{
+	return !filter && !diff && sourceWidth > 0 && left == 0 &&
+	       right > 0 && (uint32_t)right == panelWidth &&
+	       (uint64_t)sourceWidth * 3 == (uint64_t)panelWidth * 2;
