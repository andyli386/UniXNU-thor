+/* Exact 3:2 horizontal area coverage. Only the middle pixel straddles
+ * a source-pixel boundary, and carries half the weight of each pixel. */
+static inline void
+drawThorAreaRowScalar(const uint32_t *top, const uint32_t *bottom, uint32_t weight,
+    uint32_t *panel, uint32_t width)
+{
+	constexpr uint32_t opaque = 0xff000000u;
+	for (uint32_t x = 0; x < width; x += 2) {
+		const uint32_t a = top[x] == bottom[x] ? top[x] : blend(top[x], bottom[x], weight);
+		const uint32_t b = top[x + 1] == bottom[x + 1] ? top[x + 1] :
+		    blend(top[x + 1], bottom[x + 1], weight);
+		const uint32_t middle = (a & b) + (((a ^ b) & 0xfefefefeu) >> 1);
