 		}
 		return;
@@ -1127,11 +1139,26 @@
 	}
 	printf("Pong FTS: PASS %s scan configured, /dev/pong-touch ready; SPI 0x%llx reset=%u irq=%u axes=%ux%u flip=%u\n",
