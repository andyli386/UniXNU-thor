--- a/bsd/dev/pong_fts.c
+++ b/bsd/dev/pong_fts.c
@@ -873,13 +873,24 @@
 }
 
 static struct {
-	uint32_t polls, events, touches, errors, io_failures, last_x, last_y;
+	uint32_t polls, events, touches, releases, errors, io_failures, last_x, last_y;
 } seen;
 
 static struct {
 	bool down;
 	uint32_t x, y;
 } contact[FTS_MAX_TOUCHES];
+
+static bool
+fts_has_contact(void)
+{
+	for (unsigned id = 0; id < FTS_MAX_TOUCHES; id++) {
+		if (contact[id].down) {
+			return true;
+		}
+	}
+	return false;
+}
 
 /*
  * boot-arg touch_flip: bit 0 mirrors the screen's x, bit 1 its y, bit 2 keeps the controller's axes unswapped.
@@ -917,6 +928,7 @@
 	if (type == FTS_EVENT_LEAVE) {
