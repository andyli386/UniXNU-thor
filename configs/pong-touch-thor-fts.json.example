{
  "_comment": "Copy to configs/pong-touch-thor-fts.json and fill with this board's CONFIRMED Recovery-DT values for the STMicro FTS touch controller. pins order: [spi-clk, spi-cs, spi-mosi, spi-miso, irq-gpio, rst-gpio]. Remove _comment and set enable=true. Until this file exists the FTS driver stays dormant and the Goodix node keeps its place.",
  "enable": false,
  "spi_base": "0x990000",
  "tlmm_base": "0xF000000",
  "gcc_base": "0x100000",
  "rsc_base": "0x17A20000",
  "cmd_db_base": "0x80860000",
  "gpio_offset": "0x100000",
  "pins": [16, 17, 18, 19, 21, 20],
  "max_x": 1080,
  "max_y": 2412
}
